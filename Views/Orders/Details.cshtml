@model WebApplication_ClothingEcommerce.Models.Order

@{
    ViewData["Title"] = "Order Details";

    var orderNumber = Model.Id.ToString()[..8].ToUpper();

    var subtotal = Model.Items?.Sum(x => x.UnitPrice * x.Quantity) ?? 0m;
    var deliveryFee = Model.TotalAmount - subtotal;

    if (deliveryFee < 0)
    {
        deliveryFee = 0m;
    }

    var statusClass = Model.Status.ToString() switch
    {
        "Pending" => "bg-warning-subtle text-warning-emphasis",
        "Processing" => "bg-info-subtle text-info-emphasis",
        "Shipped" => "bg-primary-subtle text-primary",
        "Delivered" => "bg-success-subtle text-success",
        "Cancelled" => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };

    var paymentStatusClass = Model.Payment?.PaymentStatus.ToString() switch
    {
        "Paid" => "bg-success-subtle text-success",
        "Pending" => "bg-warning-subtle text-warning-emphasis",
        "Failed" => "bg-danger-subtle text-danger",
        "Refunded" => "bg-info-subtle text-info-emphasis",
        _ => "bg-secondary-subtle text-secondary"
    };

    var shipmentStatusClass = Model.Shipment?.ShipmentStatus.ToString() switch
    {
        "Pending" => "bg-warning-subtle text-warning-emphasis",
        "Processing" => "bg-info-subtle text-info-emphasis",
        "Shipped" => "bg-primary-subtle text-primary",
        "Delivered" => "bg-success-subtle text-success",
        _ => "bg-secondary-subtle text-secondary"
    };
}

<style>
    .order-details-page {
        background: #fff;
    }

    .order-details-hero {
        background: linear-gradient(120deg, var(--blue-soft, #eaf2ff), #fff 60%);
        border-bottom: 1px solid var(--border, #eeeeee);
        padding: 32px 0;
    }

    .order-details-eyebrow {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .12em;
        color: var(--google-blue, #4285F4);
        margin-bottom: 4px;
    }

    .order-details-hero h1 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--black, #202124);
        margin-bottom: 4px;
    }

    .order-details-card {
        border: 1px solid var(--border, #eeeeee);
        border-radius: 20px;
        background: #fff;
    }

    .order-details-section-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #fff;
    }

        .order-details-section-icon.blue {
            background: var(--google-blue, #4285F4);
        }

        .order-details-section-icon.green {
            background: var(--google-green, #34A853);
        }

        .order-details-section-icon.yellow {
            background: var(--google-yellow-dark, #F9AB00);
        }

        .order-details-section-icon.red {
            background: var(--google-red, #EA4335);
        }

    .order-details-item-image {
        width: 100%;
        height: 110px;
        object-fit: cover;
        border-radius: 14px;
        border: 1px solid var(--border, #eeeeee);
    }

    .order-details-item-image-placeholder {
        height: 110px;
        border-radius: 14px;
        border: 1px solid var(--border, #eeeeee);
        background: var(--light-gray, #f8f8f6);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gray, #999);
    }

    .order-details-brand-label {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--google-blue, #4285F4);
    }

    .order-details-item-total {
        color: var(--google-blue, #4285F4);
        font-weight: 800;
    }

    .order-details-total-value {
        color: var(--google-blue, #4285F4);
        font-weight: 800;
    }

    .order-details-back-btn {
        display: block;
        width: 100%;
        text-align: center;
        border: 1px solid #dcdcdc;
        border-radius: 12px;
        padding: 13px;
        color: var(--black, #202124);
        text-decoration: none;
        font-weight: 700;
        transition: all .2s ease;
    }

        .order-details-back-btn:hover {
            border-color: var(--google-blue, #4285F4);
            color: var(--google-blue, #4285F4);
        }

    .order-details-continue-btn {
        display: block;
        width: 100%;
        text-align: center;
        border: 0;
        border-radius: 12px;
        padding: 14px;
        background: var(--google-blue, #4285F4);
        color: #fff;
        text-decoration: none;
        font-weight: 700;
        box-shadow: 0 10px 24px rgba(66,133,244,.28);
        transition: all .2s ease;
    }

        .order-details-continue-btn:hover {
            background: var(--google-blue-dark, #3367D6);
            color: #fff;
            transform: translateY(-2px);
        }
</style>

<div class="order-details-page">

    <!-- =========================================================
         BREADCRUMB
    ========================================================= -->

    <section class="py-3 border-bottom">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">
                            <i class="bi bi-house me-1"></i> Home
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Orders" asp-action="Index" class="text-decoration-none text-secondary">
                            <i class="bi bi-box-seam me-1"></i> My Orders
                        </a>
                    </li>
                    <li class="breadcrumb-item active fw-semibold" aria-current="page" style="color: var(--google-blue, #4285F4);">
                        Order Details
                    </li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- =========================================================
         HERO
    ========================================================= -->

    <section class="order-details-hero">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="order-details-eyebrow">ORDER DETAILS</div>
                    <h1>Order #@orderNumber</h1>
                    <p class="text-secondary mb-0">
                        Placed on @Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                    </p>
                </div>

                <span class="badge rounded-pill px-4 py-2 fs-6 @statusClass">
                    @Model.Status
                </span>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">

            <!-- SUCCESS MESSAGE -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }

            <div class="row g-4">

                <!-- LEFT COLUMN -->
                <div class="col-lg-8">

                    <!-- ORDER ITEMS -->
                    <div class="order-details-card mb-4 p-4">

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-bold mb-1">Order Items</h5>
                                <small class="text-secondary">
                                    @(Model.Items?.Count ?? 0) @((Model.Items?.Count ?? 0) == 1 ? "item" : "items")
                                </small>
                            </div>
                            <div class="order-details-section-icon blue">
                                <i class="bi bi-bag-check"></i>
                            </div>
                        </div>

                        @if (Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                var image =
                                    item.Variant?.Product?.Images?.FirstOrDefault(x => x.IsPrimary)
                                    ?? item.Variant?.Product?.Images?.FirstOrDefault();

                                var itemTotal = item.UnitPrice * item.Quantity;

                                <div class="row g-3 align-items-center border-bottom pb-4 mb-4">

                                    <!-- IMAGE -->
                                    <div class="col-4 col-sm-3 col-md-2">
                                        @if (!string.IsNullOrWhiteSpace(image?.ImageUrl))
                                        {
                                            <img src="@image.ImageUrl"
                                                 alt="@item.Variant?.Product?.Name"
                                                 class="order-details-item-image" />
                                        }
                                        else
                                        {
                                            <div class="order-details-item-image-placeholder">
                                                <i class="bi bi-image fs-2"></i>
                                            </div>
                                        }
                                    </div>

                                    <!-- PRODUCT INFO -->
                                    <div class="col-8 col-sm-5 col-md-5">
                                        <div class="order-details-brand-label mb-1">
                                            @(item.Variant?.Product?.Brand?.Name ?? "CLOTHÉ")
                                        </div>
                                        <h6 class="fw-bold mb-1">
                                            @(item.Variant?.Product?.Name ?? "Product")
                                        </h6>

                                        <div class="small text-secondary">
                                            @if (item.Variant?.Size != null)
                                            {
                                                <span class="me-3">
                                                    Size: <strong class="text-dark">@item.Variant.Size.Name</strong>
                                                </span>
                                            }
                                            @if (item.Variant?.Color != null)
                                            {
                                                <span>
                                                    Color: <strong class="text-dark">@item.Variant.Color.Name</strong>
                                                </span>
                                            }
                                        </div>

                                        @if (item.Variant != null)
                                        {
                                            <div class="small text-secondary mt-1">
                                                SKU: @item.Variant.SKU
                                            </div>
                                        }

                                        <div class="small text-secondary mt-1">
                                            Quantity: <strong class="text-dark">@item.Quantity</strong>
                                        </div>
                                    </div>

                                    <!-- UNIT PRICE -->
                                    <div class="col-6 col-md-2">
                                        <small class="text-secondary d-block">Unit Price</small>
                                        <strong>$@item.UnitPrice.ToString("0.00")</strong>
                                    </div>

                                    <!-- TOTAL -->
                                    <div class="col-6 col-md-3 text-end">
                                        <small class="text-secondary d-block">Total</small>
                                        <strong class="fs-5 order-details-item-total">
                                            $@itemTotal.ToString("0.00")
                                        </strong>
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-bag-x display-5 text-secondary"></i>
                                <p class="text-secondary mb-0 mt-2">No order items found.</p>
                            </div>
                        }

                    </div>

                    <!-- SHIPPING ADDRESS -->
                    <div class="order-details-card mb-4 p-4">

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="order-details-section-icon green">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Shipping Address</h5>
                                <small class="text-secondary">Delivery destination</small>
                            </div>
                        </div>

                        @if (Model.Address != null)
                        {
                            <div class="ps-1">
                                <strong class="d-block mb-1">Delivery Address</strong>
                                <div class="text-secondary">
                                    @Model.Address.Street
                                    @if (!string.IsNullOrWhiteSpace(Model.Address.City))
                                    {
                                        <span>, @Model.Address.City</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Address.Province))
                                    {
                                        <span>, @Model.Address.Province</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Address.PostalCode))
                                    {
                                        <span>, @Model.Address.PostalCode</span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border rounded-3 mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                Shipping address is unavailable.
                            </div>
                        }

                    </div>

                </div>

                <!-- RIGHT COLUMN -->
                <div class="col-lg-4">

                    <!-- ORDER SUMMARY -->
                    <div class="order-details-card mb-4 p-4">
                        <h5 class="fw-bold mb-4">Order Summary</h5>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-secondary">Subtotal</span>
                            <strong>$@subtotal.ToString("0.00")</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-secondary">Delivery</span>
                            @if (deliveryFee > 0)
                            {
                                <strong>$@deliveryFee.ToString("0.00")</strong>
                            }
                            else
                            {
                                <strong style="color: var(--google-green, #34A853);">Free</strong>
                            }
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">Total</span>
                            <strong class="fs-3 order-details-total-value">
                                $@Model.TotalAmount.ToString("0.00")
                            </strong>
                        </div>
                    </div>

                    <!-- PAYMENT -->
                    <div class="order-details-card mb-4 p-4">

                        <div class="d-flex align-items-center gap-2 mb-4">
                            <div class="order-details-section-icon yellow" style="width:38px;height:38px;font-size:15px;">
                                <i class="bi bi-credit-card"></i>
                            </div>
                            <h5 class="fw-bold mb-0">Payment</h5>
                        </div>

                        @if (Model.Payment != null)
                        {
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-secondary">Method</span>
                                <strong>@(Model.Payment.PaymentMethod?.Name ?? "Credit / Debit Card")</strong>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary">Status</span>
                                <span class="badge rounded-pill px-3 py-2 @paymentStatusClass">
                                    @Model.Payment.PaymentStatus
                                </span>
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary mb-0">Payment information unavailable.</p>
                        }

                    </div>

                    <!-- SHIPMENT -->
                    <div class="order-details-card mb-4 p-4">

                        <div class="d-flex align-items-center gap-2 mb-4">
                            <div class="order-details-section-icon red" style="width:38px;height:38px;font-size:15px;">
                                <i class="bi bi-truck"></i>
                            </div>
                            <h5 class="fw-bold mb-0">Shipment</h5>
                        </div>

                        @if (Model.Shipment != null)
                        {
                            <div class="mb-3">
                                <span class="text-secondary small d-block">Shipping Company</span>
                                <strong>@Model.Shipment.ShippingCompany</strong>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.Shipment.TrackingNumber))
                            {
                                <div class="mb-3">
                                    <span class="text-secondary small d-block">Tracking Number</span>
                                    <code>@Model.Shipment.TrackingNumber</code>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary">Status</span>
                                <span class="badge rounded-pill px-3 py-2 @shipmentStatusClass">
                                    @Model.Shipment.ShipmentStatus
                                </span>
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary mb-0">Shipment information unavailable.</p>
                        }

                    </div>

                    <!-- ACTIONS -->
                    <a asp-controller="Orders" asp-action="Index" class="order-details-back-btn mb-2">
                        <i class="bi bi-arrow-left me-2"></i> Back to Orders
                    </a>

                    <a asp-controller="Shop" asp-action="Index" class="order-details-continue-btn">
                        <i class="bi bi-bag me-2"></i> Continue Shopping
                    </a>

                </div>

            </div>

        </div>
    </section>

</div>