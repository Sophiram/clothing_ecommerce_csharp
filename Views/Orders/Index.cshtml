@model IEnumerable<WebApplication_ClothingEcommerce.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<!-- =========================================================
     BREADCRUMB
========================================================= -->

<section class="py-3 bg-light border-bottom">

    <div class="container">

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb mb-0">

                <li class="breadcrumb-item">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="text-decoration-none text-secondary">
                        <i class="bi bi-house me-1"></i>
                        Home
                    </a>
                </li>

                <li class="breadcrumb-item active text-dark fw-semibold"
                    aria-current="page">
                    My Orders
                </li>

            </ol>

        </nav>

    </div>

</section>

<!-- =========================================================
     MAIN
========================================================= -->

<section class="py-5 bg-light min-vh-100">

    <div class="container">


        <!-- =====================================================
         HEADER
    ====================================================== -->

        <div class="d-flex
            flex-column
            flex-md-row
            justify-content-between
            align-items-md-center
            gap-4
            mb-5">

            <div>

                <div class="small
                    text-uppercase
                    fw-bold
                    text-primary
                    mb-2">

                    <i class="bi bi-person-circle me-1"></i>
                    ACCOUNT

                </div>

                <h1 class="fw-bold mb-2">
                    My Orders
                </h1>

                <p class="text-secondary mb-0">
                    Track and view all your previous orders.
                </p>

            </div>


            <div class="d-flex
                align-items-center
                justify-content-center
                bg-white
                rounded-circle
                shadow-sm"
                 style="width:64px;height:64px;">

                <i class="bi bi-box-seam fs-3 text-primary"></i>

            </div>

        </div>


        <!-- =====================================================
         ALERTS
    ====================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success
                border-0
                shadow-sm
                rounded-3
                d-flex
                align-items-center
                gap-2
                mb-4">

                <i class="bi bi-check-circle-fill fs-5"></i>

                <span>
                    @TempData["Success"]
                </span>

            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger
                border-0
                shadow-sm
                rounded-3
                d-flex
                align-items-center
                gap-2
                mb-4">

                <i class="bi bi-exclamation-circle-fill fs-5"></i>

                <span>
                    @TempData["Error"]
                </span>

            </div>
        }


        <!-- =====================================================
         EMPTY ORDERS
    ====================================================== -->
        @if (Model == null || !Model.Any())
        {
            <div class="card
                border-0
                shadow-sm
                rounded-4">

                <div class="card-body
                    text-center
                    py-5
                    px-4">

                    <div class="d-inline-flex
                        align-items-center
                        justify-content-center
                        rounded-circle
                        bg-primary-subtle
                        text-primary
                        mb-4"
                         style="width:96px;height:96px;">

                        <i class="bi bi-bag-x display-6"></i>

                    </div>


                    <h3 class="fw-bold mb-2">
                        No orders yet
                    </h3>


                    <p class="text-secondary
                        mx-auto
                        mb-4"
                       style="max-width:500px;">

                        You haven't placed any orders yet.
                        Start shopping and your orders will appear here.

                    </p>


                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="btn btn-dark px-4 py-2 rounded-3">

                        <i class="bi bi-bag me-2"></i>

                        Start Shopping

                    </a>

                </div>

            </div>
        }
        else
        {

            <!-- =================================================
             ORDER COUNT
        ================================================== -->

            <div class="d-flex
                justify-content-between
                align-items-end
                mb-4">

                <div>

                    <h5 class="fw-bold mb-1">
                        Your Orders
                    </h5>

                    <div class="small text-secondary">

                        <i class="bi bi-receipt me-1"></i>

                        @Model.Count()
                        @(Model.Count() == 1 ? "order" : "orders")

                    </div>

                </div>

            </div>


            <!-- =================================================
             ORDER LIST
        ================================================== -->
            @foreach (var order in Model)
            {
                var statusClass = order.Status.ToString() switch
                {
                    "Pending" =>
                        "bg-warning-subtle text-warning-emphasis",

                    "Processing" =>
                        "bg-info-subtle text-info-emphasis",

                    "Shipped" =>
                        "bg-primary-subtle text-primary",

                    "Delivered" =>
                        "bg-success-subtle text-success",

                    "Cancelled" =>
                        "bg-danger-subtle text-danger",

                    _ =>
                        "bg-secondary-subtle text-secondary"
                };


                var firstItem = order.Items?.FirstOrDefault();


                var image =
                    firstItem?.Variant?.Product?.Images?
                        .FirstOrDefault(x => x.IsPrimary)
                    ??
                    firstItem?.Variant?.Product?.Images?
                        .FirstOrDefault();


                var itemCount = order.Items?.Count ?? 0;


                var productName =
                    firstItem?.Variant?.Product?.Name
                    ?? "Order Items";


                var brandName =
                    firstItem?.Variant?.Product?.Brand?.Name
                    ?? "CLOTHÉ";


                <!-- =================================================
                 ORDER CARD
            ================================================== -->

                <div class="card
                    border-0
                    shadow-sm
                    rounded-4
                    mb-4">

                    <div class="card-body p-4">


                        <!-- =================================================
                         ORDER HEADER
                    ================================================== -->

                        <div class="d-flex
                            flex-column
                            flex-md-row
                            justify-content-between
                            align-items-md-center
                            gap-3">

                            <div>

                                <div class="d-flex
                                    align-items-center
                                    gap-2
                                    mb-2">

                                    <span class="fw-bold">
                                        Order
                                    </span>

                                    <code class="bg-light
                                        px-2
                                        py-1
                                        rounded-2">

                                        #@order.Id.ToString()[..8].ToUpper()

                                    </code>

                                </div>


                                <div class="small text-secondary">

                                    <i class="bi bi-calendar3 me-1"></i>

                                    @order.OrderDate
                                    @* .ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt") *@

                                </div>

                            </div>


                            <!-- STATUS -->

                            <div>

                                <span class="badge
                                    rounded-pill
                                    px-3
                                    py-2
                                    @statusClass">

                                    @order.Status

                                </span>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- =================================================
                         ORDER PRODUCT
                    ================================================== -->

                        <div class="row
                            align-items-center
                            g-4">


                            <!-- PRODUCT IMAGE -->

                            <div class="col-4 col-sm-3 col-md-2">

                                @if (!string.IsNullOrWhiteSpace(
                                    image?.ImageUrl))
                                {
                                    <img src="@image.ImageUrl"
                                         alt="@productName"
                                         class="img-fluid
                                    rounded-3
                                    border"
                                         style="width:100%;
                                    height:120px;
                                    object-fit:cover;"
                                         onerror="this.style.display='none';
                                    this.nextElementSibling.style.display='flex';" />

                                    <div class="bg-light
                                        border
                                        rounded-3
                                        align-items-center
                                        justify-content-center"
                                         style="height:120px;
                                        display:none;">

                                        <i class="bi bi-image
                                            fs-2
                                            text-secondary">
                                        </i>

                                    </div>
                                }
                                else
                                {
                                    <div class="bg-light
                                        border
                                        rounded-3
                                        d-flex
                                        align-items-center
                                        justify-content-center"
                                         style="height:120px;">

                                        <i class="bi bi-image
                                            fs-2
                                            text-secondary">
                                        </i>

                                    </div>
                                }

                            </div>


                            <!-- PRODUCT INFO -->

                            <div class="col-8 col-md-5">

                                <div class="small
                                    text-uppercase
                                    fw-bold
                                    text-primary
                                    mb-1">

                                    @brandName

                                </div>


                                <h5 class="fw-bold mb-2">

                                    @productName

                                </h5>


                                @if (firstItem?.Variant != null)
                                {
                                    <div class="small text-secondary mb-2">

                                        @if (firstItem.Variant.Color != null)
                                        {
                                            <span class="me-3">

                                                <i class="bi bi-palette me-1"></i>

                                                @firstItem.Variant.Color.Name

                                            </span>
                                        }


                                        @if (firstItem.Variant.Size != null)
                                        {
                                            <span>

                                                <i class="bi bi-rulers me-1"></i>

                                                @firstItem.Variant.Size.Name

                                            </span>
                                        }

                                    </div>
                                }


                                <div class="small text-secondary">

                                    @if (itemCount == 1)
                                    {
                                        <span>
                                            1 item
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            @itemCount items
                                        </span>
                                    }

                                </div>


                                @if (itemCount > 1)
                                {
                                    <div class="small text-secondary mt-1">

                                        + @(itemCount - 1)
                                        more
                                        @(itemCount - 1 == 1 ? "item" : "items")

                                    </div>
                                }

                            </div>


                            <!-- TOTAL -->

                            <div class="col-6 col-md-2">

                                <small class="text-secondary d-block mb-1">
                                    Total
                                </small>

                                <strong class="fs-5 text-primary">

                                    $@order.TotalAmount.ToString("0.00")

                                </strong>

                            </div>


                            <!-- ACTION -->

                            <div class="col-6 col-md-3 text-md-end">

                                <a asp-controller="Orders"
                                   asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="btn btn-dark
                                    rounded-3
                                    px-3">

                                    View Order

                                    <i class="bi bi-arrow-right ms-1"></i>

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        }

    </div>
   

</section>
