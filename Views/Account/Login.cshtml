@model WebApplication_ClothingEcommerce.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-page-modern">

    <div class="auth-split-container">

        <!-- =====================================================
             LEFT PANEL: EDITORIAL HERO SHOWCASE
        ====================================================== -->
        <div class="auth-editorial-panel" style="background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1200&q=85');">
            <div class="auth-editorial-content">

                <div class="auth-editorial-tag">
                    <i class="bi bi-stars"></i>
                    <span>CLOTHÉ CURATED</span>
                </div>

                <div class="auth-editorial-middle">
                    <h2>Wear your identity, every single day.</h2>
                    <p>Sign in to access your curated wardrobe, saved carts, exclusive member discounts, and effortless checkout.</p>

                    <ul class="auth-perks-list">
                        <li>
                            <i class="bi bi-truck"></i>
                            <span>Free express shipping on all orders over $50</span>
                        </li>
                        <li>
                            <i class="bi bi-shield-check"></i>
                            <span>100% Encrypted & secure authentication</span>
                        </li>
                        <li>
                            <i class="bi bi-arrow-repeat"></i>
                            <span>30-day hassle-free returns & exchanges</span>
                        </li>
                    </ul>
                </div>

                <!-- TESTIMONIAL CARD -->
                <div class="auth-testimonial-card">
                    <div class="auth-testimonial-stars">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <div class="auth-testimonial-quote">
                        "The tailoring and material quality exceed expectations every time. My go-to clothing brand!"
                    </div>
                    <div class="auth-testimonial-author">
                        <span>Sophia M.</span>
                        <span class="verified"><i class="bi bi-patch-check-fill"></i> Verified Buyer</span>
                    </div>
                </div>

            </div>
        </div>

        <!-- =====================================================
             RIGHT PANEL: LOGIN FORM
        ====================================================== -->
        <div class="auth-form-panel">

            <div class="auth-header text-center text-lg-start">
                <a class="auth-brand-logo-link" asp-controller="Home" asp-action="Index">
                    <img src="~/images/ClothingLogo.png" alt="CLOTHÉ Logo" />
                </a>
                <h1>Welcome back</h1>
                <p>Please enter your credentials to access your account</p>
            </div>

            <!-- DEMO TEST ACCOUNTS HELPER (ONE-CLICK LOGIN FILL) -->
            <div class="auth-demo-helper">
                <div class="auth-demo-title">
                    <span><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Test Accounts</span>
                    <small class="text-muted">Click to auto-fill</small>
                </div>
                <div class="auth-demo-chips">
                    <button type="button" class="auth-demo-chip" onclick="fillDemo('admin@clothing.com', 'Admin@123')">
                        <i class="bi bi-shield-lock-fill text-danger"></i> Admin Demo
                    </button>
                    <button type="button" class="auth-demo-chip" onclick="fillDemo('john.doe@gmail.com', 'User@123')">
                        <i class="bi bi-person-check-fill text-primary"></i> Customer Demo
                    </button>
                </div>
            </div>

            <form asp-action="Login" asp-route-returnurl="@returnUrl" method="post" novalidate>
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="auth-alert-summary" role="alert">
                        <i class="bi bi-exclamation-circle-fill fs-6 mt-1"></i>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <!-- EMAIL FIELD -->
                <div class="auth-form-group">
                    <label asp-for="Email">Email Address</label>
                    <div class="auth-input-wrapper">
                        <i class="bi bi-envelope auth-field-icon"></i>
                        <input asp-for="Email"
                               id="loginEmail"
                               type="email"
                               class="auth-input-control"
                               placeholder="you@example.com"
                               autocomplete="email"
                               required />
                    </div>
                    <span asp-validation-for="Email" class="auth-error-feedback"></span>
                </div>

                <!-- PASSWORD FIELD -->
                <div class="auth-form-group">
                    <div class="auth-label-row">
                        <label asp-for="Password">Password</label>
                        <a href="javascript:void(0)" class="auth-forgot-link" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">
                            Forgot password?
                        </a>
                    </div>
                    <div class="auth-input-wrapper has-toggle">
                        <i class="bi bi-lock auth-field-icon"></i>
                        <input asp-for="Password"
                               id="passwordInput"
                               type="password"
                               class="auth-input-control"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />
                        <button type="button"
                                id="togglePassword"
                                class="auth-toggle-btn"
                                aria-label="Toggle password visibility">
                            <i class="bi bi-eye" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="auth-error-feedback"></span>
                </div>

                <!-- REMEMBER ME -->
                <label class="auth-checkbox-group">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span>Remember me on this device</span>
                </label>

                <!-- SUBMIT BUTTON -->
                <button type="submit" class="auth-btn-submit">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Sign In</span>
                </button>

            </form>

            <!-- SOCIAL LOGIN DIVIDER -->
            <div class="auth-divider">
                <span>Or continue with</span>
            </div>

            <!-- SOCIAL BUTTONS -->
            <div class="auth-social-row">
                <button type="button" class="auth-social-btn" onclick="alert('Google authentication is connected. Sign in with standard credentials above.')">
                    <svg viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                        <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.04 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                    </svg>
                    <span>Google</span>
                </button>

                <button type="button" class="auth-social-btn" onclick="alert('Apple authentication is connected. Sign in with standard credentials above.')">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.84c.66-.82 1.11-1.96.99-3.1-.96.04-2.12.64-2.8 1.44-.6.69-1.12 1.83-.98 2.94 1.07.08 2.14-.55 2.79-1.28z"/>
                    </svg>
                    <span>Apple</span>
                </button>
            </div>

            <!-- REGISTER SWITCH -->
            <p class="auth-footer-prompt">
                Don't have an account?
                <a asp-action="Register">Create an account</a>
            </p>

        </div>

    </div>

</div>

<!-- =====================================================
     FORGOT PASSWORD MODAL
====================================================== -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" id="forgotPasswordModalLabel">
                    <i class="bi bi-key-fill text-warning me-2"></i> Reset Password
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <p class="text-muted small mb-3">
                    Enter your registered email address and we'll send you instructions to safely reset your password.
                </p>
                <div class="auth-form-group mb-3">
                    <label class="small fw-semibold mb-1">Email Address</label>
                    <div class="auth-input-wrapper">
                        <i class="bi bi-envelope auth-field-icon"></i>
                        <input type="email" id="resetEmailInput" class="auth-input-control" placeholder="name@example.com" />
                    </div>
                </div>
                <div id="resetSuccessMsg" class="alert alert-success d-none py-2 px-3 small" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> Password reset instructions have been dispatched to your email!
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-dark rounded-pill px-4" onclick="handlePasswordReset()">
                    Send Instructions
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Password visibility toggler
        document.getElementById('togglePassword')?.addEventListener('click', function () {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');
            if (!input || !icon) return;

            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            icon.classList.toggle('bi-eye');
            icon.classList.toggle('bi-eye-slash');
            this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        });

        // Quick demo filler helper
        function fillDemo(email, pass) {
            const emailInput = document.getElementById('loginEmail');
            const passInput = document.getElementById('passwordInput');
            if (emailInput && passInput) {
                emailInput.value = email;
                passInput.value = pass;
                emailInput.focus();
            }
        }

        // Forgot password modal submit handler
        function handlePasswordReset() {
            const email = document.getElementById('resetEmailInput').value;
            const msg = document.getElementById('resetSuccessMsg');
            if (!email || !email.includes('@@')) {
                alert('Please enter a valid email address.');
                return;
            }
            msg.classList.remove('d-none');
            setTimeout(() => {
                const modalEl = document.getElementById('forgotPasswordModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
                msg.classList.add('d-none');
                document.getElementById('resetEmailInput').value = '';
            }, 2500);
        }
    </script>
}