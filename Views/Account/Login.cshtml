@model WebApplication_ClothingEcommerce.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!-- Google reCAPTCHA API -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<div class="auth-page">

    <div class="auth-container">
        <div class="auth-card">

            <div class="auth-logo text-center mb-3">
                <img src="~/images/ClothingLogo.png" alt="CLOTHÉ Logo" style="max-height: 50px; object-fit: contain;" />
            </div>

            <div class="auth-heading">
                <h1>Sign in</h1>
                <p>Welcome back to our clothing store</p>
            </div>

            <form asp-action="Login" asp-route-returnurl="@returnUrl" method="post" novalidate>

                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>
                }

                <div class="auth-field">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email"
                           autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger field-validation-error"></span>
                </div>

                <div class="auth-field">
                    <div class="auth-label-row">
                        <label asp-for="Password" class="mb-0">Password</label>
                        <a asp-action="ForgotPassword">Forgot password?</a>
                    </div>
                    <div class="password-input-wrapper" style="position:relative;">
                        <input asp-for="Password"
                               id="passwordInput"
                               type="password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               style="padding-right:44px;" />
                        <button type="button"
                                id="togglePassword"
                                aria-label="Show password"
                                style="position:absolute; right:12px; top:50%; transform:translateY(-50%); border:0; background:transparent; color:#5f6368; padding:0; display:flex; align-items:center;">
                            <i class="bi bi-eye" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger field-validation-error"></span>
                </div>

                <div class="auth-options d-flex justify-content-between align-items-center">
                    <label class="remember-box">
                        <input asp-for="RememberMe" class="form-check-input me-1" />
                        <span>Remember me</span>
                    </label>
                </div>

                <!-- Google reCAPTCHA -->
                <div class="auth-captcha-wrapper mb-3">
                    <div class="g-recaptcha" data-sitekey="YOUR_SITE_KEY_HERE"></div>
                </div>

                <button type="submit" class="auth-submit">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Sign in
                </button>

            </form>

            <div class="auth-divider">
                <span>or</span>
            </div>

            <p class="auth-bottom">
                Don't have an account?
                <a asp-action="Register">Create account</a>
            </p>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePassword').addEventListener('click', function() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');
            const isHidden = input.type === 'password';

            input.type = isHidden ? 'text' : 'password';
            icon.classList.toggle('bi-eye');
            icon.classList.toggle('bi-eye-slash');
            this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        });
    </script>
}