@model WebApplication_ClothingEcommerce.Models.ViewModels.ShopViewModel

@{
    var categories = Model.Categories ?? Enumerable.Empty<WebApplication_ClothingEcommerce.Models.Category>();
    var brands = Model.Brands ?? Enumerable.Empty<WebApplication_ClothingEcommerce.Models.Brand>();
}

<style>
    .shop-filters .form-check-input:checked {
        background-color: var(--google-blue, #4285F4);
        border-color: var(--google-blue, #4285F4);
    }

    .shop-filters .list-group-item-action {
        color: var(--gray, #666);
        padding: 8px 0;
        transition: color .15s ease;
    }

        .shop-filters .list-group-item-action:hover {
            color: var(--google-blue, #4285F4);
            background: transparent;
        }

        .shop-filters .list-group-item-action.active-filter {
            color: var(--google-blue, #4285F4);
            font-weight: 700;
        }

    .shop-filters h6 {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: var(--black, #202124);
    }

    .shop-filters .input-group .form-control {
        border: 1px solid #dcdcdc;
        border-radius: 10px 0 0 10px;
    }

        .shop-filters .input-group .form-control:focus {
            border-color: var(--google-blue, #4285F4);
            box-shadow: 0 0 0 3px rgba(66,133,244,.12);
        }

    .shop-filters .input-group .btn {
        border-radius: 0 10px 10px 0;
        background: var(--google-blue, #4285F4);
        border: 1px solid var(--google-blue, #4285F4);
        color: #fff;
    }

        .shop-filters .input-group .btn:hover {
            background: var(--google-blue-dark, #3367D6);
        }

    .shop-filters-clear-btn {
        display: block;
        text-align: center;
        border: 1px solid #f4c7c3;
        border-radius: 50px;
        color: var(--google-red-dark, #C5221F);
        background: #fff;
        padding: 10px;
        text-decoration: none;
        font-weight: 700;
        font-size: 13px;
        transition: all .2s ease;
    }

        .shop-filters-clear-btn:hover {
            background: var(--google-red, #EA4335);
            border-color: var(--google-red, #EA4335);
            color: #fff;
        }
</style>

<div class="shop-filters">

    <!-- On Sale -->
    <div class="mb-4">

        <div class="form-check form-switch">

            <input class="form-check-input" type="checkbox" role="switch" id="onSaleSwitch"
            @(Model.OnSale == true ? "checked" : "")
                   data-shop-index-url="@Url.Action("Index", "Shop")"
                   data-category-id="@Model.CategoryId"
                   data-brand-id="@Model.BrandId"
                   data-search="@Model.Search"
                   data-sort="@Model.Sort" />

            <label class="form-check-label fw-bold" for="onSaleSwitch">
                <i class="bi bi-lightning-charge-fill me-1" style="color: var(--google-red, #EA4335);"></i>
                On Sale Only
            </label>

        </div>

    </div>


    <!-- Categories -->
    <div class="mb-4">

        <h6 class="mb-3">
            Category
        </h6>

        <div class="list-group list-group-flush">

            <a asp-controller="Shop"
               asp-action="Index"
               asp-route-brandId="@Model.BrandId"
               asp-route-search="@Model.Search"
               asp-route-sort="@Model.Sort"
               asp-route-onSale="@Model.OnSale"
               class="list-group-item list-group-item-action border-0 px-0
                @(Model.CategoryId == null ? "active-filter" : "")">

                All Categories

            </a>

            @foreach (var category in categories)
            {
                <a asp-controller="Shop"
                   asp-action="Index"
                   asp-route-categoryId="@category.Id"
                   asp-route-brandId="@Model.BrandId"
                   asp-route-search="@Model.Search"
                   asp-route-sort="@Model.Sort"
                   asp-route-onSale="@Model.OnSale"
                   class="list-group-item list-group-item-action border-0 px-0
                    @(Model.CategoryId == category.Id ? "active-filter" : "")">

                    @category.Name

                </a>
            }

        </div>

    </div>


    <!-- Brands -->
    <div class="mb-4">

        <h6 class="mb-3">
            Brand
        </h6>

        <div class="list-group list-group-flush">

            <a asp-controller="Shop"
               asp-action="Index"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-search="@Model.Search"
               asp-route-sort="@Model.Sort"
               asp-route-onSale="@Model.OnSale"
               class="list-group-item list-group-item-action border-0 px-0
                @(Model.BrandId == null ? "active-filter" : "")">

                All Brands

            </a>

            @foreach (var brand in brands)
            {
                <a asp-controller="Shop"
                   asp-action="Index"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-brandId="@brand.Id"
                   asp-route-search="@Model.Search"
                   asp-route-sort="@Model.Sort"
                   asp-route-onSale="@Model.OnSale"
                   class="list-group-item list-group-item-action border-0 px-0
                    @(Model.BrandId == brand.Id ? "active-filter" : "")">

                    <span class="d-flex align-items-center gap-2">

                        @if (!string.IsNullOrWhiteSpace(brand.Logo))
                        {
                            <span class="rounded border bg-white d-inline-flex
                                align-items-center justify-content-center"
                                  style="width:28px;height:28px;">

                                <img src="@brand.Logo"
                                     alt="@brand.Name"
                                     style="width:100%;height:100%;object-fit:contain;" />

                            </span>
                        }

                        <span>
                            @brand.Name
                        </span>

                    </span>

                </a>
            }

        </div>

    </div>


    <!-- Search -->
    <div class="mb-4">

        <h6 class="mb-3">
            Search
        </h6>

        <form asp-controller="Shop"
              asp-action="Index"
              method="get">

            <input type="hidden"
                   name="categoryId"
                   value="@Model.CategoryId" />

            <input type="hidden"
                   name="brandId"
                   value="@Model.BrandId" />

            <input type="hidden"
                   name="sort"
                   value="@Model.Sort" />

            <input type="hidden"
                   name="onSale"
                   value="@Model.OnSale" />

            <div class="input-group">

                <input type="text"
                       name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Search products..." />

                <button type="submit"
                        class="btn">

                    <i class="bi bi-search"></i>

                </button>

            </div>

        </form>

    </div>


    <!-- Clear -->
    @if (Model.CategoryId.HasValue ||
         Model.BrandId.HasValue ||
         Model.OnSale == true ||
         !string.IsNullOrWhiteSpace(Model.Search) ||
         !string.IsNullOrWhiteSpace(Model.Sort))
    {
        <div class="d-grid">

            <a asp-controller="Shop"
               asp-action="Index"
               class="shop-filters-clear-btn">

                <i class="bi bi-x-circle me-1"></i>
                Clear Filters

            </a>

        </div>
    }

</div>

<script>
    (function () {
        var toggle = document.getElementById('onSaleSwitch');
        if (!toggle) return;

        toggle.addEventListener('change', function () {
            var url = new URL(toggle.dataset.shopIndexUrl, window.location.origin);

            if (toggle.dataset.categoryId) url.searchParams.set('categoryId', toggle.dataset.categoryId);
            if (toggle.dataset.brandId) url.searchParams.set('brandId', toggle.dataset.brandId);
            if (toggle.dataset.search) url.searchParams.set('search', toggle.dataset.search);
            if (toggle.dataset.sort) url.searchParams.set('sort', toggle.dataset.sort);

            url.searchParams.set('onSale', toggle.checked);
            window.location.href = url.toString();
        });
    })();
</script>