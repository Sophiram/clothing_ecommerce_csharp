@model WebApplication_ClothingEcommerce.Models.Product

@inject Microsoft.AspNetCore.Identity.SignInManager<WebApplication_ClothingEcommerce.Models.ApplicationUser> SignInManager
@inject WebApplication_ClothingEcommerce.Data.AppDbContext DbContext

@using WebApplication_ClothingEcommerce.Data.Enums

@{
    ViewData["Title"] = Model.Name;

    var primaryImage = Model.Images?.FirstOrDefault(x => x.IsPrimary)
        ?? Model.Images?.FirstOrDefault();

    var images = Model.Images?.ToList()
        ?? new List<WebApplication_ClothingEcommerce.Models.ProductImage>();

    var variants = Model.Variants?
        .Where(v => v.Status == VariantStatus.Available)
        .ToList()
        ?? new List<WebApplication_ClothingEcommerce.Models.ProductVariant>();

    var minPrice = variants
        .Select(v => v.Price)
        .DefaultIfEmpty(0)
        .Min();

    var maxPrice = variants
        .Select(v => v.Price)
        .DefaultIfEmpty(0)
        .Max();

    var compareAt = variants
        .Where(v => v.CompareAtPrice.HasValue && v.CompareAtPrice > v.Price)
        .Select(v => v.CompareAtPrice)
        .FirstOrDefault();

    var totalStock = variants.Sum(v => v.Inventory?.AvailableQuantity ?? 0);

    var distinctSizes = variants
        .Where(v => v.Size != null)
        .Select(v => v.Size!)
        .GroupBy(s => s.Id)
        .Select(g => g.First())
        .OrderBy(s => s.Name)
        .ToList();

    var distinctColors = variants
        .Where(v => v.Color != null)
        .Select(v => v.Color!)
        .GroupBy(c => c.Id)
        .Select(g => g.First())
        .OrderBy(c => c.Name)
        .ToList();

    var reviews = Model.Reviews?
        .OrderByDescending(x => x.CreatedAt)
        .ToList()
        ?? new List<WebApplication_ClothingEcommerce.Models.Review>();

    var averageRating = reviews.Any()
        ? reviews.Average(x => x.Rating)
        : 0;

    var fullStars = (int)Math.Floor(averageRating);
    var hasHalfStar = averageRating - fullStars >= 0.5;

    // Review breakdown
    var fiveStarCount = reviews.Count(r => r.Rating == 5);
    var fourStarCount = reviews.Count(r => r.Rating == 4);
    var threeStarCount = reviews.Count(r => r.Rating == 3);
    var twoStarCount = reviews.Count(r => r.Rating == 2);
    var oneStarCount = reviews.Count(r => r.Rating == 1);

    var fiveStarPct = reviews.Any() ? (int)Math.Round((double)fiveStarCount / reviews.Count * 100) : 0;
    var fourStarPct = reviews.Any() ? (int)Math.Round((double)fourStarCount / reviews.Count * 100) : 0;
    var threeStarPct = reviews.Any() ? (int)Math.Round((double)threeStarCount / reviews.Count * 100) : 0;
    var twoStarPct = reviews.Any() ? (int)Math.Round((double)twoStarCount / reviews.Count * 100) : 0;
    var oneStarPct = reviews.Any() ? (int)Math.Round((double)oneStarCount / reviews.Count * 100) : 0;

    var recommendPct = reviews.Any()
        ? (int)Math.Round((double)reviews.Count(r => r.Rating >= 4) / reviews.Count * 100)
        : 100;

    var isSignedIn = SignInManager.IsSignedIn(User);

    // Current user's existing review (if any)
    var currentUserEmail = User.Identity?.Name;
    WebApplication_ClothingEcommerce.Models.Customer? currentCustomer = null;
    WebApplication_ClothingEcommerce.Models.Review? userReview = null;

    if (isSignedIn && !string.IsNullOrEmpty(currentUserEmail))
    {
        try
        {
            currentCustomer = DbContext.Customers.FirstOrDefault(c => c.Email == currentUserEmail);
            if (currentCustomer != null)
            {
                userReview = reviews.FirstOrDefault(r => r.CustomerId == currentCustomer.Id);
            }
        }
        catch { }
    }
}

<div class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-200">

    <!-- BREADCRUMB -->
    <nav class="border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-900/40 py-3.5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <ol class="flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                <li><a asp-controller="Home" asp-action="Index" class="hover:text-slate-900 dark:hover:text-white transition">Home</a></li>
                <li class="text-slate-300 dark:text-slate-600">/</li>
                <li><a asp-controller="Shop" asp-action="Index" class="hover:text-slate-900 dark:hover:text-white transition">Shop</a></li>
                @if (Model.Category != null)
                {
                    <li class="text-slate-300 dark:text-slate-600">/</li>
                    <li><a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.Category.Id" class="hover:text-slate-900 dark:hover:text-white transition">@Model.Category.Name</a></li>
                }
                <li class="text-slate-300 dark:text-slate-600">/</li>
                <li class="text-slate-900 dark:text-white font-semibold truncate max-w-xs sm:max-w-md">@Model.Name</li>
            </ol>
        </div>
    </nav>

    <!-- FEEDBACK ALERTS -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        @if (TempData["Success"] != null)
        {
            <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 flex items-center justify-between gap-3 text-sm">
                <div class="flex items-center gap-2.5">
                    <i class="bi bi-check-circle-fill text-emerald-500 text-lg shrink-0"></i>
                    <span>@TempData["Success"]</span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 dark:text-emerald-400 hover:opacity-75 text-lg">&times;</button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200 flex items-center justify-between gap-3 text-sm">
                <div class="flex items-center gap-2.5">
                    <i class="bi bi-exclamation-triangle-fill text-rose-500 text-lg shrink-0"></i>
                    <span>@TempData["Error"]</span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-rose-600 dark:text-rose-400 hover:opacity-75 text-lg">&times;</button>
            </div>
        }
    </div>

    <!-- PRODUCT HERO (GALLERY & DETAILS) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14">

            <!-- LEFT GALLERY (7 COLS) -->
            <div class="lg:col-span-7">
                <div class="lg:sticky lg:top-24 space-y-3">
                    <div class="aspect-[4/5] relative rounded-3xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-800 shadow-sm group">

                        <!-- Brand Badge -->
                        <span class="absolute top-4 left-4 z-10 px-3.5 py-1.5 rounded-full text-[11px] font-extrabold uppercase tracking-widest bg-slate-900/90 text-white backdrop-blur shadow-md">
                            @(Model.Brand?.Name ?? "CLOTHÉ")
                        </span>

                        @if (compareAt.HasValue && minPrice > 0)
                        {
                            var discountPct = (int)Math.Round((1 - (minPrice / compareAt.Value)) * 100);
                            if (discountPct > 0)
                            {
                                <span class="absolute top-4 left-24 sm:left-28 z-10 px-3 py-1.5 rounded-full text-xs font-black bg-rose-600 text-white shadow-md">
                                    -@discountPct% OFF
                                </span>
                            }
                        }

                        <!-- Gallery Actions -->
                        <div class="absolute top-4 right-4 z-10 flex items-center gap-2">
                            <button type="button" onclick="toggleFullscreen()" class="w-10 h-10 rounded-full bg-white/90 dark:bg-slate-900/90 backdrop-blur text-slate-800 dark:text-white flex items-center justify-center shadow-md hover:bg-slate-900 hover:text-white dark:hover:bg-white dark:hover:text-slate-900 transition active:scale-95" aria-label="View fullscreen">
                                <i class="bi bi-arrows-fullscreen"></i>
                            </button>
                        </div>

                        <!-- Prev / Next Chevrons -->
                        @if (images.Count > 1)
                        {
                            <button type="button" onclick="prevImage()" class="absolute top-1/2 -translate-y-1/2 left-3 z-10 w-11 h-11 rounded-full bg-white/90 dark:bg-slate-900/90 backdrop-blur text-slate-800 dark:text-white flex items-center justify-center shadow-lg opacity-0 group-hover:opacity-100 transition hover:scale-110 active:scale-95" aria-label="Previous photo">
                                <i class="bi bi-chevron-left text-lg"></i>
                            </button>
                            <button type="button" onclick="nextImage()" class="absolute top-1/2 -translate-y-1/2 right-3 z-10 w-11 h-11 rounded-full bg-white/90 dark:bg-slate-900/90 backdrop-blur text-slate-800 dark:text-white flex items-center justify-center shadow-lg opacity-0 group-hover:opacity-100 transition hover:scale-110 active:scale-95" aria-label="Next photo">
                                <i class="bi bi-chevron-right text-lg"></i>
                            </button>
                            <span class="absolute bottom-4 right-4 z-10 px-3 py-1 rounded-full text-xs font-bold bg-slate-900/75 text-white backdrop-blur">
                                <span id="galleryCurrentIdx">1</span> / @images.Count
                            </span>
                        }

                        @if (primaryImage != null && !string.IsNullOrWhiteSpace(primaryImage.ImageUrl))
                        {
                            <img id="mainProductImage" src="@primaryImage.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                        }
                        else
                        {
                            <div class="flex items-center justify-center h-full text-slate-400 text-5xl">
                                <i class="bi bi-image"></i>
                            </div>
                        }

                    </div>

                    <!-- Thumbnails Strip -->
                    @if (images.Count > 1)
                    {
                        <div class="flex gap-2.5 overflow-x-auto py-2" id="thumbnailStrip">
                            @for (int i = 0; i < images.Count; i++)
                            {
                                var img = images[i];
                                if (!string.IsNullOrWhiteSpace(img.ImageUrl))
                                {
                                    <button type="button" class="shrink-0 w-20 h-24 rounded-2xl overflow-hidden border-2 transition focus:outline-none @(img == primaryImage ? "border-slate-900 dark:border-blue-500 ring-2 ring-slate-900/20 dark:ring-blue-500/30" : "border-slate-200 dark:border-slate-800 opacity-80 hover:opacity-100 hover:border-slate-400")" data-index="@(i + 1)" onclick="changeImageByIndex(@i, '@img.ImageUrl')">
                                        <img src="@img.ImageUrl" alt="@Model.Name thumbnail" class="w-full h-full object-cover" />
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT PRODUCT INFORMATION (5 COLS) -->
            <div class="lg:col-span-5 space-y-6">

                <!-- Brand Link -->
                <a asp-controller="Shop" asp-action="Index" asp-route-brandId="@Model.Brand?.Id" class="inline-flex items-center gap-2.5 group">
                    @if (!string.IsNullOrWhiteSpace(Model.Brand?.Logo))
                    {
                        <img src="@Model.Brand.Logo" alt="@Model.Brand.Name" class="w-8 h-8 rounded-full border border-slate-200 dark:border-slate-700 object-contain p-0.5 bg-white shadow-sm" />
                    }
                    else
                    {
                        <span class="w-8 h-8 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800 flex items-center justify-center text-sm">
                            <i class="bi bi-award"></i>
                        </span>
                    }
                    <span class="text-xs font-extrabold uppercase tracking-widest text-blue-600 dark:text-blue-400 group-hover:underline">
                        @(Model.Brand?.Name ?? "CLOTHÉ")
                    </span>
                </a>

                <!-- Product Title -->
                <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
                    @Model.Name
                </h1>

                <!-- Ratings & Reviews Meta -->
                <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
                    <a href="#reviewsSection" class="flex items-center gap-2 hover:text-slate-900 dark:hover:text-white transition">
                        <span class="flex items-center gap-1 text-amber-400">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= fullStars)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else if (i == fullStars + 1 && hasHalfStar)
                                {
                                    <i class="bi bi-star-half"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-slate-300 dark:text-slate-600"></i>
                                }
                            }
                        </span>
                        <strong class="text-slate-900 dark:text-white font-bold">@averageRating.ToString("0.0")</strong>
                        <span>(@reviews.Count review@(reviews.Count == 1 ? "" : "s"))</span>
                    </a>

                    @if (Model.Category != null)
                    {
                        <span class="text-slate-300 dark:text-slate-600">•</span>
                        <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.Category.Id" class="hover:text-slate-900 dark:hover:text-white transition">
                            @Model.Category.Name
                        </a>
                    }
                </div>

                <!-- Price Block -->
                <div class="py-4 border-y border-slate-200/80 dark:border-slate-800 space-y-1">
                    <div id="productPrice" class="flex items-center flex-wrap gap-3">
                        @if (minPrice > 0)
                        {
                            <span class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                                $@minPrice.ToString("0.00")
                            </span>

                            @if (compareAt.HasValue)
                            {
                                <span class="text-lg line-through text-slate-400 dark:text-slate-500">
                                    $@compareAt.Value.ToString("0.00")
                                </span>

                                var discountPct = (int)Math.Round((1 - (minPrice / compareAt.Value)) * 100);
                                if (discountPct > 0)
                                {
                                    <span class="px-2.5 py-1 rounded-full text-xs font-black bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900">
                                        Save $@((compareAt.Value - minPrice).ToString("0.00")) (-@discountPct%)
                                    </span>
                                }
                            }
                        }
                        else
                        {
                            <span class="text-xl font-bold text-slate-500">Contact us</span>
                        }
                    </div>

                    @if (minPrice > 0 && minPrice != maxPrice)
                    {
                        <div id="priceRange" class="text-xs text-slate-500 dark:text-slate-400">
                            Price varies by selected options ($@minPrice.ToString("0.00") – $@maxPrice.ToString("0.00"))
                        </div>
                    }
                </div>

                <!-- Description -->
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                    @(Model.Description ?? "Designed with premium fabrics, durable stitching, and timeless everyday style.")
                </p>

                <!-- Quick Facts Grid -->
                <div class="grid grid-cols-2 gap-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-800">
                    <div>
                        <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-0.5">Material</span>
                        <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">@(string.IsNullOrWhiteSpace(Model.Material) ? "100% Premium Cotton" : Model.Material)</span>
                    </div>
                    <div>
                        <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-0.5">Gender</span>
                        <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">@Model.Gender</span>
                    </div>
                    <div>
                        <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-0.5">Availability</span>
                        <span id="productAvailability" class="text-sm font-semibold">
                            @if (totalStock > 0)
                            {
                                <span class="text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1">
                                    <i class="bi bi-check-circle-fill"></i> In Stock
                                </span>
                            }
                            else
                            {
                                <span class="text-rose-600 dark:text-rose-400 inline-flex items-center gap-1">
                                    <i class="bi bi-x-circle-fill"></i> Out of Stock
                                </span>
                            }
                        </span>
                    </div>
                    <div>
                        <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-0.5">Collection</span>
                        <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">@(Model.Category?.Name ?? "Essential")</span>
                    </div>
                </div>

                <!-- VARIANT SELECTION & ADD TO CART FORM -->
                @if (variants.Count > 0)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" id="addToCartForm" class="space-y-5">
                        @Html.AntiForgeryToken()

                        <!-- Colors -->
                        @if (distinctColors.Any())
                        {
                            <div class="space-y-2">
                                <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                                    <span>Color: <strong id="selectedColorLabel" class="text-blue-600 dark:text-blue-400 font-semibold normal-case">All Colors</strong></span>
                                </div>
                                <div class="flex flex-wrap gap-2" id="colorChipsContainer">
                                    @foreach (var col in distinctColors)
                                    {
                                        <button type="button" class="variant-color-chip inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 hover:border-slate-900 dark:hover:border-white transition shadow-sm" data-color-id="@col.Id" data-color-name="@col.Name" onclick="selectColorChip(this, '@col.Id', '@col.Name')">
                                            <span class="w-3.5 h-3.5 rounded-full border border-black/10 shrink-0" style="background-color: @(string.IsNullOrWhiteSpace(col.HexCode) ? "#202124" : col.HexCode);"></span>
                                            <span>@col.Name</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Sizes -->
                        @if (distinctSizes.Any())
                        {
                            <div class="space-y-2">
                                <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                                    <span>Size: <strong id="selectedSizeLabel" class="text-blue-600 dark:text-blue-400 font-semibold normal-case">Choose size</strong></span>
                                    <button type="button" class="text-slate-500 hover:text-slate-900 dark:hover:text-white normal-case font-semibold text-xs inline-flex items-center gap-1 transition" onclick="openSizeGuideModal()">
                                        <i class="bi bi-rulers"></i> Size Guide
                                    </button>
                                </div>
                                <div class="flex flex-wrap gap-2" id="sizeChipsContainer">
                                    @foreach (var sz in distinctSizes)
                                    {
                                        <button type="button" class="variant-size-chip min-w-[44px] h-10 px-3.5 rounded-xl text-xs font-bold bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 hover:border-slate-900 dark:hover:border-white transition shadow-sm flex items-center justify-center" data-size-id="@sz.Id" data-size-name="@sz.Name" onclick="selectSizeChip(this, '@sz.Id', '@sz.Name')">
                                            @sz.Name
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Hidden / Synchronized select -->
                        <div>
                            <label for="variantSelect" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">
                                Selected Option
                            </label>
                            <select name="variantId" id="variantSelect" class="w-full h-11 px-4 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs sm:text-sm font-medium focus:ring-2 focus:ring-blue-500 outline-none" required>
                                <option value="">Choose your size & color option</option>
                                @foreach (var variant in variants)
                                {
                                    var stock = variant.Inventory?.AvailableQuantity ?? 0;
                                    var isSale = variant.CompareAtPrice.HasValue && variant.CompareAtPrice.Value > variant.Price;
                                    var optionLabel = (variant.Size?.Name ?? "One Size") + " / " + (variant.Color?.Name ?? "Default") + " — $" + variant.Price.ToString("0.00") + (isSale ? " (Sale)" : "") + (stock <= 0 ? " — Out of Stock" : "");

                                    <option value="@variant.Id" data-price="@variant.Price" data-compare-at="@(variant.CompareAtPrice ?? 0)" data-stock="@stock" data-size-id="@variant.SizeId" data-color-id="@variant.ColorId">
                                        @optionLabel
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Live Stock Feedback -->
                        <div id="stockMessage" class="text-xs font-semibold">
                            @if (totalStock > 0)
                            {
                                <span class="text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1.5">
                                    <i class="bi bi-check-circle-fill"></i> In stock — ready to ship
                                </span>
                            }
                            else
                            {
                                <span class="text-rose-600 dark:text-rose-400 inline-flex items-center gap-1.5">
                                    <i class="bi bi-x-circle-fill"></i> Currently out of stock
                                </span>
                            }
                        </div>

                        <!-- Quantity Stepper & Buttons Row -->
                        <div class="purchase-row flex items-center gap-3 pt-2">
                            <!-- Stepper -->
                            <div class="flex items-center h-12 rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 overflow-hidden shadow-sm shrink-0">
                                <button type="button" class="w-10 h-full flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition text-base font-bold" onclick="changeQuantity(-1)" aria-label="Decrease quantity">−</button>
                                <input type="number" name="quantity" id="quantityInput" value="1" min="1" max="1" class="w-12 h-full text-center bg-transparent border-0 font-bold text-sm text-slate-900 dark:text-white outline-none" readonly />
                                <button type="button" class="w-10 h-full flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition text-base font-bold" onclick="changeQuantity(1)" aria-label="Increase quantity">+</button>
                            </div>

                            <!-- Add to Cart -->
                            <button type="submit" id="addCartButton" class="flex-1 h-12 rounded-2xl bg-slate-900 hover:bg-slate-800 dark:bg-blue-600 dark:hover:bg-blue-500 text-white font-bold text-sm flex items-center justify-center gap-2 shadow-lg shadow-slate-900/10 transition active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed" disabled="@(totalStock <= 0 ? "disabled" : null)">
                                <i class="bi bi-bag-plus-fill text-base"></i>
                                <span data-en="Add to Cart" data-kh="បន្ថែមទៅកន្ត្រក">Add to Cart</span>
                            </button>

                            <!-- Wishlist -->
                            @if (isSignedIn)
                            {
                                <button type="button" onclick="submitWishlistForm()" class="w-12 h-12 rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 flex items-center justify-center text-slate-700 dark:text-slate-200 hover:text-rose-500 hover:border-rose-500 transition active:scale-95 shadow-sm shrink-0" title="Add to wishlist" aria-label="Add to wishlist">
                                    <i class="bi bi-heart text-lg"></i>
                                </button>
                            }
                        </div>

                    </form>

                    @if (isSignedIn)
                    {
                        <form id="wishlistForm" asp-controller="Wishlist" asp-action="Add" method="post" class="hidden">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="wishlistVariantId" name="variantId" value="" />
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="block text-center text-xs text-slate-500 hover:text-slate-900 dark:hover:text-white transition">
                            <i class="bi bi-heart me-1 text-rose-500"></i> Sign in to save this to your wishlist
                        </a>
                    }
                }
                else
                {
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-500">
                        <i class="bi bi-info-circle me-1.5"></i> This product currently has no available sizes or colors.
                    </div>
                }

                <!-- Service Highlights Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-6 border-t border-slate-200/80 dark:border-slate-800">
                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-800 flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm flex items-center justify-center text-sm shrink-0">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div class="text-xs">
                            <strong class="block font-bold text-slate-900 dark:text-white">Fast Delivery</strong>
                            <span class="text-slate-500 dark:text-slate-400">2–3 business days</span>
                        </div>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-800 flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm flex items-center justify-center text-sm shrink-0">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>
                        <div class="text-xs">
                            <strong class="block font-bold text-slate-900 dark:text-white">30-Day Returns</strong>
                            <span class="text-slate-500 dark:text-slate-400">Hassle-free exchange</span>
                        </div>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-800 flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm flex items-center justify-center text-sm shrink-0">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="text-xs">
                            <strong class="block font-bold text-slate-900 dark:text-white">Authentic Quality</strong>
                            <span class="text-slate-500 dark:text-slate-400">Certified fabrics</span>
                        </div>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-800 flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm flex items-center justify-center text-sm shrink-0">
                            <i class="bi bi-lock"></i>
                        </div>
                        <div class="text-xs">
                            <strong class="block font-bold text-slate-900 dark:text-white">Secure Checkout</strong>
                            <span class="text-slate-500 dark:text-slate-400">Protected payment</span>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <!-- TABS SECTION -->
        <div class="mt-16 pt-12 border-t border-slate-200/80 dark:border-slate-800">
            <!-- Tabs Nav -->
            <div class="flex border-b border-slate-200 dark:border-slate-800 gap-8 text-sm font-bold">
                <button type="button" class="tab-btn pb-4 border-b-2 border-slate-900 dark:border-blue-500 text-slate-900 dark:text-white transition" onclick="switchProductTab(0, this)">
                    Description & Details
                </button>
                <button type="button" class="tab-btn pb-4 border-b-2 border-transparent text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 transition" onclick="switchProductTab(1, this)">
                    Fabric & Care
                </button>
                <button type="button" class="tab-btn pb-4 border-b-2 border-transparent text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 transition" onclick="switchProductTab(2, this)">
                    Shipping & Returns
                </button>
            </div>

            <!-- Tabs Panels -->
            <div class="pt-8">
                <!-- Panel 0: Description -->
                <div id="tabPanel0" class="tab-panel space-y-6 max-w-3xl">
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Designed for Everyday Elegance</h2>
                    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                        @(Model.Description ?? "Crafted from carefully selected fabrics, this piece delivers the perfect balance of comfort, durability, and contemporary silhouette.")
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-800">
                            <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1 flex items-center gap-2">
                                <i class="bi bi-stars text-blue-600 dark:text-blue-400"></i> Premium Finish
                            </h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">High tensile stitching designed for regular wear and lasting form retention.</p>
                        </div>
                        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-800">
                            <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1 flex items-center gap-2">
                                <i class="bi bi-feather text-blue-600 dark:text-blue-400"></i> Breathable Comfort
                            </h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Soft touch texture that adapts comfortably across all seasons.</p>
                        </div>
                    </div>
                </div>

                <!-- Panel 1: Fabric & Care -->
                <div id="tabPanel1" class="tab-panel hidden max-w-2xl">
                    <table class="w-full text-left text-sm divide-y divide-slate-200/80 dark:divide-slate-800">
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            <tr>
                                <th class="py-3.5 text-xs font-medium text-slate-400 w-1/3">Material Composition</th>
                                <td class="py-3.5 text-sm font-semibold text-slate-800 dark:text-slate-200">@(string.IsNullOrWhiteSpace(Model.Material) ? "100% Combed Cotton" : Model.Material)</td>
                            </tr>
                            <tr>
                                <th class="py-3.5 text-xs font-medium text-slate-400">Target Gender</th>
                                <td class="py-3.5 text-sm font-semibold text-slate-800 dark:text-slate-200">@Model.Gender</td>
                            </tr>
                            <tr>
                                <th class="py-3.5 text-xs font-medium text-slate-400">Washing Instructions</th>
                                <td class="py-3.5 text-sm font-semibold text-slate-800 dark:text-slate-200">Machine wash cold with like colors, gentle cycle</td>
                            </tr>
                            <tr>
                                <th class="py-3.5 text-xs font-medium text-slate-400">Drying</th>
                                <td class="py-3.5 text-sm font-semibold text-slate-800 dark:text-slate-200">Tumble dry low or line dry in shade</td>
                            </tr>
                            <tr>
                                <th class="py-3.5 text-xs font-medium text-slate-400">Ironing</th>
                                <td class="py-3.5 text-sm font-semibold text-slate-800 dark:text-slate-200">Low iron if needed, do not iron over prints</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Panel 2: Shipping & Returns -->
                <div id="tabPanel2" class="tab-panel hidden max-w-3xl">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-800 space-y-3">
                            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                                <i class="bi bi-box-seam text-blue-600 dark:text-blue-400"></i> Delivery Options
                            </h3>
                            <ul class="text-xs text-slate-500 dark:text-slate-400 space-y-2">
                                <li><strong>Standard Shipping:</strong> 2–4 business days ($3.99, Free over $50).</li>
                                <li><strong>Express Shipping:</strong> 1–2 business days ($7.99).</li>
                                <li><strong>Store Pickup:</strong> Free at selected branch locations.</li>
                            </ul>
                        </div>
                        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-800 space-y-3">
                            <h3 class="font-bold text-sm text-slate-900 dark:text-white flex items-center gap-2">
                                <i class="bi bi-arrow-counterclockwise text-blue-600 dark:text-blue-400"></i> Easy 30-Day Returns
                            </h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                                Not quite the right fit? No worries! Return any unwashed, unworn items with tags attached within 30 days for an instant exchange or full refund.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- REVIEWS & RATINGS SECTION -->
        <div class="mt-16 pt-12 border-t border-slate-200/80 dark:border-slate-800" id="reviewsSection">
            <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">Customer Community</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Customer Reviews & Ratings</h2>
                </div>
                @if (isSignedIn && userReview == null)
                {
                    <a href="#writeReviewCard" class="px-5 py-2.5 rounded-full text-xs font-bold bg-slate-900 hover:bg-slate-800 dark:bg-blue-600 dark:hover:bg-blue-500 text-white transition shadow-sm inline-flex items-center gap-2">
                        <i class="bi bi-pencil-square"></i> Write a Review
                    </a>
                }
            </div>

            <!-- Score Hero & Breakdown Row -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-10">
                <!-- Hero Score Box (4 cols) -->
                <div class="lg:col-span-4 rounded-3xl p-8 bg-slate-900 text-white flex flex-col items-center justify-center text-center shadow-lg">
                    <div class="text-5xl font-black mb-2">@averageRating.ToString("0.0")</div>
                    <div class="flex items-center gap-1 text-amber-400 text-xl mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= fullStars)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else if (i == fullStars + 1 && hasHalfStar)
                            {
                                <i class="bi bi-star-half"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-white/30"></i>
                            }
                        }
                    </div>
                    <div class="text-sm font-semibold">Based on @reviews.Count verified review@(reviews.Count == 1 ? "" : "s")</div>
                    <div class="text-xs text-white/60 mt-1">@recommendPct% of customers recommend this product</div>
                </div>

                <!-- Breakdown Bars (8 cols) -->
                <div class="lg:col-span-8 p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 flex flex-col justify-center space-y-3">
                    <div class="flex items-center gap-3 text-xs">
                        <span class="w-14 font-bold text-slate-800 dark:text-slate-200">5 Stars</span>
                        <div class="flex-1 h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: @fiveStarPct%;"></div>
                        </div>
                        <span class="w-16 text-right text-slate-400">@fiveStarCount (@fiveStarPct%)</span>
                    </div>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="w-14 font-bold text-slate-800 dark:text-slate-200">4 Stars</span>
                        <div class="flex-1 h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: @fourStarPct%;"></div>
                        </div>
                        <span class="w-16 text-right text-slate-400">@fourStarCount (@fourStarPct%)</span>
                    </div>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="w-14 font-bold text-slate-800 dark:text-slate-200">3 Stars</span>
                        <div class="flex-1 h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: @threeStarPct%;"></div>
                        </div>
                        <span class="w-16 text-right text-slate-400">@threeStarCount (@threeStarPct%)</span>
                    </div>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="w-14 font-bold text-slate-800 dark:text-slate-200">2 Stars</span>
                        <div class="flex-1 h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: @twoStarPct%;"></div>
                        </div>
                        <span class="w-16 text-right text-slate-400">@twoStarCount (@twoStarPct%)</span>
                    </div>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="w-14 font-bold text-slate-800 dark:text-slate-200">1 Star</span>
                        <div class="flex-1 h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-amber-400 rounded-full transition-all duration-500" style="width: @oneStarPct%;"></div>
                        </div>
                        <span class="w-16 text-right text-slate-400">@oneStarCount (@oneStarPct%)</span>
                    </div>
                </div>
            </div>

            <!-- WRITE / UPDATE REVIEW CARD -->
            <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm mb-10" id="writeReviewCard">
                @if (isSignedIn)
                {
                    <div class="flex items-center justify-between pb-5 mb-6 border-b border-slate-100 dark:border-slate-800">
                        <div>
                            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">
                                @(userReview != null ? "Update Your Review" : "Write a Customer Review")
                            </h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">
                                @(userReview != null ? $"You posted a review on {userReview.CreatedAt:MMM dd, yyyy}. You can modify your rating and feedback below." : "Share your honest thoughts about the fit, comfort, and fabric with other shoppers.")
                            </p>
                        </div>
                        @if (userReview != null)
                        {
                            <button type="button" onclick="openDeleteReviewModal()" class="px-3.5 py-1.5 rounded-full text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 hover:bg-rose-100 dark:hover:bg-rose-900/60 transition">
                                <i class="bi bi-trash3 me-1"></i> Delete Review
                            </button>
                        }
                    </div>

                    <form asp-controller="Reviews" asp-action="Add" method="post" id="reviewForm" class="space-y-6">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="rating" id="reviewRatingInput" value="@(userReview?.Rating ?? 5)" />

                        <!-- Interactive Star Picker -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                                Your Overall Rating <span class="text-rose-500">*</span>
                            </label>
                            <div class="flex items-center gap-3">
                                <div class="flex items-center gap-1.5 text-2xl text-slate-300 dark:text-slate-700 cursor-pointer" id="starPicker">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        var isSel = (userReview != null ? userReview.Rating : 5) >= i;
                                        <i class="bi @(isSel ? "bi-star-fill text-amber-400" : "bi-star") star-picker-item transition hover:scale-110" data-rating="@i" title="@i Star@(i > 1 ? "s" : "")"></i>
                                    }
                                </div>
                                <span id="starRatingLabel" class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                    @((userReview?.Rating ?? 5) switch
                                    {
                                        5 => "5 - Excellent, loved it!",
                                        4 => "4 - Very good",
                                        3 => "3 - Average / Fair",
                                        2 => "2 - Not as expected",
                                        _ => "1 - Disappointed"
                                    })
                                </span>
                            </div>
                        </div>

                        <!-- Feedback Comment -->
                        <div>
                            <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                                <label for="reviewCommentInput">Your Feedback & Comments</label>
                                <span class="text-slate-400 font-normal normal-case" id="reviewCharCounter">0 / 1000</span>
                            </div>
                            <textarea name="comment" id="reviewCommentInput" rows="4" maxlength="1000" class="w-full p-4 rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 outline-none leading-relaxed" placeholder="Tell us what you liked or disliked. How was the sizing, fabric softness, and everyday wear?">@(userReview?.Comment ?? "")</textarea>
                        </div>

                        <div class="flex items-center gap-3">
                            <button type="submit" class="px-6 py-3 rounded-full text-xs font-bold bg-slate-900 hover:bg-slate-800 dark:bg-blue-600 dark:hover:bg-blue-500 text-white transition shadow-sm inline-flex items-center gap-2">
                                <i class="bi bi-send-fill"></i> @(userReview != null ? "Update Review" : "Submit Review")
                            </button>
                            <span class="text-xs text-slate-400">Your review will be posted under your account name.</span>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-center py-6 max-w-md mx-auto space-y-3">
                        <div class="w-14 h-14 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl mx-auto shadow-sm">
                            <i class="bi bi-chat-square-quote-fill"></i>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Have you tried this item?</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                            Sign in to your CLOTHÉ account to share your rating and review with our community.
                        </p>
                        <div class="pt-2">
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + "#reviewsSection")" class="px-6 py-2.5 rounded-full text-xs font-bold bg-slate-900 hover:bg-slate-800 dark:bg-blue-600 dark:hover:bg-blue-500 text-white transition shadow-sm inline-flex items-center gap-2">
                                <i class="bi bi-box-arrow-in-right"></i> Sign in to Write a Review
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- REVIEWS LIST & FILTERS -->
            @if (reviews.Any())
            {
                <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
                    <div class="flex flex-wrap gap-2" id="reviewFilters">
                        <button type="button" class="review-filter-btn px-4 py-1.5 rounded-full text-xs font-bold bg-slate-900 dark:bg-blue-600 text-white transition" data-filter="all">All (@reviews.Count)</button>
                        <button type="button" class="review-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-slate-900 transition" data-filter="5">5 ★ (@fiveStarCount)</button>
                        <button type="button" class="review-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-slate-900 transition" data-filter="4">4 ★ (@fourStarCount)</button>
                        <button type="button" class="review-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-slate-900 transition" data-filter="3">3 ★ (@threeStarCount)</button>
                        <button type="button" class="review-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-slate-900 transition" data-filter="2">2 ★ (@twoStarCount)</button>
                        <button type="button" class="review-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-slate-900 transition" data-filter="1">1 ★ (@oneStarCount)</button>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold text-slate-400">Sort by:</span>
                        <select id="reviewSortSelect" class="h-9 px-3 rounded-full text-xs font-medium border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white outline-none">
                            <option value="newest">Most Recent</option>
                            <option value="highest">Highest Rating</option>
                            <option value="lowest">Lowest Rating</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-4" id="reviewsListContainer">
                    @foreach (var r in reviews)
                    {
                        var isCurrentUser = currentCustomer != null && r.CustomerId == currentCustomer.Id;
                        var customerInitial = !string.IsNullOrWhiteSpace(r.Customer?.FirstName) ? r.Customer.FirstName.Substring(0, 1).ToUpper() : "C";

                        <div class="review-item-card p-6 rounded-3xl bg-white dark:bg-slate-900 border @(isCurrentUser ? "border-blue-500 dark:border-blue-500 ring-2 ring-blue-500/20" : "border-slate-200 dark:border-slate-800") shadow-sm" data-rating="@r.Rating" data-timestamp="@r.CreatedAt.Ticks">
                            <div class="flex items-start justify-between gap-4 mb-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full @(isCurrentUser ? "bg-blue-600 text-white" : "bg-slate-800 text-white dark:bg-slate-700") font-bold text-sm flex items-center justify-center shrink-0">
                                        @customerInitial
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <strong class="text-sm font-bold text-slate-900 dark:text-white">
                                                @(r.Customer?.FirstName ?? "Customer") @(r.Customer?.LastName ?? "")
                                            </strong>
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                                Verified
                                            </span>
                                            @if (isCurrentUser)
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-500 text-white">Your Review</span>
                                            }
                                        </div>
                                        <div class="text-[11px] text-slate-400 mt-0.5">
                                            @r.CreatedAt.ToString("MMMM dd, yyyy")
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center gap-1 text-amber-400 text-sm">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= r.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-slate-300 dark:text-slate-600"></i>
                                        }
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(r.Comment))
                            {
                                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed m-0">
                                    @r.Comment
                                </p>
                            }
                            else
                            {
                                <p class="text-xs italic text-slate-400 m-0">
                                    (Customer did not provide written comments)
                                </p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12 rounded-3xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800">
                    <i class="bi bi-chat-square-heart text-4xl text-slate-400 block mb-2"></i>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">No Reviews Yet</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Be the first to share your thoughts and help others make a stylish choice!</p>
                </div>
            }
        </div>

        <!-- RELATED PRODUCTS SECTION -->
        @if (ViewBag.RelatedProducts != null)
        {
            var relatedProducts = (List<WebApplication_ClothingEcommerce.Models.Product>)ViewBag.RelatedProducts;
            if (relatedProducts.Any())
            {
                <div class="mt-16 pt-12 border-t border-slate-200/80 dark:border-slate-800">
                    <div class="flex items-end justify-between gap-4 mb-8">
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">Explore Collections</span>
                            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">You May Also Like</h2>
                        </div>
                        <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="px-4 py-2 rounded-full text-xs font-bold border border-slate-300 dark:border-slate-700 hover:bg-slate-900 hover:text-white dark:hover:bg-white dark:hover:text-slate-900 transition">
                            View All &rarr;
                        </a>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                        @foreach (var related in relatedProducts)
                        {
                            <partial name="_ProductCard" model="related" />
                        }
                    </div>
                </div>
            }
        }

    </section>

</div>

