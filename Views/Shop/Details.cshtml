@section Scripts {
    <script>
        /* TAB SWITCHER */
        function switchProductTab(index, btn) {
            document.querySelectorAll('.tab-panel').forEach((p, i) => {
                p.classList.toggle('hidden', i !== index);
            });
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('border-slate-900', 'dark:border-blue-500', 'text-slate-900', 'dark:text-white');
                b.classList.add('border-transparent', 'text-slate-400');
            });
            btn.classList.remove('border-transparent', 'text-slate-400');
            btn.classList.add('border-slate-900', 'dark:border-blue-500', 'text-slate-900', 'dark:text-white');
        }

        /* MODAL HELPERS */
        function openSizeGuideModal() {
            document.getElementById('sizeGuideModal').classList.remove('hidden');
        }
        function closeSizeGuideModal() {
            document.getElementById('sizeGuideModal').classList.add('hidden');
        }
        function openDeleteReviewModal() {
            const m = document.getElementById('deleteReviewModal');
            if (m) m.classList.remove('hidden');
        }
        function closeDeleteReviewModal() {
            const m = document.getElementById('deleteReviewModal');
            if (m) m.classList.add('hidden');
        }

        /* GALLERY CONTROLLER */
        const galleryImages = [
            @for (int i = 0; i < images.Count; i++)
            {
                @: { index: @(i + 1), url: "@images[i].ImageUrl" }@(i < images.Count - 1 ? "," : "")
            }
        ];
        let currentGalleryIndex = 0;

        function changeImageByIndex(index, src) {
            if (index < 0 || index >= galleryImages.length) return;
            currentGalleryIndex = index;
            const mainImg = document.getElementById("mainProductImage");
            const counter = document.getElementById("galleryCurrentIdx");

            if (counter) counter.textContent = index + 1;

            if (mainImg) {
                mainImg.style.opacity = "0.2";
                setTimeout(() => {
                    mainImg.src = src || galleryImages[index].url;
                    mainImg.onload = () => { mainImg.style.opacity = "1"; };
                }, 80);
            }

            const thumbs = document.querySelectorAll("#thumbnailStrip button");
            thumbs.forEach((thumb, i) => {
                const isActive = i === index;
                thumb.classList.toggle("border-slate-900", isActive);
                thumb.classList.toggle("dark:border-blue-500", isActive);
                thumb.classList.toggle("ring-2", isActive);
                thumb.classList.toggle("border-slate-200", !isActive);
                thumb.classList.toggle("dark:border-slate-800", !isActive);
                thumb.classList.toggle("opacity-80", !isActive);
            });
        }

        function prevImage() {
            if (galleryImages.length <= 1) return;
            let prev = currentGalleryIndex - 1;
            if (prev < 0) prev = galleryImages.length - 1;
            changeImageByIndex(prev);
        }

        function nextImage() {
            if (galleryImages.length <= 1) return;
            let next = currentGalleryIndex + 1;
            if (next >= galleryImages.length) next = 0;
            changeImageByIndex(next);
        }

        function toggleFullscreen() {
            const mainImg = document.getElementById("mainProductImage");
            if (mainImg && mainImg.requestFullscreen) {
                mainImg.requestFullscreen();
            }
        }

        /* VARIANT SELECTION & SYNCHRONIZATION */
        const variantSelect = document.getElementById("variantSelect");
        const priceElement = document.getElementById("productPrice");
        const stockMessage = document.getElementById("stockMessage");
        const availability = document.getElementById("productAvailability");
        const addCartButton = document.getElementById("addCartButton");
        const stickyAddCartButton = document.getElementById("stickyAddCartButton");
        const stickyPrice = document.getElementById("stickyPrice");
        const quantityInput = document.getElementById("quantityInput");
        const wishlistVariant = document.getElementById("wishlistVariantId");

        let selectedColorId = null;
        let selectedSizeId = null;

        function selectColorChip(chip, colorId, colorName) {
            document.querySelectorAll(".variant-color-chip").forEach(c => {
                c.classList.remove("border-slate-900", "dark:border-white", "bg-slate-900", "text-white");
                c.classList.add("bg-white", "dark:bg-slate-900", "border-slate-300", "dark:border-slate-700");
            });
            chip.classList.add("border-slate-900", "dark:border-white", "bg-slate-900", "text-white");
            chip.classList.remove("bg-white", "dark:bg-slate-900", "border-slate-300", "dark:border-slate-700");
            selectedColorId = colorId;
            const label = document.getElementById("selectedColorLabel");
            if (label) label.textContent = colorName;
            findAndSelectVariant();
        }

        function selectSizeChip(chip, sizeId, sizeName) {
            document.querySelectorAll(".variant-size-chip").forEach(s => {
                s.classList.remove("border-slate-900", "dark:border-white", "bg-slate-900", "text-white");
                s.classList.add("bg-white", "dark:bg-slate-900", "border-slate-300", "dark:border-slate-700");
            });
            chip.classList.add("border-slate-900", "dark:border-white", "bg-slate-900", "text-white");
            chip.classList.remove("bg-white", "dark:bg-slate-900", "border-slate-300", "dark:border-slate-700");
            selectedSizeId = sizeId;
            const label = document.getElementById("selectedSizeLabel");
            if (label) label.textContent = sizeName;
            findAndSelectVariant();
        }

        function findAndSelectVariant() {
            if (!variantSelect) return;
            let matchedOption = null;

            for (let i = 1; i < variantSelect.options.length; i++) {
                const opt = variantSelect.options[i];
                const optColor = opt.dataset.colorId;
                const optSize = opt.dataset.sizeId;

                const matchColor = !selectedColorId || optColor === selectedColorId;
                const matchSize = !selectedSizeId || optSize === selectedSizeId;

                if (matchColor && matchSize) {
                    matchedOption = opt;
                    break;
                }
            }

            if (matchedOption) {
                variantSelect.value = matchedOption.value;
                variantSelect.dispatchEvent(new Event("change"));
            } else {
                if (stockMessage) {
                    stockMessage.innerHTML = '<span class="text-rose-600 dark:text-rose-400 text-xs font-bold"><i class="bi bi-x-circle-fill me-1"></i> Selected combination is unavailable</span>';
                }
                if (addCartButton) addCartButton.disabled = true;
                if (stickyAddCartButton) stickyAddCartButton.disabled = true;
            }
        }

        if (variantSelect) {
            variantSelect.addEventListener("change", function () {
                const selected = this.options[this.selectedIndex];

                if (!selected || !selected.value) {
                    if (addCartButton) addCartButton.disabled = true;
                    if (stickyAddCartButton) stickyAddCartButton.disabled = true;
                    return;
                }

                const price = parseFloat(selected.dataset.price);
                const compareAt = parseFloat(selected.dataset.compareAt) || 0;
                const stock = parseInt(selected.dataset.stock) || 0;

                const colId = selected.dataset.colorId;
                const szId = selected.dataset.sizeId;
                if (colId) {
                    selectedColorId = colId;
                    document.querySelectorAll(".variant-color-chip").forEach(c => {
                        const isMatch = c.dataset.colorId === colId;
                        c.classList.toggle("border-slate-900", isMatch);
                        c.classList.toggle("dark:border-white", isMatch);
                        c.classList.toggle("bg-slate-900", isMatch);
                        c.classList.toggle("text-white", isMatch);
                        if (isMatch) {
                            const label = document.getElementById("selectedColorLabel");
                            if (label && c.dataset.colorName) label.textContent = c.dataset.colorName;
                        }
                    });
                }
                if (szId) {
                    selectedSizeId = szId;
                    document.querySelectorAll(".variant-size-chip").forEach(s => {
                        const isMatch = s.dataset.sizeId === szId;
                        s.classList.toggle("border-slate-900", isMatch);
                        s.classList.toggle("dark:border-white", isMatch);
                        s.classList.toggle("bg-slate-900", isMatch);
                        s.classList.toggle("text-white", isMatch);
                        if (isMatch) {
                            const label = document.getElementById("selectedSizeLabel");
                            if (label && s.dataset.sizeName) label.textContent = s.dataset.sizeName;
                        }
                    });
                }

                if (priceElement && !isNaN(price)) {
                    if (compareAt > price) {
                        const discountPct = Math.round((1 - (price / compareAt)) * 100);
                        const savedAmount = (compareAt - price).toFixed(2);
                        priceElement.innerHTML = `<span class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">$${price.toFixed(2)}</span> <span class="text-lg line-through text-slate-400 dark:text-slate-500">$${compareAt.toFixed(2)}</span> <span class="px-2.5 py-1 rounded-full text-xs font-black bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900">Save $${savedAmount} (-${discountPct}%)</span>`;
                    } else {
                        priceElement.innerHTML = `<span class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">$${price.toFixed(2)}</span>`;
                    }
                }

                if (stickyPrice && !isNaN(price)) {
                    stickyPrice.textContent = "$" + price.toFixed(2);
                }

                if (quantityInput) {
                    quantityInput.max = Math.max(stock, 1);
                    if (parseInt(quantityInput.value) > stock && stock > 0) {
                        quantityInput.value = stock;
                    }
                }

                if (stockMessage) {
                    if (stock <= 0) {
                        stockMessage.innerHTML = '<span class="text-rose-600 dark:text-rose-400 text-xs font-bold inline-flex items-center gap-1.5"><i class="bi bi-x-circle-fill"></i> Out of stock — check back soon</span>';
                    } else if (stock <= 5) {
                        stockMessage.innerHTML = `<span class="text-amber-600 dark:text-amber-400 text-xs font-bold inline-flex items-center gap-1.5"><i class="bi bi-exclamation-circle-fill"></i> Only ${stock} left in stock — order soon!</span>`;
                    } else {
                        stockMessage.innerHTML = `<span class="text-emerald-600 dark:text-emerald-400 text-xs font-bold inline-flex items-center gap-1.5"><i class="bi bi-check-circle-fill"></i> In stock (${stock} available) — ready to ship</span>`;
                    }
                }

                if (availability) {
                    availability.innerHTML = stock > 0
                        ? '<span class="text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1"><i class="bi bi-check-circle-fill"></i> In Stock</span>'
                        : '<span class="text-rose-600 dark:text-rose-400 inline-flex items-center gap-1"><i class="bi bi-x-circle-fill"></i> Out of Stock</span>';
                }

                if (addCartButton) {
                    addCartButton.disabled = stock <= 0;
                }
                if (stickyAddCartButton) {
                    stickyAddCartButton.disabled = stock <= 0;
                }

                if (wishlistVariant) {
                    wishlistVariant.value = selected.value;
                }
            });

            if (variantSelect.options.length > 1) {
                let defaultIndex = 1;
                for (let i = 1; i < variantSelect.options.length; i++) {
                    const optStock = parseInt(variantSelect.options[i].dataset.stock) || 0;
                    if (optStock > 0) {
                        defaultIndex = i;
                        break;
                    }
                }
                variantSelect.selectedIndex = defaultIndex;
                variantSelect.dispatchEvent(new Event("change"));
            }
        }

        function changeQuantity(amount) {
            if (!quantityInput) return;
            let current = parseInt(quantityInput.value) || 1;
            const max = parseInt(quantityInput.max) || 1;
            current += amount;
            if (current < 1) current = 1;
            if (current > max) current = max;
            quantityInput.value = current;
        }

        function submitWishlistForm() {
            const form = document.getElementById("wishlistForm");
            const wVariant = document.getElementById("wishlistVariantId");
            if (form && variantSelect) {
                wVariant.value = variantSelect.value;
                form.submit();
            }
        }

        const isSignedIn = @(isSignedIn ? "true" : "false");
        function redirectToLogin() {
            window.location.href = "/Account/Login?ReturnUrl=" + encodeURIComponent(window.location.pathname);
        }

        const cartForm = document.getElementById("addToCartForm");
        if (cartForm) {
            cartForm.addEventListener("submit", async function (e) {
                if (!isSignedIn) {
                    e.preventDefault();
                    redirectToLogin();
                    return false;
                }
                if (!variantSelect || !variantSelect.value) {
                    e.preventDefault();
                    alert("Please choose a product option (size & color) before adding to bag.");
                    return false;
                }

                e.preventDefault();
                const btn = addCartButton;
                const originalHtml = btn ? btn.innerHTML : '';
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="bi bi-arrow-repeat animate-spin"></i> <span>Adding…</span>';
                }

                try {
                    const formData = new FormData(cartForm);
                    const response = await fetch(cartForm.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        if (btn) {
                            btn.innerHTML = '<i class="bi bi-check-lg"></i> <span>Added!</span>';
                            setTimeout(function () {
                                btn.innerHTML = originalHtml;
                                btn.disabled = false;
                            }, 1600);
                        }

                        document.dispatchEvent(new CustomEvent('cart:updated', {
                            detail: {
                                toast: true,
                                title: "Added to bag!",
                                message: data.message || "Item was successfully added to your shopping cart."
                            }
                        }));
                    } else {
                        throw new Error('Server returned ' + response.status);
                    }
                } catch (err) {
                    if (btn) {
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }
                    cartForm.submit();
                }
            });
        }

        /* Sticky mobile CTA observer */
        const stickyBar = document.getElementById("stickyMobileCta");
        const purchaseRow = document.querySelector(".purchase-row");
        if (stickyBar && purchaseRow && "IntersectionObserver" in window) {
            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        stickyBar.classList.add("translate-y-full");
                    } else if (entry.boundingClientRect.top < 0) {
                        stickyBar.classList.remove("translate-y-full");
                    } else {
                        stickyBar.classList.add("translate-y-full");
                    }
                });
            }, { threshold: 0 });
            observer.observe(purchaseRow);
        }

        if (stickyAddCartButton && cartForm) {
            stickyAddCartButton.addEventListener("click", function () {
                if (!isSignedIn) {
                    redirectToLogin();
                    return;
                }
                if (!variantSelect || !variantSelect.value) {
                    alert("Please choose a product option before adding to bag.");
                    return;
                }
                cartForm.requestSubmit ? cartForm.requestSubmit() : cartForm.submit();
            });
        }

        /* STAR RATING PICKER */
        const starPicker = document.getElementById("starPicker");
        const ratingInput = document.getElementById("reviewRatingInput");
        const ratingLabel = document.getElementById("starRatingLabel");

        const ratingDescriptions = {
            1: "1 - Disappointed",
            2: "2 - Not as expected",
            3: "3 - Average / Fair",
            4: "4 - Very good",
            5: "5 - Excellent, loved it!"
        };

        if (starPicker && ratingInput) {
            const stars = starPicker.querySelectorAll(".star-picker-item");

            function updateStars(val) {
                stars.forEach(star => {
                    const r = parseInt(star.dataset.rating);
                    if (r <= val) {
                        star.classList.add("bi-star-fill", "text-amber-400");
                        star.classList.remove("bi-star", "text-slate-300", "dark:text-slate-700");
                    } else {
                        star.classList.remove("bi-star-fill", "text-amber-400");
                        star.classList.add("bi-star", "text-slate-300", "dark:text-slate-700");
                    }
                });
                if (ratingLabel) {
                    ratingLabel.textContent = ratingDescriptions[val] || `${val} Stars`;
                }
            }

            stars.forEach(star => {
                star.addEventListener("mouseenter", function () {
                    const hoverVal = parseInt(this.dataset.rating);
                    stars.forEach(s => {
                        const r = parseInt(s.dataset.rating);
                        s.classList.toggle("bi-star-fill", r <= hoverVal);
                        s.classList.toggle("text-amber-400", r <= hoverVal);
                        s.classList.toggle("bi-star", r > hoverVal);
                    });
                    if (ratingLabel) ratingLabel.textContent = ratingDescriptions[hoverVal] || `${hoverVal} Stars`;
                });

                star.addEventListener("click", function () {
                    const clickVal = parseInt(this.dataset.rating);
                    ratingInput.value = clickVal;
                    updateStars(clickVal);
                });
            });

            starPicker.addEventListener("mouseleave", function () {
                const currentVal = parseInt(ratingInput.value) || 5;
                updateStars(currentVal);
            });
        }

        /* Char Counter */
        const commentInput = document.getElementById("reviewCommentInput");
        const charCounter = document.getElementById("reviewCharCounter");
        if (commentInput && charCounter) {
            function updateCharCount() {
                charCounter.textContent = `${commentInput.value.length} / 1000`;
            }
            commentInput.addEventListener("input", updateCharCount);
            updateCharCount();
        }

        /* REVIEWS FILTERING & SORTING */
        const filterBtns = document.querySelectorAll(".review-filter-btn");
        const reviewCards = document.querySelectorAll(".review-item-card");
        const sortSelect = document.getElementById("reviewSortSelect");
        const reviewsContainer = document.getElementById("reviewsListContainer");

        if (filterBtns.length > 0 && reviewCards.length > 0) {
            filterBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    filterBtns.forEach(b => {
                        b.classList.remove("bg-slate-900", "dark:bg-blue-600", "text-white");
                        b.classList.add("bg-white", "dark:bg-slate-900", "text-slate-600", "dark:text-slate-400", "border", "border-slate-300", "dark:border-slate-700");
                    });
                    this.classList.remove("bg-white", "dark:bg-slate-900", "text-slate-600", "dark:text-slate-400", "border", "border-slate-300", "dark:border-slate-700");
                    this.classList.add("bg-slate-900", "dark:bg-blue-600", "text-white");
                    const filter = this.dataset.filter;

                    reviewCards.forEach(card => {
                        const cardRating = card.dataset.rating;
                        if (filter === "all" || cardRating === filter) {
                            card.style.display = "";
                        } else {
                            card.style.display = "none";
                        }
                    });
                });
            });
        }

        if (sortSelect && reviewsContainer && reviewCards.length > 0) {
            sortSelect.addEventListener("change", function () {
                const criteria = this.value;
                const cardsArray = Array.from(reviewCards);

                cardsArray.sort((a, b) => {
                    if (criteria === "highest") {
                        return parseInt(b.dataset.rating) - parseInt(a.dataset.rating);
                    } else if (criteria === "lowest") {
                        return parseInt(a.dataset.rating) - parseInt(b.dataset.rating);
                    } else {
                        return parseInt(b.dataset.timestamp) - parseInt(a.dataset.timestamp);
                    }
                });

                cardsArray.forEach(card => reviewsContainer.appendChild(card));
            });
        }
    </script>
}
