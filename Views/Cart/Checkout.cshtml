@model WebApplication_ClothingEcommerce.Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";

    var paymentMethods =
        ViewBag.PaymentMethods
        as List<WebApplication_ClothingEcommerce.Models.PaymentMethod>
        ?? new List<WebApplication_ClothingEcommerce.Models.PaymentMethod>();
}

<style>
    .checkout-page {
        background: #fff;
    }

    .checkout-hero {
        background: linear-gradient(120deg, var(--blue-soft, #eaf2ff), #fff 60%);
        border-bottom: 1px solid var(--border, #eeeeee);
        padding: 32px 0;
    }

    .checkout-hero-eyebrow {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .12em;
        color: var(--google-blue, #4285F4);
        margin-bottom: 4px;
    }

    .checkout-hero h1 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--black, #202124);
        margin-bottom: 0;
    }

    .checkout-card {
        border: 1px solid var(--border, #eeeeee);
        border-radius: 20px;
        background: #fff;
    }

    .checkout-card-title {
        font-size: 18px;
        font-weight: 800;
        color: var(--black, #202124);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .checkout-section-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: #fff;
    }

        .checkout-section-icon.blue {
            background: var(--google-blue, #4285F4);
        }

        .checkout-section-icon.green {
            background: var(--google-green, #34A853);
        }

        .checkout-section-icon.yellow {
            background: var(--google-yellow-dark, #F9AB00);
        }

    .checkout-page .form-control,
    .checkout-page .form-select {
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 10px 14px;
    }

        .checkout-page .form-control:focus,
        .checkout-page .form-select:focus {
            border-color: var(--google-blue, #4285F4);
            box-shadow: 0 0 0 3px rgba(66,133,244,.12);
        }

    .checkout-page .form-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--black, #202124);
    }

    .payment-method-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        border: 1px solid #dcdcdc;
        border-radius: 14px;
        height: 100%;
        cursor: pointer;
        transition: all .2s ease;
    }

        .payment-method-card:hover {
            border-color: var(--google-blue, #4285F4);
            background: var(--blue-soft, #eaf2ff);
        }

        .payment-method-card:has(input:checked) {
            border-color: var(--google-blue, #4285F4);
            background: var(--blue-soft, #eaf2ff);
            box-shadow: 0 0 0 2px rgba(66,133,244,.15);
        }

    .checkout-place-order-btn {
        width: 100%;
        border: 0;
        border-radius: 12px;
        padding: 16px;
        background: var(--google-blue, #4285F4);
        color: #fff;
        font-weight: 800;
        font-size: 15px;
        box-shadow: 0 10px 24px rgba(66,133,244,.28);
        transition: all .2s ease;
    }

        .checkout-place-order-btn:hover {
            background: var(--google-blue-dark, #3367D6);
            transform: translateY(-2px);
        }

    .checkout-summary-card {
        border: 1px solid var(--border, #eeeeee);
        border-radius: 20px;
        background: #fff;
        position: sticky;
        top: 90px;
    }

    .checkout-summary-item-img {
        width: 70px;
        height: 85px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid var(--border, #eeeeee);
    }

    .checkout-summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 14px;
        color: var(--gray, #666);
    }

    .checkout-summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 14px;
        border-top: 1px solid var(--border, #eeeeee);
    }

    .checkout-summary-total-value {
        font-size: 22px;
        font-weight: 800;
        color: var(--google-blue, #4285F4);
    }
</style>

<div class="checkout-page">

    <!-- =========================================
         BREADCRUMB
    ========================================== -->
    <section class="py-3 border-bottom">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a asp-controller="Shop" asp-action="Index" class="text-decoration-none text-secondary">
                            <i class="bi bi-shop me-1"></i> Shop
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Cart" asp-action="Index" class="text-decoration-none text-secondary">
                            Cart
                        </a>
                    </li>
                    <li class="breadcrumb-item active fw-semibold" aria-current="page" style="color: var(--google-blue, #4285F4);">
                        Checkout
                    </li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- =========================================
         HERO
    ========================================== -->
    <section class="checkout-hero">
        <div class="container">
            <div class="checkout-hero-eyebrow">FINAL STEP</div>
            <h1>Checkout</h1>
        </div>
    </section>

    <section class="py-5">
        <div class="container">

            <div class="row g-4">

                <!-- ========================= -->
                <!-- CHECKOUT FORM -->
                <!-- ========================= -->

                <div class="col-lg-8">

                    <form asp-action="Checkout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger border-0 rounded-3">
                        </div>

                        <!-- CUSTOMER -->
                        <div class="checkout-card mb-4 p-4">

                            <div class="checkout-card-title">
                                <span class="checkout-section-icon blue">
                                    <i class="bi bi-person"></i>
                                </span>
                                Customer Information
                            </div>

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label">First Name</label>
                                    <input asp-for="FirstName" class="form-control" />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label">Last Name</label>
                                    <input asp-for="LastName" class="form-control" />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label">Phone</label>
                                    <input asp-for="Phone" class="form-control" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <input asp-for="Email" class="form-control" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                            </div>

                        </div>


                        <!-- ========================= -->
                        <!-- SHIPPING ADDRESS -->
                        <!-- ========================= -->

                        <div class="checkout-card mb-4 p-4">

                            <div class="checkout-card-title">
                                <span class="checkout-section-icon green">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                Shipping Address
                            </div>

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label asp-for="Province" class="form-label">Province</label>
                                    <input asp-for="Province" class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="City" class="form-label">City</label>
                                    <input asp-for="City" class="form-control" />
                                </div>

                                <div class="col-md-8">
                                    <label asp-for="Street" class="form-label">Street</label>
                                    <input asp-for="Street" class="form-control" />
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="PostalCode" class="form-label">Postal Code</label>
                                    <input asp-for="PostalCode" class="form-control" />
                                </div>

                            </div>

                        </div>


                        <!-- ========================= -->
                        <!-- PAYMENT METHOD -->
                        <!-- ========================= -->

                        <div class="checkout-card mb-4 p-4">

                            <div class="checkout-card-title">
                                <span class="checkout-section-icon yellow">
                                    <i class="bi bi-credit-card"></i>
                                </span>
                                Payment Method
                            </div>

                            @if (paymentMethods.Count == 0)
                            {
                                <div class="alert alert-warning border-0 rounded-3">
                                    No payment methods are currently available.
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">

                                    @foreach (var method in paymentMethods)
                                    {
                                        <div class="col-md-6">

                                            <label class="payment-method-card">

                                                <input type="radio"
                                                       asp-for="PaymentMethodId"
                                                       value="@method.Id"
                                                       class="form-check-input" />

                                                @if (!string.IsNullOrWhiteSpace(method.Icon))
                                                {
                                                    <img src="@method.Icon"
                                                         alt="@method.Name"
                                                         style="width:42px;height:42px;object-fit:contain;" />
                                                }

                                                <div>
                                                    <div class="fw-semibold">
                                                        @method.Name
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(method.Description))
                                                    {
                                                        <small class="text-muted">
                                                            @method.Description
                                                        </small>
                                                    }
                                                </div>

                                            </label>

                                        </div>
                                    }

                                </div>
                            }

                            <span asp-validation-for="PaymentMethodId" class="text-danger small"></span>

                        </div>


                        <button type="submit" class="checkout-place-order-btn">
                            <i class="bi bi-lock-fill me-2"></i>
                            Place Order
                        </button>

                    </form>

                </div>


                <!-- ========================= -->
                <!-- ORDER SUMMARY -->
                <!-- ========================= -->

                <div class="col-lg-4">

                    <div class="checkout-summary-card p-4">

                        <h4 class="fw-bold mb-4">Order Summary</h4>

                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex gap-3 mb-3">

                                <img src="@item.ImageUrl"
                                     alt="@item.ProductName"
                                     class="checkout-summary-item-img" />

                                <div class="flex-grow-1">

                                    <div class="fw-semibold">
                                        @item.ProductName
                                    </div>

                                    <small class="text-muted">
                                        @item.Size / @item.Color
                                    </small>

                                    <div class="small text-secondary">
                                        @item.Quantity × @item.UnitPrice.ToString("C")
                                    </div>

                                </div>

                            </div>
                        }

                        <hr />

                        <div class="checkout-summary-row">
                            <span>Subtotal</span>
                            <strong class="text-dark">@Model.SubTotal.ToString("C")</strong>
                        </div>

                        <div class="checkout-summary-row">
                            <span>Delivery</span>
                            <strong class="text-dark">@Model.DeliveryFee.ToString("C")</strong>
                        </div>

                        <div class="checkout-summary-total">
                            <strong class="fs-5">Total</strong>
                            <strong class="checkout-summary-total-value">
                                @Model.Total.ToString("C")
                            </strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </section>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}