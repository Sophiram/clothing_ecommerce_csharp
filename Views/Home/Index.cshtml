@model IEnumerable<WebApplication_ClothingEcommerce.Models.Product>

@using WebApplication_ClothingEcommerce.Data.Enums

@{
    ViewData["Title"] = "Home";
}
<!-- =========================================================
     HERO - MODERN GOOGLE COLOR STYLE
========================================================= -->

<section class="modern-hero">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- HERO CONTENT -->
            <div class="col-lg-6">
                <div class="hero-content">

                    <!-- LABEL -->
                    <div class="hero-label">
                        NEW COLLECTION 2026
                    </div>

                    <!-- TITLE -->
                    <h1>
                        Wear your <span>identity.</span>
                    </h1>

                    <!-- DESCRIPTION -->
                    <p>
                        Discover modern clothing designed for everyday
                        confidence, comfort and effortless style.
                    </p>

                    <!-- BUTTONS -->
                    <div class="hero-buttons">
                        <a asp-controller="Shop" asp-action="Index" class="hero-primary-btn">
                            <span>Shop Collection</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>

                        <a asp-controller="Shop" asp-action="Index" class="hero-secondary-btn">
                            Explore Products
                            <i class="bi bi-arrow-up-right ms-1"></i>
                        </a>
                    </div>

                    <!-- STATS -->
                    <div class="hero-stats">
                        <div>
                            <strong>500+</strong>
                            <span>PRODUCTS</span>
                        </div>
                        <div>
                            <strong>50+</strong>
                            <span>BRANDS</span>
                        </div>
                        <div>
                            <strong>10K+</strong>
                            <span>CUSTOMERS</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- HERO IMAGE -->
            <div class="col-lg-6">
                <div class="hero-visual">

                    <div class="hero-image-main">
                        <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=1000&q=85"
                             alt="Fashion Collection" />
                    </div>

                    <!-- FLOATING CARD -->
                    <div class="hero-floating-card">
                        <div class="floating-icon">
                            <i class="bi bi-stars"></i>
                        </div>
                        <div>
                            <strong>New Season</strong>
                            <small>Fresh styles are here</small>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>


<!-- =========================================================
     CATEGORIES
========================================================= -->

<section class="py-5">

    <div class="container py-4">

        <div class="d-flex justify-content-between
            align-items-end mb-4">

            <div>

                <div class="text-uppercase
                    small fw-bold text-primary mb-2">

                    SHOP BY STYLE

                </div>

                <h2 class="fw-bold mb-0">
                    Categories
                </h2>

            </div>

            <a asp-controller="Shop"
               asp-action="Index"
               class="btn btn-outline-dark">

                View All

                <i class="bi bi-arrow-right ms-2"></i>

            </a>

        </div>


        <div class="row g-4">

            <!-- MEN -->
            <div class="col-md-4">

                <a asp-controller="Shop"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                        <img src="https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&w=800&q=80"
                             class="card-img-top"
                             alt="Men"
                             style="height:320px;object-fit:cover;" />

                        <div class="card-body p-4">

                            <small class="text-secondary">
                                01
                            </small>

                            <div class="d-flex
                                justify-content-between
                                align-items-center">

                                <h4 class="fw-bold mb-0">
                                    Men
                                </h4>

                                <span class="btn btn-dark rounded-circle">

                                    <i class="bi bi-arrow-up-right"></i>

                                </span>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- WOMEN -->
            <div class="col-md-4">

                <a asp-controller="Shop"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                        <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=800&q=80"
                             class="card-img-top"
                             alt="Women"
                             style="height:320px;object-fit:cover;" />

                        <div class="card-body p-4">

                            <small class="text-secondary">
                                02
                            </small>

                            <div class="d-flex
                                justify-content-between
                                align-items-center">

                                <h4 class="fw-bold mb-0">
                                    Women
                                </h4>

                                <span class="btn btn-dark rounded-circle">

                                    <i class="bi bi-arrow-up-right"></i>

                                </span>

                            </div>

                        </div>

                    </div>

                </a>

            </div>


            <!-- ACCESSORIES -->
            <div class="col-md-4">

                <a asp-controller="Shop"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                        <img src="https://images.unsplash.com/photo-1523779917675-b6ed3a42a561?auto=format&fit=crop&w=800&q=80"
                             class="card-img-top"
                             alt="Accessories"
                             style="height:320px;object-fit:cover;" />

                        <div class="card-body p-4">

                            <small class="text-secondary">
                                03
                            </small>

                            <div class="d-flex
                                justify-content-between
                                align-items-center">

                                <h4 class="fw-bold mb-0">
                                    Accessories
                                </h4>

                                <span class="btn btn-dark rounded-circle">

                                    <i class="bi bi-arrow-up-right"></i>

                                </span>

                            </div>

                        </div>

                    </div>

                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     POPULAR BRANDS
========================================================= -->

<section class="py-5">

    <div class="container py-4">

        <!-- HEADER -->

        <div class="d-flex justify-content-between
            align-items-end mb-4">

            <div>

                <div class="text-uppercase
                    small
                    fw-bold
                    text-primary
                    mb-2">

                    SHOP BY BRAND

                </div>

                <h2 class="fw-bold mb-0">
                    Popular Brands
                </h2>

            </div>

            <a asp-controller="Shop"
               asp-action="Index"
               class="btn btn-outline-dark">

                View All

                <i class="bi bi-arrow-right ms-2"></i>

            </a>

        </div>


        <!-- BRAND GRID -->
        @if (ViewBag.Brands != null &&
                     ViewBag.Brands.Count > 0)
        {
            <div class="row g-3">

                @foreach (var brand in ViewBag.Brands)
                {
                    <div class="col-6 col-md-4 col-lg-3">

                        <a asp-controller="Shop"
                           asp-action="Index"
                           asp-route-brandId="@brand.Id"
                           class="text-decoration-none">

                            <div class="brand-home-card
                                card
                                border-0
                                shadow-sm
                                rounded-4
                                h-100">

                                <div class="card-body
                                    p-4
                                    text-center">

                                    <!-- LOGO -->

                                    <div class="brand-logo-wrapper
                                        mx-auto
                                        mb-3">

                                        @if (!string.IsNullOrWhiteSpace(brand.Logo))
                                        {
                                            <img src="@brand.Logo"
                                                 alt="@brand.Name"
                                                 class="brand-home-logo" />
                                        }
                                        else
                                        {
                                            <div class="brand-logo-placeholder">

                                                <i class="bi bi-award"></i>

                                            </div>
                                        }

                                    </div>


                                    <!-- NAME -->

                                    <h5 class="fw-bold
                                        text-dark
                                        mb-1">

                                        @brand.Name

                                    </h5>


                                    <small class="text-secondary">

                                        View Products

                                        <i class="bi bi-arrow-right ms-1"></i>

                                    </small>

                                </div>

                            </div>

                        </a>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="text-center text-secondary py-5">

                <i class="bi bi-award display-5"></i>

                <p class="mt-3 mb-0">
                    No brands available.
                </p>

            </div>
        }

    </div>

</section>




<!-- =========================================================
     LATEST PRODUCTS
========================================================= -->

<section class="py-5 bg-light">

    <div class="container py-4">

        <div class="d-flex justify-content-between
            align-items-end mb-4">

            <div>

                <div class="text-uppercase
                    small fw-bold text-primary mb-2">

                    FEATURED

                </div>

                <h2 class="fw-bold mb-0">
                    Latest Products
                </h2>

            </div>

            <a asp-controller="Shop"
               asp-action="Index"
               class="btn btn-outline-dark">

                Shop All

                <i class="bi bi-arrow-right ms-2"></i>

            </a>

        </div>


        <div class="row g-4">

            @if (Model != null && Model.Any())
            {
                foreach (var product in Model.Take(8))
                {
                    var primaryImage =
                        product.Images?
                            .FirstOrDefault(x => x.IsPrimary)
                        ?? product.Images?
                            .FirstOrDefault();

                    var price =
                        product.Variants?
                            .Where(v =>
                                v.Status == VariantStatus.Available)
                            .Select(v => v.Price)
                            .DefaultIfEmpty(0)
                            .Min()
                        ?? 0;

                    <div class="col-6 col-md-4 col-lg-3">

                        <div class="card h-100 border-0
                            shadow-sm rounded-4 overflow-hidden">

                            <!-- IMAGE -->

                            <div class="position-relative">

                                <a asp-controller="Shop"
                                   asp-action="Details"
                                   asp-route-id="@product.Id">

                                    @if (primaryImage != null &&
                                         !string.IsNullOrWhiteSpace(
                                             primaryImage.ImageUrl))
                                    {
                                        <img src="@primaryImage.ImageUrl"
                                             class="card-img-top"
                                             alt="@product.Name"
                                             style="height:300px;
                                        object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light
                                            d-flex
                                            align-items-center
                                            justify-content-center"
                                             style="height:300px;">

                                            <i class="bi bi-image
                                                display-5
                                                text-secondary">
                                            </i>

                                        </div>
                                    }

                                </a>

                                <span class="position-absolute
                                    top-0 start-0
                                    m-3 badge text-bg-dark">

                                    NEW

                                </span>

                                <a asp-controller="Shop"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="position-absolute
                                    top-0 end-0
                                    m-3 btn btn-light
                                    rounded-circle shadow-sm">

                                    <i class="bi bi-heart"></i>

                                </a>

                            </div>


                            <!-- CONTENT -->

                            <div class="card-body p-3">

                                <div class="d-flex align-items-center gap-2">

                                    @if (!string.IsNullOrWhiteSpace(product.Brand?.Logo))
                                    {
                                        <img src="@product.Brand.Logo"
                                             alt="@product.Brand.Name"
                                             class="rounded border bg-white"
                                             style="width:28px;height:28px;object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <div class="rounded border bg-light d-flex align-items-center justify-content-center"
                                             style="width:28px;height:28px;">

                                            <i class="bi bi-award text-secondary"
                                               style="font-size:14px;"></i>

                                        </div>
                                    }

                                    <small class="text-uppercase text-primary fw-bold">
                                        @(product.Brand?.Name ?? "CLOTHÉ")
                                    </small>

                                </div>

                                <a asp-controller="Shop"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="text-decoration-none text-dark">

                                    <h5 class="fw-bold mt-2 mb-2">

                                        @product.Name

                                    </h5>

                                </a>


                                <div class="d-flex
                                    justify-content-between
                                    align-items-center">

                                    <strong class="fs-5">

                                        @if (price > 0)
                                        {
                                            @price.ToString("C")
                                        }
                                        else
                                        {
                                            @:Contact us
                                        }

                                    </strong>

                                    <a asp-controller="Shop"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn btn-dark rounded-circle">

                                        <i class="bi bi-arrow-up-right"></i>

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="text-center
                        bg-white
                        rounded-4
                        shadow-sm
                        p-5">

                        <i class="bi bi-bag
                            display-4
                            text-secondary">
                        </i>

                        <h5 class="fw-bold mt-3">
                            No products available
                        </h5>

                        <p class="text-secondary mb-0">
                            Products will appear here once they are added.
                        </p>

                    </div>

                </div>
            }

        </div>

    </div>

</section>


<!-- =========================================================
     PROMO
========================================================= -->

<section class="py-5">

    <div class="container py-4">

        <div class="card border-0 shadow-sm
            rounded-4 overflow-hidden">

            <div class="row g-0 align-items-center">

                <div class="col-lg-6">

                    <div class="p-4 p-lg-5">

                        <div class="text-uppercase
                            small fw-bold
                            text-primary mb-3">

                            CLOTHÉ ESSENTIALS

                        </div>

                        <h2 class="display-6 fw-bold mb-3">

                            Simple.
                            <span class="text-primary">
                                Modern.
                            </span>
                            You.

                        </h2>

                        <p class="text-secondary mb-4">

                            Build your everyday wardrobe with timeless
                            pieces designed to work together.

                        </p>

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="btn btn-dark btn-lg px-4">

                            Explore Collection

                            <i class="bi bi-arrow-right ms-2"></i>

                        </a>

                    </div>

                </div>


                <div class="col-lg-6">

                    <img src="https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=1000&q=85"
                         class="img-fluid w-100"
                         alt="Clothing Collection"
                         style="height:420px;object-fit:cover;" />

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FEATURES
========================================================= -->

<section class="py-5 bg-light">

    <div class="container py-4">

        <div class="mb-4">

            <div class="text-uppercase
                small fw-bold text-primary mb-2">

                WHY CLOTHÉ

            </div>

            <h2 class="fw-bold">
                Made for you
            </h2>

        </div>


        <div class="row g-4">

            <!-- DELIVERY -->
            <div class="col-md-4">

                <div class="card border-0
                    shadow-sm
                    rounded-4
                    h-100">

                    <div class="card-body p-4">

                        <div class="rounded-circle
                            bg-primary-subtle
                            text-primary
                            d-flex
                            align-items-center
                            justify-content-center
                            mb-3"
                             style="width:55px;height:55px;">

                            <i class="bi bi-truck fs-4"></i>

                        </div>

                        <h5 class="fw-bold">
                            Fast Delivery
                        </h5>

                        <p class="text-secondary mb-0">

                            Reliable delivery directly
                            to your door.

                        </p>

                    </div>

                </div>

            </div>


            <!-- SECURITY -->
            <div class="col-md-4">

                <div class="card border-0
                    shadow-sm
                    rounded-4
                    h-100">

                    <div class="card-body p-4">

                        <div class="rounded-circle
                            bg-primary-subtle
                            text-primary
                            d-flex
                            align-items-center
                            justify-content-center
                            mb-3"
                             style="width:55px;height:55px;">

                            <i class="bi bi-shield-check fs-4"></i>

                        </div>

                        <h5 class="fw-bold">
                            Secure Shopping
                        </h5>

                        <p class="text-secondary mb-0">

                            Your account and orders
                            are protected.

                        </p>

                    </div>

                </div>

            </div>


            <!-- RETURNS -->
            <div class="col-md-4">

                <div class="card border-0
                    shadow-sm
                    rounded-4
                    h-100">

                    <div class="card-body p-4">

                        <div class="rounded-circle
                            bg-primary-subtle
                            text-primary
                            d-flex
                            align-items-center
                            justify-content-center
                            mb-3"
                             style="width:55px;height:55px;">

                            <i class="bi bi-arrow-repeat fs-4"></i>

                        </div>

                        <h5 class="fw-bold">
                            Easy Returns
                        </h5>

                        <p class="text-secondary mb-0">

                            Simple and convenient
                            return experience.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>