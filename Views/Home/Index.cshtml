@model IEnumerable<WebApplication_ClothingEcommerce.Models.Product>
@using WebApplication_ClothingEcommerce.Data.Enums

@{
    ViewData["Title"] = "CLOTHÉ - Modern Fashion, Streetwear & Luxury Essentials";
    var homeSettings = ViewBag.HomePageSettings as WebApplication_ClothingEcommerce.Models.HomePageSettings ?? new WebApplication_ClothingEcommerce.Models.HomePageSettings();
    
    var heroTitleRaw = homeSettings.HeroTitle ?? "Wear your identity.";
    var highlightWord = homeSettings.HeroHighlightWord ?? "identity.";
    if (string.IsNullOrWhiteSpace(highlightWord)) highlightWord = "identity.";
    
    // Case-insensitive, consistent gradient highlight for hero title
    string mainTitleHtml = heroTitleRaw;
    int hIdx = heroTitleRaw.IndexOf(highlightWord, StringComparison.OrdinalIgnoreCase);
    if (hIdx >= 0)
    {
        var before = heroTitleRaw.Substring(0, hIdx);
        var matched = heroTitleRaw.Substring(hIdx, highlightWord.Length);
        var after = heroTitleRaw.Substring(hIdx + highlightWord.Length);
        mainTitleHtml = $"{before}<span class=\"bg-gradient-to-r from-amber-400 via-rose-500 to-violet-600 dark:from-amber-300 dark:via-rose-400 dark:to-violet-400 bg-clip-text text-transparent font-serif italic font-extrabold\">{matched}</span>{after}";
    }
    else
    {
        var words = heroTitleRaw.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length > 1)
        {
            var lead = string.Join(" ", words.Take(words.Length - 1));
            var last = words.Last();
            mainTitleHtml = $"{lead} <span class=\"bg-gradient-to-r from-amber-400 via-rose-500 to-violet-600 dark:from-amber-300 dark:via-rose-400 dark:to-violet-400 bg-clip-text text-transparent font-serif italic font-extrabold\">{last}</span>";
        }
        else
        {
            mainTitleHtml = $"<span class=\"bg-gradient-to-r from-amber-400 via-rose-500 to-violet-600 dark:from-amber-300 dark:via-rose-400 dark:to-violet-400 bg-clip-text text-transparent font-serif italic font-extrabold\">{heroTitleRaw}</span>";
        }
    }

    var testimonials = new[]
    {
        new { Name = "Sophea Linda", Role = "Verified Buyer", City = "Phnom Penh", Text = "The fit is truly exceptional and the organic fabric feels ultra-luxurious. Delivery arrived at my doorstep in less than 24 hours.", AvatarBg = "from-pink-500 to-rose-600", Initials = "SL" },
        new { Name = "Marc Tith", Role = "Fashion Creator", City = "Siem Reap", Text = "The cleanest aesthetic in Cambodia. Instant Bakong KHQR payment made checkout effortless, and the tailoring is runway quality.", AvatarBg = "from-violet-500 to-indigo-600", Initials = "MT" },
        new { Name = "Dara Kem", Role = "Verified Buyer", City = "Battambang", Text = "I've made four purchases this season alone. Streetwear silhouettes that maintain shape and comfort after countless washes.", AvatarBg = "from-amber-500 to-orange-600", Initials = "DK" },
        new { Name = "Alice Wong", Role = "VIP Member", City = "Phnom Penh", Text = "VIP customer care helped me confirm my exact measurements in Khmer within minutes. Genuinely 5-star standard.", AvatarBg = "from-emerald-500 to-teal-600", Initials = "AW" }
    };

    var instaImages = new[]
    {
        new { Img = "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=600&q=80", Tag = "#Streetwear", Likes = "1.8K" },
        new { Img = "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=600&q=80", Tag = "#MinimalStyle", Likes = "2.4K" },
        new { Img = "https://images.unsplash.com/photo-1552374196-c4e7ffc6e126?auto=format&fit=crop&w=600&q=80", Tag = "#TailoredFit", Likes = "940" },
        new { Img = "https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=600&q=80", Tag = "#ModernClassic", Likes = "3.1K" },
        new { Img = "https://images.unsplash.com/photo-1490114538077-0a7f8cb49891?auto=format&fit=crop&w=600&q=80", Tag = "#AtelierEdition", Likes = "1.5K" },
        new { Img = "https://images.unsplash.com/photo-1554568218-0f1715e72254?auto=format&fit=crop&w=600&q=80", Tag = "#EverydayChic", Likes = "2.2K" }
    };
}

<!-- =========================================================
     PROMO TICKER BAR (OPTIONAL FROM SETTINGS)
========================================================= -->
@if (!string.IsNullOrEmpty(homeSettings.PromoText))
{
    <div class="relative overflow-hidden bg-gradient-to-r from-violet-600 via-pink-600 to-amber-500 text-white text-xs font-semibold py-2.5 px-4 shadow-sm">
        <div class="max-w-screen-xl mx-auto flex items-center justify-between gap-4">
            <div class="flex items-center gap-2 truncate">
                <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full bg-white/20 text-[10px] font-extrabold uppercase tracking-wider">
                    @(string.IsNullOrEmpty(homeSettings.PromoTag) ? "Flash Sale" : homeSettings.PromoTag)
                </span>
                <span data-en="@homeSettings.PromoText" data-kh="ការបញ្ចុះតម្លៃពិសេសសម្រាប់រដូវកាលថ្មី!">
                    @homeSettings.PromoText
                </span>
            </div>
            @if (!string.IsNullOrEmpty(homeSettings.PromoCtaUrl))
            {
                <a href="@homeSettings.PromoCtaUrl" class="inline-flex items-center gap-1 font-bold underline hover:text-amber-200 transition-colors flex-shrink-0 text-xs">
                    <span data-en="@homeSettings.PromoCtaText" data-kh="ទិញឥឡូវ">
                        @(string.IsNullOrEmpty(homeSettings.PromoCtaText) ? "Shop Now" : homeSettings.PromoCtaText)
                    </span>
                    <i class="bi bi-arrow-right text-[11px]"></i>
                </a>
            }
        </div>
    </div>
}

<!-- =========================================================
     1. HERO SECTION (NEW VIBRANT & COLORFUL STYLE)
========================================================= -->
<section class="relative overflow-hidden bg-white dark:bg-slate-950 min-h-[92vh] flex items-center transition-colors duration-300">
    <!-- Radiant Multi-Color Ambient Orbs in Background -->
    <div class="absolute -top-24 -right-24 w-[600px] h-[600px] bg-gradient-to-br from-pink-500/20 via-purple-500/20 to-indigo-500/10 rounded-full blur-3xl opacity-70 pointer-events-none animate-pulse"></div>
    <div class="absolute -bottom-32 -left-32 w-[550px] h-[550px] bg-gradient-to-tr from-cyan-400/20 via-blue-500/15 to-violet-600/15 rounded-full blur-3xl opacity-60 pointer-events-none"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[400px] h-[400px] bg-gradient-to-r from-amber-400/10 via-rose-400/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-24 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

            <!-- HERO CONTENT (7 COLS) -->
            <div class="lg:col-span-7 order-2 lg:order-1 text-center lg:text-left">
                
                <!-- Radiant Colorful Pill Badge -->
                <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-gradient-to-r from-pink-500/10 via-purple-500/10 to-indigo-500/10 border border-pink-500/30 dark:border-pink-400/30 text-xs font-bold tracking-wider uppercase mb-6 shadow-sm">
                    <span class="flex h-2 w-2 relative">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-pink-500"></span>
                    </span>
                    <span class="bg-gradient-to-r from-pink-600 via-purple-600 to-indigo-600 dark:from-pink-400 dark:via-purple-300 dark:to-indigo-300 bg-clip-text text-transparent"
                          data-en="@homeSettings.HeroLabel" data-kh="បណ្តុំម៉ូដទាន់សម័យ ២០២៦">
                        @(homeSettings.HeroLabel ?? "New Season Collection 2026")
                    </span>
                    <span class="text-pink-500 text-[10px]">&bull;</span>
                    <span class="text-xs font-semibold text-gray-600 dark:text-slate-300" data-en="Just Dropped" data-kh="ទើបមកដល់">Just Dropped</span>
                </div>

                <h1 class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-extrabold tracking-tight leading-[1.08] mb-6 text-gray-900 dark:text-white"
                    data-en="@mainTitleHtml"
                    data-kh="ស្លៀកពាក់ដើម្បីបង្ហាញ <span class='bg-gradient-to-r from-amber-400 via-rose-500 to-violet-600 dark:from-amber-300 dark:via-rose-400 dark:to-violet-400 bg-clip-text text-transparent font-serif italic font-extrabold'>អត្តសញ្ញាណរបស់អ្នក។</span>">
                    @Html.Raw(mainTitleHtml)
                </h1>

                <!-- Colorful Multi-tone Sub-description -->
                <p class="text-base sm:text-lg text-gray-600 dark:text-slate-300 leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0"
                   data-en="@homeSettings.HeroDescription"
                   data-kh="ស្វែងរកសម្លៀកបំពាក់ទាន់សម័យដែលត្រូវបានរចនាឡើងដើម្បីផ្តល់ទំនុកចិត្ត ភាពស្រស់ស្អាត និងផាសុកភាពខ្ពស់បំផុត។">
                    @(homeSettings.HeroDescription ?? "Discover modern streetwear & luxury essentials engineered for effortless confidence. Organic fabrics, tailored silhouettes, and timeless pieces made for modern lifestyles.")
                </p>

                <!-- Action CTA Buttons with Colorful Gradients -->
                <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 mb-10">
                    <a href="@(homeSettings.HeroPrimaryBtnUrl ?? "/Shop")"
                       class="group relative inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-violet-600 via-indigo-600 to-blue-600 hover:from-violet-700 hover:via-indigo-700 hover:to-blue-700 text-white text-sm font-bold rounded-2xl transition-all duration-300 shadow-xl shadow-indigo-500/25 hover:shadow-2xl hover:shadow-indigo-500/40 hover:-translate-y-0.5 active:translate-y-0">
                        <span data-en="@homeSettings.HeroPrimaryBtnText" data-kh="ទិញបណ្តុំម៉ូដឥឡូវ">
                            @(homeSettings.HeroPrimaryBtnText ?? "Shop Collection")
                        </span>
                        <i class="bi bi-arrow-right text-base group-hover:translate-x-1 transition-transform"></i>
                    </a>

                    <a href="@(homeSettings.HeroSecondaryBtnUrl ?? "/Shop")"
                       class="inline-flex items-center gap-2.5 px-7 py-4 rounded-2xl border border-gray-200 dark:border-slate-700 bg-white/70 dark:bg-slate-900/70 backdrop-blur-md text-gray-800 dark:text-slate-200 hover:border-pink-500 dark:hover:border-pink-400 hover:text-pink-600 dark:hover:text-pink-400 text-sm font-bold transition-all duration-200 hover:-translate-y-0.5 shadow-sm">
                        <i class="bi bi-compass text-pink-500 dark:text-pink-400"></i>
                        <span data-en="@homeSettings.HeroSecondaryBtnText" data-kh="ស្វែងរកផលិតផល">
                            @(homeSettings.HeroSecondaryBtnText ?? "Explore Products")
                        </span>
                    </a>
                </div>

                <!-- Colorful Trust Metrics & Achievements Bar -->
                <div class="grid grid-cols-3 gap-4 pt-8 border-t border-gray-100 dark:border-slate-800/80 max-w-lg mx-auto lg:mx-0">
                    <!-- Metric 1: Cyan/Blue -->
                    <div class="text-center lg:text-left">
                        <div class="text-2xl sm:text-3xl font-black bg-gradient-to-r from-blue-600 to-cyan-500 dark:from-blue-400 dark:to-cyan-300 bg-clip-text text-transparent">
                            @(homeSettings.Stat1Value ?? "500+")
                        </div>
                        <div class="text-xs font-semibold text-gray-500 dark:text-slate-400 mt-0.5 truncate"
                             data-en="@homeSettings.Stat1Label" data-kh="ផលិតផលម៉ូដ">
                            @(homeSettings.Stat1Label ?? "Curated Styles")
                        </div>
                    </div>

                    <!-- Metric 2: Violet/Purple -->
                    <div class="text-center lg:text-left border-x border-gray-100 dark:border-slate-800/80 px-2 sm:px-4">
                        <div class="text-2xl sm:text-3xl font-black bg-gradient-to-r from-violet-600 to-purple-500 dark:from-violet-400 dark:to-purple-300 bg-clip-text text-transparent">
                            @(homeSettings.Stat2Value ?? "50+")
                        </div>
                        <div class="text-xs font-semibold text-gray-500 dark:text-slate-400 mt-0.5 truncate"
                             data-en="@homeSettings.Stat2Label" data-kh="ម៉ាកយីហោល្បីៗ">
                            @(homeSettings.Stat2Label ?? "Top Brands")
                        </div>
                    </div>

                    <!-- Metric 3: Pink/Rose -->
                    <div class="text-center lg:text-left">
                        <div class="text-2xl sm:text-3xl font-black bg-gradient-to-r from-pink-600 to-rose-500 dark:from-pink-400 dark:to-rose-300 bg-clip-text text-transparent">
                            @(homeSettings.Stat3Value ?? "10K+")
                        </div>
                        <div class="text-xs font-semibold text-gray-500 dark:text-slate-400 mt-0.5 truncate"
                             data-en="@homeSettings.Stat3Label" data-kh="អតិថិជនពេញចិត្ត">
                            @(homeSettings.Stat3Label ?? "Happy Shoppers")
                        </div>
                    </div>
                </div>

            </div>

            <!-- HERO VISUAL SHOWCASE (5 COLS) WITH COLORFUL GLOW -->
            <div class="lg:col-span-5 order-1 lg:order-2 relative">
                <!-- Glowing Colorful Halo Behind Image -->
                <div class="absolute -inset-2 bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 rounded-3xl blur-xl opacity-30 group-hover:opacity-60 transition duration-1000"></div>

                <div class="relative rounded-3xl overflow-hidden aspect-[4/5] max-w-md mx-auto lg:max-w-none shadow-2xl border border-white/60 dark:border-slate-800 group">
                    <img src="@(string.IsNullOrEmpty(homeSettings.HeroImageUrl) ? "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1000&q=85" : homeSettings.HeroImageUrl)"
                         alt="CLOTHÉ Season Collection"
                         class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>

                    <!-- Live Lookbook Tag -->
                    <div class="absolute top-4 right-4 bg-black/40 backdrop-blur-md px-3 py-1 rounded-full border border-white/20 text-[10px] font-extrabold uppercase tracking-wider text-white flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                        <span>LOOKBOOK 2026</span>
                    </div>
                </div>

                <!-- Floating Glass Card 1 (Top Left) with Colorful Icon -->
                <div class="absolute top-8 -left-3 sm:-left-6 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl shadow-xl p-3.5 flex items-center gap-3 border border-white/70 dark:border-slate-800 animate-in fade-in slide-in-from-left duration-700">
                    <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-amber-400 to-orange-500 text-white flex items-center justify-center flex-shrink-0 text-lg shadow-md shadow-amber-500/30">
                        <i class="bi bi-stars"></i>
                    </div>
                    <div>
                        <div class="text-xs font-black text-gray-900 dark:text-white"
                             data-en="@homeSettings.FloatingCard1Title" data-kh="រដូវកាលថ្មី">
                            @(homeSettings.FloatingCard1Title ?? "New Season Drop")
                        </div>
                        <div class="text-[11px] font-semibold text-gray-500 dark:text-slate-400"
                             data-en="@homeSettings.FloatingCard1Sub" data-kh="ម៉ូដពេញនិយមទើបមកដល់">
                            @(homeSettings.FloatingCard1Sub ?? "Trending runway arrivals")
                        </div>
                    </div>
                </div>

                <!-- Floating Glass Card 2 (Bottom Right) with Colorful Icon -->
                <div class="absolute bottom-10 -right-3 sm:-right-6 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl shadow-xl p-3.5 flex items-center gap-3 border border-white/70 dark:border-slate-800 animate-in fade-in slide-in-from-right duration-700">
                    <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-emerald-400 to-teal-500 text-white flex items-center justify-center flex-shrink-0 text-lg shadow-md shadow-emerald-500/30">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div>
                        <div class="text-xs font-black text-gray-900 dark:text-white"
                             data-en="@homeSettings.FloatingCard2Title" data-kh="ដឹកជញ្ជូនរហ័សឥតគិតថ្លៃ">
                            @(homeSettings.FloatingCard2Title ?? "Free Express Delivery")
                        </div>
                        <div class="text-[11px] font-semibold text-gray-500 dark:text-slate-400"
                             data-en="@homeSettings.FloatingCard2Sub" data-kh="សម្រាប់ការបញ្ជាទិញលើស $50">
                            @(homeSettings.FloatingCard2Sub ?? "Cambodia-wide on $50+")
                        </div>
                    </div>
                </div>

                <!-- Customer Rating Pill (Bottom Left) -->
                <div class="absolute -bottom-4 left-6 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl shadow-xl px-4 py-2.5 border border-white/70 dark:border-slate-800 flex items-center gap-3">
                    <div class="flex items-center gap-0.5 text-amber-400 text-xs">
                        @for (int s = 0; s < 5; s++) { <i class="bi bi-star-fill"></i> }
                    </div>
                    <div class="text-xs font-extrabold text-gray-900 dark:text-white">4.9/5</div>
                    <span class="text-[11px] text-gray-500 dark:text-slate-400 font-medium" data-en="2.5k+ reviews" data-kh="២,៥០០+ ការវាយតម្លៃ">2.5k+ reviews</span>
                </div>

            </div>

        </div>
    </div>
</section>

<!-- =========================================================
     2. MARQUEE BANNER STRIP (HIGH ENERGY FASHION TICKER)
========================================================= -->
<div class="py-3.5 bg-slate-900 dark:bg-slate-950 text-white border-y border-slate-800 overflow-hidden select-none">
    <div class="flex whitespace-nowrap gap-8 items-center text-xs font-bold uppercase tracking-widest text-slate-300">
        <span class="flex items-center gap-2 text-pink-400"><i class="bi bi-lightning-charge-fill"></i> <span data-en="SEASON DROP 2026" data-kh="រដូវកាលថ្មី ២០២៦">SEASON DROP 2026</span></span>
        <span class="text-slate-600">&bull;</span>
        <span class="flex items-center gap-2 text-cyan-400"><i class="bi bi-shield-check"></i> <span data-en="100% AUTHENTIC FABRICS" data-kh="សាច់ក្រណាត់គុណភាពខ្ពស់ ១០០%">100% AUTHENTIC FABRICS</span></span>
        <span class="text-slate-600">&bull;</span>
        <span class="flex items-center gap-2 text-amber-400"><i class="bi bi-qr-code-scan"></i> <span data-en="BAKONG KHQR INSTANT PAY" data-kh="ទូទាត់រហ័សតាម BAKONG KHQR">BAKONG KHQR INSTANT PAY</span></span>
        <span class="text-slate-600">&bull;</span>
        <span class="flex items-center gap-2 text-emerald-400"><i class="bi bi-truck"></i> <span data-en="SAME-DAY PHNOM PENH DELIVERY" data-kh="ដឹកជញ្ជូនក្នុងថ្ងៃនៅភ្នំពេញ">SAME-DAY PHNOM PENH DELIVERY</span></span>
        <span class="text-slate-600">&bull;</span>
        <span class="flex items-center gap-2 text-purple-400"><i class="bi bi-arrow-repeat"></i> <span data-en="30-DAY EASY EXCHANGE" data-kh="ប្តូរទំនិញងាយស្រួលក្នុងរយៈពេល ៣០ ថ្ងៃ">30-DAY EASY EXCHANGE</span></span>
        <span class="text-slate-600">&bull;</span>
        <span class="flex items-center gap-2 text-pink-400"><i class="bi bi-lightning-charge-fill"></i> <span data-en="SEASON DROP 2026" data-kh="រដូវកាលថ្មី ២០២៦">SEASON DROP 2026</span></span>
    </div>
</div>

<!-- =========================================================
     3. SHOP BY STYLE / CURATED CATEGORIES
========================================================= -->
<section class="py-16 lg:py-24 bg-gray-50/70 dark:bg-slate-900/50 transition-colors duration-200">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
            <div>
                <span class="text-xs font-extrabold uppercase tracking-widest bg-gradient-to-r from-pink-600 to-purple-600 dark:from-pink-400 dark:to-purple-400 bg-clip-text text-transparent block mb-2"
                      data-en="Curated Collections" data-kh="បណ្តុំម៉ូដពិសេសៗ">
                    Curated Collections
                </span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight"
                    data-en="Shop by Style" data-kh="ស្វែងរកតាមរចនាប័ទ្ម">
                    Shop by Style
                </h2>
            </div>
            <a asp-controller="Shop" asp-action="Index"
               class="inline-flex items-center gap-2 text-sm font-bold text-indigo-600 dark:text-indigo-400 hover:text-pink-600 dark:hover:text-pink-400 transition-colors group">
                <span data-en="View All Categories" data-kh="មើលប្រភេទទាំងអស់">View All Categories</span>
                <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            @if (ViewBag.Categories != null)
            {
                int catIndex = 1;
                foreach (var category in (IEnumerable<WebApplication_ClothingEcommerce.Models.Category>)ViewBag.Categories)
                {
                    if (catIndex > 3) break;
                    string bgImage = "https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?auto=format&fit=crop&w=800&q=80";
                    var catNameLower = category.Name.ToLower();
                    if (catNameLower.Contains("women")) bgImage = "https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=800&q=80";
                    else if (catNameLower.Contains("men")) bgImage = "https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&w=800&q=80";
                    else if (catNameLower.Contains("access") || catNameLower.Contains("jewel")) bgImage = "https://images.unsplash.com/photo-1523779917675-b6ed3a42a561?auto=format&fit=crop&w=800&q=80";
                    else if (catNameLower.Contains("shoe")) bgImage = "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=800&q=80";

                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@category.Id"
                       class="group relative overflow-hidden rounded-3xl aspect-[3/4] block shadow-md hover:shadow-2xl transition-all duration-300">
                        <img src="@bgImage" alt="@category.Name"
                             class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent"></div>
                        
                        <div class="absolute inset-0 p-8 flex flex-col justify-between">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 backdrop-blur-md border border-white/20 text-[11px] font-extrabold uppercase tracking-widest text-white w-fit">
                                0@(catIndex) &middot; @category.Name.ToUpper()
                            </span>
                            
                            <div class="flex items-end justify-between gap-4">
                                <div>
                                    <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-1.5">@category.Name</h3>
                                    <span class="text-xs text-slate-200 font-semibold flex items-center gap-1 group-hover:text-amber-300 transition-colors">
                                        <span data-en="Explore Collection" data-kh="ស្វែងរកបណ្តុំម៉ូដ">Explore Collection</span> &rarr;
                                    </span>
                                </div>
                                <span class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-white group-hover:bg-gradient-to-tr group-hover:from-violet-600 group-hover:to-pink-600 transition-all duration-300 shadow-lg flex-shrink-0">
                                    <i class="bi bi-arrow-up-right text-base"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                    catIndex++;
                }
            }
            else
            {
                <div class="col-span-3 text-center py-16 text-gray-400 dark:text-slate-500">No categories found.</div>
            }
        </div>
    </div>
</section>

