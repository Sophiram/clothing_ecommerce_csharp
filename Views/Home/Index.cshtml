            <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-2"
                data-en="Follow Our Community" data-kh="ចូលរួមជាមួយសហគមន៍យើង">
                Follow Our Community
            </h2>
            <p class="text-xs text-gray-500 dark:text-slate-400">
                Tag <strong class="text-gray-800 dark:text-slate-200 font-bold">@@clothe.official</strong> for a chance to be featured on our official lookbook
            </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
            @for (int i = 0; i < instaImages.Length; i++)
            {
                var item = instaImages[i];
                <a asp-controller="Shop" asp-action="Index"
                   class="group relative overflow-hidden rounded-2xl aspect-square block shadow-sm hover:shadow-xl transition-all duration-300">
                    <img src="@item.Img" alt="@item.Tag"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                    
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between p-3.5">
                        <span class="text-[10px] font-bold text-white/80 self-end">@item.Tag</span>
                        <div class="text-center text-white">
                            <i class="bi bi-instagram text-xl block mb-1 text-pink-400"></i>
                            <span class="text-xs font-bold flex items-center gap-1 justify-center">
                                <i class="bi bi-heart-fill text-rose-500 text-[10px]"></i> @item.Likes
                            </span>
                        </div>
                    </div>
                </a>
            }
        </div>

    </div>
</section>

<!-- =========================================================
     10. VIP FASHION CLUB / NEWSLETTER
========================================================= -->
<section class="py-16 lg:py-24 bg-white dark:bg-slate-950 transition-colors duration-200">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-violet-900 via-indigo-950 to-slate-950 p-8 sm:p-12 lg:p-16 shadow-2xl border border-indigo-900/50">
            <!-- Glow Accents -->
            <div class="absolute top-0 right-0 w-96 h-96 bg-pink-500/15 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 max-w-2xl mx-auto text-center">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[11px] font-extrabold uppercase tracking-widest text-amber-300 mb-4">
                    <i class="bi bi-gem"></i> VIP PRIVILEGE
                </span>
                
                <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4"
                    data-en="Join the CLOTHÉ Club" data-kh="ចូលរួមសមាជិក CLOTHÉ Club">
                    Join the CLOTHÉ Club
                </h3>
                
                <p class="text-slate-300 text-sm leading-relaxed mb-8"
                   data-en="Subscribe for private drop notifications, exclusive lookbooks, and receive 15% off your first purchase."
                   data-kh="ចុះឈ្មោះដើម្បីទទួលបានការជូនដំណឹងអំពីម៉ូដថ្មីៗ និងទទួលបានការបញ្ចុះតម្លៃ ១៥% លើការបញ្ជាទិញលើកដំបូង។">
                    Subscribe for private drop notifications, exclusive lookbooks, and receive 15% off your first purchase.
                </p>

                <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); window.showToast ? window.showToast('success', 'Thank you for joining the VIP club!') : alert('Subscribed!');">
                    <input type="email"
                           required
                           placeholder="Enter your email address…"
                           data-placeholder-kh="បញ្ចូលអ៊ីមែលរបស់អ្នក…"
                           class="flex-1 px-4 py-3.5 rounded-2xl bg-white/10 border border-white/20 text-white placeholder-white/50 text-sm focus:outline-none focus:ring-2 focus:ring-pink-500 backdrop-blur-md" />
                    
                    <button type="submit"
                            class="px-7 py-3.5 rounded-2xl bg-gradient-to-r from-pink-600 to-violet-600 hover:from-pink-700 hover:to-violet-700 text-white text-sm font-bold shadow-lg shadow-pink-600/30 transition-all duration-200 hover:-translate-y-0.5 whitespace-nowrap">
                        <span data-en="Subscribe" data-kh="ចុះឈ្មោះ">Subscribe</span>
                    </button>
                </form>

                <p class="text-[11px] text-slate-400 mt-4">
                    <i class="bi bi-shield-lock me-1"></i> No spam. Unsubscribe at any time.
                </p>
            </div>
        </div>
    </div>
</section>
