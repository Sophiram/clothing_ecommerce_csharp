@{
    ViewData["Title"] = "About Us";
}

<section class="clothe-about">

    <!-- =========================================
         HERO
    ========================================== -->
    <div class="about-hero">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <span class="about-label">
                        ABOUT CLOTHÉ
                    </span>

                    <h1>
                        Style that feels
                        <span class="about-gradient-text">
                            like you.
                        </span>
                    </h1>

                    <p class="about-hero-text">
                        CLOTHÉ is a modern clothing store built around
                        simple design, quality materials, and effortless
                        everyday fashion.
                    </p>

                    <div class="about-buttons">

                        <!-- REDIRECT TO SHOP -->
                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="about-primary-btn">

                            Explore Collection

                            <i class="bi bi-arrow-right"></i>

                        </a>

                        <!-- CONTACT -->
                        <a href="#contact"
                           class="about-secondary-btn">

                            Contact Us

                            <i class="bi bi-arrow-down ms-1"></i>

                        </a>

                    </div>

                </div>


                <div class="col-lg-6">

                    <div class="about-image-wrapper">

                        <div class="about-color-dot dot-blue"></div>
                        <div class="about-color-dot dot-red"></div>
                        <div class="about-color-dot dot-yellow"></div>
                        <div class="about-color-dot dot-green"></div>

                        <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=1200&auto=format&fit=crop"
                             alt="CLOTHÉ Fashion Store"
                             class="about-main-image" />

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         INTRODUCTION
    ========================================== -->
    <div class="about-introduction">

        <div class="container">

            <div class="about-section-heading">

                <span>OUR STORY</span>

                <h2>
                    Fashion doesn't have to be complicated.
                </h2>

                <p>
                    We created CLOTHÉ with one simple idea:
                    everyday clothing should be comfortable,
                    stylish, and easy to choose.
                </p>

            </div>


            <div class="row g-4 mt-4">

                <!-- SIMPLE -->
                <div class="col-md-4">

                    <div class="about-story-card">

                        <div class="about-icon blue-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <h3>
                            Simple
                        </h3>

                        <p>
                            Clean designs that fit naturally
                            into your everyday wardrobe.
                        </p>

                    </div>

                </div>


                <!-- COMFORTABLE -->
                <div class="col-md-4">

                    <div class="about-story-card">

                        <div class="about-icon red-icon">
                            <i class="bi bi-heart"></i>
                        </div>

                        <h3>
                            Comfortable
                        </h3>

                        <p>
                            We believe looking good should
                            never mean sacrificing comfort.
                        </p>

                    </div>

                </div>


                <!-- QUALITY -->
                <div class="col-md-4">

                    <div class="about-story-card">

                        <div class="about-icon green-icon">
                            <i class="bi bi-gem"></i>
                        </div>

                        <h3>
                            Quality
                        </h3>

                        <p>
                            Carefully selected materials made
                            to become part of your wardrobe.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         VALUES
    ========================================== -->
    <div class="about-values">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-5">

                    <span class="about-label">
                        WHAT WE BELIEVE
                    </span>

                    <h2>
                        Designed for
                        <span class="about-green-text">
                            real life.
                        </span>
                    </h2>

                    <p>
                        From casual essentials to statement pieces,
                        every CLOTHÉ collection is designed to make
                        getting dressed easier.
                    </p>

                </div>


                <div class="col-lg-7">

                    <div class="value-list">

                        <!-- VALUE 01 -->
                        <div class="value-item">

                            <span class="value-number blue-number">
                                01
                            </span>

                            <div>

                                <h4>
                                    Quality First
                                </h4>

                                <p>
                                    We focus on products that provide
                                    lasting comfort and value.
                                </p>

                            </div>

                        </div>


                        <!-- VALUE 02 -->
                        <div class="value-item">

                            <span class="value-number red-number">
                                02
                            </span>

                            <div>

                                <h4>
                                    Modern Style
                                </h4>

                                <p>
                                    Timeless designs inspired by
                                    contemporary fashion.
                                </p>

                            </div>

                        </div>


                        <!-- VALUE 03 -->
                        <div class="value-item">

                            <span class="value-number yellow-number">
                                03
                            </span>

                            <div>

                                <h4>
                                    Customer First
                                </h4>

                                <p>
                                    Your shopping experience matters
                                    from discovery to delivery.
                                </p>

                            </div>

                        </div>


                        <!-- VALUE 04 -->
                        <div class="value-item">

                            <span class="value-number green-number">
                                04
                            </span>

                            <div>

                                <h4>
                                    Everyday Confidence
                                </h4>

                                <p>
                                    Clothing that helps you feel
                                    confident wherever you go.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         STATS
    ========================================== -->
    <div class="about-stats">

        <div class="container">

            <div class="stats-card">

                <div class="row g-4 text-center">

                    <!-- CUSTOMERS -->
                    <div class="col-6 col-lg-3">

                        <div class="stat-number blue-text">
                            10K+
                        </div>

                        <div class="stat-label">
                            Happy Customers
                        </div>

                    </div>


                    <!-- PRODUCTS -->
                    <div class="col-6 col-lg-3">

                        <div class="stat-number red-text">
                            500+
                        </div>

                        <div class="stat-label">
                            Products
                        </div>

                    </div>


                    <!-- FEEDBACK -->
                    <div class="col-6 col-lg-3">

                        <div class="stat-number yellow-text">
                            99%
                        </div>

                        <div class="stat-label">
                            Positive Feedback
                        </div>

                    </div>


                    <!-- SUPPORT -->
                    <div class="col-6 col-lg-3">

                        <div class="stat-number green-text">
                            24/7
                        </div>

                        <div class="stat-label">
                            Customer Support
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
     CONTACT US
========================================= -->
    <section id="contact" class="about-contact">

        <div class="container">

            <!-- SECTION HEADER -->
            <div class="contact-section-header text-center">

                <span class="about-label">
                    CONTACT CLOTHÉ
                </span>

                <h2>
                    We'd love to
                    <span class="about-gradient-text">
                        hear from you.
                    </span>
                </h2>

                <p>
                    Have a question about our products, your order,
                    delivery, or anything else? Get in touch with us.
                </p>

            </div>


            <div class="contact-wrapper">

                <!-- =========================================
                 LEFT - CONTACT INFORMATION
            ========================================== -->
                <div class="contact-information">

                    <div class="contact-info-content">

                        <span class="contact-small-label">
                            GET IN TOUCH
                        </span>

                        <h3>
                            Let's talk about
                            <span>style.</span>
                        </h3>

                        <p>
                            Our team is always ready to help you find
                            the perfect style and answer your questions.
                        </p>


                        <!-- EMAIL -->
                        <a href="mailto:hello@clothe.com"
                           class="contact-item">

                            <div class="contact-item-icon contact-blue">
                                <i class="bi bi-envelope"></i>
                            </div>

                            <div class="contact-item-content">

                                <small>
                                    EMAIL
                                </small>

                                <strong>
                                    hello@clothe.com
                                </strong>

                            </div>

                            <i class="bi bi-arrow-up-right contact-arrow"></i>

                        </a>


                        <!-- PHONE -->
                        <a href="tel:+85512345678"
                           class="contact-item">

                            <div class="contact-item-icon contact-red">
                                <i class="bi bi-telephone"></i>
                            </div>

                            <div class="contact-item-content">

                                <small>
                                    PHONE
                                </small>

                                <strong>
                                    +855 12 345 678
                                </strong>

                            </div>

                            <i class="bi bi-arrow-up-right contact-arrow"></i>

                        </a>


                        <!-- LOCATION -->
                        <div class="contact-item">

                            <div class="contact-item-icon contact-yellow">
                                <i class="bi bi-geo-alt"></i>
                            </div>

                            <div class="contact-item-content">

                                <small>
                                    LOCATION
                                </small>

                                <strong>
                                    Phnom Penh, Cambodia
                                </strong>

                            </div>

                        </div>


                        <!-- SOCIAL -->
                        <div class="contact-social">

                            <span>
                                FOLLOW CLOTHÉ
                            </span>

                            <div class="contact-social-links">

                                <a href="#" aria-label="Facebook">
                                    <i class="bi bi-facebook"></i>
                                </a>

                                <a href="#" aria-label="Instagram">
                                    <i class="bi bi-instagram"></i>
                                </a>

                                <a href="#" aria-label="Telegram">
                                    <i class="bi bi-telegram"></i>
                                </a>

                                <a href="#" aria-label="TikTok">
                                    <i class="bi bi-tiktok"></i>
                                </a>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =========================================
                 RIGHT - CONTACT FORM
            ========================================== -->
                <div class="contact-form-wrapper">

                    <div class="contact-form-header">

                        <div>

                            <span>
                                SEND A MESSAGE
                            </span>

                            <h3>
                                How can we help?
                            </h3>

                        </div>

                        <div class="contact-form-icon">
                            <i class="bi bi-chat-heart"></i>
                        </div>

                    </div>


                    <form>

                        <div class="row g-4">

                            <!-- NAME -->
                            <div class="col-md-6">

                                <label class="contact-form-label">
                                    Your Name
                                </label>

                                <input type="text"
                                       class="form-control contact-input"
                                       placeholder="Enter your name" />

                            </div>


                            <!-- EMAIL -->
                            <div class="col-md-6">

                                <label class="contact-form-label">
                                    Email Address
                                </label>

                                <input type="email"
                                       class="form-control contact-input"
                                       placeholder="Enter your email" />

                            </div>


                            <!-- SUBJECT -->
                            <div class="col-12">

                                <label class="contact-form-label">
                                    Subject
                                </label>

                                <input type="text"
                                       class="form-control contact-input"
                                       placeholder="What can we help you with?" />

                            </div>


                            <!-- MESSAGE -->
                            <div class="col-12">

                                <label class="contact-form-label">
                                    Message
                                </label>

                                <textarea class="form-control contact-input contact-textarea"
                                          rows="5"
                                          placeholder="Tell us how we can help..."></textarea>

                            </div>


                            <!-- BUTTON -->
                            <div class="col-12">

                                <button type="button"
                                        class="contact-submit-btn">

                                    <span>
                                        Send Message
                                    </span>

                                    <i class="bi bi-arrow-up-right"></i>

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </section>

    <!-- =========================================
         CTA
    ========================================== -->
    <section class="about-cta">

        <div class="container">

            <div class="cta-card">

                <span class="about-label">
                    FIND YOUR STYLE
                </span>

                <h2>
                    Your wardrobe.
                    <span>
                        Your way.
                    </span>
                </h2>

                <p>
                    Discover clothing made for your everyday moments.
                </p>


                <!-- REDIRECT TO SHOP -->
                <a asp-controller="Shop"
                   asp-action="Index"
                   class="about-primary-btn">

                    Shop CLOTHÉ

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </section>

</section>
