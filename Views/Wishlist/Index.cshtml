@model WebApplication_ClothingEcommerce.Models.Wishlist

@{
    ViewData["Title"] = "Wishlist";
    ViewData["AccountActiveSection"] = "Wishlist";
    var itemCount = Model?.Items?.Count ?? 0;
}

<div class="min-h-[85vh] bg-slate-50 dark:bg-slate-950 py-8 lg:py-12 transition-colors duration-200">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-6">

        <!-- 4-Tab Customer Account Navigation -->
        <partial name="_AccountNav" />

        <!-- HERO BANNER -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-950 text-white p-6 sm:p-8 lg:p-10 mb-8 shadow-xl border border-slate-700/50">
            <!-- Glow background effect -->
            <div class="absolute -top-24 -right-24 w-80 h-80 bg-rose-500/15 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs font-semibold uppercase tracking-wider mb-3">
                        <i class="bi bi-heart-fill text-rose-400"></i>
                        <span data-en="Saved Favorites" data-kh="ទំនិញដែលបានរក្សាទុក">Saved Favorites</span>
                    </div>
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white mb-2">
                        <span data-en="My Wishlist" data-kh="បញ្ជីប្រាថ្នារបស់ខ្ញុំ">My Wishlist</span>
                    </h1>
                    <p class="text-sm sm:text-base text-slate-300 max-w-xl"
                       data-en="Save pieces you love, compare styles, and move them directly to your shopping bag when ready."
                       data-kh="រក្សាទុកម៉ូដដែលអ្នកស្រលាញ់ ប្រៀបធៀបរចនាបថ និងផ្ទេរវាទៅកន្ត្រកទិញទំនិញនៅពេលរួចរាល់។">
                        Save pieces you love, compare styles, and move them directly to your shopping bag when ready.
                    </p>
                </div>

                <div class="flex items-center gap-3 self-start md:self-center">
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        <form asp-controller="Wishlist" asp-action="Clear" method="post" onsubmit="return confirm('Are you sure you want to clear your entire wishlist?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-rose-300 hover:text-white bg-white/5 hover:bg-rose-500/20 border border-rose-400/30 transition-all duration-200 shadow-sm">
                                <i class="bi bi-trash3"></i>
                                <span data-en="Clear Wishlist" data-kh="សម្អាតបញ្ជីទាំងអស់">Clear Wishlist</span>
                            </button>
                        </form>
                    }
                    <div class="hidden md:flex items-center justify-center w-16 h-16 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 text-rose-400 text-2xl shadow-inner">
                        <i class="bi bi-heart-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- ALERTS -->
        @if (TempData["Success"] != null)
        {
            <div class="flex items-center justify-between gap-3 p-4 mb-6 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 shadow-sm">
                <div class="flex items-center gap-3">
                    <i class="bi bi-check-circle-fill text-xl text-emerald-500"></i>
                    <span class="text-sm font-medium">@TempData["Success"]</span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-300 p-1">
                    <i class="bi bi-x-lg text-xs"></i>
                </button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="flex items-center justify-between gap-3 p-4 mb-6 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200 shadow-sm">
                <div class="flex items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill text-xl text-rose-500"></i>
                    <span class="text-sm font-medium">@TempData["Error"]</span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 dark:hover:text-rose-300 p-1">
                    <i class="bi bi-x-lg text-xs"></i>
                </button>
            </div>
        }

        <!-- EMPTY STATE -->
        @if (Model?.Items == null || !Model.Items.Any())
        {
            <div class="bg-white dark:bg-slate-900 rounded-3xl border border-gray-200/80 dark:border-slate-800 p-8 sm:p-12 text-center shadow-sm max-w-2xl mx-auto my-6">
                <div class="w-20 h-20 rounded-full bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 text-rose-500 flex items-center justify-center mx-auto mb-5 text-3xl shadow-sm">
                    <i class="bi bi-heart"></i>
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white mb-2"
                    data-en="Your wishlist is empty" data-kh="បញ្ជីប្រាថ្នារបស់អ្នកនៅទទេ">
                    Your wishlist is empty
                </h3>
                <p class="text-sm text-gray-500 dark:text-slate-400 mb-6 max-w-md mx-auto"
                   data-en="Explore our newest collections and tap the heart icon on any piece to save it for easy access later."
                   data-kh="ស្វែងរកបណ្តុំម៉ូដថ្មីៗរបស់យើង ហើយចុចលើរូបបេះដូងដើម្បីរក្សាទុកសម្រាប់ងាយស្រួលទិញពេលក្រោយ។">
                    Explore our newest collections and tap the heart icon on any piece to save it for easy access later.
                </p>
                <a asp-controller="Shop" asp-action="Index"
                   class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-lg hover:shadow-xl transition-all duration-200">
                    <i class="bi bi-bag"></i>
                    <span data-en="Browse Products" data-kh="រុករកទំនិញទាំងអស់">Browse Products</span>
                </a>
            </div>
        }
        else
        {
            <!-- WISHLIST TOOLBAR -->
            <div class="flex items-center justify-between mb-6 pb-2 border-b border-gray-200 dark:border-slate-800">
                <span class="text-sm font-semibold text-gray-600 dark:text-slate-400">
                    <span data-en="Showing" data-kh="បង្ហាញ">Showing</span>
                    <strong class="text-gray-900 dark:text-white">@itemCount</strong>
                    <span data-en="@(itemCount == 1 ? "saved item" : "saved items")" data-kh="ទំនិញដែលបានរក្សាទុក">@(itemCount == 1 ? "saved item" : "saved items")</span>
                </span>
            </div>

            <!-- WISHLIST GRID -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                @foreach (var item in Model.Items)
                {
                    var product = item.Variant?.Product;
                    var image = product?.Images?.FirstOrDefault(x => x.IsPrimary)
                                ?? product?.Images?.FirstOrDefault();
                    var inStock = (item.Variant?.Inventory?.AvailableQuantity ?? 0) > 0;

                    <div class="group bg-white dark:bg-slate-900 rounded-2xl border border-gray-200/80 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
                        
                        <!-- Image Container -->
                        <div class="relative aspect-[3/4] bg-slate-100 dark:bg-slate-800 overflow-hidden">
                            <!-- Remove Wishlist Button -->
                            <form asp-controller="Wishlist" asp-action="Remove" method="post" class="absolute top-2.5 right-2.5 z-10">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit"
                                        class="w-8 h-8 rounded-full bg-white/90 dark:bg-slate-800/90 backdrop-blur text-gray-500 dark:text-slate-400 hover:text-rose-600 hover:bg-white dark:hover:bg-slate-700 shadow-sm flex items-center justify-center transition-transform duration-200 hover:scale-110"
                                        title="Remove from wishlist" aria-label="Remove item">
                                    <i class="bi bi-x-lg text-xs"></i>
                                </button>
                            </form>

                            <!-- Stock Badge -->
                            <div class="absolute top-2.5 left-2.5 z-10">
                                @if (inStock)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100/90 dark:bg-emerald-900/80 text-emerald-800 dark:text-emerald-200 backdrop-blur"
                                          data-en="In Stock" data-kh="មានក្នុងស្តុក">In Stock</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100/90 dark:bg-rose-900/80 text-rose-800 dark:text-rose-200 backdrop-blur"
                                          data-en="Sold Out" data-kh="អស់ពីស្តុក">Sold Out</span>
                                }
                            </div>

                            <!-- Product Thumbnail -->
                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Variant?.ProductId" class="block w-full h-full">
                                @if (!string.IsNullOrEmpty(image?.ImageUrl))
                                {
                                    <img src="@image.ImageUrl" alt="@product?.Name"
                                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center text-gray-400 dark:text-slate-600">
                                        <i class="bi bi-image text-3xl"></i>
                                    </div>
                                }
                            </a>
                        </div>

                        <!-- Card Content -->
                        <div class="p-4 flex flex-col flex-1 justify-between gap-3">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">
                                    @(product?.Brand?.Name ?? "CLOTHÉ")
                                </span>

                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Variant?.ProductId" class="block group-hover:text-blue-600 transition-colors">
                                    <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100 truncate mt-0.5" title="@product?.Name">
                                        @(product?.Name ?? "Product Item")
                                    </h3>
                                </a>

                                <!-- Variant Badges -->
                                <div class="flex flex-wrap items-center gap-1.5 mt-2">
                                    @if (item.Variant?.Size != null)
                                    {
                                        <span class="text-[10px] font-medium px-2 py-0.5 rounded-md bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-300 border border-gray-200/60 dark:border-slate-700">
                                            @item.Variant.Size.Name
                                        </span>
                                    }
                                    @if (item.Variant?.Color != null)
                                    {
                                        <span class="text-[10px] font-medium px-2 py-0.5 rounded-md bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-300 border border-gray-200/60 dark:border-slate-700 flex items-center gap-1">
                                            @if (!string.IsNullOrEmpty(item.Variant.Color.HexCode))
                                            {
                                                <span class="w-2 h-2 rounded-full inline-block border border-gray-300 dark:border-slate-600" style="background-color: @item.Variant.Color.HexCode;"></span>
                                            }
                                            @item.Variant.Color.Name
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="pt-2 border-t border-gray-100 dark:border-slate-800 space-y-2.5">
                                <div class="text-base sm:text-lg font-bold text-gray-900 dark:text-white">
                                    $@(item.Variant?.Price.ToString("N2") ?? "0.00")
                                </div>

                                <div class="flex flex-col gap-2">
                                    <form asp-controller="Wishlist" asp-action="MoveToCart" asp-route-id="@item.Id" method="post" class="w-full">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
                                                @(inStock ? "" : "disabled")>
                                            <i class="bi bi-bag-plus"></i>
                                            <span data-en="Move to Bag" data-kh="ផ្ទេរទៅកន្ត្រក">Move to Bag</span>
                                        </button>
                                    </form>

                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Variant?.ProductId"
                                       class="w-full inline-flex items-center justify-center px-3 py-1.5 rounded-xl text-xs font-medium text-gray-700 dark:text-slate-300 bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors">
                                        <span data-en="View Details" data-kh="មើលព័ត៌មានលម្អិត">View Details</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
