@model WebApplication_ClothingEcommerce.Models.Wishlist

@{
    ViewData["Title"] = "Wishlist";
}

<!-- =========================================================
     BREADCRUMB & TOP HEADER
========================================================= -->
<section class="py-3 bg-light border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-controller="Shop" asp-action="Index" class="text-decoration-none text-secondary">
                        <i class="bi bi-shop me-1"></i> Shop
                    </a>
                </li>
                <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">
                    My Wishlist
                </li>
            </ol>
        </nav>
    </div>
</section>

<section class="py-5 bg-light min-vh-100">
    <div class="container">

        <!-- HEADER HERO -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="text-uppercase text-primary fw-bold small mb-1 tracking-wider">
                    SAVED ITEMS
                </div>
                <h1 class="fw-bold mb-1">
                    My Wishlist
                </h1>
                <p class="text-secondary mb-0">
                    Your favorite pieces saved for later.
                </p>
            </div>

            <div class="d-none d-md-flex bg-white text-primary rounded-circle align-items-center justify-content-center shadow-sm"
                 style="width:64px;height:64px;">
                <i class="bi bi-heart-fill fs-3 text-danger"></i>
            </div>
        </div>

        <!-- ALERTS -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-circle-fill fs-5"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- EMPTY WISHLIST STATE -->
        @if (Model?.Items == null || !Model.Items.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 text-center py-5">
                <div class="card-body p-5">
                    <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 90px; height: 90px;">
                        <i class="bi bi-heart display-5"></i>
                    </div>
                    <h3 class="fw-bold mt-2">Your wishlist is empty</h3>
                    <p class="text-secondary mb-4">
                        Save products you love here to easily find or purchase them later.
                    </p>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-dark btn-lg px-4 rounded-3 shadow-sm">
                        <i class="bi bi-bag me-2"></i> Browse Products
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- WISHLIST GRID -->
            <div class="row g-4">
                @foreach (var item in Model.Items)
                {
                    var product = item.Variant?.Product;
                    var image = product?.Images?.FirstOrDefault(x => x.IsPrimary)
                                ?? product?.Images?.FirstOrDefault();

                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">

                            <!-- REMOVE BUTTON (TOP RIGHT OVERLAY) -->
                            <form asp-controller="Wishlist"
                                  asp-action="Remove"
                                  method="post"
                                  class="position-absolute top-0 end-0 m-2 z-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit"
                                        class="btn btn-light btn-sm rounded-circle shadow-sm text-danger border-0"
                                        title="Remove from wishlist"
                                        style="width: 36px; height: 36px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>

                            <!-- PRODUCT IMAGE -->
                            <a asp-controller="Shop"
                               asp-action="Details"
                               asp-route-id="@item.Variant?.ProductId"
                               class="text-decoration-none">
                                <div class="bg-light position-relative">
                                    @if (!string.IsNullOrEmpty(image?.ImageUrl))
                                    {
                                        <img src="@image.ImageUrl"
                                             class="card-img-top"
                                             alt="@product?.Name"
                                             loading="lazy"
                                             style="height: 260px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center bg-light"
                                             style="height: 260px;">
                                            <i class="bi bi-image display-5 text-secondary"></i>
                                        </div>
                                    }
                                </div>
                            </a>

                            <!-- PRODUCT DETAILS -->
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <small class="text-uppercase text-primary fw-bold">
                                        @(product?.Brand?.Name ?? "CLOTHÉ")
                                    </small>

                                    <a asp-controller="Shop"
                                       asp-action="Details"
                                       asp-route-id="@item.Variant?.ProductId"
                                       class="text-decoration-none text-dark d-block">
                                        <h6 class="fw-bold mt-1 mb-2 text-truncate">
                                            @(product?.Name ?? "Unknown Product")
                                        </h6>
                                    </a>

                                    <div class="small text-secondary mb-2">
                                        @if (item.Variant?.Size != null)
                                        {
                                            <span class="me-2">Size: <strong>@item.Variant.Size.Name</strong></span>
                                        }
                                        @if (item.Variant?.Color != null)
                                        {
                                            <span>Color: <strong>@item.Variant.Color.Name</strong></span>
                                        }
                                    </div>
                                </div>

                                <div class="pt-2 border-top mt-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong class="fs-5 text-dark">
                                            $@(item.Variant?.Price.ToString("0.00") ?? "0.00")
                                        </strong>
                                    </div>

                                    <a asp-controller="Shop"
                                       asp-action="Details"
                                       asp-route-id="@item.Variant?.ProductId"
                                       class="btn btn-dark btn-sm w-100 rounded-3">
                                        <i class="bi bi-eye me-1"></i> View Options
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>