@model WebApplication_ClothingEcommerce.Models.Wishlist

@{
    ViewData["Title"] = "Wishlist";
    ViewData["AccountActiveSection"] = "Wishlist";
    var itemCount = Model?.Items?.Count ?? 0;
}

<style>
    .wishlist-page {
        background-color: #f8fafc;
        min-height: 85vh;
    }

    /* Hero Banner */
    .wishlist-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-radius: 28px;
        position: relative;
        overflow: hidden;
        color: #ffffff;
        box-shadow: 0 16px 36px -10px rgba(15, 23, 42, 0.25);
        padding: 2.25rem 2.5rem;
    }

    .wishlist-hero::before {
        content: "";
        position: absolute;
        top: -60%;
        right: -10%;
        width: 380px;
        height: 380px;
        background: radial-gradient(circle, rgba(239, 68, 68, 0.15) 0%, rgba(15, 23, 42, 0) 70%);
        pointer-events: none;
    }

    .wishlist-hero-eyebrow {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .12em;
        color: #fca5a5;
        margin-bottom: 6px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .wishlist-hero-icon {
        width: 68px;
        height: 68px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #ef4444;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }

    /* Wishlist Product Cards */
    .wishlist-card {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.06);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.02);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
    }

    .wishlist-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
    }

    .wishlist-img-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 3/4;
        overflow: hidden;
        background: #f1f5f9;
    }

    .wishlist-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .wishlist-card:hover .wishlist-img {
        transform: scale(1.05);
    }

    .wishlist-remove-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(0, 0, 0, 0.06);
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        z-index: 2;
    }

    .wishlist-remove-btn:hover {
        background: #ef4444;
        color: #ffffff;
        transform: scale(1.1);
    }

    .wishlist-stock-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 9999px;
        z-index: 2;
    }

    .stock-in {
        background: rgba(220, 252, 231, 0.95);
        color: #166534;
        backdrop-filter: blur(4px);
    }

    .stock-out {
        background: rgba(254, 226, 226, 0.95);
        color: #991b1b;
        backdrop-filter: blur(4px);
    }

    .wishlist-body {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
    }

    .btn-move-cart {
        background: #0f172a;
        color: #ffffff;
        font-weight: 700;
        font-size: 13.5px;
        padding: 10px 16px;
        border-radius: 9999px;
        border: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        transition: all 0.2s ease;
    }

    .btn-move-cart:hover:not(:disabled) {
        background: #1e293b;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
    }

    .btn-move-cart:disabled {
        background: #e2e8f0;
        color: #94a3b8;
        cursor: not-allowed;
    }

    /* Empty Box */
    .wishlist-empty-box {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.06);
        border-radius: 28px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    @@media (max-width: 768px) {
        .wishlist-hero {
            padding: 1.5rem;
            border-radius: 20px;
        }

        .wishlist-body {
            padding: 1rem;
        }
    }
</style>

<div class="wishlist-page py-4 py-lg-5">
    <div class="container">
        <partial name="_AccountNav" />

        <!-- HERO BANNER -->
        <div class="wishlist-hero mb-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4 position-relative" style="z-index: 1;">
                <div>
                    <div class="wishlist-hero-eyebrow">
                        <i class="bi bi-heart-fill"></i> SAVED FAVORITES
                    </div>
                    <h1 class="h3 fw-bold mb-1 text-white">My Wishlist</h1>
                    <p class="text-white-50 mb-0 small">
                        Save pieces you love, compare styles, and move them directly to your bag when ready.
                    </p>
                </div>

                <div class="d-flex align-items-center gap-3">
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        <form asp-controller="Wishlist" asp-action="Clear" method="post" onsubmit="return confirm('Are you sure you want to clear your entire wishlist?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light rounded-pill px-3 py-2 btn-sm fw-semibold">
                                <i class="bi bi-trash3 me-1"></i> Clear Wishlist
                            </button>
                        </form>
                    }
                    <div class="d-none d-md-flex wishlist-hero-icon">
                        <i class="bi bi-heart-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- ALERTS -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <span class="fw-medium">@TempData["Success"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <span class="fw-medium">@TempData["Error"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- EMPTY STATE -->
        @if (Model?.Items == null || !Model.Items.Any())
        {
            <div class="wishlist-empty-box text-center py-5 px-4 my-2">
                <div class="py-4">
                    <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 84px; height: 84px;">
                        <i class="bi bi-heart display-6"></i>
                    </div>
                    <h4 class="fw-bold mb-2 text-dark">Your wishlist is currently empty</h4>
                    <p class="text-secondary mx-auto mb-4" style="max-width: 440px;">
                        Explore our newest collections and tap the heart icon on any piece to save it for easy access later.
                    </p>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-dark rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-bag me-1"></i> Browse Products
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- GRID HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-secondary small fw-semibold">
                    Showing @itemCount @(itemCount == 1 ? "saved item" : "saved items")
                </span>
            </div>

            <!-- WISHLIST GRID -->
            <div class="row g-3 g-md-4">
                @foreach (var item in Model.Items)
                {
                    var product = item.Variant?.Product;
                    var image = product?.Images?.FirstOrDefault(x => x.IsPrimary)
                                ?? product?.Images?.FirstOrDefault();
                    var inStock = (item.Variant?.Inventory?.AvailableQuantity ?? 0) > 0;

                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="wishlist-card">
                            <!-- Image Container -->
                            <div class="wishlist-img-wrapper">
                                <!-- Remove Form -->
                                <form asp-controller="Wishlist" asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="wishlist-remove-btn" title="Remove from wishlist">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>

                                <!-- Stock Status Badge -->
                                <span class="wishlist-stock-badge @(inStock ? "stock-in" : "stock-out")">
                                    @(inStock ? "In Stock" : "Sold Out")
                                </span>

                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Variant?.ProductId" class="d-block w-100 h-100">
                                    @if (!string.IsNullOrEmpty(image?.ImageUrl))
                                    {
                                        <img src="@image.ImageUrl" class="wishlist-img" alt="@product?.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center w-100 h-100 text-secondary">
                                            <i class="bi bi-image display-6"></i>
                                        </div>
                                    }
                                </a>
                            </div>

                            <!-- Body -->
                            <div class="wishlist-body">
                                <div>
                                    <small class="text-uppercase text-primary fw-bold tracking-wider" style="font-size: 10.5px;">
                                        @(product?.Brand?.Name ?? "CLOTHÉ")
                                    </small>

                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Variant?.ProductId" class="text-decoration-none text-dark d-block">
                                        <h6 class="fw-bold mt-1 mb-2 text-truncate" title="@product?.Name">
                                            @(product?.Name ?? "Product Item")
                                        </h6>
                                    </a>

                                    <div class="d-flex flex-wrap gap-1 small text-secondary mb-2">
                                        @if (item.Variant?.Size != null)
                                        {
                                            <span class="badge bg-light text-secondary border">
                                                Size: @item.Variant.Size.Name
                                            </span>
                                        }
                                        @if (item.Variant?.Color != null)
                                        {
                                            <span class="badge bg-light text-secondary border">
                                                Color: @item.Variant.Color.Name
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="pt-2 mt-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <strong class="fs-5 text-dark fw-bold">
                                            $@(item.Variant?.Price.ToString("N2") ?? "0.00")
                                        </strong>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <form asp-controller="Wishlist" asp-action="MoveToCart" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-move-cart" @(inStock ? "" : "disabled")>
                                                <i class="bi bi-bag-plus"></i>
                                                <span>Move to Bag</span>
                                            </button>
                                        </form>

                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Variant?.ProductId" class="btn btn-outline-dark btn-sm rounded-pill">
                                            View Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
