@model WebApplication_ClothingEcommerce.Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";

    var paymentMethods =
        ViewBag.PaymentMethods
        as List<WebApplication_ClothingEcommerce.Models.PaymentMethod>
        ?? new List<WebApplication_ClothingEcommerce.Models.PaymentMethod>();
}

<div class="container py-5">

    <div class="row g-4">

        <!-- ========================= -->
        <!-- CHECKOUT FORM -->
        <!-- ========================= -->

        <div class="col-lg-8">

            <form asp-action="Index"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- CUSTOMER -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-body p-4">

                        <h4 class="mb-4">
                            Customer Information
                        </h4>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="FirstName"
                                       class="form-label">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="LastName"
                                       class="form-label">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Phone"
                                       class="form-label">
                                    Phone
                                </label>

                                <input asp-for="Phone"
                                       class="form-control" />

                                <span asp-validation-for="Phone"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Email"
                                       class="form-label">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ========================= -->
                <!-- SHIPPING ADDRESS -->
                <!-- ========================= -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-body p-4">

                        <h4 class="mb-4">
                            Shipping Address
                        </h4>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="Province"
                                       class="form-label">
                                    Province
                                </label>

                                <input asp-for="Province"
                                       class="form-control" />

                            </div>

                            <div class="col-md-6">

                                <label asp-for="City"
                                       class="form-label">
                                    City
                                </label>

                                <input asp-for="City"
                                       class="form-control" />

                            </div>

                            <div class="col-md-8">

                                <label asp-for="Street"
                                       class="form-label">
                                    Street
                                </label>

                                <input asp-for="Street"
                                       class="form-control" />

                            </div>

                            <div class="col-md-4">

                                <label asp-for="PostalCode"
                                       class="form-label">
                                    Postal Code
                                </label>

                                <input asp-for="PostalCode"
                                       class="form-control" />

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ========================= -->
                <!-- PAYMENT METHOD -->
                <!-- ========================= -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-body p-4">

                        <h4 class="mb-4">
                            Payment Method
                        </h4>

                        @if (paymentMethods.Count == 0)
                        {
                            <div class="alert alert-warning">
                                No payment methods are currently available.
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">

                                @foreach (var method in paymentMethods)
                                {
                                    <div class="col-md-6">

                                        <label class="payment-method-card
                                            d-flex
                                            align-items-center
                                            gap-3
                                            p-3
                                            border
                                            rounded-3
                                            h-100">

                                            <input type="radio"
                                                   asp-for="PaymentMethodId"
                                                   value="@method.Id"
                                                   class="form-check-input" />

                                            @if (!string.IsNullOrWhiteSpace(method.Icon))
                                            {
                                                <img src="@method.Icon"
                                                     alt="@method.Name"
                                                     style="width:45px;height:45px;object-fit:contain;" />
                                            }

                                            <div>

                                                <div class="fw-semibold">
                                                    @method.Name
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(method.Description))
                                                {
                                                    <small class="text-muted">
                                                        @method.Description
                                                    </small>
                                                }

                                            </div>

                                        </label>

                                    </div>
                                }

                            </div>
                        }

                        <span asp-validation-for="PaymentMethodId"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <button type="submit"
                        class="btn btn-dark btn-lg w-100">

                    Place Order

                </button>

            </form>

        </div>


        <!-- ========================= -->
        <!-- ORDER SUMMARY -->
        <!-- ========================= -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h4 class="mb-4">
                        Order Summary
                    </h4>

                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex gap-3 mb-3">

                            <img src="@item.ImageUrl"
                                 alt="@item.ProductName"
                                 style="width:70px;height:85px;object-fit:cover;border-radius:8px;" />

                            <div class="flex-grow-1">

                                <div class="fw-semibold">
                                    @item.ProductName
                                </div>

                                <small class="text-muted">
                                    @item.Size / @item.Color
                                </small>

                                <div>
                                    @item.Quantity ×
                                    @item.UnitPrice.ToString("C")
                                </div>

                            </div>

                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Subtotal
                        </span>

                        <strong>
                            @Model.SubTotal.ToString("C")
                        </strong>

                    </div>

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Delivery
                        </span>

                        <strong>
                            @Model.DeliveryFee.ToString("C")
                        </strong>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <strong class="fs-5">
                            Total
                        </strong>

                        <strong class="fs-5">
                            @Model.Total.ToString("C")
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}