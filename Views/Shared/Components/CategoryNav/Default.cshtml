@model IEnumerable<WebApplication_ClothingEcommerce.Models.Category>

<li class="nav-item dropdown categories-dropdown">

    <a class="clothe-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
        <i class="bi bi-grid-fill" style="font-size: 0.8rem;" aria-hidden="true"></i>
        <span>Categories</span>
    </a>

    <ul class="dropdown-menu categories-dropdown-menu">

        <li>
            <a class="dropdown-item categories-dropdown-all"
               asp-controller="Shop"
               asp-action="Index">
                <i class="bi bi-collection-fill" aria-hidden="true"></i>
                <span>All Collections</span>
            </a>
        </li>

        @if (Model != null && Model.Any())
        {
            <li><hr class="dropdown-divider categories-divider" /></li>

            @foreach (var category in Model)
            {
                <li>
                    <a class="dropdown-item categories-dropdown-item"
                       asp-controller="Shop"
                       asp-action="Index"
                       asp-route-categoryId="@category.Id">
                        <span>@category.Name</span>
                        <i class="bi bi-chevron-right categories-dropdown-arrow" aria-hidden="true"></i>
                    </a>
                </li>
            }
        }
        else
        {
            <li><hr class="dropdown-divider categories-divider" /></li>
            <li>
                <div class="categories-dropdown-empty">
                    <i class="bi bi-inboxes" aria-hidden="true"></i>
                    <span>No categories yet</span>
                </div>
            </li>
        }

    </ul>

</li>

<style>
    .categories-dropdown-menu {
        min-width: 220px;
        padding: 8px;
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 14px;
        box-shadow: 0 8px 30px -6px rgba(15, 23, 42, 0.13), 0 2px 8px -2px rgba(15, 23, 42, 0.05);
        margin-top: 8px !important;
        animation: menu-slide-down 0.18s ease-out;
    }

    .categories-dropdown-menu .dropdown-item {
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
        display: flex;
        align-items: center;
        gap: 9px;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .categories-dropdown-menu .dropdown-item i {
        font-size: 0.9rem;
        color: #6b7280;
        flex-shrink: 0;
        transition: color 0.15s ease;
    }

    .categories-dropdown-all {
        font-weight: 600 !important;
        color: #0f172a !important;
    }

    .categories-dropdown-item {
        justify-content: space-between;
    }

    .categories-dropdown-arrow {
        opacity: 0;
        transform: translateX(-4px);
        transition: opacity 0.15s ease, transform 0.15s ease;
        font-size: 0.7rem !important;
        color: #9ca3af !important;
    }

    .categories-dropdown-menu .dropdown-item:hover,
    .categories-dropdown-menu .dropdown-item:focus-visible {
        background-color: #f3f4f6;
        color: #0f172a;
    }

    .categories-dropdown-menu .dropdown-item:hover i,
    .categories-dropdown-menu .dropdown-item:focus-visible i {
        color: #0f172a;
    }

    .categories-dropdown-item:hover .categories-dropdown-arrow {
        opacity: 1;
        transform: translateX(0);
    }

    .categories-dropdown-empty {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px;
        color: #9ca3af;
        font-size: 0.8125rem;
    }

    .categories-divider {
        margin: 4px 0;
        border-color: #f3f4f6;
    }

    @@media (min-width: 992px) {
        .categories-dropdown-menu {
            max-height: 420px;
            overflow-y: auto;
        }
    }
</style>