@inject WebApplication_ClothingEcommerce.Data.AppDbContext DbContext

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    int userCartCount = 0;
    int userWishlistCount = 0;
    string userDisplayName = "My Account";
    string userFirstName = "";
    string userFirstLetter = "U";
    string userEmail = "";
    string? userAvatarUrl = null;
    bool isAdmin = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        userEmail = User.Identity.Name ?? "";
        isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");

        try
        {
            var appUser = DbContext.Users.FirstOrDefault(u => u.Email == userEmail);
            if (appUser != null)
            {
                var avatarFolder = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "uploads", "avatars");
                if (System.IO.Directory.Exists(avatarFolder))
                {
                    var files = System.IO.Directory.GetFiles(avatarFolder, $"{appUser.Id}.*");
                    if (files.Length > 0)
                    {
                        var fi = new System.IO.FileInfo(files[0]);
                        userAvatarUrl = $"/uploads/avatars/{System.IO.Path.GetFileName(files[0])}?v={fi.LastWriteTimeUtc.Ticks}";
                    }
                }
            }

            var customer = DbContext.Customers.FirstOrDefault(c => c.Email == userEmail);
            if (customer != null)
            {
                if (!string.IsNullOrWhiteSpace(customer.FirstName))
                {
                    userFirstName = customer.FirstName;
                    userDisplayName = $"{customer.FirstName} {customer.LastName}".Trim();
                    userFirstLetter = customer.FirstName.Substring(0, 1).ToUpper();
                }
                else
                {
                    userFirstName = userEmail.Split('@')[0];
                    userDisplayName = userFirstName;
                    userFirstLetter = !string.IsNullOrEmpty(userDisplayName) ? userDisplayName.Substring(0, 1).ToUpper() : "U";
                }

                userCartCount = DbContext.CartItems
                    .Where(ci => ci.Cart.CustomerId == customer.Id)
                    .Sum(ci => (int?)ci.Quantity) ?? 0;

                userWishlistCount = DbContext.WishlistItems
                    .Count(wi => wi.Wishlist.CustomerId == customer.Id);
            }
            else
            {
                userFirstName = userEmail.Split('@')[0];
                userDisplayName = userFirstName;
                userFirstLetter = !string.IsNullOrEmpty(userDisplayName) ? userDisplayName.Substring(0, 1).ToUpper() : "U";
            }
        }
        catch
        {
            userFirstName = userEmail.Split('@')[0];
            userDisplayName = userFirstName;
            userFirstLetter = "U";
        }
    }

    if (ViewBag.CartCount != null)
    {
        int parsedCount = 0;
        if (int.TryParse(Convert.ToString(ViewBag.CartCount), out parsedCount) && parsedCount > 0)
        {
            userCartCount = parsedCount;
        }
    }

    var navCategories = new List<WebApplication_ClothingEcommerce.Models.Category>();
    var layoutHomeSettings = new WebApplication_ClothingEcommerce.Models.HomePageSettings();
    try
    {
        navCategories = DbContext.Categories.OrderBy(c => c.Name).ToList();
        layoutHomeSettings = DbContext.HomePageSettings.FirstOrDefault() ?? layoutHomeSettings;
    }
    catch { }
}
<!DOCTYPE html>
<html lang="en" class="">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CLOTHÉ</title>

    <!-- Google Fonts: Inter + Kantumruy Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800;1,14..32,400&family=Kantumruy+Pro:ital,wght@0,100..700;1,100..700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons (icon library only, no Bootstrap CSS) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Compiled Standalone Tailwind CSS (Full utility set, responsive, dark mode, Kantumruy Pro) -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />


    <!-- Theme & i18n engine (runs before DOM paint to avoid flash) -->
    <script src="~/js/site-theme-i18n.js" asp-append-version="true"></script>

    <!-- Override theme engine to use Tailwind dark class -->
    <script>
        (function () {
            var stored = localStorage.getItem('site_theme');
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var isDark = stored === 'dark' || (!stored && prefersDark);
            if (isDark) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
</head>

<body>

<!-- =========================================================
     PROMO BAR
========================================================= -->
<div id="promoBar" class="promo-bar">
    <div class="flex items-center gap-2 flex-wrap">
        <span class="px-2 py-0.5 bg-yellow-400 text-yellow-900 text-[10px] font-bold uppercase rounded-full tracking-wide"
              data-en="@layoutHomeSettings.PromoTag" data-kh="លក់ប្រូម៉ូសិន">@layoutHomeSettings.PromoTag</span>
        <span class="text-slate-300" data-en="@layoutHomeSettings.PromoText" data-kh="បណ្តុំរដូវកាល — បញ្ចុះតម្លៃរហូតដល់ ៤០%!">@layoutHomeSettings.PromoText</span>
    </div>

    <!-- Countdown -->
    <div class="flex items-center gap-1.5 flex-shrink-0" id="promoCountdown">
        <div class="flex flex-col items-center bg-white/10 rounded-lg px-2 py-0.5 min-w-[32px]">
            <span id="cd-h" class="text-sm font-bold leading-tight">00</span>
            <span class="text-[8px] text-slate-400 uppercase">H</span>
        </div>
        <span class="text-slate-500">:</span>
        <div class="flex flex-col items-center bg-white/10 rounded-lg px-2 py-0.5 min-w-[32px]">
            <span id="cd-m" class="text-sm font-bold leading-tight">00</span>
            <span class="text-[8px] text-slate-400 uppercase">M</span>
        </div>
        <span class="text-slate-500">:</span>
        <div class="flex flex-col items-center bg-white/10 rounded-lg px-2 py-0.5 min-w-[32px]">
            <span id="cd-s" class="text-sm font-bold leading-tight">00</span>
            <span class="text-[8px] text-slate-400 uppercase">S</span>
        </div>
    </div>

    <div class="flex items-center gap-3 flex-shrink-0">
        <a href="@layoutHomeSettings.PromoCtaUrl"
           class="hidden sm:inline-flex items-center gap-1 text-yellow-400 hover:text-yellow-300 font-semibold text-xs transition-colors">
            <span data-en="@layoutHomeSettings.PromoCtaText" data-kh="ទិញឥឡូវនេះ">@layoutHomeSettings.PromoCtaText</span>
            <i class="bi bi-arrow-right-short"></i>
        </a>
        <button id="promoBarClose" type="button" aria-label="Dismiss"
                class="text-slate-400 hover:text-white transition-colors p-0.5">
            <i class="bi bi-x-lg text-xs"></i>
        </button>
    </div>
</div>

<!-- =========================================================
     NAVBAR
========================================================= -->
<header id="siteNavbar"
        class="sticky top-0 z-30 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-gray-100 dark:border-slate-800 transition-shadow duration-300"
        style="box-shadow: 0 1px 0 rgba(0,0,0,.06);">

    <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
        <div class="flex items-center gap-4 h-16">

            <!-- BRAND LOGO -->
            <a asp-controller="Home" asp-action="Index" class="flex-shrink-0 flex items-center" aria-label="CLOTHÉ — Go to homepage">
                <!-- Light mode logo -->
                <img src="~/images/ClothingLogo.png" alt="CLOTHÉ" class="clothe-logo-img h-9 w-auto block dark:hidden" style="height: 36px; width: auto; object-fit: contain;" />
                <!-- Dark mode logo -->
                <img src="~/images/ClothingLogoDarkMode.svg" alt="CLOTHÉ" class="clothe-logo-img h-9 w-auto hidden dark:block" style="height: 36px; width: auto; object-fit: contain;" />
            </a>

            <!-- DESKTOP NAV LINKS -->
            <nav class="hidden lg:flex items-center gap-6 ml-4">
                <a asp-controller="Home" asp-action="Index"
                   class="nav-link-clothe @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                    Home
                </a>
                <a asp-controller="Shop" asp-action="Index"
                   class="nav-link-clothe @(currentController == "Shop" ? "active" : "")">
                    Shop
                </a>

                <!-- Categories Dropdown -->
                <div class="dropdown-trigger relative">
                    <button type="button" class="nav-link-clothe flex items-center gap-1">
                        <i class="bi bi-grid-3x3-gap-fill text-xs"></i>
                        Categories
                        <i class="bi bi-chevron-down text-[10px] opacity-60 transition-transform duration-200"></i>
                    </button>
                    <div class="dropdown-panel w-56">
                        <a asp-controller="Shop" asp-action="Index"
                           class="dropdown-item-clothe font-semibold text-brand-blue">
                            <i class="bi bi-collection-fill"></i> All Collections
                        </a>
                        <div class="my-1 border-t border-gray-100 dark:border-slate-700"></div>
                        @if (navCategories != null && navCategories.Any())
                        {
                            @foreach (var cat in navCategories)
                            {
                                <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@cat.Id"
                                   class="dropdown-item-clothe">
                                    <i class="bi bi-tag text-gray-400"></i> @cat.Name
                                </a>
                            }
                        }
                    </div>
                </div>

                <!-- Sale -->
                <a asp-controller="Shop" asp-action="Index" asp-route-onSale="true"
                   class="nav-link-clothe text-red-500 dark:text-red-400 hover:text-red-600 dark:hover:text-red-300">
                    Sale <span class="sale-pill">HOT</span>
                </a>

                <!-- About & Contact Dropdown -->
                <div class="dropdown-trigger relative">
                    <a asp-controller="Home" asp-action="About"
                       class="nav-link-clothe flex items-center gap-1 @(currentController == "Home" && (currentAction == "About" || currentAction == "Contact") ? "active" : "")">
                        About
                        <i class="bi bi-chevron-down text-[10px] opacity-60 transition-transform duration-200"></i>
                    </a>
                    <div class="dropdown-panel w-52">
                        <a asp-controller="Home" asp-action="About"
                           class="dropdown-item-clothe">
                            <i class="bi bi-info-circle text-brand-blue"></i> About Us
                        </a>
                        <a asp-controller="Home" asp-action="About" asp-fragment="contact"
                           class="dropdown-item-clothe">
                            <i class="bi bi-chat-dots text-brand-blue"></i> Contact
                        </a>
                        <div class="my-1 border-t border-gray-100 dark:border-slate-700"></div>
                        <a href="https://t.me/khmerclothingstore_bot" target="_blank" rel="noopener noreferrer"
                           class="dropdown-item-clothe text-[#229ED9] hover:text-[#1b8bc2]">
                            <i class="bi bi-telegram text-[#229ED9]"></i> Telegram Chat
                        </a>
                    </div>
                </div>

                @if (isAdmin)
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                       class="nav-link-clothe flex items-center gap-1.5 text-brand-blue dark:text-blue-400">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                }
            </nav>

            <!-- DESKTOP SEARCH -->
            <div class="hidden lg:block flex-1 max-w-xs xl:max-w-sm">
                <form asp-controller="Shop" asp-action="Index" method="get"
                      class="relative flex items-center">
                    <i class="bi bi-search absolute left-3 text-gray-400 dark:text-slate-500 text-sm pointer-events-none"></i>
                    <input type="text" name="search" id="navSearchInput"
                           class="input-clothe pl-9 pr-8 py-2 text-sm"
                           placeholder="Search styles, brands…"
                           autocomplete="off" aria-label="Search products" />
                    <button type="button" id="navSearchClear"
                            class="absolute right-2 text-gray-400 hover:text-gray-600 hidden">
                        <i class="bi bi-x-circle-fill text-sm"></i>
                    </button>
                </form>
            </div>

            <!-- SPACER -->
            <div class="flex-1 lg:flex-none"></div>

            <!-- ACTION BUTTONS -->
            <div class="flex items-center gap-1">

                <!-- Language Toggle -->
                <div class="dropdown-trigger relative">
                    <button type="button"
                            class="nav-action-btn text-sm font-semibold gap-1.5 w-auto px-2"
                            title="Language / ភាសា">
                        <span id="globalLangFlag" class="inline-flex items-center">
                            <img src="~/images/flags/gb.svg" alt="English" class="w-5 h-3.5 object-cover rounded-xs shadow-xs" />
                        </span>
                        <span id="globalLangText" class="hidden xl:inline text-xs font-semibold">ENG</span>
                        <i class="bi bi-chevron-down text-[9px] opacity-60"></i>
                    </button>
                    <div class="dropdown-panel w-44">
                        <button type="button" onclick="setGlobalLanguage('en')"
                                class="dropdown-item-clothe justify-between">
                            <span class="inline-flex items-center gap-2">
                                <img src="~/images/flags/gb.svg" alt="English" class="w-5 h-3.5 object-cover rounded-xs shadow-xs" />
                                English
                            </span>
                            <i class="bi bi-check2 text-brand-blue hidden" id="checkLangEn"></i>
                        </button>
                        <button type="button" onclick="setGlobalLanguage('kh')"
                                class="dropdown-item-clothe justify-between font-khmer">
                            <span class="inline-flex items-center gap-2">
                                <img src="~/images/flags/kh.svg" alt="ភាសាខ្មែរ" class="w-5 h-3.5 object-cover rounded-xs shadow-xs" />
                                ភាសាខ្មែរ
                            </span>
                            <i class="bi bi-check2 text-brand-blue hidden" id="checkLangKh"></i>
                        </button>
                    </div>
                </div>

                <!-- Dark Mode Toggle -->
                <button type="button" class="nav-action-btn" id="globalThemeToggleBtn"
                        onclick="toggleGlobalTheme()" title="Toggle dark mode">
                    <i class="bi bi-moon-stars-fill" id="globalThemeIcon"></i>
                </button>

                <!-- Wishlist (authenticated only) -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Wishlist" asp-action="Index"
                       class="nav-action-btn relative" title="Wishlist" aria-label="My Wishlist">
                        <i class="bi bi-heart text-base"></i>
                        @if (userWishlistCount > 0)
                        {
                            <span class="nav-badge">@userWishlistCount</span>
                        }
                    </a>
                }

                <!-- Cart -->
                <button type="button" class="nav-action-btn relative" id="cartDrawerToggle"
                        title="Shopping Bag" aria-label="Shopping Bag">
                    <i class="bi bi-bag text-base"></i>
                    @if (userCartCount > 0)
                    {
                        <span class="nav-badge bg-red-500" id="cartBadge">@userCartCount</span>
                    }
                    else
                    {
                        <span class="nav-badge bg-red-500 hidden" id="cartBadge">0</span>
                    }
                </button>

                <!-- User Account -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown-trigger relative hidden sm:block">
                        <button type="button" class="flex items-center gap-2 pl-1 pr-2 py-1 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors">
                            <span class="user-avatar">
                                @if (!string.IsNullOrEmpty(userAvatarUrl))
                                {
                                    <img src="@userAvatarUrl" alt="@userDisplayName" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    @userFirstLetter
                                }
                            </span>
                            <span class="hidden lg:block text-sm font-medium text-gray-700 dark:text-slate-300 max-w-[80px] truncate">
                                @(string.IsNullOrEmpty(userFirstName) ? "Account" : userFirstName)
                            </span>
                            <i class="bi bi-chevron-down text-[10px] text-gray-400 hidden lg:block"></i>
                        </button>

                        <!-- User Dropdown -->
                        <div class="dropdown-panel w-60">
                            <!-- User header -->
                            <div class="flex items-center gap-3 px-4 py-3 border-b border-gray-100 dark:border-slate-700">
                                <span class="user-avatar flex-shrink-0 w-10 h-10 text-base">
                                    @if (!string.IsNullOrEmpty(userAvatarUrl))
                                    {
                                        <img src="@userAvatarUrl" alt="@userDisplayName" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        @userFirstLetter
                                    }
                                </span>
                                <div class="min-w-0">
                                    <div class="text-sm font-semibold text-gray-900 dark:text-slate-100 truncate">@userDisplayName</div>
                                    <div class="text-xs text-gray-500 dark:text-slate-400 truncate">@userEmail</div>
                                    @if (User.IsInRole("SuperAdmin"))
                                    {
                                        <span class="inline-block mt-0.5 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide rounded bg-amber-100 text-amber-800">SuperAdmin</span>
                                    }
                                    else if (isAdmin)
                                    {
                                        <span class="inline-block mt-0.5 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide rounded bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="inline-block mt-0.5 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide rounded bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400">Member</span>
                                    }
                                </div>
                            </div>

                            <!-- My Account section -->
                            <div class="py-1">
                                <p class="px-4 pt-2 pb-1 text-[10px] font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider">My Account</p>
                                <a class="dropdown-item-clothe" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person w-4 text-center"></i> <span>Profile Overview</span>
                                </a>
                                <a class="dropdown-item-clothe" asp-controller="Orders" asp-action="Index">
                                    <i class="bi bi-box-seam w-4 text-center"></i> <span>My Orders</span>
                                </a>
                                <a class="dropdown-item-clothe" asp-controller="Wishlist" asp-action="Index">
                                    <i class="bi bi-heart w-4 text-center"></i> <span>Wishlist</span>
                                </a>
                                <a class="dropdown-item-clothe" asp-controller="Cart" asp-action="Index">
                                    <i class="bi bi-bag w-4 text-center"></i> <span>Shopping Bag</span>
                                </a>
                            </div>

                            @if (isAdmin)
                            {
                                <div class="border-t border-gray-100 dark:border-slate-700 py-1">
                                    <p class="px-4 pt-2 pb-1 text-[10px] font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider">Administration</p>
                                    <a class="dropdown-item-clothe text-brand-blue dark:text-blue-400" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 w-4 text-center"></i> <span>Admin Dashboard</span>
                                    </a>
                                    <a class="dropdown-item-clothe" asp-area="Admin" asp-controller="Products" asp-action="Index">
                                        <i class="bi bi-box-seam-fill w-4 text-center"></i> <span>Manage Products</span>
                                    </a>
                                </div>
                            }

                            <div class="border-t border-gray-100 dark:border-slate-700 py-1">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item-clothe text-red-600 dark:text-red-400 w-full">
                                        <i class="bi bi-box-arrow-right w-4 text-center"></i> <span>Sign out</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="hidden sm:flex items-center gap-2 ml-1">
                        <a asp-controller="Account" asp-action="Login"
                           class="btn-outline-clothe py-2 px-4 text-xs">
                            <i class="bi bi-person"></i> Sign in
                        </a>
                        <a asp-controller="Account" asp-action="Register"
                           class="btn-primary-clothe py-2 px-4 text-xs">
                            Get started
                        </a>
                    </div>
                }

                <!-- Mobile hamburger -->
                <button type="button" id="mobileMenuToggle"
                        class="lg:hidden nav-action-btn ml-1"
                        aria-label="Open menu">
                    <i class="bi bi-list text-lg" id="mobileMenuIcon"></i>
                </button>
            </div>
        </div>
    </div>
</header>

<!-- =========================================================
     MOBILE DRAWER
========================================================= -->
<div id="mobileDrawerOverlay" class="drawer-overlay" onclick="closeMobileMenu()"></div>
<div id="mobileDrawer" class="drawer-panel left">

    <!-- Drawer Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 dark:border-slate-800">
        <a asp-controller="Home" asp-action="Index">
            <img src="~/images/ClothingLogo.png" alt="CLOTHÉ" class="h-7 w-auto" />
        </a>
        <button type="button" onclick="closeMobileMenu()"
                class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors">
            <i class="bi bi-x-lg text-sm text-gray-500"></i>
        </button>
    </div>

    <div class="overflow-y-auto h-[calc(100%-64px)]">

        <!-- Logged In User Card -->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="p-4 border-b border-gray-100 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="user-avatar w-10 h-10 text-base">
                        @if (!string.IsNullOrEmpty(userAvatarUrl))
                        {
                            <img src="@userAvatarUrl" alt="@userDisplayName" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            @userFirstLetter
                        }
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="text-sm font-semibold text-gray-900 dark:text-slate-100 truncate">@userDisplayName</div>
                        <div class="text-xs text-gray-500 dark:text-slate-400 truncate">@userEmail</div>
                    </div>
                </div>
                <!-- Quick action tiles -->
                <div class="grid grid-cols-4 gap-2 mt-3">
                    <a asp-controller="Profile" asp-action="Index"
                       class="flex flex-col items-center gap-1 p-2 rounded-xl bg-gray-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 transition-colors text-center">
                        <i class="bi bi-person text-brand-blue text-base"></i>
                        <span class="text-[10px] font-medium text-gray-600 dark:text-slate-400">Profile</span>
                    </a>
                    <a asp-controller="Orders" asp-action="Index"
                       class="flex flex-col items-center gap-1 p-2 rounded-xl bg-gray-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 transition-colors text-center">
                        <i class="bi bi-box-seam text-brand-blue text-base"></i>
                        <span class="text-[10px] font-medium text-gray-600 dark:text-slate-400">Orders</span>
                    </a>
                    <a asp-controller="Wishlist" asp-action="Index"
                       class="relative flex flex-col items-center gap-1 p-2 rounded-xl bg-gray-50 dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-slate-700 transition-colors text-center">
                        <i class="bi bi-heart text-brand-blue text-base"></i>
                        <span class="text-[10px] font-medium text-gray-600 dark:text-slate-400">Wishlist</span>
                        @if (userWishlistCount > 0)
                        {
