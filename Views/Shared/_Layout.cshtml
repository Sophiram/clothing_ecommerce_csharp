                    </span>
                    <div>
                        <div class="fw-bold small" id="cartToastTitle">Added to bag!</div>
                        <div class="text-white-50 small" id="cartToastMsg">Item has been added to your shopping bag.</div>
                    </div>
                </div>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-sm btn-light rounded-pill ms-auto me-2 px-3 fw-semibold">View Bag</a>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- =====================================================
         CART EVENT LISTENER & REAL-TIME BADGE UPDATER
    ====================================================== -->
    <script>
        window.showCartToast = function(title, message) {
            const toastEl = document.getElementById('cartToast');
            if (!toastEl) return;
            if (title) document.getElementById('cartToastTitle').textContent = title;
            if (message) document.getElementById('cartToastMsg').textContent = message;
            const toast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3500 });
            toast.show();
        };

        document.addEventListener('cart:updated', async function(e) {
            if (e && e.detail && e.detail.toast) {
                window.showCartToast(e.detail.title || "Added to bag!", e.detail.message || "Item was successfully added.");
            }

            try {
                const res = await fetch('/Cart/GetCount');
                if (res.ok) {
                    const data = await res.json();
                    const cartBtns = document.querySelectorAll('.clothe-action-btn[title="Shopping Bag"]');
                    cartBtns.forEach(btn => {
                        let badge = btn.querySelector('.clothe-badge-count');
                        if (data.count > 0) {
                            if (badge) {
                                badge.textContent = data.count;
                                badge.classList.remove('d-none');
                            } else {
                                badge = document.createElement('span');
                                badge.className = 'clothe-badge-count badge-sale';
                                badge.textContent = data.count;
                                btn.appendChild(badge);
                            }
                        } else if (badge) {
                            badge.classList.add('d-none');
                        }
                    });
                }
            } catch(err) {
                console.error('Failed to refresh cart count', err);
            }
        });
    </script>

    <!-- =====================================================
         NAVBAR INTERACTIVE ENHANCEMENTS: SEARCH & MOBILE DRAWER
    ====================================================== -->
    <script>
        (function() {
            // Search input clear buttons (Desktop & Mobile)
            function setupSearchClear(inputId, clearBtnId) {
                var input = document.getElementById(inputId);
                var btn = document.getElementById(clearBtnId);
                if (!input || !btn) return;

                function toggleClear() {
                    if (input.value.trim().length > 0) {
                        btn.classList.remove('d-none');
                    } else {
                        btn.classList.add('d-none');
                    }
                }

                input.addEventListener('input', toggleClear);
                btn.addEventListener('click', function() {
                    input.value = '';
                    toggleClear();
                    input.focus();
                });
                toggleClear();
            }

            setupSearchClear('navSearchInput', 'navSearchClear');
            setupSearchClear('mobileSearchInput', 'mobileSearchClear');

            // Global shortcut Ctrl+K or / to focus search
            document.addEventListener('keydown', function(e) {
                if ((e.ctrlKey && e.key.toLowerCase() === 'k') || (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName))) {
                    var desktopSearch = document.getElementById('navSearchInput');
                    var mobileSearch = document.getElementById('mobileSearchInput');
                    if (desktopSearch && window.innerWidth >= 992) {
                        e.preventDefault();
                        desktopSearch.focus();
                    } else if (mobileSearch) {
                        e.preventDefault();
                        var mobileOffcanvas = document.getElementById('clotheMobileNav');
                        if (mobileOffcanvas && !mobileOffcanvas.classList.contains('show')) {
                            var bsOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(mobileOffcanvas);
                            bsOffcanvas.show();
                        }
                        // Focus might need a slight delay to allow offcanvas to open
                        setTimeout(() => mobileSearch.focus(), 300);
                    }
                }
            });
        })();
    </script>

