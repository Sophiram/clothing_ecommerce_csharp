@inject WebApplication_ClothingEcommerce.Data.AppDbContext DbContext

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    int userCartCount = 0;
    int userWishlistCount = 0;
    string userDisplayName = "My Account";
    string userFirstName = "";
    string userFirstLetter = "U";
    string userEmail = "";
    string? userAvatarUrl = null;
    bool isAdmin = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        userEmail = User.Identity.Name ?? "";
        isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");

        try
        {
            var appUser = DbContext.Users.FirstOrDefault(u => u.Email == userEmail);
            if (appUser != null)
            {
                var avatarFolder = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "uploads", "avatars");
                if (System.IO.Directory.Exists(avatarFolder))
                {
                    var files = System.IO.Directory.GetFiles(avatarFolder, $"{appUser.Id}.*");
                    if (files.Length > 0)
                    {
                        var fi = new System.IO.FileInfo(files[0]);
                        userAvatarUrl = $"/uploads/avatars/{System.IO.Path.GetFileName(files[0])}?v={fi.LastWriteTimeUtc.Ticks}";
                    }
                }
            }

            var customer = DbContext.Customers.FirstOrDefault(c => c.Email == userEmail);
            if (customer != null)
            {
                if (!string.IsNullOrWhiteSpace(customer.FirstName))
                {
                    userFirstName = customer.FirstName;
                    userDisplayName = $"{customer.FirstName} {customer.LastName}".Trim();
                    userFirstLetter = customer.FirstName.Substring(0, 1).ToUpper();
                }
                else
                {
                    userFirstName = userEmail.Split('@')[0];
                    userDisplayName = userFirstName;
                    userFirstLetter = !string.IsNullOrEmpty(userDisplayName) ? userDisplayName.Substring(0, 1).ToUpper() : "U";
                }

                userCartCount = DbContext.CartItems
                    .Where(ci => ci.Cart.CustomerId == customer.Id)
                    .Sum(ci => (int?)ci.Quantity) ?? 0;

                userWishlistCount = DbContext.WishlistItems
                    .Count(wi => wi.Wishlist.CustomerId == customer.Id);
            }
            else
            {
                userFirstName = userEmail.Split('@')[0];
                userDisplayName = userFirstName;
                userFirstLetter = !string.IsNullOrEmpty(userDisplayName) ? userDisplayName.Substring(0, 1).ToUpper() : "U";
            }
        }
        catch
        {
            userFirstName = userEmail.Split('@')[0];
            userDisplayName = userFirstName;
            userFirstLetter = "U";
        }
    }

    if (ViewBag.CartCount != null)
    {
        int parsedCount = 0;
        if (int.TryParse(Convert.ToString(ViewBag.CartCount), out parsedCount) && parsedCount > 0)
        {
            userCartCount = parsedCount;
        }
    }

    var navCategories = new List<WebApplication_ClothingEcommerce.Models.Category>();
    try
    {
        navCategories = DbContext.Categories.OrderBy(c => c.Name).ToList();
    }
    catch { }
}
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - CLOTHÉ
    </title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- CLOTHÉ Modern Navbar & Authentication Stylesheets -->
    <link rel="stylesheet"
          href="~/css/navbar-modern.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/auth-modern.css"
          asp-append-version="true" />

</head>

<body>

    <!-- =====================================================
         PROMO / COUNTDOWN BAR
    ====================================================== -->
    <div class="clothe-promo-bar" id="promoBar">
        <div class="container clothe-promo-inner">
            <div class="clothe-promo-text">
                <span class="clothe-promo-tag">Flash Sale</span>
                <span>Season Collection — Up to <strong>40% OFF</strong> essentials & trending styles!</span>
            </div>

            <div class="clothe-promo-countdown" id="promoCountdown" aria-label="Sale countdown">
                <div class="clothe-countdown-unit">
                    <span id="cd-h">00</span>
                    <small>H</small>
                </div>
                <div class="clothe-countdown-unit">
                    <span id="cd-m">00</span>
                    <small>M</small>
                </div>
                <div class="clothe-countdown-unit">
                    <span id="cd-s">00</span>
                    <small>S</small>
                </div>
            </div>

            <a asp-controller="Shop" asp-action="Index" asp-route-onSale="true" class="clothe-promo-cta">
                Shop Now <i class="bi bi-arrow-right-short"></i>
            </a>

            <button class="clothe-promo-close" id="promoBarClose" type="button" aria-label="Dismiss promo bar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <!-- =====================================================
         CLOTHÉ REFINED NAVBAR
    ====================================================== -->
    <nav class="clothe-navbar">
        <div class="container clothe-nav-container">

            <!-- BRAND LOGO -->
            <a class="clothe-brand" asp-controller="Home" asp-action="Index" aria-label="CLOTHÉ — Go to homepage">
                <img src="~/images/ClothingLogo.png" alt="CLOTHÉ" class="clothe-brand-logo" />
            </a>

            <!-- DESKTOP NAVIGATION LINKS -->
            <ul class="clothe-nav-links d-none d-lg-flex">
                <li>
                    <a asp-controller="Home" asp-action="Index"
                       class="clothe-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        Home
                    </a>
                </li>
                <li>
                    <a asp-controller="Shop" asp-action="Index"
                       class="clothe-nav-link @(currentController == "Shop" ? "active" : "")">
                        Shop
                    </a>
                </li>

                <!-- Live category dropdown -->
                @await Component.InvokeAsync("CategoryNav")



                <li>
                    <a asp-controller="Shop" asp-action="Index" asp-route-onSale="true"
                       class="clothe-nav-link clothe-nav-link-sale">
                        Sale
                        <span class="clothe-sale-pill" aria-hidden="true">HOT</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Home" asp-action="About"
                       class="clothe-nav-link @(currentController == "Home" && currentAction == "About" ? "active" : "")">
                        About
                    </a>
                </li>

                @if (isAdmin)
                {
                    <li>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                           class="clothe-admin-badge" aria-label="Open Admin Dashboard">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                }
            </ul>

            <!-- LIVE SEARCH BAR (DESKTOP) -->
            <div class="clothe-nav-search d-none d-lg-block">
                <form asp-controller="Shop" asp-action="Index" method="get" class="clothe-search-form" id="desktopSearchForm" role="search">
                    <i class="bi bi-search clothe-search-icon" aria-hidden="true"></i>
                    <input type="text"
                           name="search"
                           id="navSearchInput"
                           class="clothe-search-input"
                           placeholder="Search styles, brands, collections…"
                           autocomplete="off"
                           aria-label="Search products" />
                    <button type="button" class="clothe-search-clear d-none" id="navSearchClear" aria-label="Clear search">
                        <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
                    </button>
                    <button type="submit" class="clothe-search-submit" aria-label="Submit search">
                        <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                    </button>
                </form>
            </div>

            <!-- ACTION BUTTONS & USER PROFILE -->
            <div class="clothe-nav-actions">

                <!-- WISHLIST -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Wishlist"
                       asp-action="Index"
                       class="clothe-action-btn"
                       title="My Wishlist"
                       aria-label="My Wishlist">
                        <i class="bi bi-heart" aria-hidden="true"></i>
                        @if (userWishlistCount > 0)
                        {
                            <span class="clothe-badge-count" aria-hidden="true">@userWishlistCount</span>
                        }
                    </a>
                }

                <!-- CART -->
                <button type="button"
                        class="clothe-action-btn"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#cartSidebarDrawer"
                        aria-controls="cartSidebarDrawer"
                        title="Shopping Bag"
                        aria-label="Shopping Bag">
                    <i class="bi bi-bag" aria-hidden="true"></i>
                    @if (userCartCount > 0)
                    {
                        <span class="clothe-badge-count badge-sale" aria-hidden="true">@userCartCount</span>
                    }
                </button>

                <!-- USER ACCOUNT -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="clothe-user-trigger"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                type="button"
                                aria-label="Account menu">
                            <span class="clothe-user-avatar">
                                @if (!string.IsNullOrEmpty(userAvatarUrl))
                                {
                                    <img src="@userAvatarUrl" alt="@userDisplayName" class="clothe-avatar-img" />
                                }
                                else
                                {
                                    @userFirstLetter
                                }
                            </span>
                            <span class="clothe-user-name d-none d-lg-inline">@(string.IsNullOrEmpty(userFirstName) ? "Account" : userFirstName)</span>
                            <i class="bi bi-chevron-down clothe-user-chevron d-none d-lg-inline" aria-hidden="true"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end clothe-dropdown-menu">
                            <li>
                                <div class="clothe-user-header">
                                    <div class="clothe-user-header-avatar">
                                        @if (!string.IsNullOrEmpty(userAvatarUrl))
                                        {
                                            <img src="@userAvatarUrl" alt="@userDisplayName" class="clothe-avatar-img" />
                                        }
                                        else
                                        {
                                            @userFirstLetter
                                        }
                                    </div>
                                    <div class="clothe-user-meta">
                                        <strong>@userDisplayName</strong>
                                        <small>@userEmail</small>
                                        @if (User.IsInRole("SuperAdmin"))
                                        {
                                            <span class="clothe-user-role-badge role-admin">
                                                <i class="bi bi-shield-fill-check" aria-hidden="true"></i> SuperAdmin
                                            </span>
                                        }
                                        else if (isAdmin)
                                        {
                                            <span class="clothe-user-role-badge role-admin">
                                                <i class="bi bi-shield-check" aria-hidden="true"></i> Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="clothe-user-role-badge role-member">
                                                <i class="bi bi-stars" aria-hidden="true"></i> Member
                                            </span>
                                        }
                                    </div>
                                </div>
                            </li>

                            <li><div class="clothe-dropdown-section-title">My Account</div></li>

                            <li>
                                <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person"></i>
                                    <span>Profile Overview</span>
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" asp-controller="Orders" asp-action="Index">
                                    <i class="bi bi-box-seam"></i>
                                    <span>My Orders</span>
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" asp-controller="Wishlist" asp-action="Index">
                                    <i class="bi bi-heart"></i>
                                    <span>Wishlist</span>
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" asp-controller="Cart" asp-action="Index">
                                    <i class="bi bi-bag"></i>
                                    <span>Shopping Bag</span>
                                </a>
                            </li>

                            @if (isAdmin)
                            {
                                <li><hr class="clothe-dropdown-divider" /></li>
                                <li><div class="clothe-dropdown-section-title">Administration</div></li>

                                <li>
                                    <a class="dropdown-item admin-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i>
                                        <span>Admin Dashboard</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item admin-item" asp-area="Admin" asp-controller="Products" asp-action="Index">
                                        <i class="bi bi-box-seam-fill"></i>
                                        <span>Manage Products</span>
                                    </a>
                                </li>
                            }

                            <li><hr class="clothe-dropdown-divider" /></li>

                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="clothe-logout-btn">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Sign out</span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-none d-sm-flex align-items-center gap-2">
                        <a asp-controller="Account" asp-action="Login" class="clothe-btn-signin">
                            <i class="bi bi-person"></i>
                            <span>Sign in</span>
                        </a>

                        <a asp-controller="Account" asp-action="Register" class="clothe-btn-register">
                            <span>Get started</span>
                        </a>
                    </div>
                }

                <!-- MOBILE HAMBURGER TOGGLER -->
                <button class="clothe-mobile-toggler d-lg-none"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#clotheMobileNav"
                        aria-controls="clotheMobileNav"
                        aria-label="Open navigation menu"
                        id="clotheMobileToggler">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>

            </div>

        </div>

     
    </nav>
    <!-- MOBILE MENU DRAWER (OFFCANVAS) -->
    <div class="offcanvas offcanvas-start d-lg-none" tabindex="-1" id="clotheMobileNav" aria-labelledby="clotheMobileNavLabel">
        <div class="offcanvas-header" style="border-bottom: 1px solid #f3f4f6;">
            <a class="clothe-brand" asp-controller="Home" asp-action="Index" id="clotheMobileNavLabel">
                <img src="~/images/ClothingLogo.png" alt="CLOTHÉ" class="clothe-brand-logo" style="height:30px;" />
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close navigation"></button>
        </div>
        <div class="offcanvas-body clothe-mobile-menu">

            <!-- Logged In User Mobile Card -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="clothe-mobile-user-card mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="clothe-user-avatar">
                            @if (!string.IsNullOrEmpty(userAvatarUrl))
                            {
                                <img src="@userAvatarUrl" alt="@userDisplayName" class="clothe-avatar-img" />
                            }
                            else
                            {
                                @userFirstLetter
                            }
                        </span>
                        <div class="flex-grow-1 overflow-hidden">
                            <strong class="d-block text-truncate" style="font-size:0.9375rem;color:#0f172a;">@userDisplayName</strong>
                            <small class="text-muted text-truncate d-block" style="font-size:0.8rem;">@userEmail</small>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <span style="display:inline-block;margin-top:3px;padding:1px 7px;font-size:0.65rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border-radius:4px;background:#fef3c7;color:#92400e;">SuperAdmin</span>
                            }
                            else if (isAdmin)
                            {
                                <span style="display:inline-block;margin-top:3px;padding:1px 7px;font-size:0.65rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border-radius:4px;background:#fee2e2;color:#b91c1c;">Admin</span>
                            }
                            else
                            {
                                <span style="display:inline-block;margin-top:3px;padding:1px 7px;font-size:0.65rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border-radius:4px;background:#dbeafe;color:#1d4ed8;">Member</span>
                            }
                        </div>
                    </div>
                    <div class="clothe-mobile-user-grid mt-3">
                        <a asp-controller="Profile" asp-action="Index" class="clothe-mobile-user-tile">
                            <i class="bi bi-person"></i>
                            <span>Profile</span>
                        </a>
                        <a asp-controller="Orders" asp-action="Index" class="clothe-mobile-user-tile">
                            <i class="bi bi-box-seam"></i>
                            <span>Orders</span>
                        </a>
                        <a asp-controller="Wishlist" asp-action="Index" class="clothe-mobile-user-tile position-relative">
                            <i class="bi bi-heart"></i>
                            <span>Wishlist</span>
                            @if (userWishlistCount > 0)
                            {
                                <span class="badge bg-dark rounded-pill">@userWishlistCount</span>
                            }
                        </a>
                        <button type="button"
                                class="clothe-mobile-user-tile position-relative border-0 bg-transparent text-start"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#cartSidebarDrawer"
                                aria-controls="cartSidebarDrawer">
                            <i class="bi bi-bag"></i>
                            <span>Bag</span>
                            @if (userCartCount > 0)
                            {
                                <span class="badge bg-danger rounded-pill">@userCartCount</span>
                            }
                        </button>
                    </div>
                </div>
            }

            <!-- Mobile Search Bar -->
            <div class="clothe-mobile-search-wrap">
                <form asp-controller="Shop" asp-action="Index" method="get" class="clothe-search-form" id="mobileSearchForm">
                    <i class="bi bi-search clothe-search-icon"></i>
                    <input type="text"
                           name="search"
                           id="mobileSearchInput"
                           class="clothe-search-input"
                           placeholder="Search styles, brands, collections..."
                           autocomplete="off" />
                    <button type="button" class="clothe-search-clear d-none" id="mobileSearchClear" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                    <button type="submit" class="clothe-search-submit" title="Search">
                        <i class="bi bi-arrow-right-short"></i>
                    </button>
                </form>
            </div>

            <!-- Mobile Navigation List -->
            <ul class="clothe-mobile-nav-list">
                <li class="clothe-mobile-nav-item">
                    <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        <span><i class="bi bi-house me-2"></i> Home</span>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                </li>
                <li class="clothe-mobile-nav-item">
                    <a asp-controller="Shop" asp-action="Index" class="@(currentController == "Shop" && currentAction == "Index" && string.IsNullOrEmpty(Context.Request.Query["onSale"]) && string.IsNullOrEmpty(Context.Request.Query["categoryId"]) ? "active" : "")">
                        <span><i class="bi bi-shop me-2"></i> Shop All</span>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                </li>

                <!-- Categories Expandable Accordion in Mobile -->
                <li class="clothe-mobile-nav-item">
                    <a href="#mobileCategoriesCollapse" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="mobileCategoriesCollapse" class="d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-grid me-2"></i> Categories</span>
                        <i class="bi bi-chevron-down text-muted small transition-chevron"></i>
                    </a>
                    <div class="collapse ps-3 pe-2 py-1" id="mobileCategoriesCollapse">
                        <div class="d-flex flex-column gap-1 my-1">
                            <a asp-controller="Shop" asp-action="Index" class="clothe-mobile-sublink fw-semibold">
                                <i class="bi bi-collection-fill me-2 text-primary"></i> All Collections
                            </a>
                            @if (navCategories != null && navCategories.Any())
                            {
                                @foreach (var cat in navCategories)
                                {
                                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@cat.Id" class="clothe-mobile-sublink">
                                        <span>@cat.Name</span>
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </li>

                <li class="clothe-mobile-nav-item">
                    <a asp-controller="Shop" asp-action="Index" asp-route-onSale="true" class="sale-item @(!string.IsNullOrEmpty(Context.Request.Query["onSale"]) ? "active" : "")">
                        <span><i class="bi bi-lightning-charge-fill me-2"></i> Sale & Promotions</span>
                        <span class="clothe-sale-pill">HOT</span>
                    </a>
                </li>
                <li class="clothe-mobile-nav-item">
                    <a asp-controller="Home" asp-action="About" class="@(currentController == "Home" && currentAction == "About" ? "active" : "")">
                        <span><i class="bi bi-info-circle me-2"></i> About Us</span>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                </li>

                @if (isAdmin)
                {
                    <li class="clothe-mobile-nav-item">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-danger fw-bold">
                            <span><i class="bi bi-speedometer2 me-2"></i> Admin Dashboard</span>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                    </li>
                }
            </ul>

            <!-- Mobile Auth Buttons or Logout -->
            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="clothe-mobile-auth-block">
                    <a asp-controller="Account" asp-action="Login" class="clothe-btn-signin">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Sign in</span>
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="clothe-btn-register">
                        <span>Create Account</span>
                    </a>
                </div>
            }
            else
            {
                <div class="mt-3 pt-2" style="border-top: 1px solid #f3f4f6;">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="clothe-logout-btn w-100 justify-content-center" style="padding: 10px 14px;">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            <span>Sign out</span>
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main>
        @RenderBody()
    </main>


    <!-- =====================================================
         NEWSLETTER STRIP (site-wide, sits above footer)
    ====================================================== -->

    <section class="newsletter-strip">

        <div class="container">

            <div class="newsletter-strip-inner">

                <div class="newsletter-strip-text">
                    <span class="newsletter-strip-label">STAY IN THE LOOP</span>
                    <h3>Get 10% off your first order</h3>
                    <p>Sign up for drops, deals and style tips. No spam, ever.</p>
                </div>

                <form class="newsletter-strip-form" id="newsletterForm">
                    <div class="newsletter-input-wrap">
                        <i class="bi bi-envelope"></i>
                        <input type="email" class="newsletter-input" placeholder="Enter your email" required />
                    </div>
                    <button type="submit" class="newsletter-submit-btn">
                        Subscribe
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </form>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="google-footer">

