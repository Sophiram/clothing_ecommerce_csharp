<!-- Override theme toggle for Tailwind dark class -->
<script>
    // Patch theme engine to toggle <html class="dark"> instead of body.dark-mode
    window.toggleGlobalTheme = function () {
        const isDark = document.documentElement.classList.contains('dark');
        const next = isDark ? 'light' : 'dark';
        localStorage.setItem('site_theme', next);
        if (next === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
        const icon = document.getElementById('globalThemeIcon');
        if (icon) icon.className = next === 'dark' ? 'bi bi-sun-fill text-yellow-400' : 'bi bi-moon-stars-fill';
        const mIcon = document.getElementById('mobileThemeIcon');
        if (mIcon) mIcon.className = next === 'dark' ? 'bi bi-sun-fill text-yellow-400' : 'bi bi-moon-stars-fill';
    };

    // Apply i18n lang controls on load
    document.addEventListener('DOMContentLoaded', function () {
        const lang = localStorage.getItem('site_language') || 'en';
        const isDark = document.documentElement.classList.contains('dark');
        const icon = document.getElementById('globalThemeIcon');
        if (icon) icon.className = isDark ? 'bi bi-sun-fill text-yellow-400' : 'bi bi-moon-stars-fill';
        const mIcon = document.getElementById('mobileThemeIcon');
        if (mIcon) mIcon.className = isDark ? 'bi bi-sun-fill text-yellow-400' : 'bi bi-moon-stars-fill';

        // Sync lang check marks
        const checkEn = document.getElementById('checkLangEn');
        const checkKh = document.getElementById('checkLangKh');
        if (checkEn) checkEn.classList.toggle('hidden', lang === 'kh');
        if (checkKh) checkKh.classList.toggle('hidden', lang !== 'kh');

        // Apply font-khmer to body when Khmer is active
        if (lang === 'kh') {
            document.documentElement.setAttribute('lang', 'km');
        }
    });
</script>

<!-- Mobile menu + cart drawer JS -->
<script>
    // ── MOBILE MENU ──
    function openMobileMenu() {
        document.getElementById('mobileDrawer').classList.add('open');
        document.getElementById('mobileDrawerOverlay').classList.add('open');
        document.body.style.overflow = 'hidden';
        document.getElementById('mobileMenuIcon').className = 'bi bi-x-lg text-lg';
    }
    function closeMobileMenu() {
        document.getElementById('mobileDrawer').classList.remove('open');
        document.getElementById('mobileDrawerOverlay').classList.remove('open');
        document.body.style.overflow = '';
        document.getElementById('mobileMenuIcon').className = 'bi bi-list text-lg';
    }
    document.getElementById('mobileMenuToggle').addEventListener('click', function () {
        if (document.getElementById('mobileDrawer').classList.contains('open')) {
            closeMobileMenu();
        } else {
            openMobileMenu();
        }
    });

    // ── MOBILE CATEGORIES ──
    function toggleMobileCategories() {
        const list = document.getElementById('mobileCategoryList');
        const chevron = document.getElementById('mobileCatChevron');
        const isOpen = !list.classList.contains('hidden');
        list.classList.toggle('hidden', isOpen);
        chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
    }

    // ── CART DRAWER ──
    function openCartDrawer() {
        document.getElementById('cartDrawer').classList.add('open');
        document.getElementById('cartDrawerOverlay').classList.add('open');
        document.body.style.overflow = 'hidden';
        loadCartDrawerContent();
    }
    function closeCartDrawer() {
        document.getElementById('cartDrawer').classList.remove('open');
        document.getElementById('cartDrawerOverlay').classList.remove('open');
        document.body.style.overflow = '';
    }
    async function loadCartDrawerContent() {
        const content = document.getElementById('cartDrawerContent');
        if (!content) return;
        try {
            const res = await fetch('/Cart/SidebarPartial');
            if (res.ok) {
                content.innerHTML = await res.text();
            } else {
                content.innerHTML = '<p class="text-center text-sm text-gray-400 mt-8">Could not load cart.</p>';
            }
        } catch {
            content.innerHTML = '<p class="text-center text-sm text-gray-400 mt-8">Could not load cart.</p>';
        }
    }

    // ── CART SIDEBAR GLOBAL ENGINE (AJAX QUANTITY, VARIANT EDITING, REMOVAL) ──
    window.updateSidebarQty = async function (itemId, newQty) {
        if (newQty < 1) return;
        var qtyEl = document.getElementById('itemQty_' + itemId);
        if (qtyEl) qtyEl.textContent = newQty;

        try {
            var csrfToken = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]')?.value || '';
            var formData = new FormData();
            formData.append('id', itemId);
            formData.append('quantity', newQty);
            if (csrfToken) formData.append('__RequestVerificationToken', csrfToken);

            var res = await fetch('/Cart/Update', {
                method: 'POST',
                headers: { 
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': csrfToken
                },
                body: formData
            });

            if (res.ok) {
                var data = await res.json();
                document.dispatchEvent(new CustomEvent('cart:updated', { 
                    detail: { count: data.cartCount } 
                }));
                loadCartDrawerContent();
            }
        } catch (err) {
            console.error('Update qty error:', err);
            loadCartDrawerContent();
        }
    };

    window.removeSidebarItem = async function (itemId) {
        var row = document.getElementById('cartItemRow_' + itemId);
        if (row) {
            row.style.opacity = '0.3';
            row.style.pointerEvents = 'none';
        }

        try {
            var csrfToken = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]')?.value || '';
            var formData = new FormData();
            formData.append('id', itemId);
            if (csrfToken) formData.append('__RequestVerificationToken', csrfToken);

            var res = await fetch('/Cart/Remove', {
                method: 'POST',
                headers: { 
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': csrfToken
                },
                body: formData
            });

            if (res.ok) {
                var data = await res.json();
                document.dispatchEvent(new CustomEvent('cart:updated', { 
                    detail: { count: data.cartCount, toast: true, title: "Item Removed", message: "Item was removed from your bag." } 
                }));
                loadCartDrawerContent();
            }
        } catch (err) {
            console.error('Remove item error:', err);
            loadCartDrawerContent();
        }
    };

    window.toggleVariantEditor = async function (itemId, productId, currentVariantId) {
        var editor = document.getElementById('variantEditor_' + itemId);
        if (!editor) return;

        if (!editor.classList.contains('hidden')) {
            editor.classList.add('hidden');
            return;
        }

        editor.classList.remove('hidden');
        var loader = document.getElementById('variantLoader_' + itemId);
        var fields = document.getElementById('variantFields_' + itemId);
        var select = document.getElementById('selVariant_' + itemId);
        var priceLbl = document.getElementById('variantPriceLbl_' + itemId);

        if (loader) loader.classList.remove('hidden');
        if (fields) fields.classList.add('hidden');
        if (select) select.innerHTML = '';

        try {
            var res = await fetch('/Cart/GetProductVariants?productId=' + encodeURIComponent(productId));
            if (res.ok) {
                var variants = await res.json();
                variants.forEach(function (v) {
                    var opt = document.createElement('option');
                    opt.value = v.id;
                    var stockText = v.stock > 0 ? (v.stock <= 5 ? ` (Only ${v.stock} left)` : '') : ' (Out of Stock)';
                    opt.textContent = `${v.sizeName} / ${v.colorName} - $${v.price.toFixed(2)}${stockText}`;
                    opt.dataset.price = v.price.toFixed(2);
                    opt.dataset.stock = v.stock;
                    if (v.stock <= 0) opt.disabled = true;
                    if (currentVariantId && v.id.toLowerCase() === currentVariantId.toLowerCase()) opt.selected = true;
                    select.appendChild(opt);
                });

                function updatePriceLabel() {
                    var sel = select.options[select.selectedIndex];
                    if (sel && priceLbl) {
                        priceLbl.textContent = '$' + sel.dataset.price;
                    }
                }
                select.onchange = updatePriceLabel;
                updatePriceLabel();

                if (loader) loader.classList.add('hidden');
                if (fields) fields.classList.remove('hidden');
            }
        } catch (err) {
            if (loader) loader.textContent = 'Could not load options.';
        }
    };

    window.closeVariantEditor = function (itemId) {
        var editor = document.getElementById('variantEditor_' + itemId);
        if (editor) editor.classList.add('hidden');
    };

    window.saveVariantChange = async function (itemId) {
        var select = document.getElementById('selVariant_' + itemId);
        if (!select || !select.value) return;

        var newVariantId = select.value;
        try {
            var csrfToken = document.querySelector('#antiforgeryForm input[name="__RequestVerificationToken"]')?.value || '';
            var formData = new FormData();
            formData.append('id', itemId);
            formData.append('newVariantId', newVariantId);
            if (csrfToken) formData.append('__RequestVerificationToken', csrfToken);

            var res = await fetch('/Cart/ChangeVariant', {
                method: 'POST',
                headers: { 
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': csrfToken
                },
                body: formData
            });

            if (res.ok) {
                var data = await res.json();
                document.dispatchEvent(new CustomEvent('cart:updated', { 
                    detail: { count: data.cartCount, toast: true, title: "Option Updated", message: data.message || "Variant updated." } 
                }));
                loadCartDrawerContent();
            }
        } catch (err) {
            console.error('Save variant error:', err);
        }
    };

    document.getElementById('cartDrawerToggle').addEventListener('click', openCartDrawer);
    var mobileCartBtn = document.getElementById('mobileCartDrawerBtn');
    if (mobileCartBtn) mobileCartBtn.addEventListener('click', function () { closeMobileMenu(); openCartDrawer(); });

    // ── NAVBAR SCROLL ──
    (function () {
        var navbar = document.getElementById('siteNavbar');
        if (!navbar) return;
        window.addEventListener('scroll', function () {
            if (window.scrollY > 15) {
                navbar.style.boxShadow = '0 4px 20px rgba(0,0,0,.12)';
            } else {
                navbar.style.boxShadow = '0 1px 0 rgba(0,0,0,.06)';
            }
        }, { passive: true });
    })();

    // ── PROMO BAR COUNTDOWN ──
    (function () {
        var bar = document.getElementById('promoBar');
        var closeBtn = document.getElementById('promoBarClose');
        if (sessionStorage.getItem('promoBarDismissed') === '1') {
            if (bar) bar.style.display = 'none';
        }
        if (closeBtn && bar) {
            closeBtn.addEventListener('click', function () {
                bar.style.display = 'none';
                sessionStorage.setItem('promoBarDismissed', '1');
            });
        }
        function updateCountdown() {
            var now = new Date();
            var midnight = new Date(now);
            midnight.setHours(24, 0, 0, 0);
            var diff = midnight - now;
            var h = Math.floor(diff / 3600000);
            var m = Math.floor((diff % 3600000) / 60000);
            var s = Math.floor((diff % 60000) / 1000);
            var hEl = document.getElementById('cd-h');
            var mEl = document.getElementById('cd-m');
            var sEl = document.getElementById('cd-s');
            if (hEl) hEl.textContent = String(h).padStart(2, '0');
            if (mEl) mEl.textContent = String(m).padStart(2, '0');
            if (sEl) sEl.textContent = String(s).padStart(2, '0');
        }
        updateCountdown();
        setInterval(updateCountdown, 1000);
    })();

    // ── NEWSLETTER ──
    (function () {
        var form = document.getElementById('newsletterForm');
        if (!form) return;
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var btn = document.getElementById('newsletterBtn');
            if (btn) {
                btn.innerHTML = '<i class="bi bi-check-lg"></i> Subscribed!';
                btn.disabled = true;
                setTimeout(function () {
                    btn.innerHTML = 'Subscribe <i class="bi bi-arrow-right"></i>';
                    btn.disabled = false;
                }, 2500);
            }
        });
    })();

    // ── SEARCH CLEAR ──
    (function () {
        function setupClear(inputId, clearId) {
            var input = document.getElementById(inputId);
            var btn = document.getElementById(clearId);
            if (!input || !btn) return;
            input.addEventListener('input', function () {
                btn.classList.toggle('hidden', input.value.trim() === '');
            });
            btn.addEventListener('click', function () {
                input.value = '';
                btn.classList.add('hidden');
                input.focus();
            });
        }
        setupClear('navSearchInput', 'navSearchClear');
        setupClear('mobileSearchInput', 'mobileSearchClear');

        // Ctrl+K shortcut
        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey && e.key.toLowerCase() === 'k') ||
                (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName))) {
                e.preventDefault();
                var si = document.getElementById('navSearchInput');
                if (si && window.innerWidth >= 1024) si.focus();
                else openMobileMenu();
            }
        });
    })();

    // ── CART TOAST ──
    window.showCartToast = function (title, message) {
        var toast = document.getElementById('cartToast');
        if (!toast) return;
        if (title) document.getElementById('cartToastTitle').textContent = title;
        if (message) document.getElementById('cartToastMsg').textContent = message;
        toast.classList.remove('hidden');
        clearTimeout(window._cartToastTimer);
        window._cartToastTimer = setTimeout(function () {
            toast.classList.add('hidden');
        }, 3500);
    };

    document.addEventListener('cart:updated', async function (e) {
        if (e && e.detail && e.detail.toast) {
            window.showCartToast(e.detail.title || "Added to bag!", e.detail.message || "Item was successfully added.");
        }
        try {
            var res = await fetch('/Cart/GetCount');
            if (res.ok) {
                var data = await res.json();
                var badge = document.getElementById('cartBadge');
                if (badge) {
                    badge.textContent = data.count;
                    badge.classList.toggle('hidden', data.count === 0);
                }
            }
        } catch (err) { }
    });
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
