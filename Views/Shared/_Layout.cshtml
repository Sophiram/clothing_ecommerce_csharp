    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 2050;">
        <div id="cartToast" class="toast align-items-center border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 14px; background: #0f172a; color: white;">
            <div class="d-flex p-2 align-items-center">
                <div class="toast-body d-flex align-items-center gap-3">
                    <span class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; flex-shrink: 0;">
