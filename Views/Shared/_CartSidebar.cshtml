@inject WebApplication_ClothingEcommerce.Data.AppDbContext DbContext
@inject Microsoft.AspNetCore.Identity.UserManager<WebApplication_ClothingEcommerce.Models.ApplicationUser> UserManager
@using Microsoft.EntityFrameworkCore

@{
    var userEmail = User.Identity?.Name;
    var customer = !string.IsNullOrEmpty(userEmail)
        ? DbContext.Customers.FirstOrDefault(c => c.Email == userEmail)
        : null;

    var cart = customer != null
        ? DbContext.Carts
            .Include(c => c.Items).ThenInclude(i => i.Variant).ThenInclude(v => v.Product).ThenInclude(p => p.Images)
            .Include(c => c.Items).ThenInclude(i => i.Variant).ThenInclude(v => v.Product).ThenInclude(p => p.Brand)
            .Include(c => c.Items).ThenInclude(i => i.Variant).ThenInclude(v => v.Size)
            .Include(c => c.Items).ThenInclude(i => i.Variant).ThenInclude(v => v.Color)
            .FirstOrDefault(c => c.CustomerId == customer.Id)
        : null;

    var cartItems = cart?.Items?.ToList() ?? new List<WebApplication_ClothingEcommerce.Models.CartItem>();
    var totalQuantity = cartItems.Sum(i => i.Quantity);
    var subtotal = cartItems.Where(i => i.Variant != null).Sum(i => i.Quantity * i.Variant!.Price);
    var freeShippingThreshold = 50.00m;
    var amountNeeded = Math.Max(0, freeShippingThreshold - subtotal);
    var progressPercent = Math.Min(100, (int)((subtotal / freeShippingThreshold) * 100));
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<style>
    .clothe-cart-drawer {
        width: 440px !important;
        max-width: 90vw;
        border-left: 1px solid rgba(0,0,0,0.08);
        box-shadow: -10px 0 40px rgba(0,0,0,0.12);
        display: flex;
        flex-direction: column;
        z-index: 1060;
    }

    .clothe-cart-drawer .offcanvas-header {
        padding: 18px 24px;
        border-bottom: 1px solid #f1f3f4;
        background: #ffffff;
    }

    .clothe-cart-drawer-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #202124;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .clothe-cart-drawer-badge {
        background: #f1f3f4;
        color: #5f6368;
        font-size: 12px;
        font-weight: 700;
        padding: 2px 9px;
        border-radius: 50px;
    }

    /* Free Shipping Progress Strip */
    .cart-drawer-shipping-meter {
        background: #f8fafc;
        border-bottom: 1px solid #f1f3f4;
        padding: 14px 24px;
    }

    .cart-drawer-shipping-text {
        font-size: 12.5px;
        color: #3c4043;
        margin-bottom: 8px;
    }

    .cart-drawer-progress {
        height: 6px;
        background: #e8eaed;
        border-radius: 50px;
        overflow: hidden;
    }

    .cart-drawer-progress-bar {
        background: linear-gradient(90deg, #4285F4, #34A853);
        height: 100%;
        border-radius: 50px;
        transition: width .3s ease;
    }

    /* Drawer Scrollable Body */
    .clothe-cart-drawer-body {
        padding: 0;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    /* ========================================================
       EMPTY STATE IN SIDEBAR (like other top platforms)
       ======================================================== */
    .cart-drawer-empty {
        padding: 40px 28px;
        text-align: center;
        margin: auto 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .cart-drawer-empty-icon-wrap {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(66, 133, 244, 0.08), rgba(52, 168, 83, 0.08));
        border: 2px dashed rgba(66, 133, 244, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        color: #4285F4;
        font-size: 42px;
        position: relative;
    }

    .cart-drawer-empty-icon-pulse {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 2px solid rgba(66, 133, 244, 0.2);
        animation: empty-pulse 2s infinite ease-out;
    }

    @@keyframes empty-pulse {
        0% { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(1.3); opacity: 0; }
    }

    .cart-drawer-empty-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #202124;
        margin-bottom: 8px;
        letter-spacing: -0.02em;
    }

    .cart-drawer-empty-text {
        font-size: 13.5px;
        color: #5f6368;
        line-height: 1.5;
        margin-bottom: 24px;
        max-width: 320px;
    }

    .cart-drawer-shop-btn {
        background: #202124;
        color: #ffffff !important;
        font-weight: 700;
        font-size: 14px;
        border-radius: 50px;
        padding: 13px 28px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s ease;
        box-shadow: 0 4px 14px rgba(32, 33, 36, 0.2);
        margin-bottom: 28px;
    }

    .cart-drawer-shop-btn:hover {
        background: #000000;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    }

    .cart-drawer-explore-title {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #80868b;
        margin-bottom: 12px;
    }

    .cart-drawer-pills-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        margin-bottom: 30px;
    }

    .cart-drawer-explore-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 14px;
        border-radius: 50px;
        background: #f8f9fa;
        border: 1px solid #e8eaed;
        color: #3c4043;
        font-size: 12.5px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
    }

    .cart-drawer-explore-pill:hover {
        background: #e8f0fe;
        border-color: #4285F4;
        color: #1a73e8;
    }

    .cart-drawer-perks {
        width: 100%;
        border-top: 1px solid #f1f3f4;
        padding-top: 20px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .cart-drawer-perk-item {
        font-size: 11px;
        color: #5f6368;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        text-align: center;
    }

    .cart-drawer-perk-item i {
        font-size: 16px;
        color: #4285F4;
    }

    /* Populated Items List */
    .cart-drawer-item {
        padding: 16px 20px;
        border-bottom: 1px solid #f1f3f4;
        display: flex;
        gap: 14px;
        position: relative;
    }

    .cart-drawer-item-img {
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #f1f3f4;
        flex-shrink: 0;
    }

    .cart-drawer-item-img-placeholder {
        width: 72px;
        height: 72px;
        border-radius: 12px;
        background: #f8f9fa;
        border: 1px solid #f1f3f4;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9aa0a6;
        font-size: 24px;
        flex-shrink: 0;
    }

    .cart-drawer-item-info {
        flex: 1;
        min-width: 0;
    }

    .cart-drawer-item-brand {
        font-size: 10.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #4285F4;
    }

    .cart-drawer-item-title {
        font-size: 13.5px;
        font-weight: 700;
        color: #202124;
        text-decoration: none;
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 4px;
    }

    .cart-drawer-item-title:hover {
        color: #4285F4;
    }

    .cart-drawer-item-attrs {
        font-size: 11.5px;
        color: #5f6368;
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
    }

    .cart-drawer-stepper {
        display: inline-flex;
        align-items: center;
        border: 1px solid #dadce0;
        border-radius: 50px;
        background: #ffffff;
        padding: 2px;
    }

    .cart-drawer-stepper-btn {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 0;
        background: transparent;
        color: #3c4043;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        transition: background .2s ease;
        padding: 0;
    }

    .cart-drawer-stepper-btn:hover {
        background: #f1f3f4;
        color: #202124;
    }

    .cart-drawer-stepper-qty {
        min-width: 28px;
        text-align: center;
        font-size: 12.5px;
        font-weight: 700;
        color: #202124;
    }

    .cart-drawer-delete-btn {
        background: transparent;
        border: 0;
        color: #9aa0a6;
        font-size: 14px;
        cursor: pointer;
        padding: 4px;
        transition: color .2s ease;
    }

    .cart-drawer-delete-btn:hover {
        color: #ea4335;
    }

    /* Footer */
    .clothe-cart-drawer-footer {
        padding: 20px 24px;
        background: #ffffff;
        border-top: 1px solid #f1f3f4;
        box-shadow: 0 -4px 16px rgba(0,0,0,0.03);
    }

    .cart-drawer-subtotal-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .cart-drawer-subtotal-val {
        font-size: 1.25rem;
        font-weight: 800;
        color: #202124;
    }
</style>

<!-- CART SIDEBAR OFFCANVAS DRAWER -->
<div class="offcanvas offcanvas-end clothe-cart-drawer" tabindex="-1" id="cartSidebarDrawer" aria-labelledby="cartSidebarLabel">
    
    <!-- HEADER -->
    <div class="offcanvas-header">
        <h5 class="clothe-cart-drawer-title" id="cartSidebarLabel">
            <i class="bi bi-bag"></i>
            <span>Shopping Bag</span>
            <span class="clothe-cart-drawer-badge">@totalQuantity @(totalQuantity == 1 ? "item" : "items")</span>
        </h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <!-- FREE SHIPPING PROGRESS STRIP -->
    <div class="cart-drawer-shipping-meter">
        <div class="d-flex justify-content-between align-items-center cart-drawer-shipping-text">
            @if (cartItems.Count == 0)
            {
                <span><i class="bi bi-truck text-primary me-1"></i> Free delivery on orders over <strong>$@freeShippingThreshold.ToString("0.00")</strong></span>
            }
            else if (amountNeeded > 0)
            {
                <span>Add <strong>$@amountNeeded.ToString("0.00")</strong> more for <strong>FREE Delivery</strong></span>
                <span class="fw-bold text-primary small">@progressPercent%</span>
            }
            else
            {
                <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> You unlocked FREE Delivery!</span>
                <span class="badge bg-success rounded-pill small">100%</span>
            }
        </div>
        <div class="cart-drawer-progress">
            <div class="cart-drawer-progress-bar" style="width: @(cartItems.Count == 0 ? 0 : progressPercent)%"></div>
        </div>
    </div>

    <!-- BODY -->
    <div class="clothe-cart-drawer-body">
        @if (cartItems.Count == 0)
        {
            <!-- ========================================================
                 EMPTY CART SIDEBAR VIEW (requested by user)
                 ======================================================== -->
            <div class="cart-drawer-empty">
                <div class="cart-drawer-empty-icon-wrap">
                    <div class="cart-drawer-empty-icon-pulse"></div>
                    <i class="bi bi-bag-x"></i>
                </div>

                <h4 class="cart-drawer-empty-title">Your bag is empty</h4>
                <p class="cart-drawer-empty-text">
                    Looks like you haven't added anything to your cart yet. Explore our curated collections to find your new favorites.
                </p>

                <a asp-controller="Shop" asp-action="Index" class="cart-drawer-shop-btn">
                    <span>Start Shopping</span>
                    <i class="bi bi-arrow-right"></i>
                </a>

                <div class="cart-drawer-explore-title">POPULAR COLLECTIONS</div>
                <div class="cart-drawer-pills-wrap">
                    <a asp-controller="Shop" asp-action="Index" asp-route-onSale="true" class="cart-drawer-explore-pill text-danger">
                        <span>🔥 Sale & Promotions</span>
                    </a>
                    <a asp-controller="Shop" asp-action="Index" asp-route-sort="newest" class="cart-drawer-explore-pill">
                        <span>✨ New Arrivals</span>
                    </a>
                    <a asp-controller="Shop" asp-action="Index" asp-route-sort="popularity" class="cart-drawer-explore-pill">
                        <span>⭐ Best Sellers</span>
                    </a>
                    <a asp-controller="Shop" asp-action="Index" class="cart-drawer-explore-pill">
                        <span>👕 All Clothing</span>
                    </a>
                </div>

                <div class="cart-drawer-perks">
                    <div class="cart-drawer-perk-item">
                        <i class="bi bi-lightning-charge"></i>
                        <span>Fast Delivery</span>
                    </div>
                    <div class="cart-drawer-perk-item">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>30-Day Returns</span>
                    </div>
                    <div class="cart-drawer-perk-item">
                        <i class="bi bi-shield-check"></i>
                        <span>Secure Checkout</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- ========================================================
                 POPULATED CART ITEMS IN SIDEBAR
                 ======================================================== -->
            <div class="cart-drawer-items-list">
                @foreach (var item in cartItems)
                {
                    var image = item.Variant?.Product?.Images?.FirstOrDefault(x => x.IsPrimary)
                                ?? item.Variant?.Product?.Images?.FirstOrDefault();
                    var itemTotal = item.Quantity * (item.Variant?.Price ?? 0);

                    <div class="cart-drawer-item">
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Variant?.ProductId">
                            @if (!string.IsNullOrWhiteSpace(image?.ImageUrl))
                            {
                                <img src="@image.ImageUrl" alt="@item.Variant?.Product?.Name" class="cart-drawer-item-img" />
                            }
                            else
                            {
                                <div class="cart-drawer-item-img-placeholder">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                        </a>

                        <div class="cart-drawer-item-info">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <span class="cart-drawer-item-brand">
                                    @(item.Variant?.Product?.Brand?.Name ?? "CLOTHÉ")
                                </span>
                                <form asp-controller="Cart" asp-action="Remove" method="post" class="m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <button type="submit" class="cart-drawer-delete-btn" title="Remove item">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>

                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Variant?.ProductId" class="cart-drawer-item-title">
                                @(item.Variant?.Product?.Name ?? "Product Name")
                            </a>

                            <div class="cart-drawer-item-attrs">
                                @if (item.Variant?.Size != null)
                                {
                                    <span>Size: <strong>@item.Variant.Size.Name</strong></span>
                                }
                                @if (item.Variant?.Color != null)
                                {
                                    <span class="d-inline-flex align-items-center gap-1">
                                        Color: 
                                        @if (!string.IsNullOrEmpty(item.Variant.Color.HexCode))
                                        {
                                            <span style="width: 10px; height: 10px; border-radius: 50%; background: @item.Variant.Color.HexCode; display: inline-block; border: 1px solid #ccc;"></span>
                                        }
                                        <strong>@item.Variant.Color.Name</strong>
                                    </span>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <!-- Stepper Form -->
                                <div class="cart-drawer-stepper">
                                    <form asp-controller="Cart" asp-action="Update" method="post" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                        <button type="submit" class="cart-drawer-stepper-btn" title="Decrease">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                    </form>

                                    <span class="cart-drawer-stepper-qty">@item.Quantity</span>

                                    <form asp-controller="Cart" asp-action="Update" method="post" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                        <button type="submit" class="cart-drawer-stepper-btn" title="Increase">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </form>
                                </div>

                                <strong class="text-dark" style="font-size: 13.5px;">
                                    $@itemTotal.ToString("0.00")
                                </strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- FOOTER (Only when cart has items) -->
    @if (cartItems.Count > 0)
    {
        <div class="clothe-cart-drawer-footer">
            <div class="cart-drawer-subtotal-row">
                <span class="text-secondary fw-semibold" style="font-size: 14px;">Subtotal</span>
                <span class="cart-drawer-subtotal-val">$@subtotal.ToString("0.00")</span>
            </div>
            <p class="text-secondary small mb-3" style="font-size: 12px;">
                Taxes and shipping calculated at checkout.
            </p>

            <div class="d-grid gap-2">
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-dark rounded-pill py-2 fw-bold d-flex align-items-center justify-content-center gap-2" style="font-size: 14px; background: #202124;">
                    <span>Checkout Now</span>
                    <i class="bi bi-arrow-right"></i>
                </a>

                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold" style="font-size: 13.5px;">
                    View Full Bag
                </a>
            </div>

            <div class="d-flex align-items-center justify-content-center gap-3 mt-3 text-secondary small" style="font-size: 11px;">
                <span><i class="bi bi-shield-check text-success me-1"></i>Encrypted Checkout</span>
                <span>•</span>
                <span><i class="bi bi-arrow-repeat text-primary me-1"></i>30-Day Returns</span>
            </div>
        </div>
    }

</div>
