@model WebApplication_ClothingEcommerce.Models.Cart

@{
    ViewData["Title"] = "Cart Details";
    var customer = Model?.Customer;
    var items = Model?.Items?.ToList() ?? new List<WebApplication_ClothingEcommerce.Models.CartItem>();
    var totalQuantity = items.Sum(i => i.Quantity);
    var subtotal = items.Sum(i => (i.Variant?.Price ?? 0) * i.Quantity);
}

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <!-- Breadcrumb -->
            <nav class="flex mb-2" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                    <li class="inline-flex items-center">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hover:text-primary-600 dark:hover:text-primary-400">Admin</a>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span data-en="Commerce" data-kh="ពាណិជ្ជកម្ម">Commerce</span>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span class="text-slate-900 dark:text-white font-semibold" data-en="Cart Details" data-kh="ព័ត៌មានលម្អិតកន្ត្រក">Cart Details</span>
                    </li>
                </ol>
            </nav>

            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950/50 text-primary-600 dark:text-primary-400 flex items-center justify-center text-lg">
                    <i class="bi bi-cart3"></i>
                </span>
                <span data-en="Shopping Cart Details" data-kh="ព័ត៌មានលម្អិតកន្ត្រកទំនិញ">Shopping Cart Details</span>
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Active customer cart session, registered reserved items, and checkout readiness.
            </p>
        </div>

        <div class="flex items-center gap-2.5">
            @if (Model != null && Model.CustomerId != Guid.Empty)
            {
                <a asp-controller="Cart" asp-action="Index" asp-route-customerId="@Model?.CustomerId" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold shadow-sm transition">
                    <i class="bi bi-pencil-square"></i>
                    <span>Manage Cart Session</span>
                </a>
            }
            <form asp-controller="Cart" asp-action="SeedSample" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="customerId" value="@(Model?.CustomerId ?? ViewBag.CustomerId)" />
                <button type="submit" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-sm transition">
                    <i class="bi bi-plus-circle"></i>
                    <span>Populate Sample Items</span>
                </button>
            </form>
        </div>
    </div>

    <!-- 2-COLUMN LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- LEFT COLUMN: Cart Items Table (8 cols) -->
        <div class="lg:col-span-8 bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i class="bi bi-box-seam text-primary-500"></i>
                    <span>Cart Items (@items.Count)</span>
                </h2>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Total Units: @totalQuantity</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                            <th class="py-3.5 pl-6 pr-4">Item Details</th>
                            <th class="py-3.5 px-4">Variant Info</th>
                            <th class="py-3.5 px-4 text-center">Qty</th>
                            <th class="py-3.5 px-4 text-right">Unit Price</th>
                            <th class="py-3.5 pl-4 pr-6 text-right">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 text-sm">
                        @if (!items.Any())
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center text-slate-500 dark:text-slate-400">
                                    <i class="bi bi-cart-x text-3xl text-slate-400 mb-2 block"></i>
                                    <div class="font-semibold text-sm">This cart is currently empty.</div>
                                    <form asp-controller="Cart" asp-action="SeedSample" method="post" class="mt-3 inline-block">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="customerId" value="@(Model?.CustomerId ?? ViewBag.CustomerId)" />
                                        <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold shadow-sm transition">
                                            <i class="bi bi-plus-circle"></i>
                                            <span>Populate Sample Items</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in items)
                            {
                                var prod = item.Variant?.Product;
                                var img = prod?.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? prod?.Images?.FirstOrDefault()?.ImageUrl;
                                var price = item.Variant?.Price ?? 0;
                                var total = price * item.Quantity;

                                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                                    <td class="py-4 pl-6 pr-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-12 h-14 rounded-xl bg-slate-100 dark:bg-slate-800 overflow-hidden border border-slate-200 dark:border-slate-700 flex-shrink-0">
                                                @if (!string.IsNullOrEmpty(img))
                                                {
                                                    <img src="@img" alt="@(prod?.Name ?? "Item")" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full flex items-center justify-center text-slate-400"><i class="bi bi-image text-lg"></i></div>
                                                }
                                            </div>
                                            <div class="min-w-0">
                                                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 block">
                                                    @(prod?.Brand?.Name ?? "Brand")
                                                </span>
                                                <a asp-controller="CartItems" asp-action="Details" asp-route-id="@item.Id" class="text-sm font-semibold text-slate-900 dark:text-white hover:text-primary-600 transition truncate block">
                                                    @(prod?.Name ?? "Product Item")
                                                </a>
                                                <span class="font-mono text-[11px] text-slate-400 block">SKU: @(item.Variant?.SKU ?? "N/A")</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="py-4 px-4 text-xs text-slate-600 dark:text-slate-300">
                                        <div>Color: <strong class="text-slate-800 dark:text-slate-200">@(item.Variant?.Color?.Name ?? "-")</strong></div>
                                        <div>Size: <strong class="text-slate-800 dark:text-slate-200">@(item.Variant?.Size?.Name ?? "-")</strong></div>
                                    </td>

                                    <td class="py-4 px-4 text-center font-bold text-slate-800 dark:text-slate-200">
                                        @item.Quantity
                                    </td>

                                    <td class="py-4 px-4 text-right text-xs font-medium text-slate-600 dark:text-slate-300">
                                        $@price.ToString("N2")
                                    </td>

                                    <td class="py-4 pl-4 pr-6 text-right font-extrabold text-slate-900 dark:text-white">
                                        $@total.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- RIGHT COLUMN: Customer & Summary (4 cols) -->
        <div class="lg:col-span-4 space-y-6">

            <!-- Summary Card -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-4">
                <h3 class="text-base font-bold text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800">
                    Cart Financials
                </h3>

                <div class="space-y-2.5 text-xs">
                    <div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
                        <span>Items Subtotal</span>
                        <span class="font-bold text-slate-900 dark:text-white">$@subtotal.ToString("N2")</span>
                    </div>

                    <div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
                        <span>Total Items</span>
                        <span class="font-bold text-slate-900 dark:text-white">@totalQuantity</span>
                    </div>

                    <div class="border-t border-slate-100 dark:border-slate-800 pt-3 flex items-center justify-between">
                        <span class="text-sm font-bold text-slate-900 dark:text-white">Estimated Total</span>
                        <span class="text-xl font-extrabold text-primary-600 dark:text-primary-400">$@subtotal.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- Customer Owner Card -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-3">
                <h3 class="text-base font-bold text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800">
                    Cart Customer
                </h3>

                @if (customer != null)
                {
                    <div class="space-y-2 text-xs">
                        <div>
                            <span class="text-slate-400 uppercase font-semibold text-[10px] block">Customer</span>
                            <strong class="text-sm text-slate-900 dark:text-white">@customer.FirstName @customer.LastName</strong>
                        </div>
                        <div>
                            <span class="text-slate-400 uppercase font-semibold text-[10px] block">Email</span>
                            <span class="text-slate-800 dark:text-slate-200">@customer.Email</span>
                        </div>
                        <div class="pt-2">
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id" class="inline-flex items-center gap-1 text-xs font-semibold text-primary-600 hover:underline">
                                Customer Profile <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-xs text-slate-400 italic">No customer profile linked.</p>
                }
            </div>

        </div>
    </div>
</div>
