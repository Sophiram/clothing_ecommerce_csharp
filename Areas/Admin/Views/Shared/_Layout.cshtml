<!-- =====================================================
     SWEETALERT2 (Toast Notifications)
====================================================== -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });

    window.showToast = function(type, message) {
        if (type === 'error') {
            Toast.fire({
                icon: 'error',
                title: message,
                timer: 5000 // longer duration for error
            });
        } else {
            Toast.fire({
                icon: type,
                title: message
            });
        }
    };

    document.addEventListener("DOMContentLoaded", function() {
        @if (TempData["Success"] != null)
        {
            <text>showToast('success', '@TempData["Success"]');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>showToast('error', '@TempData["Error"]');</text>
        }
        @if (TempData["Warning"] != null)
        {
            <text>showToast('warning', '@TempData["Warning"]');</text>
        }
        @if (TempData["Info"] != null)
        {
            <text>showToast('info', '@TempData["Info"]');</text>
        }
    });
</script>

@Html.AntiForgeryToken()
<!-- =====================================================
     GLOBAL AJAX MODAL
====================================================== -->
<div class="modal fade" id="globalAjaxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="globalAjaxModalBody">
            <!-- Content will be loaded here via AJAX -->
        </div>
    </div>
</div>

<script>
    // =========================================================
    //  UNIVERSAL MODAL & DROPDOWN ENGINE (Tailwind & Bootstrap Compat)
    // =========================================================
    window.openModal = function (modalElOrId, relatedTarget) {
        const el = typeof modalElOrId === 'string' ? document.querySelector(modalElOrId) : modalElOrId;
        if (!el) return;
        el.classList.add('show');
        el.style.display = 'flex';
        document.body.classList.add('modal-open');
        const ev = new CustomEvent('show.bs.modal', { bubbles: true, cancelable: true });
        if (relatedTarget) ev.relatedTarget = relatedTarget;
        el.dispatchEvent(ev);
    };

    window.closeModal = function (modalElOrId) {
        const el = typeof modalElOrId === 'string' ? document.querySelector(modalElOrId) : modalElOrId;
        if (!el) return;
        el.classList.remove('show');
        el.style.display = 'none';
        if (!document.querySelector('.modal.show, .modal[style*="display: flex"], .modal[style*="display: block"]')) {
            document.body.classList.remove('modal-open');
        }
        el.dispatchEvent(new CustomEvent('hidden.bs.modal', { bubbles: true }));
    };

    // Polyfill bootstrap.Modal
    if (typeof window.bootstrap === 'undefined') {
        window.bootstrap = {};
    }
    window.bootstrap.Modal = function (el) {
        this._element = typeof el === 'string' ? document.querySelector(el) : el;
        this.show = (relatedTarget) => window.openModal(this._element, relatedTarget);
        this.hide = () => window.closeModal(this._element);
    };
    window.bootstrap.Modal.getInstance = function (el) {
        const target = typeof el === 'string' ? document.querySelector(el) : el;
        return new window.bootstrap.Modal(target);
    };
    window.bootstrap.Modal.getOrCreateInstance = function (el) {
        const target = typeof el === 'string' ? document.querySelector(el) : el;
        return new window.bootstrap.Modal(target);
    };

    // Close all open meatball dropdowns
    window.closeAllMeatballMenus = function () {
        document.querySelectorAll('.dropdown.show, .dropdown-menu.show, .dropdown-menu-meatball').forEach(el => {
            el.classList.remove('show', 'dropup');
            if (el.classList.contains('dropdown-menu')) {
                el.style.cssText = '';
            }
        });
        document.querySelectorAll('tr[data-elevated-zindex="true"], td[data-elevated-zindex="true"]').forEach(el => {
            el.style.zIndex = '';
            el.removeAttribute('data-elevated-zindex');
        });
        document.querySelectorAll('.action-meatball-btn[aria-expanded="true"]').forEach(b => {
            b.setAttribute('aria-expanded', 'false');
        });
    };

    // Universal Table Action & Dropdown Toggle
    let lastActionBtn = null;
    let lastActionTime = 0;

    window.toggleActionMenu = function (btn, e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
            if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        }
        if (!btn) return;

        // Prevent duplicate trigger on same button within 200ms
        const now = Date.now();
        if (lastActionBtn === btn && (now - lastActionTime) < 200) {
            return;
        }
        lastActionBtn = btn;
        lastActionTime = now;

        const parent = btn.closest('.dropdown') || btn.parentElement;
        const menu = parent ? parent.querySelector('.dropdown-menu') : null;
        if (!menu) return;

        const isOpen = parent.classList.contains('show') || menu.classList.contains('show') || menu.style.display === 'block';

        // Close all other open dropdowns first
        document.querySelectorAll('.dropdown.show, .dropdown-menu.show, .dropdown-menu-meatball').forEach(el => {
            if (el !== parent && el !== menu) {
                el.classList.remove('show', 'dropup');
                if (el.classList.contains('dropdown-menu')) {
                    el.style.cssText = '';
                }
            }
        });
        document.querySelectorAll('tr[data-elevated-zindex="true"], td[data-elevated-zindex="true"]').forEach(el => {
            el.style.zIndex = '';
            el.removeAttribute('data-elevated-zindex');
        });
        document.querySelectorAll('.action-meatball-btn[aria-expanded="true"]').forEach(b => {
            if (b !== btn) b.setAttribute('aria-expanded', 'false');
        });

        const td = btn.closest('td');
        const tr = btn.closest('tr');

        if (isOpen) {
            parent.classList.remove('show', 'dropup');
            menu.classList.remove('show');
            menu.style.cssText = '';
            btn.setAttribute('aria-expanded', 'false');
            if (td) { td.style.zIndex = ''; td.removeAttribute('data-elevated-zindex'); }
            if (tr) { tr.style.zIndex = ''; tr.removeAttribute('data-elevated-zindex'); }
        } else {
            // Elevate active row and cell to z-index 999 so no other rows or buttons overlap
            if (td) { td.style.zIndex = '999'; td.setAttribute('data-elevated-zindex', 'true'); }
            if (tr) { tr.style.zIndex = '999'; tr.setAttribute('data-elevated-zindex', 'true'); }

            // Position fixed relative to viewport for pixel-perfect anchoring
            const rect = btn.getBoundingClientRect();

            // Temporarily display block & hidden to accurately measure dimensions
            menu.style.cssText = 'position: fixed !important; display: block !important; visibility: hidden !important; z-index: 999 !important; margin: 0 !important;';

            const menuWidth = menu.offsetWidth || 185;
            const menuHeight = menu.offsetHeight || 155;

            // Align menu's RIGHT border exactly flush with button's RIGHT border
            let left = Math.round(rect.right - menuWidth);
            if (left < 10) left = 10;
            if (left + menuWidth > window.innerWidth - 10) {
                left = window.innerWidth - menuWidth - 10;
            }

            // Determine whether to open downward or upward (dropup)
            const spaceBelow = window.innerHeight - rect.bottom;
            let top;
            if (spaceBelow < (menuHeight + 16) && rect.top > (menuHeight + 16)) {
                // Dropup: 6px above button
                top = Math.round(rect.top - menuHeight - 6);
                parent.classList.add('dropup');
            } else {
                // Dropdown: 6px below button
                top = Math.round(rect.bottom + 6);
                parent.classList.remove('dropup');
            }

            menu.style.setProperty('position', 'fixed', 'important');
            menu.style.setProperty('left', left + 'px', 'important');
            menu.style.setProperty('top', top + 'px', 'important');
            menu.style.setProperty('right', 'auto', 'important');
            menu.style.setProperty('bottom', 'auto', 'important');
            menu.style.setProperty('z-index', '999', 'important');
            menu.style.setProperty('visibility', 'visible', 'important');
            menu.style.setProperty('opacity', '1', 'important');
            menu.style.setProperty('pointer-events', 'auto', 'important');

            parent.classList.add('show');
            menu.classList.add('show');
            btn.setAttribute('aria-expanded', 'true');
        }
    };

    document.addEventListener("DOMContentLoaded", function () {

        // Universal Click Handler for Modals, Dropdowns, and Delete Actions
        document.addEventListener('click', function (e) {

            // 1. MODAL OPEN: [data-bs-toggle="modal"]
            const toggleModalBtn = e.target.closest('[data-bs-toggle="modal"]');
            if (toggleModalBtn) {
                e.preventDefault();
                // Close any open meatball menus when opening a modal
                window.closeAllMeatballMenus();

                const targetSel = toggleModalBtn.getAttribute('data-bs-target') || toggleModalBtn.getAttribute('href');
                if (targetSel && targetSel.startsWith('#')) {
                    const targetModal = document.querySelector(targetSel);
                    if (targetModal) {
                        window.openModal(targetModal, toggleModalBtn);
                    }
                }
                return;
            }

            // 2. MODAL DISMISS: [data-bs-dismiss="modal"]
            const dismissModalBtn = e.target.closest('[data-bs-dismiss="modal"]');
            if (dismissModalBtn) {
                e.preventDefault();
                const modal = dismissModalBtn.closest('.modal');
                if (modal) window.closeModal(modal);
                return;
            }

            // 3. BACKDROP CLICK: Click outside modal-content closes modal
            if (e.target.classList.contains('modal')) {
                window.closeModal(e.target);
                return;
            }

            // 4. BILINGUAL SWEETALERT2 DELETE CONFIRMATION: Intercept delete links
            const a = e.target.closest('a[href]');
            if (a && !a.hasAttribute('data-no-confirm')) {
                let url;
                try {
                    url = new URL(a.href, window.location.origin);
                } catch (err) { }

                if (url && url.pathname.toLowerCase().includes('/delete') && url.pathname.toLowerCase().startsWith('/admin/')) {
                    e.preventDefault();
                    window.closeAllMeatballMenus();
                    const isKh = (localStorage.getItem('site_language') || 'en') === 'kh';
                    Swal.fire({
                        title: isKh ? 'តើអ្នកប្រាកដទេ?' : 'Are you sure?',
                        text: isKh ? 'សកម្មភាពលុបនេះមិនអាចត្រឡប់វិញបានទេ។' : 'This action cannot be undone.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ea4335',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: isKh ? 'បាទ/ចាស លុបវា!' : 'Yes, delete it!',
                        cancelButtonText: isKh ? 'បោះបង់' : 'Cancel',
                        reverseButtons: true
                    }).then(result => {
                        if (result.isConfirmed) {
                            const form = document.createElement('form');
                            form.method = 'post';
                            form.action = a.href;
                            const token = document.querySelector('input[name="__RequestVerificationToken"]');
                            if (token) {
                                form.appendChild(token.cloneNode(true));
                            }
                            document.body.appendChild(form);
                            form.submit();
                        }
                    });
                    return;
                }
            }

            // 5. MEATBALL BUTTON CLICK: handled by toggleActionMenu
            const meatballBtn = e.target.closest('.action-meatball-btn, [data-action-toggle="meatball"]');
            if (meatballBtn) {
                window.toggleActionMenu(meatballBtn, e);
                return;
            }

            // 6. DROPDOWN ITEM CLICK: allow action then close menu
            if (e.target.closest('.dropdown-item')) {
                setTimeout(() => {
                    window.closeAllMeatballMenus();
                }, 100);
                return;
            }

            // 7. OUTSIDE CLICK: close all open meatball dropdowns
            if (!e.target.closest('.dropdown') && !e.target.closest('.dropdown-menu-meatball')) {
                window.closeAllMeatballMenus();
            }
        });

        // Close floating dropdown on scroll (with capture to catch table container scrolling)
        window.addEventListener('scroll', function () {
            window.closeAllMeatballMenus();
        }, { capture: true, passive: true });

        // Close floating dropdown on window resize
        window.addEventListener('resize', function () {
            window.closeAllMeatballMenus();
        }, { passive: true });

        // Close dropdown / modal on Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                window.closeAllMeatballMenus();
                const openModal = document.querySelector('.modal.show, .modal[style*="display: flex"], .modal[style*="display: block"]');
                if (openModal) window.closeModal(openModal);
            }
        });
    });
</script>

@await RenderSectionAsync("Scripts", required: false)

