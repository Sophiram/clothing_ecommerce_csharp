<!-- =====================================================
     SWEETALERT2 (Toast Notifications)
====================================================== -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });

    window.showToast = function(type, message) {
        if (type === 'error') {
            Toast.fire({
                icon: 'error',
                title: message,
                timer: 5000 // longer duration for error
            });
        } else {
            Toast.fire({
                icon: type,
                title: message
            });
        }
    };

    document.addEventListener("DOMContentLoaded", function() {
        @if (TempData["Success"] != null)
        {
            <text>showToast('success', '@TempData["Success"]');</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>showToast('error', '@TempData["Error"]');</text>
        }
        @if (TempData["Warning"] != null)
        {
            <text>showToast('warning', '@TempData["Warning"]');</text>
        }
        @if (TempData["Info"] != null)
        {
            <text>showToast('info', '@TempData["Info"]');</text>
        }
    });
</script>

@Html.AntiForgeryToken()
<!-- =====================================================
     GLOBAL AJAX MODAL
====================================================== -->
<div class="modal fade" id="globalAjaxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="globalAjaxModalBody">
            <!-- Content will be loaded here via AJAX -->
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modalEl = document.getElementById('globalAjaxModal');
        const modalBody = document.getElementById('globalAjaxModalBody');
        const ajaxModal = new bootstrap.Modal(modalEl);

        document.addEventListener('click', function (e) {
            // Find if a relevant link was clicked
            const a = e.target.closest('a[href]');
            if (!a) return;

            if (a.hasAttribute('data-no-ajax')) return;

            // Use URL object to reliably get the pathname
            let url;
            try {
                url = new URL(a.href, window.location.origin);
            } catch (err) {
                return; // Invalid URL, let browser handle it
            }

            const path = url.pathname.toLowerCase();
            
            // Only intercept links within the Admin area
            if (!path.startsWith('/admin/')) return;

            const isCreateOrEdit = path.includes('/create') || path.includes('/edit');
            const isDelete = path.includes('/delete');

            if (isDelete) {
                e.preventDefault();
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'This action cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ea4335',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it!'
                }).then(result => {
                    if (result.isConfirmed) {
                        const form = document.createElement('form');
                        form.method = 'post';
                        form.action = a.href; // Use full href for the form action
                        const token = document.querySelector('input[name="__RequestVerificationToken"]');
                        if (token) {
                            form.appendChild(token.cloneNode());
                        }
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
                return;
            }

            if (isCreateOrEdit) {
                e.preventDefault();
                modalBody.innerHTML = '<div class="text-center p-5"><div class="spinner-border text-primary" role="status"></div></div>';
                ajaxModal.show();

                fetch(a.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(res => res.text())
                    .then(html => {
                        modalBody.innerHTML = html;
                    })
                    .catch(() => {
                        modalBody.innerHTML = '<div class="p-4 text-danger">Failed to load content.</div>';
                    });
            }
        });

        // Intercept form submissions inside the modal
        document.addEventListener('submit', function (e) {
            if (!modalBody.contains(e.target)) return;

            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;

            fetch(form.action, {
                method: form.method || 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => {
                if (res.redirected) {
                    window.location.href = res.url;
                } else if (res.ok) {
                    return res.text();
                } else {
                    window.showToast('error', 'An error occurred.');
                    if (submitBtn) submitBtn.disabled = false;
                }
            })
            .then(html => {
                if (html) {
                    modalBody.innerHTML = html;
                }
            })
            .catch(() => {
                window.showToast('error', 'Network error.');
                if (submitBtn) submitBtn.disabled = false;
            });
        });
    });
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>