    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Kantumruy+Pro:ital,wght@0,100..700;1,100..700&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Compiled Tailwind CSS -->
    <link rel="stylesheet"
          href="~/css/tailwind.css"
          asp-append-version="true" />

    <!-- Admin CSS -->
    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <!-- Global Theme & i18n Engine -->
    <script src="~/js/site-theme-i18n.js" asp-append-version="true"></script>

    <script>
        (function () {
            var stored = localStorage.getItem('site_theme');
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var isDark = stored === 'dark' || (!stored && prefersDark);
            if (isDark) {
                document.documentElement.classList.add('dark', 'dark-mode');
            } else {
                document.documentElement.classList.remove('dark', 'dark-mode');
            }
        })();
    </script>
</head>


