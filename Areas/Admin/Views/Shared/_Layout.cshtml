@using Microsoft.AspNetCore.Identity
@using WebApplication_ClothingEcommerce.Models
@inject WebApplication_ClothingEcommerce.Data.AppDbContext DbContext
@{
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var roleTitle = isSuperAdmin ? "Super Administrator" : "Store Administrator";

    string userEmail = User.Identity?.Name ?? "";
    string userDisplayName = userEmail.Split('@')[0];
    string userFirstName = "";
    string userFirstLetter = !string.IsNullOrEmpty(userDisplayName) ? userDisplayName.Substring(0, 1).ToUpper() : "A";
    string? userAvatarUrl = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        try
        {
            var appUser = DbContext.Users.FirstOrDefault(u => u.UserName == userEmail || u.Email == userEmail);
            if (appUser != null)
            {
                userEmail = appUser.Email ?? userEmail;
                if (!string.IsNullOrWhiteSpace(appUser.FullName))
                {
                    userDisplayName = appUser.FullName;
                    userFirstName = appUser.FirstName;
                    userFirstLetter = !string.IsNullOrWhiteSpace(appUser.FirstName) 
                        ? appUser.FirstName.Substring(0, 1).ToUpper() 
                        : appUser.FullName.Substring(0, 1).ToUpper();
                }
                else if (!string.IsNullOrWhiteSpace(appUser.FirstName))
                {
                    userDisplayName = appUser.FirstName;
                    userFirstName = appUser.FirstName;
                    userFirstLetter = appUser.FirstName.Substring(0, 1).ToUpper();
                }

                var avatarFolder = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "uploads", "avatars");
                if (System.IO.Directory.Exists(avatarFolder))
                {
                    var files = System.IO.Directory.GetFiles(avatarFolder, $"{appUser.Id}.*");
                    if (files.Length > 0)
                    {
                        var fi = new System.IO.FileInfo(files[0]);
                        userAvatarUrl = $"/uploads/avatars/{System.IO.Path.GetFileName(files[0])}?v={fi.LastWriteTimeUtc.Ticks}";
                    }
                }
            }
        }
        catch { }
    }

    // Dynamic Admin Notifications (Unread Messages & Recent Orders)
    var unreadContactCount = 0;
    var unreadContactList = new List<WebApplication_ClothingEcommerce.Models.ContactMessage>();
    var recentOrdersCount = 0;
    var recentOrdersList = new List<WebApplication_ClothingEcommerce.Models.Order>();

    if (User.Identity?.IsAuthenticated == true)
    {
        try
        {
            unreadContactCount = DbContext.ContactMessages.Count(m => !m.IsRead);
            unreadContactList = DbContext.ContactMessages
                .Where(m => !m.IsRead)
                .OrderByDescending(m => m.CreatedAt)
                .Take(4)
                .ToList();

            recentOrdersCount = DbContext.Orders
                .Count(o => o.Status == WebApplication_ClothingEcommerce.Data.Enums.OrderStatus.Pending 
                         || o.Status == WebApplication_ClothingEcommerce.Data.Enums.OrderStatus.Processing);

            recentOrdersList = Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.Include(
                DbContext.Orders, o => o.Customer)
                .OrderByDescending(o => o.OrderDate)
                .Take(4)
                .ToList();
        }
        catch { }
    }

    var totalNotificationBadgeCount = unreadContactCount + recentOrdersCount;

    string FormatNotificationTime(DateTime dt)
    {
        var span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return dt.ToString("dd MMM");
    }
}

