@model WebApplication_ClothingEcommerce.Models.Color
@{
    ViewData["Title"] = "Color Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i> Back to Colors</a>
            <h2 class="fw-bold mt-3 mb-1">@Model.Name</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i> Delete</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3"><h5 class="fw-bold mb-0">Color Preview</h5></div>
                <div class="card-body text-center py-4">
                    <div class="rounded-circle mx-auto mb-3 shadow-sm border" style="width: 80px; height: 80px; background-color: @Model.HexCode;"></div>
                    <h6 class="fw-bold mb-1">@Model.Name</h6>
                    <span class="font-monospace text-muted">@Model.HexCode</span>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Product Variants with this Color</h5>
                    <span class="badge bg-info text-dark rounded-pill">@(Model.Variants?.Count ?? 0)</span>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (Model.Variants != null && Model.Variants.Any())
                        {
                            foreach (var item in Model.Variants)
                            {
                                <li class="list-group-item p-3">
                                    <span class="fw-semibold">Variant ID: @item.Id</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item p-4 text-center text-muted">No variants assigned to this color.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>