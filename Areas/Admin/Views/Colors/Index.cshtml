@model IEnumerable<WebApplication_ClothingEcommerce.Models.Color>

@{
    ViewData["Title"] = "Colors";
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Colors</h1>
            <p class="page-description">Manage product colors.</p>
        </div>

        <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createColorModal">
            <i class="bi bi-plus-lg"></i> Add Color
        </button>
    </div>

    <div id="alertPlaceholder"></div>

    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">All Colors</h3>
                <p class="admin-card-subtitle">Manage colors used across product variants</p>
            </div>
            <div class="admin-card-count">
                <span>@Model.Count()</span>
                <small>total</small>
            </div>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Color Name</th>
                        <th>Hex Code / Preview</th>
                        <th>Variants Linked</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="payment-name">@item.Name</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="color-swatch" style="background-color: @item.HexCode;"></div>
                                        <span class="font-monospace text-muted small">@item.HexCode</span>
                                    </div>
                                </td>
                                <td><span class="payment-count">@(item.Variants?.Count ?? 0)</span></td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button type="button" class="action-btn action-warning" title="Edit"
                                                data-bs-toggle="modal" data-bs-target="#editColorModal"
                                                data-id="@item.Id"
                                                data-name="@item.Name"
                                                data-hex="@item.HexCode">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="action-btn action-danger" title="Delete"
                                                data-bs-toggle="modal" data-bs-target="#deleteColorModal"
                                                data-id="@item.Id"
                                                data-name="@item.Name">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-palette"></i></div>
                                    <h5>No colors found</h5>
                                    <p>Add your first color to start managing variants.</p>
                                    <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createColorModal">
                                        <i class="bi bi-plus-lg"></i> Add Color
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

<!-- Create Modal -->
<div class="modal fade" id="createColorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createColorForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Color</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="createErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Color Name</label>
                        <input name="Name" class="form-control" placeholder="e.g. Midnight Blue" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hex Code</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" id="createColorPicker" class="form-control form-control-color" value="#000000" />
                            <input type="text" name="HexCode" id="createHexInput" class="form-control font-monospace" value="#000000" pattern="^#[0-9A-Fa-f]{6}$" required />
                        </div>
                        <small class="text-muted">Format: #RRGGBB</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editColorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editColorForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Color</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="editErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Color Name</label>
                        <input name="Name" id="editName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hex Code</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" id="editColorPicker" class="form-control form-control-color" />
                            <input type="text" name="HexCode" id="editHexInput" class="form-control font-monospace" pattern="^#[0-9A-Fa-f]{6}$" required />
                        </div>
                        <small class="text-muted">Format: #RRGGBB</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteColorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteColorForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header">
                    <h5 class="modal-title">Delete Color</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="deleteErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <p>Are you sure you want to delete <strong id="deleteName"></strong>? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="action-btn action-danger" style="width:auto;padding:8px 18px;">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .color-swatch {
        width: 24px;
        height: 24px;
        border-radius: 999px;
        border: 1px solid rgba(0,0,0,0.15);
    }

    .form-control-color {
        width: 52px;
        height: 38px;
        padding: 4px;
    }
</style>

@section Scripts {
    <script>
        function showAlert(type, message) {
            const placeholder = document.getElementById('alertPlaceholder');
            const cls = type === 'success' ? 'admin-alert-success' : 'admin-alert-danger';
            const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
            placeholder.innerHTML = `<div class="admin-alert ${cls}"><i class="bi ${icon}"></i> ${message}</div>`;
        }

        function showErrors(boxId, errors) {
            const box = document.getElementById(boxId);
            box.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> ' + errors.join('<br />');
            box.classList.remove('d-none');
        }

        function hideErrors(boxId) {
            document.getElementById(boxId).classList.add('d-none');
        }

        async function postForm(url, form, errorBoxId) {
            hideErrors(errorBoxId);
            const formData = new FormData(form);

            const response = await fetch(url, { method: 'POST', body: formData });

            let data = {};
            try { data = await response.json(); } catch { }

            if (!response.ok) {
                showErrors(errorBoxId, data.errors || ['Something went wrong.']);
                return null;
            }
            return data;
        }

        // ---- Sync color picker <-> hex text input ----
        function linkColorInputs(pickerId, textId) {
            const picker = document.getElementById(pickerId);
            const text = document.getElementById(textId);

            picker.addEventListener('input', () => text.value = picker.value.toUpperCase());
            text.addEventListener('input', () => {
                if (/^#[0-9A-Fa-f]{6}$/.test(text.value)) {
                    picker.value = text.value;
                }
            });
        }
        linkColorInputs('createColorPicker', 'createHexInput');
        linkColorInputs('editColorPicker', 'editHexInput');

        // ---- Create ----
        document.getElementById('createColorForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const result = await postForm('@Url.Action("Create")', this, 'createErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('createColorModal')).hide();
                sessionStorage.setItem('colorToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // ---- Edit ----
        document.getElementById('editColorModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            const hex = btn.getAttribute('data-hex') || '#000000';
            document.getElementById('editId').value = btn.getAttribute('data-id');
            document.getElementById('editName').value = btn.getAttribute('data-name');
            document.getElementById('editHexInput').value = hex;
            document.getElementById('editColorPicker').value = hex;
            hideErrors('editErrors');
        });

        document.getElementById('editColorForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const result = await postForm('@Url.Action("Edit")?id=' + id, this, 'editErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editColorModal')).hide();
                sessionStorage.setItem('colorToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // ---- Delete ----
        document.getElementById('deleteColorModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteId').value = btn.getAttribute('data-id');
            document.getElementById('deleteName').textContent = btn.getAttribute('data-name');
            hideErrors('deleteErrors');
        });

        document.getElementById('deleteColorForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('deleteId').value;
            const result = await postForm('@Url.Action("Delete")/' + id, this, 'deleteErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('deleteColorModal')).hide();
                sessionStorage.setItem('colorToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // ---- Toast after reload ----
        document.addEventListener('DOMContentLoaded', function() {
            const raw = sessionStorage.getItem('colorToast');
            if (raw) {
                const toast = JSON.parse(raw);
                showAlert(toast.type, toast.message);
                sessionStorage.removeItem('colorToast');
            }
        });
    </script>
}