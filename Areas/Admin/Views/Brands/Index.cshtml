@model IEnumerable<WebApplication_ClothingEcommerce.Models.Brand>

@{
    ViewData["Title"] = "Brands";
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Brands</h1>
            <p class="page-description">Manage product brands and their logos.</p>
        </div>

        <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createBrandModal">
            <i class="bi bi-plus-lg"></i> Add Brand
        </button>
    </div>


    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">All Brands</h3>
                <p class="admin-card-subtitle">Search and manage brands</p>
            </div>
            <div class="admin-card-count">
                <span id="brandCount">@(Model?.Count() ?? 0)</span>
                <small>total</small>
            </div>
        </div>

        <div class="search-wrapper">
            <form asp-action="Index" method="get" class="search-form">
                <div class="search-input-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="search-input" placeholder="Search brands..." />
                </div>
                <button type="submit" class="btn-search"><i class="bi bi-funnel"></i> Filter</button>
                <a asp-action="Index" class="btn-reset"><i class="bi bi-arrow-repeat"></i> Reset</a>
            </form>
        </div>

        <div class="table-responsive">
            <table class="admin-table" id="brandsTable">
                <thead>
                    <tr>
                        <th>Logo</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Products</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var brand in Model)
                        {
                            <tr data-row-id="@brand.Id">
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(brand.Logo))
                                    {
                                        <img src="@brand.Logo" alt="@brand.Name" class="brand-logo-thumb" />
                                    }
                                    else
                                    {
                                        <div class="brand-logo-placeholder"><i class="bi bi-award"></i></div>
                                    }
                                </td>
                                <td class="payment-name">@brand.Name</td>
                                <td class="description-text">@(brand.Description ?? "—")</td>
                                <td><span class="payment-count">@(brand.Products?.Count ?? 0)</span></td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@brand.Id">
                                                    <i class="bi bi-eye text-primary"></i> <span>View Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item"
                                                        data-bs-toggle="modal" data-bs-target="#editBrandModal"
                                                        data-id="@brand.Id"
                                                        data-name="@brand.Name"
                                                        data-description="@brand.Description"
                                                        data-logo="@brand.Logo">
                                                    <i class="bi bi-pencil text-warning"></i> <span>Edit Brand</span>
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider my-1" /></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger"
                                                        data-bs-toggle="modal" data-bs-target="#deleteBrandModal"
                                                        data-id="@brand.Id"
                                                        data-name="@brand.Name">
                                                    <i class="bi bi-trash"></i> <span>Delete Brand</span>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-award"></i></div>
                                    <h5>No brands found</h5>
                                    <p>Add your first brand to start managing your catalog.</p>
                                    <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createBrandModal">
                                        <i class="bi bi-plus-lg"></i> Add Brand
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

<!-- Create Modal -->
<div class="modal fade" id="createBrandModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createBrandForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Brand</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="createErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input name="Name" class="form-control" placeholder="e.g. Nike" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Logo</label>
                        <!-- TAB TOGGLE -->
                        <div class="img-input-tabs" id="createLogoTabs">
                            <button type="button" class="img-input-tab-btn active" data-tab="upload" onclick="switchImgTab('create','upload')">
                                <i class="bi bi-upload"></i> Upload File
                            </button>
                            <button type="button" class="img-input-tab-btn" data-tab="url" onclick="switchImgTab('create','url')">
                                <i class="bi bi-link-45deg"></i> Paste URL
                            </button>
                        </div>
                        <!-- UPLOAD PANEL -->
                        <div class="img-input-panel active" id="createPanel-upload">
                            <input type="file" name="logo" id="createLogoFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,.svg" onchange="previewImgFile(this,'createPreviewImg','createPreviewEmpty')" />
                            <small class="text-muted">JPG, PNG, WEBP or SVG. Max 5MB.</small>
                        </div>
                        <!-- URL PANEL -->
                        <div class="img-input-panel" id="createPanel-url">
                            <div class="img-url-group">
                                <input type="text" name="logoUrl" id="createLogoUrl" class="form-control" placeholder="https://example.com/logo.png" oninput="previewImgUrl(this.value,'createPreviewImg','createPreviewEmpty')" />
                                <button type="button" class="img-clipboard-btn" onclick="pasteFromClipboard('createLogoUrl','createPreviewImg','createPreviewEmpty',this)" title="Paste from clipboard">
                                    <i class="bi bi-clipboard"></i> Paste
                                </button>
                            </div>
                            <small class="text-muted">Paste a direct link to the logo image.</small>
                        </div>
                        <!-- PREVIEW -->
                        <div class="img-preview-box">
                            <div class="img-preview-empty" id="createPreviewEmpty">
                                <i class="bi bi-image"></i>
                                Image preview
                            </div>
                            <img id="createPreviewImg" src="" alt="Preview" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editBrandModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editBrandForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Brand</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="editErrors" class="admin-alert admin-alert-danger d-none"></div>

                    <div class="mb-3 d-flex align-items-center gap-3">
                        <img id="editLogoPreview" src="" alt="" class="brand-logo-thumb d-none" />
                        <div id="editLogoPlaceholder" class="brand-logo-placeholder"><i class="bi bi-award"></i></div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="removeLogo" id="editRemoveLogo" value="true" onchange="toggleEditRemove(this)" />
                            <label class="form-check-label small" for="editRemoveLogo">Remove current logo</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input name="Name" id="editName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" id="editDescription" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3" id="editLogoSection">
                        <label class="form-label fw-semibold">Replace Logo</label>
                        <!-- TAB TOGGLE -->
                        <div class="img-input-tabs">
                            <button type="button" class="img-input-tab-btn active" data-tab="upload" onclick="switchImgTab('edit','upload')">
                                <i class="bi bi-upload"></i> Upload File
                            </button>
                            <button type="button" class="img-input-tab-btn" data-tab="url" onclick="switchImgTab('edit','url')">
                                <i class="bi bi-link-45deg"></i> Paste URL
                            </button>
                        </div>
                        <!-- UPLOAD PANEL -->
                        <div class="img-input-panel active" id="editPanel-upload">
                            <input type="file" name="logo" id="editLogoFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,.svg" onchange="previewImgFile(this,'editPreviewImg','editPreviewEmpty')" />
                            <small class="text-muted">JPG, PNG, WEBP or SVG. Max 5MB. Leave empty to keep current.</small>
                        </div>
                        <!-- URL PANEL -->
                        <div class="img-input-panel" id="editPanel-url">
                            <div class="img-url-group">
                                <input type="text" name="logoUrl" id="editLogoUrl" class="form-control" placeholder="https://example.com/logo.png" oninput="previewImgUrl(this.value,'editPreviewImg','editPreviewEmpty')" />
                                <button type="button" class="img-clipboard-btn" onclick="pasteFromClipboard('editLogoUrl','editPreviewImg','editPreviewEmpty',this)" title="Paste from clipboard">
                                    <i class="bi bi-clipboard"></i> Paste
                                </button>
                            </div>
                            <small class="text-muted">Paste a new URL to replace the current logo.</small>
                        </div>
                        <!-- PREVIEW -->
                        <div class="img-preview-box">
                            <div class="img-preview-empty" id="editPreviewEmpty">
                                <i class="bi bi-image"></i>
                                New image preview
                            </div>
                            <img id="editPreviewImg" src="" alt="Preview" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteBrandModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteBrandForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header">
                    <h5 class="modal-title">Delete Brand</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="deleteErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <p>Are you sure you want to delete <strong id="deleteName"></strong>? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="action-btn action-danger" style="width:auto;padding:8px 18px;">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .brand-logo-thumb {
        width: 52px;
        height: 52px;
        object-fit: contain;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #fff;
    }

    .brand-logo-placeholder {
        width: 52px;
        height: 52px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        font-size: 1.2rem;
    }
</style>

@section Scripts {
    <script>
        // =========================================================
        // DUAL IMAGE INPUT - Shared Helpers
        // =========================================================

        function switchImgTab(prefix, tab) {
            // Toggle tab buttons
            const tabs = document.querySelectorAll(`#${prefix}Panel-upload, #${prefix}Panel-url`);
            const btns = document.querySelectorAll(`[onclick*="switchImgTab('${prefix}'"]`);
            btns.forEach(b => b.classList.toggle('active', b.getAttribute('data-tab') === tab));
            tabs.forEach(p => p.classList.remove('active'));
            const panel = document.getElementById(`${prefix}Panel-${tab}`);
            if (panel) panel.classList.add('active');

            // Clear opposite input
            if (tab === 'upload') {
                const urlInput = document.getElementById(`${prefix}LogoUrl`) || document.getElementById(`${prefix}ImgUrl`);
                if (urlInput) urlInput.value = '';
                const prevImg = document.getElementById(`${prefix}PreviewImg`);
                const prevEmpty = document.getElementById(`${prefix}PreviewEmpty`);
                if (prevImg) { prevImg.src = ''; prevImg.classList.remove('visible'); }
                if (prevEmpty) prevEmpty.style.display = '';
            } else {
                const fileInput = document.getElementById(`${prefix}LogoFile`) || document.getElementById(`${prefix}ImgFile`);
                if (fileInput) fileInput.value = '';
                const prevImg = document.getElementById(`${prefix}PreviewImg`);
                const prevEmpty = document.getElementById(`${prefix}PreviewEmpty`);
                if (prevImg) { prevImg.src = ''; prevImg.classList.remove('visible'); }
                if (prevEmpty) prevEmpty.style.display = '';
            }
        }

        function previewImgFile(input, previewId, emptyId) {
            const preview = document.getElementById(previewId);
            const empty = document.getElementById(emptyId);
            if (!preview || !empty) return;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.add('visible');
                    empty.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.src = '';
                preview.classList.remove('visible');
                empty.style.display = '';
            }
        }

        function previewImgUrl(url, previewId, emptyId) {
            const preview = document.getElementById(previewId);
            const empty = document.getElementById(emptyId);
            if (!preview || !empty) return;
            if (!url || !url.trim()) {
                preview.src = '';
                preview.classList.remove('visible');
                empty.style.display = '';
                return;
            }
            preview.onload = function() {
                preview.classList.add('visible');
                empty.style.display = 'none';
            };
            preview.onerror = function() {
                preview.classList.remove('visible');
                empty.style.display = '';
            };
            preview.src = url.trim();
        }

        function toggleEditRemove(cb) {
            const section = document.getElementById('editLogoSection');
            if (section) section.style.opacity = cb.checked ? '0.4' : '1';
        }

        function resetImgTabState(prefix) {
            // Reset to upload tab
            switchImgTab(prefix, 'upload');
        }

        async function pasteFromClipboard(inputId, previewId, emptyId, btn) {
            try {
                const text = await navigator.clipboard.readText();
                const input = document.getElementById(inputId);
                if (input) {
                    input.value = text;
                    previewImgUrl(text, previewId, emptyId);
                }
                if (btn) {
                    btn.classList.add('pasted');
                    btn.innerHTML = '<i class="bi bi-check-lg"></i> Pasted!';
                    setTimeout(() => {
                        btn.classList.remove('pasted');
                        btn.innerHTML = '<i class="bi bi-clipboard"></i> Paste';
                    }, 2000);
                }
            } catch (e) {
                if (window.__notyf) window.__notyf.error('Clipboard access denied. Please paste manually (Ctrl+V).');
            }
        }

        // =========================================================
        // PAGE HELPERS
        // =========================================================

        function showAlert(type, message) {
            if (window.__notyf) {
                if (type === 'success') window.__notyf.success(message);
                else window.__notyf.error(message);
            }
        }

        function showErrors(boxId, errors) {
            const box = document.getElementById(boxId);
            box.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> ' + errors.join('<br />');
            box.classList.remove('d-none');
        }

        function hideErrors(boxId) {
            document.getElementById(boxId).classList.add('d-none');
        }

        async function postForm(url, form, errorBoxId) {
            hideErrors(errorBoxId);
            const formData = new FormData(form);

            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            let data = {};
            try { data = await response.json(); } catch { }

            if (!response.ok) {
                showErrors(errorBoxId, data.errors || ['Something went wrong.']);
                return null;
            }
            return data;
        }

        // ---------- CREATE ----------
        document.getElementById('createBrandModal').addEventListener('show.bs.modal', function() {
            resetImgTabState('create');
            hideErrors('createErrors');
        });

        document.getElementById('createBrandForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const result = await postForm('@Url.Action("Create")', this, 'createErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('createBrandModal')).hide();
                sessionStorage.setItem('brandToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // ---------- EDIT ----------
        document.getElementById('editBrandModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('editId').value = btn.getAttribute('data-id');
            document.getElementById('editName').value = btn.getAttribute('data-name');
            document.getElementById('editDescription').value = btn.getAttribute('data-description') || '';
            document.getElementById('editRemoveLogo').checked = false;
            const section = document.getElementById('editLogoSection');
            if (section) section.style.opacity = '1';

            const logo = btn.getAttribute('data-logo');
            const preview = document.getElementById('editLogoPreview');
            const placeholder = document.getElementById('editLogoPlaceholder');

            if (logo) {
                preview.src = logo;
                preview.classList.remove('d-none');
                placeholder.classList.add('d-none');
            } else {
                preview.classList.add('d-none');
                placeholder.classList.remove('d-none');
            }

            resetImgTabState('edit');
            hideErrors('editErrors');
        });

        document.getElementById('editBrandForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const result = await postForm('@Url.Action("Edit")?id=' + id, this, 'editErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editBrandModal')).hide();
                sessionStorage.setItem('brandToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // ---------- DELETE ----------
        document.getElementById('deleteBrandModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteId').value = btn.getAttribute('data-id');
            document.getElementById('deleteName').textContent = btn.getAttribute('data-name');
            hideErrors('deleteErrors');
        });

        document.getElementById('deleteBrandForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('deleteId').value;
            const result = await postForm('@Url.Action("Delete")/' + id, this, 'deleteErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('deleteBrandModal')).hide();
                sessionStorage.setItem('brandToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // ---------- TOAST AFTER RELOAD ----------
        document.addEventListener('DOMContentLoaded', function() {
            const raw = sessionStorage.getItem('brandToast');
            if (raw) {
                const toast = JSON.parse(raw);
                showAlert(toast.type, toast.message);
                sessionStorage.removeItem('brandToast');
            }
        });
    </script>
}