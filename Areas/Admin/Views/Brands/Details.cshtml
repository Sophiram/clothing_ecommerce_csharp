@model WebApplication_ClothingEcommerce.Models.Brand

@{
    ViewData["Title"] = "Brand Details";
}

<div class="container-fluid py-4">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <div class="text-uppercase text-muted small fw-bold mb-1">
                Catalog / Brands
            </div>

            <h1 class="h3 fw-bold mb-1">
                Brand Details
            </h1>

            <p class="text-muted mb-0">
                View brand information and products.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-dark">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </a>

        </div>

    </div>


    <!-- =====================================================
         BRAND INFORMATION
    ====================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row g-4 align-items-center">

                <!-- LOGO -->

                <div class="col-auto">

                    @if (!string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <img src="@Model.Logo"
                             alt="@Model.Name"
                             class="rounded border bg-white"
                             style="width:120px;height:120px;object-fit:contain;" />
                    }
                    else
                    {
                        <div class="bg-light border rounded d-flex align-items-center justify-content-center"
                             style="width:120px;height:120px;">

                            <i class="bi bi-award display-4 text-muted"></i>

                        </div>
                    }

                </div>


                <!-- BRAND INFO -->

                <div class="col">

                    <h2 class="fw-bold mb-1">
                        @Model.Name
                    </h2>

                    <div class="text-muted small mb-3">
                        Brand ID:
                        <code>@Model.Id</code>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-0">
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">
                            No description available.
                        </p>
                    }

                </div>


                <!-- PRODUCT COUNT -->

                <div class="col-auto">

                    <div class="text-center border rounded p-3">

                        <div class="text-muted small fw-bold text-uppercase">
                            Products
                        </div>

                        <div class="display-6 fw-bold">
                            @(Model.Products?.Count ?? 0)
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BRAND DETAILS
    ====================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 p-4">

            <h5 class="fw-bold mb-1">
                Brand Information
            </h5>

            <p class="text-muted small mb-0">
                Basic information about this brand.
            </p>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <!-- NAME -->

                <div class="col-md-6">

                    <div class="text-muted text-uppercase small fw-bold mb-1">
                        Brand Name
                    </div>

                    <div class="fw-semibold">
                        @Model.Name
                    </div>

                </div>


                <!-- PRODUCTS -->

                <div class="col-md-6">

                    <div class="text-muted text-uppercase small fw-bold mb-1">
                        Total Products
                    </div>

                    <span class="badge bg-dark rounded-pill">
                        @(Model.Products?.Count ?? 0)
                    </span>

                </div>


                <!-- DESCRIPTION -->

                <div class="col-12">

                    <div class="text-muted text-uppercase small fw-bold mb-1">
                        Description
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div>
                            @Model.Description
                        </div>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">
                            No description available.
                        </span>
                    }

                </div>


                <!-- LOGO -->

                <div class="col-12">

                    <div class="text-muted text-uppercase small fw-bold mb-1">
                        Logo
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <code>
                            @Model.Logo
                        </code>
                    }
                    else
                    {
                        <span class="text-muted">
                            No logo uploaded.
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PRODUCTS
    ====================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Brand Products
                    </h5>

                    <p class="text-muted small mb-0">
                        Products associated with @Model.Name.
                    </p>

                </div>

                <span class="badge bg-dark rounded-pill">
                    @(Model.Products?.Count ?? 0) Products
                </span>

            </div>

        </div>


        @if (Model.Products != null && Model.Products.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4">
                                PRODUCT
                            </th>

                            <th>
                                CATEGORY
                            </th>

                            <th>
                                VARIANTS
                            </th>

                            <th>
                                PRICE
                            </th>

                            <th>
                                STATUS
                            </th>

                            <th>
                                CREATED
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var product in Model.Products)
                        {
                            var firstVariant = product.Variants?.FirstOrDefault();

                            <tr>

                                <!-- PRODUCT -->

                                <td class="px-4">

                                    <div class="fw-semibold">
                                        @product.Name
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(product.Gender))
                                    {
                                        <small class="text-muted">
                                            @product.Gender
                                        </small>
                                    }

                                </td>


                                <!-- CATEGORY -->

                                <td>

                                    @if (product.Category != null)
                                    {
                                        <span class="badge bg-light text-dark border">
                                            @product.Category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- VARIANTS -->

                                <td>

                                    <span class="badge bg-secondary rounded-pill">
                                        @(product.Variants?.Count ?? 0)
                                    </span>

                                </td>


                                <!-- PRICE -->

                                <td>

                                    @if (firstVariant != null)
                                    {
                                        @firstVariant.Price.ToString("C")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (product.Status.ToString() == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @product.Status
                                        </span>
                                    }

                                </td>


                                <!-- CREATED -->

                                <td>

                                    <small>
                                        @product.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                                    </small>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-box-seam display-4 text-muted"></i>

                <h6 class="fw-bold mt-3">
                    No products
                </h6>

                <p class="text-muted mb-0">
                    This brand does not have any products yet.
                </p>

            </div>
        }

    </div>

</div>
