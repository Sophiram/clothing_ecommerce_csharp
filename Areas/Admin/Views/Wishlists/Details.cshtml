@model WebApplication_ClothingEcommerce.Models.Wishlist

@{
    ViewData["Title"] = "Wishlist Details";
    var customerName = Model.Customer != null ? $"{Model.Customer.FirstName} {Model.Customer.LastName}".Trim() : "Customer";
    var customerInitial = !string.IsNullOrEmpty(customerName) ? customerName[..1].ToUpper() : "C";
    var totalEstimatedValue = Model.Items.Sum(i => i.Variant?.Price ?? 0);
}

<div class="w-full max-w-7xl mx-auto p-4 sm:p-6 lg:p-8 space-y-6">

    <!-- PAGE HEADER & BREADCRUMB -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <nav class="flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400 mb-1.5" aria-label="Breadcrumb">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Admin</a>
                <span class="text-slate-300 dark:text-slate-600">/</span>
                <a asp-area="Admin" asp-controller="Wishlists" asp-action="Index" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors" data-en="Wishlists" data-kh="បញ្ជីចូលចិត្ត">Wishlists</a>
                <span class="text-slate-300 dark:text-slate-600">/</span>
                <span class="text-slate-800 dark:text-slate-200 font-semibold" data-en="Details" data-kh="លម្អិត">Details</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-2.5">
                <i class="bi bi-heart-fill text-rose-500"></i>
                <span data-en="Customer Wishlist Details" data-kh="ព័ត៌មានលម្អិតបញ្ជីចូលចិត្ត">Saved Wishlist Items</span>
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1" data-en="Saved favorites and interest list for customer." data-kh="ទំនិញដែលបានរក្សាទុកដោយអតិថិជន។">
                Saved favorites and interest list for <strong class="text-slate-900 dark:text-white font-semibold">@customerName</strong> (@Model.Items.Count items).
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 shadow-sm transition">
                <i class="bi bi-arrow-left"></i>
                <span data-en="Back to Wishlists" data-kh="ត្រឡប់ទៅបញ្ជីចូលចិត្ត">Back to Wishlists</span>
            </a>
        </div>
    </div>

    <!-- MAIN TWO-COLUMN CONTENT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- LEFT: SAVED PRODUCTS TABLE (8 COLS) -->
        <div class="lg:col-span-8">
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm overflow-hidden flex flex-col justify-between">
                <div>
                    <div class="p-5 sm:p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <i class="bi bi-bag-heart-fill text-rose-500 text-lg"></i>
                            <h2 class="text-sm font-bold text-slate-900 dark:text-white" data-en="Saved Items" data-kh="ទំនិញដែលបានរក្សាទុក">Saved Items</h2>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900">
                                @Model.Items.Count
                            </span>
                        </div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">
                            Est. Value: <strong class="text-blue-600 dark:text-blue-400 font-mono text-sm sm:text-base font-bold">${@totalEstimatedValue.ToString("N2")}</strong>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-100 dark:border-slate-800 text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                                <tr>
                                    <th class="py-3.5 pl-6 pr-3" style="width: 42%;" data-en="Product" data-kh="ទំនិញ">Product</th>
                                    <th class="py-3.5 px-3" style="width: 22%;" data-en="SKU / Option" data-kh="SKU / ជម្រើស">SKU / Option</th>
                                    <th class="py-3.5 px-3" style="width: 18%;" data-en="Unit Price" data-kh="តម្លៃ">Unit Price</th>
                                    <th class="py-3.5 pl-3 pr-6 text-right" style="width: 18%;" data-en="Stock Status" data-kh="ស្ថានភាពស្តុក">Stock Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
                                @if (!Model.Items.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="py-12 text-center">
                                            <div class="max-w-xs mx-auto text-slate-400 dark:text-slate-500">
                                                <i class="bi bi-heartbreak text-4xl block mb-2 opacity-50"></i>
                                                <div class="font-bold text-slate-700 dark:text-slate-300 text-sm" data-en="Wishlist is Empty" data-kh="គ្មានទំនិញក្នុងបញ្ជីចូលចិត្ត">Wishlist is Empty</div>
                                                <p class="text-xs mt-1">This customer currently has no saved items in their wishlist.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Items)
                                    {
                                        var img = item.Variant?.Product?.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl 
                                                ?? item.Variant?.Product?.Images?.FirstOrDefault()?.ImageUrl;
                                        var available = item.Variant?.Inventory?.AvailableQuantity ?? 0;

                                        <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                                            <td class="py-4 pl-6 pr-3">
                                                <div class="flex items-center gap-3.5">
                                                    @if (!string.IsNullOrEmpty(img))
                                                    {
                                                        <img src="@img" alt="@item.Variant?.Product?.Name" class="w-12 h-14 rounded-xl border border-slate-200 dark:border-slate-700 object-cover shadow-sm shrink-0" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-12 h-14 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 text-lg shrink-0">
                                                            <i class="bi bi-image"></i>
                                                        </div>
                                                    }
                                                    <div class="min-w-0">
                                                        <div class="font-bold text-slate-900 dark:text-white text-sm truncate max-w-xs sm:max-w-sm">
                                                            @item.Variant?.Product?.Name
                                                        </div>
                                                        @if (item.Variant?.Product != null)
                                                        {
                                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Variant.ProductId" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline mt-0.5 inline-block">
                                                                View Product &rarr;
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="py-4 px-3">
                                                <div class="font-mono text-xs text-slate-400 dark:text-slate-500 mb-1">
                                                    @(item.Variant?.SKU ?? "—")
                                                </div>
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                                    @(item.Variant?.Size?.Name ?? "-") / @(item.Variant?.Color?.Name ?? "-")
                                                </span>
                                            </td>

                                            <td class="py-4 px-3">
                                                <span class="font-mono font-bold text-slate-900 dark:text-white text-sm">
                                                    ${@(item.Variant?.Price.ToString("N2") ?? "0.00")}
                                                </span>
                                            </td>

                                            <td class="py-4 pl-3 pr-6 text-right">
                                                @if (available > 0)
                                                {
                                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                        In Stock (@available)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/50 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                                        Out of Stock
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="p-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                    <span>Wishlist ID: <span class="font-mono">@Model.Id</span></span>
                    <span>Status: <strong class="text-emerald-600 dark:text-emerald-400 font-semibold">Active</strong></span>
                </div>
            </div>
        </div>

        <!-- RIGHT: CUSTOMER PROFILE SUMMARY (4 COLS) -->
        <div class="lg:col-span-4">
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm h-full flex flex-col justify-between space-y-6">
                <div>
                    <div class="flex items-center gap-2 pb-4 border-b border-slate-100 dark:border-slate-800">
                        <i class="bi bi-person-fill text-blue-600 dark:text-blue-400"></i>
                        <h2 class="text-sm font-bold text-slate-900 dark:text-white" data-en="Customer Profile" data-kh="ព័ត៌មានអតិថិជន">
                            Customer Profile
                        </h2>
                    </div>

                    <div class="text-center pt-6 pb-2">
                        <div class="w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 font-bold text-2xl flex items-center justify-center mx-auto mb-3.5 shadow-sm">
                            @customerInitial
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">
                            @customerName
                        </h3>
                        <div class="text-xs text-slate-500 dark:text-slate-400 space-y-1 mt-2">
                            <div class="flex items-center justify-center gap-1.5">
                                <i class="bi bi-envelope text-slate-400"></i>
                                <span>@(Model.Customer?.Email ?? "No email provided")</span>
                            </div>
                            <div class="flex items-center justify-center gap-1.5">
                                <i class="bi bi-telephone text-slate-400"></i>
                                <span>@(Model.Customer?.Phone ?? "No phone number")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Value Breakdown Box -->
                    <div class="mt-6 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 space-y-2.5 text-xs">
                        <div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
                            <span>Total Saved Items:</span>
                            <strong class="text-slate-900 dark:text-white font-bold">@Model.Items.Count items</strong>
                        </div>
                        <div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
                            <span>Estimated Total Value:</span>
                            <strong class="text-blue-600 dark:text-blue-400 font-mono font-bold text-sm">${@totalEstimatedValue.ToString("N2")}</strong>
                        </div>
                    </div>
                </div>

                @if (Model.Customer != null)
                {
                    <div class="pt-5 border-t border-slate-100 dark:border-slate-800">
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Customer.Id" class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/50 hover:bg-blue-100 dark:hover:bg-blue-900/60 border border-blue-200 dark:border-blue-900 transition shadow-sm">
                            <i class="bi bi-person-bounding-box"></i>
                            <span data-en="View Customer Details" data-kh="មើលព័ត៌មានអតិថិជន">View Customer Details</span>
                        </a>
                    </div>
                }
            </div>
        </div>

    </div>

</div>
