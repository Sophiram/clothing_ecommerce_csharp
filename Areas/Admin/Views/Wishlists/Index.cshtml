@model IEnumerable<WebApplication_ClothingEcommerce.Models.Wishlist>

@{
    ViewData["Title"] = "Customer Wishlists";
}

<div class="admin-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="page-eyebrow">CUSTOMERS & ENGAGEMENT</div>
            <h1 class="page-title">Wishlists</h1>
            <p class="page-description">Inspect customer demand, saved favorites, and high-interest products.</p>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="admin-alert admin-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    <!-- STAT PILLS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold">Active Customer Wishlists</small>
                        <h3 class="fw-bold mb-0 mt-1">@ViewBag.TotalCount</h3>
                    </div>
                    <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-circle">
                        <i class="bi bi-heart-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold">Total Saved Items</small>
                        <h3 class="fw-bold mb-0 mt-1 text-primary">@ViewBag.TotalItemsSaved</h3>
                    </div>
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle">
                        <i class="bi bi-bag-heart fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CARD -->
    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">All Customer Wishlists</h3>
                <p class="admin-card-subtitle">Wishlists grouped by customer</p>
            </div>
            <div class="admin-card-count">
                <span>@(Model?.Count() ?? 0)</span>
                <small>wishlists</small>
            </div>
        </div>

        <!-- SEARCH -->
        <div class="search-wrapper">
            <form asp-action="Index" method="get" class="search-form">
                <div class="search-input-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="search-input" placeholder="Search customer name or email..." />
                </div>
                <button type="submit" class="btn-search"><i class="bi bi-funnel"></i> Filter</button>
                <a asp-action="Index" class="btn-reset"><i class="bi bi-arrow-repeat"></i> Reset</a>
            </form>
        </div>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th class="text-center">Saved Items</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">
                                        <i class="bi bi-person-circle me-1 text-muted"></i>
                                        @(item.Customer != null ? $"{item.Customer.FirstName} {item.Customer.LastName}".Trim() : "Customer")
                                    </div>
                                </td>
                                <td>
                                    <code>@(item.Customer?.Email ?? "N/A")</code>
                                </td>
                                <td>
                                    <span>@(item.Customer?.Phone ?? "—")</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-bold">
                                        <i class="bi bi-heart me-1"></i> @item.Items.Count items
                                    </span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn" title="View Wishlist Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this customer wishlist?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn action-danger" title="Clear / Delete Wishlist">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state py-5 text-center">
                                    <div class="empty-icon fs-1 text-muted mb-2"><i class="bi bi-heart"></i></div>
                                    <h5>No wishlists found</h5>
                                    <p class="text-muted">When customers click the heart icon on clothing items, their wishlists will show up here.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>
