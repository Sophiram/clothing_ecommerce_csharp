@model WebApplication_ClothingEcommerce.Models.Payment

@{
    ViewData["Title"] = "Create Payment";
}

<div class="container-fluid py-4">

    <!-- HEADER -->

    <div class="mb-4">

        <div class="text-uppercase text-muted small fw-bold mb-1">
            Sales / Payments
        </div>

        <h1 class="h3 fw-bold mb-1">
            Create Payment
        </h1>

        <p class="text-muted mb-0">
            Create a new customer payment transaction.
        </p>

    </div>


    <!-- FORM CARD -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white p-4">

            <h5 class="fw-bold mb-1">
                Payment Information
            </h5>

            <p class="text-muted small mb-0">
                Enter the payment transaction details below.
            </p>

        </div>


        <div class="card-body p-4">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="row g-4">


                    <!-- ORDER -->

                    <div class="col-md-6">

                        <label asp-for="OrderId"
                               class="form-label fw-semibold">
                            Order
                        </label>

                        <input asp-for="OrderId"
                               class="form-control"
                               placeholder="Enter Order ID" />

                        <span asp-validation-for="OrderId"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- PAYMENT METHOD -->

                    <div class="col-md-6">

                        <label asp-for="PaymentMethodId"
                               class="form-label fw-semibold">
                            Payment Method
                        </label>

                        <select asp-for="PaymentMethodId"
                                class="form-select"
                                asp-items="ViewBag.PaymentMethodId">

                            <option value="">
                                Select payment method
                            </option>

                        </select>

                        <span asp-validation-for="PaymentMethodId"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- STATUS -->

                    <div class="col-md-6">

                        <label asp-for="PaymentStatus"
                               class="form-label fw-semibold">
                            Payment Status
                        </label>

                        <select asp-for="PaymentStatus"
                                class="form-select"
                                asp-items="ViewBag.PaymentStatus">

                            <option value="">
                                Select status
                            </option>

                        </select>

                        <span asp-validation-for="PaymentStatus"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- AMOUNT -->

                    <div class="col-md-6">

                        <label asp-for="Amount"
                               class="form-label fw-semibold">
                            Amount
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="Amount"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="Amount"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- PAID AT -->

                    <div class="col-md-6">

                        <label asp-for="PaidAt"
                               class="form-label fw-semibold">
                            Paid At
                        </label>

                        <input asp-for="PaidAt"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="PaidAt"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- ACTIONS -->

                <div class="border-top mt-4 pt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-dark">

                        <i class="bi bi-check-lg me-1"></i>
                        Create Payment

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
