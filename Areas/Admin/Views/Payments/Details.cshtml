@model WebApplication_ClothingEcommerce.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="container-fluid py-4">

   
    <!-- HEADER -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>

            <div class="text-uppercase text-muted small fw-bold mb-1">
                Sales / Payments
            </div>

            <h1 class="h3 fw-bold mb-1">
                Payment Details
            </h1>

            <p class="text-muted mb-0">
                View payment transaction information.
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-dark">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Back

            </a>

        </div>

    </div>


    <!-- PAYMENT CARD -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white p-4">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-light rounded p-3">

                    <i class="bi bi-credit-card-2-front fs-4"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">
                        Payment #@Model.Id
                    </h5>

                    <p class="text-muted small mb-0">
                        Order #@Model.OrderId
                    </p>

                </div>

            </div>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">


                <!-- ORDER -->

                <div class="col-md-6">

                    <div class="text-muted small text-uppercase fw-bold mb-1">
                        Order
                    </div>

                    <code>
                        #@Model.OrderId
                    </code>

                </div>


                <!-- PAYMENT METHOD -->

                <div class="col-md-6">

                    <div class="text-muted small text-uppercase fw-bold mb-1">
                        Payment Method
                    </div>

                    <div class="fw-semibold">

                        @(Model.PaymentMethod?.Name ?? "Unknown")

                    </div>

                </div>


                <!-- STATUS -->

                <div class="col-md-6">

                    <div class="text-muted small text-uppercase fw-bold mb-1">
                        Payment Status
                    </div>

                    @{
                        var status = Model.PaymentStatus.ToString();

                        var statusClass = status?.ToLower() switch
                        {
                            "paid" => "bg-success",
                            "completed" => "bg-success",
                            "successful" => "bg-success",
                            "pending" => "bg-warning text-dark",
                            "failed" => "bg-danger",
                            "cancelled" => "bg-secondary",
                            "refunded" => "bg-info text-dark",
                            _ => "bg-secondary"
                        };
                    }

                    <span class="badge @statusClass">
                        @Model.PaymentStatus
                    </span>

                </div>


                <!-- AMOUNT -->

                <div class="col-md-6">

                    <div class="text-muted small text-uppercase fw-bold mb-1">
                        Amount
                    </div>

                    <div class="fs-5 fw-bold">
                        @Model.Amount.ToString("C")
                    </div>

                </div>


                <!-- PAID AT -->

                <div class="col-md-6">

                    <div class="text-muted small text-uppercase fw-bold mb-1">
                        Paid At
                    </div>

                    @if (Model.PaidAt.HasValue)
                    {
                        <span>
                            @Model.PaidAt.Value
                            .ToLocalTime()
                            .ToString("yyyy-MM-dd HH:mm")
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            Not paid
                        </span>
                    }

                </div>


                <!-- PAYMENT ID -->

                <div class="col-md-6">

                    <div class="text-muted small text-uppercase fw-bold mb-1">
                        Payment ID
                    </div>

                    <code>
                        @Model.Id
                    </code>

                </div>

            </div>

        </div>

    </div>

</div>
