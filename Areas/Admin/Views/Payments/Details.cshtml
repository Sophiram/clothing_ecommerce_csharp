@model WebApplication_ClothingEcommerce.Models.Payment
@{
    ViewData["Title"] = $"Payment #{Model.Id.ToString()[..8].ToUpper()}";
    var statusStr = Model.PaymentStatus.ToString();
    var statusBadge = statusStr.ToLower() switch
    {
        "paid" or "completed" or "successful" => "bg-success-subtle text-success border border-success-subtle",
        "pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        "failed" => "bg-danger-subtle text-danger border border-danger-subtle",
        "cancelled" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        "refunded" => "bg-info-subtle text-info-emphasis border border-info-subtle",
        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
    };
    var statusIcon = statusStr.ToLower() switch
    {
        "paid" or "completed" or "successful" => "bi-check2-circle",
        "pending" => "bi-clock-history",
        "failed" => "bi-exclamation-octagon",
        "refunded" => "bi-arrow-counterclockwise",
        _ => "bi-question-circle"
    };
    var customer = Model.Order?.Customer;
}

<div class="admin-page">
    <!-- PAGE HEADER -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1.5"
                   data-en="Back to Payments" data-kh="ត្រឡប់ទៅការទូទាត់">
                    <i class="bi bi-arrow-left"></i>
                    <span data-en="Back to Payments" data-kh="ត្រឡប់ទៅការទូទាត់">Back to Payments</span>
                </a>
                <span class="text-muted">&bull;</span>
                <span class="badge @statusBadge rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;">
                    <i class="bi @statusIcon me-1"></i>@Model.PaymentStatus
                </span>
            </div>
            <h1 class="page-title mt-2" data-en="Payment Transaction #@Model.Id.ToString()[..8].ToUpper()" data-kh="ប្រតិបត្តិការទូទាត់ #@Model.Id.ToString()[..8].ToUpper()">
                Payment Transaction #@Model.Id.ToString()[..8].ToUpper()
            </h1>
            <p class="page-description" data-en="Gateway settlement log & customer order verification" data-kh="កំណត់ហេតុការទូទាត់តាមច្រក និងការផ្ទៀងផ្ទាត់បញ្ជាទិញ">
                Gateway settlement log &middot; Transaction ID: <span class="font-monospace small">@Model.Id</span>
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 shadow-sm"
               data-en="Edit Transaction" data-kh="កែប្រែប្រតិបត្តិការ">
                <i class="bi bi-pencil me-1.5"></i>
                <span data-en="Edit Transaction" data-kh="កែប្រែប្រតិបត្តិការ">Edit Transaction</span>
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-4 shadow-sm"
               data-en="Delete" data-kh="លុបចោល">
                <i class="bi bi-trash me-1.5"></i>
                <span data-en="Delete" data-kh="លុបចោល">Delete</span>
            </a>
        </div>
    </div>

    <!-- MAIN GRID -->
    <div class="row g-4">
        <!-- LEFT: TRANSACTION RECEIPT -->
        <div class="col-lg-7">
            <div class="admin-card mb-4">
                <div class="admin-card-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(16, 185, 129, 0.12); color: #059669;">
                            <i class="bi bi-receipt fs-4"></i>
                        </div>
                        <div>
                            <h3 class="admin-card-title mb-0" data-en="Settlement Receipt" data-kh="បង្កាន់ដៃទូទាត់">Settlement Receipt</h3>
                            <p class="admin-card-subtitle mb-0" data-en="Verified payment transaction log" data-kh="កំណត់ហេតុប្រតិបត្តិការទូទាត់ដែលបានផ្ទៀងផ្ទាត់">Verified payment transaction log</p>
                        </div>
                    </div>
                    <span class="fw-bold fs-3 text-success tabular-nums">@Model.Amount.ToString("C")</span>
                </div>

                <div class="p-4">
                    <div class="row g-4 mb-4">
                        <!-- AMOUNT -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;" data-en="Captured Amount" data-kh="ចំនួនទឹកប្រាក់ដែលទទួលបាន">Captured Amount</small>
                            <div class="fs-4 fw-bold text-success tabular-nums">@Model.Amount.ToString("C")</div>
                        </div>

                        <!-- SETTLEMENT STATUS -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;" data-en="Settlement Status" data-kh="ស្ថានភាពទូទាត់">Settlement Status</small>
                            <span class="badge @statusBadge rounded-pill px-3 py-1.5 fw-semibold fs-6">
                                <i class="bi @statusIcon me-1"></i>@Model.PaymentStatus
                            </span>
                        </div>

                        <!-- PAYMENT METHOD -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;" data-en="Payment Method" data-kh="វិធីសាស្ត្រទូទាត់">Payment Method</small>
                            <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                <i class="bi bi-wallet2 text-primary"></i>
                                <span>@(Model.PaymentMethod?.Name ?? "Credit / Debit Card")</span>
                            </div>
                            <small class="text-muted font-monospace">Provider ID: @(Model.PaymentMethodId != Guid.Empty ? $"#{Model.PaymentMethodId.ToString()[..8].ToUpper()}" : "Direct")</small>
                        </div>

                        <!-- TIMESTAMP -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;" data-en="Payment Timestamp" data-kh="កាលបរិច្ឆេទ & ពេលវេលា">Payment Timestamp</small>
                            @if (Model.PaidAt.HasValue)
                            {
                                <div class="fw-semibold text-dark">@Model.PaidAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1">Unconfirmed / Pending</span>
                            }
                        </div>
                    </div>

                    <!-- TRANSACTION AUDIT CHIP -->
                    <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px;">
                        <div class="d-flex justify-content-between align-items-center py-1.5 border-bottom">
                            <span class="text-muted small" data-en="System Payment ID" data-kh="លេខកូដទូទាត់ប្រព័ន្ធ">System Payment ID</span>
                            <span class="font-monospace small text-dark">@Model.Id</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-1.5 border-bottom">
                            <span class="text-muted small" data-en="Associated Order" data-kh="ការបញ្ជាទិញពាក់ព័ន្ធ">Associated Order</span>
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="fw-bold font-monospace text-primary text-decoration-none small">
                                #@Model.OrderId.ToString()[..8].ToUpper()
                            </a>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-1.5">
                            <span class="text-muted small" data-en="Verification State" data-kh="ស្ថានភាពផ្ទៀងផ្ទាត់">Verification State</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-0.5" style="font-size: 0.72rem;">
                                <i class="bi bi-shield-check me-1"></i> Ledger Verified
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: CUSTOMER & ORDER LINK -->
        <div class="col-lg-5">
            <!-- CUSTOMER INFO CARD -->
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <h3 class="admin-card-title" data-en="Payer Information" data-kh="ព័ត៌មានអ្នកបង់ប្រាក់">Payer Information</h3>
                    <p class="admin-card-subtitle" data-en="Account and contact on file" data-kh="គណនី និងទំនាក់ទំនង">Account and contact on file</p>
                </div>
                <div class="p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white font-bold" style="width: 44px; height: 44px; background: linear-gradient(135deg, #10b981, #059669); font-weight: 700;">
                            @((customer?.FirstName ?? "C").Substring(0, 1))
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">
                                @(customer != null ? $"{customer.FirstName} {customer.LastName}".Trim() : "Guest Checkout")
                            </h5>
                            <span class="text-muted small">Customer ID: #@(customer?.Id.ToString()[..8].ToUpper() ?? "—")</span>
                        </div>
                    </div>

                    <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px;">
                        <div class="small mb-1 text-dark">
                            <i class="bi bi-envelope me-1.5 text-primary"></i>@(customer?.Email ?? "N/A")
                        </div>
                        <div class="small text-dark font-monospace">
                            <i class="bi bi-telephone me-1.5 text-success"></i>@(customer?.Phone ?? "N/A")
                        </div>
                    </div>
                </div>
            </div>

            <!-- ASSOCIATED ORDER CARD -->
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title" data-en="Order Association" data-kh="ការភ្ជាប់បញ្ជាទិញ">Order Association</h3>
                    <p class="admin-card-subtitle" data-en="Purchased cart details" data-kh="ព័ត៌មានលម្អិតនៃកន្ត្រកទំនិញ">Purchased cart details</p>
                </div>
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small" data-en="Order ID" data-kh="លេខសម្គាល់បញ្ជាទិញ">Order ID</span>
                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="fw-bold font-monospace text-primary text-decoration-none">
                            #@Model.OrderId.ToString()[..8].ToUpper()
                        </a>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small" data-en="Order Placed" data-kh="កាលបរិច្ឆេទបញ្ជាទិញ">Order Placed</span>
                        <span class="text-dark small tabular-nums">@(Model.Order?.OrderDate.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted small" data-en="Order Status" data-kh="ស្ថានភាពបញ្ជាទិញ">Order Status</span>
                        <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1" style="font-size: 0.75rem;">
                            @(Model.Order?.Status.ToString() ?? "Processing")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 mb-4">
                        <span class="text-muted small" data-en="Order Grand Total" data-kh="សរុបបញ្ជាទិញ">Order Grand Total</span>
                        <span class="fw-bold text-success fs-5 tabular-nums">$@(Model.Order?.TotalAmount.ToString("N2") ?? Model.Amount.ToString("N2"))</span>
                    </div>

                    <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-primary rounded-pill w-100 fw-semibold shadow-sm"
                       data-en="View Complete Order" data-kh="មើលការបញ្ជាទិញពេញលេញ">
                        <i class="bi bi-box-arrow-up-right me-1.5"></i>
                        <span data-en="View Complete Order" data-kh="មើលការបញ្ជាទិញពេញលេញ">View Complete Order</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

