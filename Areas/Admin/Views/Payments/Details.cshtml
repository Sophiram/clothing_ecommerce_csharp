@model WebApplication_ClothingEcommerce.Models.Payment
@{
    ViewData["Title"] = $"Payment #{Model.Id.ToString()[..8].ToUpper()}";
    var statusStr = Model.PaymentStatus.ToString();
    var statusBadge = statusStr.ToLower() switch
    {
        "paid" or "completed" or "successful" => "bg-success-subtle text-success border border-success-subtle",
        "pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        "failed" => "bg-danger-subtle text-danger border border-danger-subtle",
        "cancelled" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        "refunded" => "bg-info-subtle text-info-emphasis border border-info-subtle",
        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
    };
    var statusIcon = statusStr.ToLower() switch
    {
        "paid" or "completed" or "successful" => "bi-check2-circle",
        "pending" => "bi-clock-history",
        "failed" => "bi-exclamation-octagon",
        "refunded" => "bi-arrow-counterclockwise",
        _ => "bi-question-circle"
    };
}

<div class="admin-page">

    <!-- PAGE HEADER -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-muted text-decoration-none small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Payments
                </a>
                <span class="text-muted">&bull;</span>
                <span class="badge @statusBadge rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;">
                    <i class="bi @statusIcon me-1"></i>@Model.PaymentStatus
                </span>
            </div>
            <h1 class="page-title">Payment Transaction #@Model.Id.ToString()[..8].ToUpper()</h1>
            <p class="page-description">Gateway transaction log and settlement details</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-3 fw-semibold">
                <i class="bi bi-pencil-square me-1"></i> Edit Transaction
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-3">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
        </div>
    </div>

    <!-- DETAILS CARD -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="admin-card mb-4">
                <div class="admin-card-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-credit-card-2-front fs-4"></i>
                        </div>
                        <div>
                            <h3 class="admin-card-title">Transaction Receipt</h3>
                            <p class="admin-card-subtitle">Verified payment gateway log</p>
                        </div>
                    </div>
                    <span class="fw-bold fs-4 text-success">@Model.Amount.ToString("C")</span>
                </div>

                <div class="p-4">
                    <div class="row g-4">
                        <!-- ORDER REF -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Related Customer Order</small>
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="fw-bold font-monospace text-primary text-decoration-none fs-6">
                                <i class="bi bi-bag-check me-1"></i>#@Model.OrderId.ToString()[..8].ToUpper()
                            </a>
                            <div class="small text-muted font-monospace mt-1">@Model.OrderId</div>
                        </div>

                        <!-- PAYMENT METHOD -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Payment Gateway / Method</small>
                            <div class="fw-bold text-dark fs-6">
                                <i class="bi bi-wallet2 me-1 text-primary"></i>@(Model.PaymentMethod?.Name ?? "Credit / Debit Card")
                            </div>
                            <div class="small text-muted mt-1">Provider ID: <span class="font-monospace">@Model.PaymentMethodId</span></div>
                        </div>

                        <!-- STATUS -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Settlement Status</small>
                            <span class="badge @statusBadge rounded-pill px-3 py-1.5 fw-semibold fs-6">
                                <i class="bi @statusIcon me-1"></i>@Model.PaymentStatus
                            </span>
                        </div>

                        <!-- AMOUNT -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Captured Amount</small>
                            <div class="fs-4 fw-bold text-success">@Model.Amount.ToString("C")</div>
                        </div>

                        <!-- PAID AT -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Timestamp</small>
                            @if (Model.PaidAt.HasValue)
                            {
                                <div class="fw-semibold text-dark">@Model.PaidAt.Value.ToLocalTime().ToString("f")</div>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">Unconfirmed / Pending</span>
                            }
                        </div>

                        <!-- PAYMENT ID -->
                        <div class="col-sm-6">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">System Transaction ID</small>
                            <span class="font-monospace small text-dark p-1.5 bg-light rounded border d-inline-block">@Model.Id</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-light border rounded-pill px-3">
                            <i class="bi bi-arrow-left me-1"></i> Back to Transactions
                        </a>
                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-primary rounded-pill px-3">
                            <i class="bi bi-eye me-1"></i> View Order Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
