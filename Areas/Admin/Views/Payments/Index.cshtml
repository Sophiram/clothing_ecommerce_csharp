@model IEnumerable<WebApplication_ClothingEcommerce.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <div class="text-uppercase text-muted small fw-bold mb-1">
                Sales / Payments
            </div>

            <h1 class="h3 fw-bold mb-1">
                Payments
            </h1>

            <p class="text-muted mb-0">
                Manage customer payments and payment transactions.
            </p>
        </div>

        <a asp-controller="PaymentMethods"
           asp-action="Index"
           class="btn btn-outline-dark">

            <i class="bi bi-credit-card me-1"></i>
            Payment Methods

        </a>

    </div>


    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@TempData["Error"]</span>
        </div>
    }


    <!-- PAYMENT CARD -->
    <div class="card border-0 shadow-sm">

        <!-- HEADER -->
        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        Payment Transactions
                    </h5>

                    <p class="text-muted small mb-0">
                        View and manage all customer payments.
                    </p>
                </div>

                <span class="badge bg-dark rounded-pill px-3 py-2">
                    @(Model?.Count() ?? 0) Payments
                </span>

            </div>

        </div>


        <!-- FILTER -->
        <div class="px-4 pb-4">

            <form method="get">

                <div class="row g-2">

                    <div class="col-lg-4">

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input name="search"
                                   value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="Search Order ID..." />

                        </div>

                    </div>


                    <div class="col-lg-3">

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Statuses
                            </option>

                            @foreach (var item in ViewBag.PaymentStatuses)
                            {
                                <option value="@item.Value"
                                        selected="@item.Selected">
                                    @item.Text
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-lg-3">

                        <select name="paymentMethodId"
                                class="form-select">

                            <option value="">
                                All Payment Methods
                            </option>

                            @foreach (var item in ViewBag.PaymentMethods)
                            {
                                <option value="@item.Value"
                                        selected="@item.Selected">
                                    @item.Text
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-lg-2">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-dark flex-grow-1">

                                <i class="bi bi-funnel me-1"></i>
                                Filter

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary"
                               title="Reset">

                                <i class="bi bi-arrow-counterclockwise"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>


        <!-- TABLE -->
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4">
                                ORDER
                            </th>

                            <th>
                                PAYMENT METHOD
                            </th>

                            <th>
                                STATUS
                            </th>

                            <th>
                                AMOUNT
                            </th>

                            <th>
                                PAID AT
                            </th>

                            <th class="text-end px-4">
                                ACTIONS
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var payment in Model)
                        {
                            <tr>

                                <!-- ORDER -->

                                <td class="px-4">

                                    <code class="text-dark">
                                        #@payment.OrderId
                                    </code>

                                </td>


                                <!-- PAYMENT METHOD -->

                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        <div class="bg-light rounded p-2">

                                            <i class="bi bi-credit-card text-dark"></i>

                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @(payment.PaymentMethod?.Name ?? "Unknown")
                                            </div>

                                            <small class="text-muted">
                                                ID #@payment.Id
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @{
                                        var status = payment.PaymentStatus.ToString();
                                        var statusClass = status?.ToLower() switch
                                        {
                                            "paid" => "bg-success",
                                            "completed" => "bg-success",
                                            "successful" => "bg-success",
                                            "pending" => "bg-warning text-dark",
                                            "failed" => "bg-danger",
                                            "cancelled" => "bg-secondary",
                                            "refunded" => "bg-info text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }

                                    <span class="badge @statusClass">
                                        @payment.PaymentStatus
                                    </span>

                                </td>


                                <!-- AMOUNT -->

                                <td>

                                    <span class="fw-bold">
                                        @payment.Amount.ToString("C")
                                    </span>

                                </td>


                                <!-- PAID AT -->

                                <td>

                                    @if (payment.PaidAt.HasValue)
                                    {
                                        <span>
                                            @payment.PaidAt.Value
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not paid
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end px-4">

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@payment.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@payment.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@payment.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- EMPTY STATE -->

            <div class="text-center py-5">

                <div class="mb-3">
                    <i class="bi bi-credit-card-2-front display-5 text-muted"></i>
                </div>

                <h5 class="fw-bold">
                    No payments found
                </h5>

                <p class="text-muted mb-0">
                    There are no payment transactions matching your search.
                </p>

            </div>
        }

    </div>

</div>
