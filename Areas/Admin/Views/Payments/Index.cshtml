@model IEnumerable<WebApplication_ClothingEcommerce.Models.Payment>
@using WebApplication_ClothingEcommerce.Data.Enums
@using WebApplication_ClothingEcommerce.Services
@{
    ViewData["Title"] = "Payments";
    var stats = ViewBag.Stats as PaymentStatsDto;
    var currentStatus = ViewBag.Status as PaymentStatus?;
    var totalCount = Model?.Count() ?? 0;
    var totalRevenue = stats?.TotalRevenue ?? Model?.Where(p => p.PaymentStatus == PaymentStatus.Paid || p.PaymentStatus == PaymentStatus.Completed).Sum(p => p.Amount) ?? 0;
    var paidCount = stats?.PaidCount ?? Model?.Count(p => p.PaymentStatus == PaymentStatus.Paid || p.PaymentStatus == PaymentStatus.Completed) ?? 0;
    var pendingCount = stats?.PendingCount ?? Model?.Count(p => p.PaymentStatus == PaymentStatus.Pending) ?? 0;
    var failedCount = stats?.FailedCount ?? Model?.Count(p => p.PaymentStatus == PaymentStatus.Failed) ?? 0;
}

<div class="admin-page">

    <!-- PAGE HEADER -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="page-eyebrow">SALES &amp; TRANSACTIONS</div>
            <h1 class="page-title">Payments</h1>
            <p class="page-description">Monitor financial transactions, gateway reconciliation, and revenue settlements.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="PaymentMethods" asp-action="Index" class="btn btn-light border rounded-pill px-3 fw-semibold">
                <i class="bi bi-wallet2 me-1"></i> Payment Methods
            </a>
            <a asp-action="Create" class="btn-primary-custom">
                <i class="bi bi-plus-lg"></i> Record Payment
            </a>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="admin-alert admin-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="admin-alert admin-alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
        </div>
    }

    <!-- KPI STAT CARDS -->
    <div class="row g-3 mb-4">
        <!-- TOTAL REVENUE -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Total Collected</small>
                        <h3 class="fw-bold mb-0 mt-1 text-success">@totalRevenue.ToString("C")</h3>
                        <small class="text-muted" style="font-size: 0.75rem;">Verified captured revenue</small>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- PAID TRANSACTIONS -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Successful Payments</small>
                        <h3 class="fw-bold mb-0 mt-1 text-primary">@paidCount</h3>
                        <small class="text-primary-emphasis" style="font-size: 0.75rem;">Completed transactions</small>
                    </div>
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- PENDING SETTLEMENT -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Pending Clearance</small>
                        <h3 class="fw-bold mb-0 mt-1 text-warning">@pendingCount</h3>
                        <small class="text-warning-emphasis" style="font-size: 0.75rem;">Awaiting gateway/COD</small>
                    </div>
                    <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- FAILED / REFUNDED -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Failed / Cancelled</small>
                        <h3 class="fw-bold mb-0 mt-1 text-danger">@failedCount</h3>
                        <small class="text-muted" style="font-size: 0.75rem;">Unsuccessful attempts</small>
                    </div>
                    <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN PAYMENTS CARD -->
    <div class="admin-card">

        <div class="admin-card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h3 class="admin-card-title">Payment Transactions</h3>
                <p class="admin-card-subtitle">Real-time gateway settlements and customer payments</p>
            </div>
            <div class="admin-card-count">
                <span>@totalCount</span>
                <small>records</small>
            </div>
        </div>

        <!-- SEARCH & FILTER BAR -->
        <div class="search-wrapper border-bottom pb-3">
            <form method="get" class="search-form flex-wrap gap-2 align-items-center mb-3">
                <div class="search-input-wrapper" style="flex: 2; min-width: 220px;">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="search-input"
                           placeholder="Search Order ID or Payment ID..." />
                </div>

                <select name="status" class="search-input" style="flex: 1; min-width: 160px;">
                    <option value="">All Statuses</option>
                    @if (ViewBag.PaymentStatuses != null)
                    {
                        foreach (var item in ViewBag.PaymentStatuses)
                        {
                            <option value="@item.Value" selected="@item.Selected">
                                @item.Text
                            </option>
                        }
                    }
                </select>

                <select name="paymentMethodId" class="search-input" style="flex: 1; min-width: 170px;">
                    <option value="">All Payment Methods</option>
                    @if (ViewBag.PaymentMethods != null)
                    {
                        foreach (var item in ViewBag.PaymentMethods)
                        {
                            <option value="@item.Value" selected="@item.Selected">
                                @item.Text
                            </option>
                        }
                    }
                </select>

                <button type="submit" class="btn-search">
                    <i class="bi bi-funnel"></i> Filter
                </button>

                <a asp-action="Index" class="btn-reset">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </a>
            </form>

            <!-- QUICK FILTER PILLS -->
            <div class="d-flex flex-wrap gap-1 align-items-center pt-1">
                <span class="text-muted small me-2 fw-semibold" style="font-size: 0.75rem;">Quick View:</span>
                <a asp-action="Index" asp-route-search="@ViewBag.Search"
                   class="btn btn-sm rounded-pill py-0 px-2.5 @(!currentStatus.HasValue ? "btn-dark text-white fw-bold" : "btn-light border text-muted")"
                   style="font-size: 0.75rem;">
                    All Payments (@totalCount)
                </a>
                <a asp-action="Index" asp-route-status="Paid" asp-route-search="@ViewBag.Search"
                   class="btn btn-sm rounded-pill py-0 px-2.5 @(currentStatus?.ToString() == "Paid" ? "btn-success text-white fw-bold" : "btn-light border text-muted")"
                   style="font-size: 0.75rem;">
                    Paid (@paidCount)
                </a>
                <a asp-action="Index" asp-route-status="Pending" asp-route-search="@ViewBag.Search"
                   class="btn btn-sm rounded-pill py-0 px-2.5 @(currentStatus?.ToString() == "Pending" ? "btn-warning text-dark fw-bold" : "btn-light border text-muted")"
                   style="font-size: 0.75rem;">
                    Pending (@pendingCount)
                </a>
                <a asp-action="Index" asp-route-status="Failed" asp-route-search="@ViewBag.Search"
                   class="btn btn-sm rounded-pill py-0 px-2.5 @(currentStatus?.ToString() == "Failed" ? "btn-danger text-white fw-bold" : "btn-light border text-muted")"
                   style="font-size: 0.75rem;">
                    Failed (@failedCount)
                </a>
            </div>
        </div>

        <!-- TRANSACTIONS TABLE -->
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="ps-4">ORDER REF</th>
                            <th>METHOD</th>
                            <th>STATUS</th>
                            <th>AMOUNT</th>
                            <th>PAID AT</th>
                            <th class="text-end pe-4">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            var statusStr = payment.PaymentStatus.ToString();
                            var statusBadge = statusStr.ToLower() switch
                            {
                                "paid" or "completed" or "successful" => "bg-success-subtle text-success border border-success-subtle",
                                "pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                "failed" => "bg-danger-subtle text-danger border border-danger-subtle",
                                "cancelled" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                                "refunded" => "bg-info-subtle text-info-emphasis border border-info-subtle",
                                _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                            };
                            var statusIcon = statusStr.ToLower() switch
                            {
                                "paid" or "completed" or "successful" => "bi-check2-circle",
                                "pending" => "bi-clock-history",
                                "failed" => "bi-exclamation-octagon",
                                "refunded" => "bi-arrow-counterclockwise",
                                _ => "bi-question-circle"
                            };

                            <tr>
                                <!-- ORDER REF -->
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@payment.OrderId"
                                           class="fw-bold font-monospace text-primary text-decoration-none" title="View Related Order">
                                            #@payment.OrderId.ToString()[..8].ToUpper()
                                        </a>
                                    </div>
                                    <small class="text-muted font-monospace" style="font-size: 0.7rem;">Tx: #@payment.Id.ToString()[..8]</small>
                                </td>

                                <!-- PAYMENT METHOD -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-3 bg-light border d-flex align-items-center justify-content-center text-dark p-2" style="width: 36px; height: 36px; flex-shrink: 0;">
                                            <i class="bi bi-credit-card fs-6 text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark small">@(payment.PaymentMethod?.Name ?? "Credit / Debit Card")</div>
                                            <small class="text-muted" style="font-size: 0.7rem;">Verified Provider</small>
                                        </div>
                                    </div>
                                </td>

                                <!-- STATUS -->
                                <td>
                                    <span class="badge @statusBadge rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;">
                                        <i class="bi @statusIcon me-1"></i>@payment.PaymentStatus
                                    </span>
                                </td>

                                <!-- AMOUNT -->
                                <td>
                                    <span class="fw-bold text-success fs-6">@payment.Amount.ToString("C")</span>
                                </td>

                                <!-- PAID AT -->
                                <td>
                                    @if (payment.PaidAt.HasValue)
                                    {
                                        <div class="small fw-semibold text-dark">@payment.PaidAt.Value.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted" style="font-size: 0.72rem;">@payment.PaidAt.Value.ToLocalTime().ToString("hh:mm tt")</small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                                            <i class="bi bi-hourglass me-1"></i>Awaiting Payment
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@payment.Id">
                                                    <i class="bi bi-eye text-primary"></i> <span>View Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@payment.Id">
                                                    <i class="bi bi-pencil text-warning"></i> <span>Edit Payment</span>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider my-1" /></li>
                                            <li>
                                                <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@payment.Id">
                                                    <i class="bi bi-trash"></i> <span>Delete Payment</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- EMPTY STATE -->
            <div class="text-center py-5 px-3">
                <div class="mb-3">
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-muted shadow-sm" style="width: 72px; height: 72px;">
                        <i class="bi bi-credit-card-2-front fs-1"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark">No payments found</h5>
                <p class="text-muted small mb-3">No payment transactions match your selected search or filters.</p>
                <a asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-arrow-repeat me-1"></i> Reset Filters
                </a>
            </div>
        }
    </div>
</div>
