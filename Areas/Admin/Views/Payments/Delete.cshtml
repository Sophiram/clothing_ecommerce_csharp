@model WebApplication_ClothingEcommerce.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
}

<div class="container-fluid py-4">

    <!-- HEADER -->

    <div class="mb-4">

        <div class="text-uppercase text-muted small fw-bold mb-1">
            Sales / Payments
        </div>

        <h1 class="h3 fw-bold mb-1">
            Delete Payment
        </h1>

        <p class="text-muted mb-0">
            Remove this payment transaction from the system.
        </p>

    </div>


    <!-- DELETE CARD -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white p-4">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-danger-subtle text-danger rounded p-3">

                    <i class="bi bi-trash fs-4"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">
                        Confirm Payment Deletion
                    </h5>

                    <p class="text-muted small mb-0">
                        This action cannot be undone.
                    </p>

                </div>

            </div>

        </div>


        <div class="card-body p-4">


            <!-- WARNING -->

            <div class="alert alert-danger d-flex gap-2 align-items-start">

                <i class="bi bi-exclamation-triangle-fill mt-1"></i>

                <div>

                    <strong>Are you sure?</strong>

                    <div class="small mt-1">
                        You are about to permanently delete this payment transaction.
                    </div>

                </div>

            </div>


            <!-- PAYMENT INFORMATION -->

            <div class="border rounded p-4 mb-4">

                <div class="row g-4">


                    <div class="col-md-6">

                        <div class="text-muted small text-uppercase fw-bold mb-1">
                            Payment ID
                        </div>

                        <code>
                            #@Model.Id
                        </code>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small text-uppercase fw-bold mb-1">
                            Order
                        </div>

                        <code>
                            #@Model.OrderId
                        </code>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small text-uppercase fw-bold mb-1">
                            Payment Method
                        </div>

                        <span class="fw-semibold">
                            @(Model.PaymentMethod?.Name ?? "Unknown")
                        </span>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small text-uppercase fw-bold mb-1">
                            Amount
                        </div>

                        <span class="fw-bold">
                            @Model.Amount.ToString("C")
                        </span>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small text-uppercase fw-bold mb-1">
                            Status
                        </div>

                        <span class="badge bg-secondary">
                            @Model.PaymentStatus
                        </span>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small text-uppercase fw-bold mb-1">
                            Paid At
                        </div>

                        @if (Model.PaidAt.HasValue)
                        {
                            <span>
                                @Model.PaidAt.Value
                                .ToLocalTime()
                                .ToString("yyyy-MM-dd HH:mm")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not paid
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- DELETE FORM -->

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                @Html.AntiForgeryToken()

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash me-1"></i>
                        Delete Payment

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
