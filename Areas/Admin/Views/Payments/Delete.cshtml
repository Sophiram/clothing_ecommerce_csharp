@model WebApplication_ClothingEcommerce.Models.Payment
@{
    ViewData["Title"] = "Delete Payment";
}

<div class="admin-page">
    <!-- PAGE HEADER -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="page-eyebrow">
                <a asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i> Back to Payments</a>
            </div>
            <h1 class="page-title text-danger">Delete Payment Transaction</h1>
            <p class="page-description">Permanently remove this payment record from the store accounts.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="admin-card text-center p-4">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                </div>
                <h3 class="fw-bold text-dark">Confirm Transaction Deletion</h3>
                <p class="text-muted small mb-4">This will permanently delete this payment entry. Reconciled invoices may be impacted.</p>

                <div class="border rounded-3 p-3 mb-4 bg-light text-start small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Transaction ID:</span>
                        <strong class="font-monospace text-dark">#@Model.Id.ToString()[..8].ToUpper()</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Associated Order:</span>
                        <strong class="font-monospace text-primary">#@Model.OrderId.ToString()[..8].ToUpper()</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Method:</span>
                        <strong class="text-dark">@(Model.PaymentMethod?.Name ?? "Credit / Debit Card")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Payment Status:</span>
                        <span class="badge bg-secondary">@Model.PaymentStatus</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Amount:</span>
                        <strong class="text-success fs-6">@Model.Amount.ToString("C")</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                            <i class="bi bi-trash me-1"></i> Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-light border rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
