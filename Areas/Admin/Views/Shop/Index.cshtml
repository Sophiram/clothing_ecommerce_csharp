@model IEnumerable<WebApplication_ClothingEcommerce.Models.Product>

@{
    ViewData["Title"] = "Shop Catalog";
}

<div class="container">
    <h1 class="my-4">Product Catalog</h1>

    <div class="row">
        <!-- Sidebar Filters -->
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">Categories</div>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" class="list-group-item list-group-item-action">All Categories</a>
                    @foreach (var cat in (IEnumerable<WebApplication_ClothingEcommerce.Models.Category>)ViewBag.Categories)
                    {
                        <a asp-action="Index" asp-route-categoryId="@cat.Id" class="list-group-item list-group-item-action">@cat.Name</a>
                    }
                </div>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-md-9">
            <div class="row">
                @foreach (var item in Model)
                {
                    var firstVariant = item.Variants.FirstOrDefault();
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">@item.Name</h5>
                                <p class="card-text text-muted">@item.Category?.Name | @item.Brand?.Name</p>
                                <p class="card-text font-weight-bold text-primary">
                                    @(firstVariant != null ? $"${firstVariant.Price}" : "N/A")
                                </p>
                            </div>
                            <div class="card-footer bg-transparent border-top-0">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm w-100">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>