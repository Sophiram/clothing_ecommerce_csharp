                                            label: 'Active Users',
                                            fontSize: '12px',
                                            formatter: () => usersTotal.toLocaleString()
                                        }
                                    }
                                }
                            }
                        },
                        dataLabels: { enabled: false },
                        legend: { position: 'bottom', horizontalAlign: 'center', fontSize: '11px' }
                    };
                    new ApexCharts(saUsersDonutEl, options).render();
                }

                // =========================================================
                // 4. SUPER ADMIN: CATEGORY CATALOG DONUT CIRCLE
                // =========================================================
                const saCatDonutEl = document.querySelector("#chart-super-category-donut");
                if (saCatDonutEl) {
                    const catData = @Html.Raw(JsonSerializer.Serialize(sa.CategoryDistributions));
                    let series = catData.map(c => Number(c.ProductCount || c.productCount || 0));
                    let labels = catData.map(c => c.CategoryName || c.categoryName || 'General');

                    if (series.length === 0 || series.reduce((a, b) => a + b, 0) === 0) {
                        series = [1];
                        labels = ['Catalog Ready'];
                    }

                    const options = {
                        series: series,
                        labels: labels,
                        colors: [colors.primary, colors.success, colors.warning, colors.danger, colors.purple, colors.teal],
                        chart: { type: 'donut', height: 220, fontFamily: 'Inter, sans-serif' },
                        stroke: { width: 2, colors: ['#ffffff'] },
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '70%',
                                    labels: {
                                        show: true,
                                        total: {
                                            show: true,
                                            label: 'Catalog Items',
                                            fontSize: '12px',
                                            formatter: () => series.reduce((a, b) => a + b, 0).toLocaleString()
                                        }
                                    }
                                }
                            }
                        },
                        dataLabels: { enabled: false },
                        legend: { position: 'bottom', horizontalAlign: 'center', fontSize: '11px' }
                    };
                    new ApexCharts(saCatDonutEl, options).render();
                }

            } else {
                // =========================================================
                // 1. STORE ADMIN: 7-DAY STORE SALES VELOCITY TREND
                // =========================================================
                const storeSalesTrend = @Html.Raw(JsonSerializer.Serialize(store.SalesTrend));
                const storeLabels = storeSalesTrend.map(x => x.DateLabel || x.dateLabel);
                const storeRevenues = storeSalesTrend.map(x => Number(x.Revenue || x.revenue || 0));
                const storeOrders = storeSalesTrend.map(x => Number(x.OrdersCount || x.ordersCount || 0));

                const storeSalesTrendEl = document.querySelector("#chart-store-sales-trend");
                if (storeSalesTrendEl) {
                    const options = {
                        series: [
                            { name: 'Store Revenue ($)', type: 'area', data: storeRevenues },
                            { name: 'Orders Placed', type: 'column', data: storeOrders }
                        ],
                        chart: {
                            height: 290,
                            type: 'line',
                            toolbar: { show: false },
                            fontFamily: 'Inter, sans-serif'
                        },
                        stroke: { width: [3, 0], curve: 'smooth' },
                        colors: [colors.primary, colors.teal],
                        fill: {
                            type: ['gradient', 'solid'],
                            gradient: {
                                shadeIntensity: 1,
                                opacityFrom: 0.35,
                                opacityTo: 0.05,
                                stops: [0, 90, 100]
                            }
                        },
                        labels: storeLabels.length > 0 ? storeLabels : ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'],
                        yaxis: [
                            {
                                title: { text: 'Revenue ($)', style: { color: colors.primary, fontWeight: 600 } },
                                labels: { formatter: (val) => '$' + Number(val).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }) }
                            },
                            {
                                opposite: true,
                                title: { text: 'Order Count', style: { color: colors.teal, fontWeight: 600 } },
                                labels: { formatter: (val) => Number(val).toFixed(0) }
                            }
                        ],
                        grid: { borderColor: '#f1f4f9', strokeDashArray: 4 },
                        legend: { position: 'top', horizontalAlign: 'right' },
                        tooltip: {
                            shared: true,
                            intersect: false,
                            y: {
                                formatter: function (y, { seriesIndex }) {
                                    if (seriesIndex === 0) return '$' + Number(y).toLocaleString(undefined, { minimumFractionDigits: 2 });
                                    return y + ' orders';
                                }
                            }
                        }
                    };
                    new ApexCharts(storeSalesTrendEl, options).render();
                }

                // =========================================================
                // 2. STORE ADMIN: ORDER STATUS DONUT CIRCLE
                // =========================================================
                const storeOrdersDonutEl = document.querySelector("#chart-store-orders-donut");
                if (storeOrdersDonutEl) {
                    const pending = @store.PendingOrdersCount;
                    const processing = @store.ProcessingOrdersCount;
                    const shipped = @store.ShippedOrdersCount;
                    const delivered = @store.DeliveredOrdersCount;
                    const total = pending + processing + shipped + delivered;

                    const donutSeries = total > 0 ? [pending, processing, shipped, delivered] : [1, 0, 0, 0];
                    const donutLabels = ['Pending', 'Processing', 'Shipped', 'Delivered'];
                    const donutColors = [colors.warning, colors.primary, colors.purple, colors.success];

                    const options = {
                        series: donutSeries,
                        labels: donutLabels,
                        colors: donutColors,
                        chart: { type: 'donut', height: 240, fontFamily: 'Inter, sans-serif' },
                        stroke: { width: 2, colors: ['#ffffff'] },
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '72%',
                                    labels: {
                                        show: true,
                                        total: {
                                            show: true,
                                            label: 'Orders',
                                            fontSize: '13px',
                                            color: '#697386',
                                            formatter: () => total.toLocaleString()
                                        },
                                        value: {
                                            fontSize: '22px',
                                            fontWeight: 800,
                                            color: '#1a1f36'
                                        }
                                    }
                                }
                            }
                        },
                        dataLabels: { enabled: false },
                        legend: { show: false },
                        tooltip: {
                            y: {
                                formatter: function (val) {
                                    if (total <= 0) return '0 orders';
                                    const pct = ((val / total) * 100).toFixed(1);
                                    return val + ' orders (' + pct + '%)';
                                }
                            }
