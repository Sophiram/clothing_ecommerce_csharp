                    };
                    new ApexCharts(storeOrdersDonutEl, options).render();
                }

                // =========================================================
                // 3. STORE ADMIN: INVENTORY STOCK HEALTH DONUT CIRCLE
                // =========================================================
                const storeInvDonutEl = document.querySelector("#chart-store-inventory-donut");
                if (storeInvDonutEl) {
                    const inStock = @store.InventoryHealth.InStockCount;
                    const lowStock = @store.InventoryHealth.LowStockCount;
                    const outStock = @store.InventoryHealth.OutOfStockCount;
                    const invTotal = inStock + lowStock + outStock;

                    const series = invTotal > 0 ? [inStock, lowStock, outStock] : [1, 0, 0];
                    const labels = ['Optimal Stock (>5)', 'Low Stock (1-5)', 'Out of Stock (0)'];
                    const invColors = [colors.success, colors.warning, colors.danger];

                    const options = {
                        series: series,
                        labels: labels,
                        colors: invColors,
                        chart: { type: 'donut', height: 220, fontFamily: 'Inter, sans-serif' },
                        stroke: { width: 2, colors: ['#ffffff'] },
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '70%',
                                    labels: {
                                        show: true,
                                        total: {
                                            show: true,
                                            label: 'Health Score',
                                            fontSize: '12px',
                                            formatter: () => '@store.InventoryHealth.HealthScorePercentage%'
                                        }
                                    }
                                }
                            }
                        },
                        dataLabels: { enabled: false },
                        legend: { position: 'bottom', horizontalAlign: 'center', fontSize: '11px' }
                    };
                    new ApexCharts(storeInvDonutEl, options).render();
                }

                // =========================================================
                // 4. STORE ADMIN: CATEGORY DISTRIBUTION DONUT CIRCLE
                // =========================================================
                const storeCatDonutEl = document.querySelector("#chart-store-category-donut");
                if (storeCatDonutEl) {
                    const catData = @Html.Raw(JsonSerializer.Serialize(store.CategoryDistributions));
                    let series = catData.map(c => Number(c.ItemsSold || c.itemsSold || c.ProductCount || c.productCount || 0));
                    let labels = catData.map(c => c.CategoryName || c.categoryName || 'General');

                    if (series.length === 0 || series.reduce((a, b) => a + b, 0) === 0) {
                        series = [1];
                        labels = ['Catalog Items'];
                    }

                    const options = {
                        series: series,
                        labels: labels,
                        colors: [colors.primary, colors.success, colors.warning, colors.danger, colors.purple, colors.teal],
                        chart: { type: 'donut', height: 220, fontFamily: 'Inter, sans-serif' },
                        stroke: { width: 2, colors: ['#ffffff'] },
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '70%',
                                    labels: {
                                        show: true,
                                        total: {
                                            show: true,
                                            label: 'Top Categories',
                                            fontSize: '12px',
                                            formatter: () => series.reduce((a, b) => a + b, 0).toLocaleString()
                                        }
                                    }
                                }
                            }
                        },
                        dataLabels: { enabled: false },
                        legend: { position: 'bottom', horizontalAlign: 'center', fontSize: '11px' }
                    };
                    new ApexCharts(storeCatDonutEl, options).render();
                }

                // =========================================================
                // 5. STORE ADMIN: RADIAL GAUGES (FULFILLMENT & TARGET)
                // =========================================================
                const radialGaugesEl = document.querySelector("#chart-store-radial-gauges");
                if (radialGaugesEl) {
                    const fulfillmentRate = @store.FulfillmentRate;
                    const targetProgress = @store.MonthlyTargetProgress;

                    const options = {
                        series: [fulfillmentRate, targetProgress],
                        chart: {
                            height: 230,
                            type: 'radialBar',
                            fontFamily: 'Inter, sans-serif'
                        },
                        plotOptions: {
                            radialBar: {
                                dataLabels: {
                                    name: { fontSize: '13px' },
                                    value: { fontSize: '18px', fontWeight: 800, formatter: (val) => val + '%' },
                                    total: {
                                        show: true,
                                        label: 'Efficiency',
                                        formatter: () => Math.round((fulfillmentRate + targetProgress) / 2) + '%'
                                    }
                                }
                            }
                        },
                        labels: ['Fulfillment Rate', 'Monthly Target'],
                        colors: [colors.success, colors.primary]
                    };
                    new ApexCharts(radialGaugesEl, options).render();
                }
            }
        });

        // Quick filter for Recent Store Orders table
        function filterRecentOrders(type, btn) {
            document.querySelectorAll('.order-filter-tabs .btn').forEach(function(b) {
                b.classList.remove('active');
            });
            if (btn) {
                btn.classList.add('active');
            } else {
                const targetBtn = document.querySelector(`.order-filter-tabs button[onclick*="'${type}'"]`);
                if (targetBtn) targetBtn.classList.add('active');
            }

            const rows = document.querySelectorAll('#recentStoreOrdersTable tbody tr.order-row');
            let visibleCount = 0;
            rows.forEach(function(r) {
                if (type === 'all') {
                    r.style.display = '';
                    visibleCount++;
                } else {
                    const orderType = r.getAttribute('data-order-type');
                    const isMatch = (orderType === type);
                    r.style.display = isMatch ? '' : 'none';
                    if (isMatch) visibleCount++;
                }
            });

            const emptyRow = document.getElementById('noMatchingOrdersRow');
            if (emptyRow) {
                emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
            }
        }

        // Initialize table filter and modal listener
        document.addEventListener("DOMContentLoaded", function () {
            const dispatchModalEl = document.getElementById('dispatchModal');
            if (dispatchModalEl) {
                dispatchModalEl.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;
                    document.getElementById('dispatchOrderId').value = btn.getAttribute('data-order-id') || '';
                    document.getElementById('dispatchOrderNum').textContent = '#' + (btn.getAttribute('data-order-num') || '');
                    document.getElementById('dispatchCustomerName').textContent = btn.getAttribute('data-customer') || 'Customer';
                    const carrier = btn.getAttribute('data-carrier') || 'J&T Express';
                    document.getElementById('dispatchCarrierSelect').value = carrier;
                    document.getElementById('dispatchTrackingInput').value = btn.getAttribute('data-tracking') || '';
                });
            }
        });
    </script>
}



