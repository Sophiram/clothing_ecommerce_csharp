@model WebApplication_ClothingEcommerce.Models.ViewModels.AdminDashboardViewModel
@using WebApplication_ClothingEcommerce.Data.Enums
@using System.Text.Json
@using System.Linq

@{
    ViewData["Title"] = Model.IsSuperAdmin ? "Super Admin Dashboard" : "Store Admin Dashboard";
    var isSuperView = Model.IsSuperAdmin && Model.ActiveView == "superadmin";
    var sa = Model.SuperAdmin;
    var store = Model.StoreAdmin;
}

<style>
    /* =========================================================
       PROFESSIONAL ENTERPRISE DASHBOARD STYLING
       Clean, modern visual language inspired by Stripe & Shopify
    ========================================================= */
    .dashboard-container {
        --dash-primary: var(--google-blue, #4285F4);
        --dash-primary-soft: rgba(66, 133, 244, 0.1);
        --dash-success: var(--google-green, #34A853);
        --dash-success-soft: rgba(52, 168, 83, 0.1);
        --dash-warning: var(--google-yellow, #FBBC04);
        --dash-warning-soft: rgba(251, 188, 4, 0.1);
        --dash-danger: var(--google-red, #EA4335);
        --dash-danger-soft: rgba(234, 67, 53, 0.1);
        --dash-purple: #8E24AA;
        --dash-purple-soft: rgba(142, 36, 170, 0.1);
        --dash-teal: #00897B;
        --dash-teal-soft: rgba(0, 137, 123, 0.1);
        --dash-card-bg: var(--admin-card, #ffffff);
        --dash-border: var(--admin-border, #e5e5e5);
        --dash-text: var(--admin-text, #333333);
        --dash-muted: var(--admin-muted, #888888);
        color: var(--dash-text);
    }
        color: var(--dash-text);
    }

    .tabular-nums {
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.01em;
    }

    /* Top Greeting Banner */
    .dash-hero {
        background: #ffffff;
        border: 1px solid var(--dash-border);
        border-radius: var(--radius-md, 12px);
        padding: 1.5rem 1.75rem;
        box-shadow: none;
    }

    .status-live-pulse {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.75rem;
        border-radius: var(--radius-sm, 6px);
        font-size: 0.75rem;
        font-weight: 600;
        background: rgba(52, 168, 83, 0.1);
        color: #1e7e34;
        border: 1px solid rgba(52, 168, 83, 0.25);
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: var(--radius-md, 12px);
        background-color: #34A853;
        box-shadow: 0 0 0 0 rgba(52, 168, 83, 0.7);
        animation: pulseAnimation 2s infinite;
    }

    @@keyframes pulseAnimation {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 168, 83, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(52, 168, 83, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 168, 83, 0); }
    }

    /* Pill Switcher */
    .view-switcher-pill {
        background: #ebf0f7;
        padding: 4px;
        border-radius: var(--radius-md, 12px);
        display: inline-flex;
        border: 1px solid #dce3ed;
    }

    .view-switcher-pill .btn {
        border-radius: var(--radius-md, 12px);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.35rem 1rem;
        border: none;
        color: var(--dash-muted);
        transition: all 0.2s ease;
    }

    .view-switcher-pill .btn.active {
        background: #ffffff;
        color: #1a1f36;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* Metric KPI Cards */
    .metric-card {
        background: var(--dash-card-bg);
        border: 1px solid var(--dash-border);
        border-radius: var(--radius-md, 12px);
        padding: 1.35rem 1.4rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        position: relative;
        overflow: hidden;
        height: 100%;
        box-shadow: none;
    }

    .metric-card:hover {
        transform: translateY(-2px);
        box-shadow: none;
        border-color: #d0d7e5;
    }

    .metric-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: var(--accent-bar, var(--dash-primary));
        opacity: 0.9;
    }

    .metric-icon-box {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-md, 12px);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .metric-title {
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--dash-muted);
        margin-bottom: 0.35rem;
    }

    .metric-value {
        font-size: 1.85rem;
        font-weight: 800;
        line-height: 1.15;
        color: var(--dash-text);
        margin-bottom: 0.35rem;
    }

    .metric-badge {
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.2rem 0.55rem;
        border-radius: var(--radius-md, 12px);
    }

    .metric-badge.positive {
        background: var(--dash-success-soft);
        color: #1e7e34;
    }

    .metric-badge.warning {
        background: var(--dash-warning-soft);
        color: #926300;
    }

    .metric-badge.danger {
        background: var(--dash-danger-soft);
        color: #c5221f;
    }

    .metric-badge.neutral {
        background: #f1f4f9;
        color: var(--dash-muted);
    }

    /* Content Cards & Panels */
    .dash-panel {
        background: var(--dash-card-bg);
        border: 1px solid var(--dash-border);
        border-radius: var(--radius-md, 12px);
        box-shadow: none;
        height: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .dash-panel-header {
        padding: 1.1rem 1.4rem;
        border-bottom: 1px solid var(--dash-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fafbfe;
    }

    .dash-panel-title {
        font-size: 0.96rem;
        font-weight: 700;
        color: var(--dash-text);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .dash-panel-subtitle {
        font-size: 0.78rem;
        color: var(--dash-muted);
        margin-top: 0.15rem;
    }

    .dash-panel-body {
        padding: 1.35rem;
        flex-grow: 1;
    }

    /* Donut Chart Legend & Stats Styling */
    .donut-legend-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.45rem 0.6rem;
        border-radius: var(--radius-md, 12px);
        transition: background-color 0.15s ease;
    }

    .donut-legend-item:hover {
        background-color: #f6f8fc;
    }

    .donut-dot {
        width: 10px;
        height: 10px;
        border-radius: var(--radius-md, 12px);
        display: inline-block;
        flex-shrink: 0;
    }

    /* Product Leaderboard */
    .rank-pill {
        width: 26px;
        height: 26px;
        border-radius: var(--radius-sm, 6px);
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .rank-gold { background: #FFF4D9; color: #B7791F; border: 1px solid #FFE099; }
    .rank-silver { background: #EEF2F6; color: #4B5565; border: 1px solid #D0D7E2; }
    .rank-bronze { background: #FBECE4; color: #A75D2A; border: 1px solid #F2CDBA; }
    .rank-default { background: #F1F4F9; color: var(--dash-muted); }

    /* Action Links & Buttons */
    .action-badge-btn {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius-md, 12px);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        transition: all 0.15s ease;
    }

    .action-badge-btn:hover {
        transform: translateY(-1px);
    }

    .quick-tool-card {
        border: 1px solid var(--dash-border);
        border-radius: var(--radius-md, 12px);
        padding: 0.9rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        text-decoration: none;
        color: var(--dash-text);
        background: #ffffff;
        transition: all 0.2s ease;
    }

    .quick-tool-card:hover {
        border-color: var(--dash-primary);
        background: var(--dash-primary-soft);
        color: var(--dash-primary);
        transform: translateX(3px);
    }

    .quick-tool-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #f0f4fd;
        color: var(--dash-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    /* Empty state */
    .dash-empty-state {
        text-align: center;
        padding: 2.5rem 1.5rem;
        color: var(--dash-muted);
    }

    .dash-empty-state i {
        font-size: 2.25rem;
        color: #ccd5e2;
        margin-bottom: 0.65rem;
        display: block;
    }
</style>

<div class="dashboard-container py-3">

    <!-- =========================================================
         TOP DASHBOARD HERO / WELCOME BANNER
    ========================================================== -->
    <div class="dash-hero mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="status-live-pulse">
                        <span class="pulse-dot"></span>
                        Platform Online
                    </span>
                    <span class="badge bg-light text-dark border px-2 py-1">
                        <i class="bi @(Model.IsSuperAdmin ? "bi-shield-lock-fill text-dark" : "bi-shop text-dark") me-1"></i>
                        @(Model.IsSuperAdmin ? "Enterprise Administrator" : "Store Administrator")
                    </span>
                    <span class="text-muted small">
                        <i class="bi bi-clock me-1"></i>@(DateTime.UtcNow.ToString("dd MMM yyyy, HH:mm")) UTC
                    </span>
                </div>
                <h1 class="h3 fw-bold mb-1 text-dark">
                    Welcome back, @(User.Identity?.Name?.Split('@')[0] ?? "Administrator")
                </h1>
                <p class="text-muted mb-0 small">
                    @(isSuperView
                        ? "Real-time enterprise metrics, financial performance, role access controls, and security audit trail."
                        : "Daily retail performance, fulfillment workflow, inventory stock distribution, and product analytics.")
                </p>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (Model.IsSuperAdmin)
                {
                    <div class="view-switcher-pill" role="group" aria-label="Toggle Dashboard View">
                        <a asp-action="Index" asp-route-view="superadmin"
                           class="btn @(isSuperView ? "active" : "")">
                            <i class="bi bi-shield-check me-1"></i> Super Admin
                        </a>
                        <a asp-action="Index" asp-route-view="store"
                           class="btn @(!isSuperView ? "active" : "")">
                            <i class="bi bi-shop me-1"></i> Store Admin
                        </a>
                    </div>
                }

                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener"
                   class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm bg-white">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Storefront
                </a>

                <button type="button" class="btn btn-sm btn-primary-custom rounded-pill px-3 shadow-sm" onclick="window.location.reload();">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    @if (isSuperView)
    {
        <!-- =====================================================
             SUPER ADMIN DASHBOARD: ENTERPRISE FINANCIALS & PLATFORM
        ====================================================== -->

        <!-- ROW 1: PRIMARY KPI STATISTIC CARDS -->
        <div class="row g-3 mb-4">
            <!-- Total Platform Revenue -->
            <div class="col-sm-6 col-xl-3">
                <div class="metric-card" style="--accent-bar: var(--dash-primary);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="metric-title">Platform Revenue</div>
                            <div class="metric-value tabular-nums">$@sa.TotalRevenue.ToString("N2")</div>
                        </div>
                        <div class="metric-icon-box" style="background: var(--dash-primary-soft); color: var(--dash-primary);">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="metric-badge @(sa.RevenueGrowthPercentage >= 0 ? "positive" : "danger")">
                            <i class="bi @(sa.RevenueGrowthPercentage >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                            @(sa.RevenueGrowthPercentage >= 0 ? "+" : "")@sa.RevenueGrowthPercentage.ToString("0.0")%
                        </span>
                        <span class="text-muted small tabular-nums">$@sa.MonthRevenue.ToString("N2") this month</span>
                    </div>
                </div>
            </div>

            <!-- Today's Revenue & AOV -->
            <div class="col-sm-6 col-xl-3">
                <div class="metric-card" style="--accent-bar: var(--dash-success);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="metric-title">Today's Revenue</div>
                            <div class="metric-value tabular-nums">$@sa.TodayRevenue.ToString("N2")</div>
                        </div>
                        <div class="metric-icon-box" style="background: var(--dash-success-soft); color: var(--dash-success);">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="metric-badge positive">
                            <i class="bi bi-cart-check"></i> Live Today
                        </span>
                        <span class="text-muted small tabular-nums">Avg: $@sa.AverageOrderValue.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- User Demographics & Security Accounts -->
            <div class="col-sm-6 col-xl-3">
                <div class="metric-card" style="--accent-bar: var(--dash-purple);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="metric-title">Platform Users</div>
                            <div class="metric-value tabular-nums">@sa.TotalUsers.ToString("N0")</div>
                        </div>
                        <div class="metric-icon-box" style="background: var(--dash-purple-soft); color: var(--dash-purple);">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="text-muted small">
                            <strong class="text-dark tabular-nums">@sa.TotalCustomers</strong> customers
                        </span>
                        <span class="metric-badge neutral">
                            <i class="bi bi-shield-check"></i> @sa.TotalAdmins admins
                        </span>
                    </div>
                </div>
            </div>

            <!-- Security Audit Trail -->
            <div class="col-sm-6 col-xl-3">
                <div class="metric-card" style="--accent-bar: var(--dash-teal);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="metric-title">Security &amp; Audits</div>
                            <div class="metric-value tabular-nums">@sa.TotalAuditLogs.ToString("N0")</div>
                        </div>
                        <div class="metric-icon-box" style="background: var(--dash-teal-soft); color: var(--dash-teal);">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="metric-badge neutral">
                            <i class="bi bi-activity"></i> @sa.TodayAuditLogs today
                        </span>
                        <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="text-dark text-decoration-none small fw-semibold">
                            View Logs <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 2: CORE VISUAL ANALYTICS - TREND LINE & ORDER STATUS DONUT -->
        <div class="row g-4 mb-4">
            <!-- 7-Day Revenue Velocity Trend -->
            <div class="col-lg-7 col-xl-8">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-graph-up text-dark"></i> 7-Day Revenue &amp; Sales Velocity
                            </h2>
                            <div class="dash-panel-subtitle">Daily transaction totals and order completion volume</div>
                        </div>
                        <span class="badge bg-light text-dark border px-2 py-1">
                            <i class="bi bi-calendar3 me-1"></i> Last 7 Days
                        </span>
                    </div>
                    <div class="dash-panel-body">
                        <div id="chart-super-revenue-trend" style="min-height: 290px;"></div>
                    </div>
                </div>
            </div>

            <!-- Order Pipeline Donut Circle -->
            <div class="col-lg-5 col-xl-4">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-pie-chart-fill text-dark"></i> Order Status Distribution
                            </h2>
                            <div class="dash-panel-subtitle">Fulfillment pipeline breakdown across all orders</div>
                        </div>
                        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0" style="font-size: 0.75rem;">
                            Orders <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                    <div class="dash-panel-body d-flex flex-column justify-content-between">
                        <div id="chart-super-orders-donut" style="min-height: 230px;"></div>

                        <!-- Custom Breakdown Legend -->
                        <div class="mt-3 pt-3 border-top">
                            <div class="row g-2 small">
                                <div class="col-6">
                                    <div class="donut-legend-item">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="donut-dot" style="background: #FBBC04;"></span>
                                            <span>Pending</span>
                                        </span>
                                        <strong class="tabular-nums">@sa.PendingOrders</strong>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="donut-legend-item">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="donut-dot" style="background: #4285F4;"></span>
                                            <span>Processing</span>
                                        </span>
                                        <strong class="tabular-nums">@sa.ProcessingOrders</strong>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="donut-legend-item">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="donut-dot" style="background: #8E24AA;"></span>
                                            <span>Shipped</span>
                                        </span>
                                        <strong class="tabular-nums">@sa.ShippedOrders</strong>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="donut-legend-item">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="donut-dot" style="background: #34A853;"></span>
                                            <span>Delivered</span>
                                        </span>
                                        <strong class="tabular-nums">@sa.DeliveredOrders</strong>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="donut-legend-item">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="donut-dot" style="background: #EA4335;"></span>
                                            <span>Cancelled</span>
                                        </span>
                                        <strong class="tabular-nums text-dark">@sa.CancelledOrders</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 3: PLATFORM ECOSYSTEM DONUT CIRCLES & SYSTEM CONTROLS -->
        <div class="row g-4 mb-4">
            <!-- Donut Circle: User & Role Demographics -->
            <div class="col-md-6 col-xl-4">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-person-badge-fill text-dark"></i> User Roles &amp; Access
                            </h2>
                            <div class="dash-panel-subtitle">RBAC platform account segregation</div>
                        </div>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="text-muted small">
                            <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                    <div class="dash-panel-body">
                        <div id="chart-super-users-donut" style="min-height: 220px;"></div>
                        <div class="mt-3 pt-2 border-top text-center text-muted small">
                            Total Accounts: <strong class="text-dark tabular-nums">@sa.TotalUsers</strong> &middot; Roles: <strong class="text-dark">@sa.TotalRoles</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Donut Circle: Category Catalog Share -->
            <div class="col-md-6 col-xl-4">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-tag-fill text-dark"></i> Catalog by Category
                            </h2>
                            <div class="dash-panel-subtitle">Product distribution across retail categories</div>
                        </div>
                        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="text-muted small">
                            <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                    <div class="dash-panel-body">
                        <div id="chart-super-category-donut" style="min-height: 220px;"></div>
                        <div class="mt-3 pt-2 border-top text-center text-muted small">
                            Total Products: <strong class="text-dark tabular-nums">@sa.TotalProducts</strong> &middot; Brands: <strong class="text-dark">@sa.TotalBrands</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Super Admin Quick Controls & Runtime Health -->
            <div class="col-xl-4">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-gear-wide-connected text-dark"></i> System &amp; Governance
                            </h2>
                            <div class="dash-panel-subtitle">Security administration shortcuts</div>
                        </div>
                    </div>
                    <div class="dash-panel-body d-flex flex-column gap-2 justify-content-center">
                        <a asp-area="Admin" asp-controller="Admins" asp-action="Index" class="quick-tool-card">
                            <span class="quick-tool-icon"><i class="bi bi-shield-lock-fill"></i></span>
                            <div class="flex-grow-1">
                                <div class="fw-bold small">Administrator Accounts</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">Manage platform credentials and lockouts</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="quick-tool-card">
                            <span class="quick-tool-icon"><i class="bi bi-key-fill"></i></span>
                            <div class="flex-grow-1">
                                <div class="fw-bold small">Security Roles &amp; RBAC</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">Configure authorization policies</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>

                        <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="quick-tool-card">
                            <span class="quick-tool-icon"><i class="bi bi-sliders"></i></span>
                            <div class="flex-grow-1">
                                <div class="fw-bold small">Platform System Settings</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">Store policies, tax, and environment</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </a>

                        <!-- Runtime specs -->
                        <div class="p-2 rounded-pill bg-light border mt-2 small text-muted">
                            <div class="d-flex justify-content-between mb-1">
                                <span><i class="bi bi-cpu me-1"></i>Framework:</span>
                                <strong class="text-dark">.NET @sa.FrameworkVersion</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span><i class="bi bi-hdd-network me-1"></i>Environment:</span>
                                <span class="badge bg-dark text-white-subtle text-dark border">@sa.EnvironmentName</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 4: RECENT AUDIT LOGS & RECENT ORDERS FEED -->
        <div class="row g-4">
            <div class="col-12">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-journal-text text-teal"></i> Recent Security Audit Trail
                            </h2>
                            <div class="dash-panel-subtitle">Real-time administrator modifications &amp; system actions</div>
                        </div>
                        <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                            View All Logs <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                    @if (sa.RecentAuditLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-borderless align-middle mb-0">
                                <thead class="border-bottom text-muted small text-uppercase">
                                    <tr>
                                        <th scope="col" class="py-3 px-4">User</th>
                                        <th scope="col" class="py-3">Action</th>
                                        <th scope="col" class="py-3">Entity</th>
                                        <th scope="col" class="py-3">Description</th>
                                        <th scope="col" class="py-3 px-4 text-end">Time (UTC)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in sa.RecentAuditLogs)
                                    {
                                        <tr class="border-bottom">
                                            <td class="fw-semibold small py-3 px-4">
                                                <i class="bi bi-person-circle me-2 text-muted"></i>
                                                @(log.UserEmail ?? "System")
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-light text-dark border font-monospace">@log.Action</span>
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-secondary text-white border">@log.EntityName</span>
                                            </td>
                                            <td class="text-muted small text-truncate py-3" style="max-width: 260px;">
                                                @(log.Description ?? "—")
                                            </td>
                                            <td class="text-end text-muted small tabular-nums py-3 px-4">
                                                @log.CreatedAt.ToString("MMM dd, HH:mm")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="dash-empty-state">
                            <i class="bi bi-journal-check"></i>
                            <p class="mb-0">All clear. Platform actions and audit events will stream here.</p>
                        </div>
                    }
                </div>
            </div>

        </div> <!-- End of Row 4 -->

        <!-- ROW 5: RECENT ORDERS TABLE -->
        <div class="dash-panel mb-4">
            <div class="dash-panel-header flex-wrap gap-2">
                <div>
                    <h2 class="dash-panel-title">
                        <i class="bi bi-receipt-cutoff text-dark"></i> Recent Orders
                    </h2>
                    <div class="dash-panel-subtitle">Latest customer purchases across the platform</div>
                </div>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-primary-custom rounded-pill px-3 shadow-sm">
                    View All Orders <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            @if (sa.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th scope="col" class="ps-4">Order ID</th>
                                <th scope="col">Customer</th>
                                <th scope="col">Date</th>
                                <th scope="col" class="text-center">Items</th>
                                <th scope="col">Total</th>
                                <th scope="col">Payment</th>
                                <th scope="col">Order Status</th>
                                <th scope="col" class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in sa.RecentOrders)
                            {
                                var custRaw = $"{order.Customer?.FirstName} {order.Customer?.LastName}".Trim();
                                var custName = !string.IsNullOrWhiteSpace(custRaw)
                                    ? custRaw
                                    : (!string.IsNullOrWhiteSpace(order.Customer?.Email) ? order.Customer.Email.Split('@')[0] : "Customer");
                                var custInit = !string.IsNullOrWhiteSpace(custName) ? custName.Substring(0, 1).ToUpper() : "C";

                                var orderStatusClass = order.Status switch
                                {
                                    OrderStatus.Delivered => "bg-success text-white",
                                    OrderStatus.Shipped => "bg-primary text-white",
                                    OrderStatus.Processing => "bg-info text-dark",
                                    OrderStatus.Confirmed => "bg-primary text-white",
                                    OrderStatus.Cancelled => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };

                                var orderDateLocal = DateTime.SpecifyKind(order.OrderDate, DateTimeKind.Utc).ToLocalTime();

                                <tr>
                                    <td class="ps-4">
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                                           class="font-monospace fw-bold small text-dark text-decoration-none" title="View Order Details">
                                            #@order.Id.ToString()[..8].ToUpper()
                                        </a>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-pill d-flex align-items-center justify-content-center text-white fw-bold shadow-sm flex-shrink-0"
                                                 style="width: 32px; height: 32px; font-size: 12px; background: linear-gradient(135deg, #4285F4, #34A853);">
                                                @custInit
                                            </div>
                                            <div class="overflow-hidden">
                                                <div class="fw-semibold small text-dark text-truncate" style="max-width: 150px;">@custName</div>
                                                <small class="text-muted d-block text-truncate" style="max-width: 150px;">@(order.Customer?.Email ?? "N/A")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted small tabular-nums">
                                        <div>@orderDateLocal.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@orderDateLocal.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border rounded-pill tabular-nums">
                                            @(order.Items?.Sum(i => i.Quantity) ?? 0)
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark tabular-nums small">
                                        $@order.TotalAmount.ToString("N2")
                                    </td>
                                    <td>
                                        @if (order.Payment != null)
                                        {
                                            if (order.Payment.PaymentStatus == PaymentStatus.Paid || order.Payment.PaymentStatus == PaymentStatus.Completed)
                                            {
                                                <span class="badge bg-dark text-white-subtle text-dark border border-success-subtle rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Paid
                                                </span>
                                            }
                                            else if (order.Payment.PaymentStatus == PaymentStatus.Pending)
                                            {
                                                <span class="badge bg-secondary-subtle text-dark-emphasis border border-warning-subtle rounded-pill">
                                                    <i class="bi bi-hourglass-split me-1"></i>Unpaid
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-dark border border-danger-subtle rounded-pill">
                                                    <i class="bi bi-x-circle-fill me-1"></i>@order.Payment.PaymentStatus
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @orderStatusClass rounded-pill">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="dropdown">
                                            <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                                <li>
                                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">
                                                        <i class="bi bi-eye text-dark"></i> <span>Order Details</span>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="dash-empty-state">
                    <i class="bi bi-bag"></i>
                    <p class="mb-0">No orders placed yet.</p>
                </div>
            }
        </div>
    }
    else
    {
        var readyCount = store.RecentOrders.Count(o => o.Status == OrderStatus.Pending ||
                                                      o.Status == OrderStatus.Confirmed ||
                                                      o.Status == OrderStatus.Processing);
        var deliveredCount = store.RecentOrders.Count(o => o.Status == OrderStatus.Delivered);
        var defaultFilter = readyCount > 0 ? "ready" : "all";

        <!-- =====================================================
             STORE ADMIN DASHBOARD: RETAIL OPERATIONS & INVENTORY
        ====================================================== -->

        <!-- ROW 1: STORE PERFORMANCE KPI CARDS -->
        <div class="row g-3 mb-4">
            <!-- Total Store Revenue -->
            <div class="col-sm-6 col-xl-3">
                <div class="metric-card" style="--accent-bar: var(--dash-primary);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="metric-title">Store Revenue</div>
                            <div class="metric-value tabular-nums">$@store.StoreRevenue.ToString("N2")</div>
                        </div>
                        <div class="metric-icon-box" style="background: var(--dash-primary-soft); color: var(--dash-primary);">
                            <i class="bi bi-wallet2"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="metric-badge positive">
                            <i class="bi bi-calendar-check"></i> Monthly:
                        </span>
                        <span class="text-muted small tabular-nums fw-semibold">$@store.MonthSales.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- Today's Sales Volume -->
            <div class="col-sm-6 col-xl-3">
                <div class="metric-card" style="--accent-bar: var(--dash-success);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="metric-title">Today's Sales</div>
                            <div class="metric-value tabular-nums">$@store.TodaySales.ToString("N2")</div>
                        </div>
                        <div class="metric-icon-box" style="background: var(--dash-success-soft); color: var(--dash-success);">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="metric-badge neutral">
                            <i class="bi bi-receipt"></i> @store.OrdersToday orders today
                        </span>
                        <span class="text-muted small tabular-nums">Total: @store.TotalOrders</span>
                    </div>
                </div>
            </div>

            <!-- Fulfillment Queue (Pending & Processing) -->
            <div class="col-sm-6 col-xl-3">
                <div class="metric-card" style="--accent-bar: var(--dash-warning);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="metric-title">Orders To Fulfill</div>
                            <div class="metric-value tabular-nums">@(store.PendingOrdersCount + store.ProcessingOrdersCount)</div>
                        </div>
                        <div class="metric-icon-box" style="background: var(--dash-warning-soft); color: #B7791F;">
                            <i class="bi bi-box-seam-fill"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="metric-badge @(store.PendingOrdersCount > 0 ? "warning" : "neutral")">
                            @store.PendingOrdersCount pending
                        </span>
                        <span class="text-muted small">@store.ProcessingOrdersCount in prep</span>
                    </div>
                </div>
            </div>

            <!-- Inventory Health & Out of Stock Alerts -->
            <div class="col-sm-6 col-xl-3">
                <div class="metric-card" style="--accent-bar: @(store.OutOfStockCount > 0 ? "var(--dash-danger)" : "var(--dash-teal)");">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="metric-title">Inventory Alerts</div>
                            <div class="metric-value tabular-nums text-@(store.OutOfStockCount > 0 ? "danger" : "dark")">@store.LowStockCount</div>
                        </div>
                        <div class="metric-icon-box" style="background: @(store.OutOfStockCount > 0 ? "var(--dash-danger-soft)" : "var(--dash-teal-soft)"); color: @(store.OutOfStockCount > 0 ? "var(--dash-danger)" : "var(--dash-teal)");">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="metric-badge @(store.OutOfStockCount > 0 ? "danger" : "positive")">
                            @store.OutOfStockCount out of stock
                        </span>
                        <a asp-area="Admin" asp-controller="Inventories" asp-action="Index" class="text-dark text-decoration-none small fw-semibold">
                            Restock <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- URGENT LOW STOCK ALERT STRIP (IF ANY) -->
        @if (store.LowStockAlerts.Any())
        {
            <div class="dash-panel mb-4" style="border-color: rgba(234, 67, 53, 0.4); background: #fffbfa;">
                <div class="p-3">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                        <div class="d-flex align-items-center gap-2 fw-bold text-dark">
                            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                            <span>Attention Required: Low Stock &amp; Depleted Variants</span>
                        </div>
                        <a asp-area="Admin" asp-controller="Inventories" asp-action="Index" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                            Inventory Manager <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                    <div class="row g-2">
                        @foreach (var alert in store.LowStockAlerts.Take(3))
                        {
                            <div class="col-md-4">
                                <div class="p-2 border rounded-pill bg-white d-flex align-items-center gap-2 shadow-sm">
                                    @if (!string.IsNullOrEmpty(alert.ImageUrl))
                                    {
                                        <img src="@alert.ImageUrl" alt="" class="rounded-0 border" style="width: 44px; height: 44px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-0 border d-flex align-items-center justify-content-center text-muted flex-shrink-0" style="width: 44px; height: 44px; background: #f8fafc;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-bold text-truncate small">@alert.ProductName</div>
                                        <small class="text-muted d-block font-monospace">@alert.SKU (@alert.SizeName / @alert.ColorName)</small>
                                        <span class="badge @(alert.AvailableQuantity <= 0 ? "bg-danger" : "bg-secondary text-dark") px-2 py-0">
                                            @(alert.AvailableQuantity <= 0 ? "0 units left" : $"{alert.AvailableQuantity} units left")
                                        </span>
                                    </div>
                                    <a asp-area="Admin" asp-controller="Inventories" asp-action="Index" class="btn btn-sm btn-outline-dark rounded-pill p-1" title="Restock">
                                        <i class="bi bi-plus-lg"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- ROW 2: STORE SALES VELOCITY & ORDER STATUS DONUT -->
        <div class="row g-4 mb-4">
            <!-- 7-Day Store Sales Velocity Chart -->
            <div class="col-lg-7 col-xl-8">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-graph-up-arrow text-dark"></i> 7-Day Store Sales Velocity
                            </h2>
                            <div class="dash-panel-subtitle">Revenue trend ($) and daily order transactions</div>
                        </div>
                        <span class="badge bg-light text-dark border px-2 py-1">
                            <i class="bi bi-calendar-week me-1"></i> Live Stream
                        </span>
                    </div>
                    <div class="dash-panel-body">
                        <div id="chart-store-sales-trend" style="min-height: 290px;"></div>
                    </div>
                </div>
            </div>

            <!-- Order Pipeline Donut Circle -->
            <div class="col-lg-5 col-xl-4">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-pie-chart-fill text-dark"></i> Order Fulfillment Donut
                            </h2>
                            <div class="dash-panel-subtitle">Status of customer purchases</div>
                        </div>
                        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0" style="font-size: 0.75rem;">
                            Orders <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                    <div class="dash-panel-body d-flex flex-column justify-content-between">
                        <div id="chart-store-orders-donut" style="min-height: 230px;"></div>

                        <!-- Legend & Status Pills -->
                        <div class="mt-3 pt-3 border-top">
                            <div class="row g-2 small">
                                <div class="col-6">
                                    <div class="donut-legend-item">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="donut-dot" style="background: #FBBC04;"></span>
                                            <span>Pending</span>
                                        </span>
                                        <strong class="tabular-nums">@store.PendingOrdersCount</strong>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="donut-legend-item">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="donut-dot" style="background: #4285F4;"></span>
                                            <span>Processing</span>
                                        </span>
                                        <strong class="tabular-nums">@store.ProcessingOrdersCount</strong>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="donut-legend-item">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="donut-dot" style="background: #8E24AA;"></span>
                                            <span>Shipped</span>
                                        </span>
                                        <strong class="tabular-nums">@store.ShippedOrdersCount</strong>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="donut-legend-item">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="donut-dot" style="background: #34A853;"></span>
                                            <span>Delivered</span>
                                        </span>
                                        <strong class="tabular-nums">@store.DeliveredOrdersCount</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 3: INVENTORY HEALTH DONUT & CATEGORY DISTRIBUTION DONUT & RADIAL GAUGES -->
        <div class="row g-4 mb-4">
            <!-- Donut Circle: Inventory Stock Health -->
            <div class="col-md-6 col-xl-4">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-boxes text-dark"></i> Inventory Stock Health
                            </h2>
                            <div class="dash-panel-subtitle">Available variant capacity &amp; safety stock</div>
                        </div>
                        <a asp-area="Admin" asp-controller="Inventories" asp-action="Index" class="text-muted small">
                            <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                    <div class="dash-panel-body">
                        <div id="chart-store-inventory-donut" style="min-height: 220px;"></div>
                        <div class="mt-3 pt-2 border-top text-center text-muted small">
                            Total Variants: <strong class="text-dark tabular-nums">@store.InventoryHealth.TotalVariants</strong> &middot; Health Score: <strong class="text-dark">@store.InventoryHealth.HealthScorePercentage%</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Donut Circle: Category Catalog Share -->
            <div class="col-md-6 col-xl-4">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-pie-chart text-dark"></i> Category Distribution
                            </h2>
                            <div class="dash-panel-subtitle">Sales &amp; product share across categories</div>
                        </div>
                        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="text-muted small">
                            <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                    <div class="dash-panel-body">
                        <div id="chart-store-category-donut" style="min-height: 220px;"></div>
                        <div class="mt-3 pt-2 border-top text-center text-muted small">
                            Active Catalog: <strong class="text-dark tabular-nums">@store.ActiveProductsCount</strong> of <strong class="text-dark">@store.TotalProducts</strong> products
                        </div>
                    </div>
                </div>
            </div>

            <!-- Radial Gauge: Fulfillment Success & Monthly Target -->
            <div class="col-xl-4">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-speedometer2 text-dark"></i> Operations Efficiency
                            </h2>
                            <div class="dash-panel-subtitle">Delivery fulfillment rate &amp; sales target</div>
                        </div>
                    </div>
                    <div class="dash-panel-body d-flex flex-column justify-content-around">
                        <div id="chart-store-radial-gauges" style="min-height: 230px;"></div>

                        <div class="row g-2 mt-2 pt-2 border-top text-center small">
                            <div class="col-6 border-end">
                                <div class="text-muted">Fulfillment Rate</div>
                                <div class="fw-bold text-dark fs-6 tabular-nums">@store.FulfillmentRate%</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted">Target Progress</div>
                                <div class="fw-bold text-dark fs-6 tabular-nums">@store.MonthlyTargetProgress%</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 4: BEST SELLERS & STORE SHORTCUTS -->
        <div class="row g-4 mb-4">
            <!-- Best Selling Products Leaderboard -->
            <div class="col-lg-7">
                <div class="dash-panel">
                    <div class="dash-panel-header">
                        <div>
                            <h2 class="dash-panel-title">
                                <i class="bi bi-trophy-fill text-dark"></i> Best Performing Products
                            </h2>
                            <div class="dash-panel-subtitle">Top revenue and volume sales leaders</div>
                        </div>
                        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                            Catalog <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                    @if (store.TopSellingProducts.Any())
                    {
                        var maxQty = store.TopSellingProducts.Max(p => p.TotalQuantitySold);
                        if (maxQty <= 0) maxQty = 1;
                        var rank = 1;

                        <div class="table-responsive">
                            <table class="table admin-table align-middle">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 50px;">#</th>
                                        <th scope="col">Product</th>
                                        <th scope="col" class="text-center">Volume</th>
                                        <th scope="col">Revenue</th>
                                        <th scope="col" class="text-end">Stock</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var prod in store.TopSellingProducts)
                                    {
                                        var rankClass = rank == 1 ? "rank-gold" : rank == 2 ? "rank-silver" : rank == 3 ? "rank-bronze" : "rank-default";
                                        var pct = Math.Min(100, (double)prod.TotalQuantitySold / maxQty * 100);

                                        <tr>
                                            <td>
                                                <span class="rank-pill @rankClass">@rank</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(prod.ImageUrl))
                                                    {
                                                        <img src="@prod.ImageUrl" alt="" class="rounded-0 border" style="width: 38px; height: 38px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-0 border d-flex align-items-center justify-content-center text-muted flex-shrink-0" style="width: 38px; height: 38px; background: #f8fafc;">
                                                            <i class="bi bi-image"></i>
                                                        </div>
                                                    }
                                                    <div class="overflow-hidden">
                                                        <div class="fw-bold text-truncate small" style="max-width: 170px;">@prod.Name</div>
                                                        <small class="text-muted">@prod.BrandName &middot; <span class="badge bg-light text-dark border px-1">@prod.CategoryName</span></small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <div class="fw-bold small tabular-nums">@prod.TotalQuantitySold</div>
                                                <div class="progress mt-1" style="height: 4px; width: 60px; margin: 0 auto;">
                                                    <div class="progress-bar bg-dark text-white" style="width: @pct.ToString("0")%;"></div>
                                                </div>
                                            </td>
                                            <td class="fw-bold text-dark tabular-nums small">
                                                $@prod.TotalRevenue.ToString("N2")
                                            </td>
                                            <td class="text-end">
                                                <span class="badge @(prod.CurrentStock > 10 ? "bg-dark text-white" : prod.CurrentStock > 0 ? "bg-secondary text-dark" : "bg-danger") rounded-pill">
                                                    @prod.CurrentStock in stock
                                                </span>
                                            </td>
                                        </tr>
                                        rank++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="dash-empty-state">
                            <i class="bi bi-graph-up"></i>
                            <p class="mb-0">No sales transactions recorded yet.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Store Operations & Pending Shipments -->
            <div class="col-lg-5">
                <!-- Quick Operations Shortcuts -->
                <div class="dash-panel mb-4">
                    <div class="dash-panel-header">
                        <h2 class="dash-panel-title">
                            <i class="bi bi-lightning-charge text-dark"></i> Quick Operations
                        </h2>
                    </div>
                    <div class="dash-panel-body">
                        <div class="row g-2">
                            <div class="col-6">
                                <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="quick-tool-card">
                                    <span class="quick-tool-icon"><i class="bi bi-plus-circle-fill"></i></span>
                                    <div>
                                        <div class="fw-bold small">Add Product</div>
                                        <small class="text-muted" style="font-size: 0.72rem;">New catalog item</small>
                                    </div>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-area="Admin" asp-controller="Inventories" asp-action="Create" class="quick-tool-card">
                                    <span class="quick-tool-icon"><i class="bi bi-boxes"></i></span>
                                    <div>
                                        <div class="fw-bold small">Add Inventory</div>
                                        <small class="text-muted" style="font-size: 0.72rem;">Restock units</small>
                                    </div>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="quick-tool-card">
                                    <span class="quick-tool-icon"><i class="bi bi-cart-check-fill"></i></span>
                                    <div>
                                        <div class="fw-bold small">Fulfill Orders</div>
                                        <small class="text-muted" style="font-size: 0.72rem;">Process pipeline</small>
                                    </div>
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-area="Admin" asp-controller="Shipments" asp-action="Index" class="quick-tool-card">
                                    <span class="quick-tool-icon"><i class="bi bi-truck"></i></span>
                                    <div>
                                        <div class="fw-bold small">Shipments</div>
                                        <small class="text-muted" style="font-size: 0.72rem;">Courier tracking</small>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ROW 5: RECENT ORDERS TABLE (READY FOR SHIPMENT PROCESSING) -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 rounded-pill border-0 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill text-dark fs-5"></i>
                <div>@TempData["Success"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 rounded-pill border-0 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-dark fs-5"></i>
                <div>@TempData["Error"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="dash-panel mb-4">
            <div class="dash-panel-header flex-wrap gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="dash-panel-title">
                            <i class="bi bi-receipt-cutoff text-dark"></i> Recent Store Orders
                        </h2>
                        @if (readyCount > 0)
                        {
                            <span class="badge bg-secondary-subtle text-dark-emphasis border border-warning-subtle rounded-pill small">
                                @readyCount Awaiting Dispatch
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-dark text-white-subtle text-dark border border-success-subtle rounded-pill small">
                                All Dispatched
                            </span>
                        }
                    </div>
                    <div class="dash-panel-subtitle">Latest customer purchases ready for shipment processing</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="btn-group btn-group-sm order-filter-tabs" role="group" aria-label="Order Filter Tabs">
                        <button type="button" class="btn btn-outline-secondary @(defaultFilter == "ready" ? "active" : "")" onclick="filterRecentOrders('ready', this)">
                            <i class="bi bi-box-seam me-1 text-dark"></i> Ready for Shipment (@readyCount)
                        </button>
                        <button type="button" class="btn btn-outline-secondary @(defaultFilter == "all" ? "active" : "")" onclick="filterRecentOrders('all', this)">
                            All Orders (@store.RecentOrders.Count)
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="filterRecentOrders('delivered', this)">
                            <i class="bi bi-check-circle me-1 text-dark"></i> Delivered (@deliveredCount)
                        </button>
                    </div>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-primary-custom rounded-pill px-3 shadow-sm">
                        View All Orders <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            @if (store.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table admin-table align-middle" id="recentStoreOrdersTable">
                        <thead>
                            <tr>
                                <th scope="col" class="ps-4">Order ID</th>
                                <th scope="col">Customer</th>
                                <th scope="col">Date</th>
                                <th scope="col" class="text-center">Items</th>
                                <th scope="col">Total</th>
                                <th scope="col">Payment</th>
                                <th scope="col">Order Status</th>
                                <th scope="col" class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in store.RecentOrders)
                            {
                                var custRaw = $"{order.Customer?.FirstName} {order.Customer?.LastName}".Trim();
                                var custName = !string.IsNullOrWhiteSpace(custRaw)
                                    ? custRaw
                                    : (!string.IsNullOrWhiteSpace(order.Customer?.Email) ? order.Customer.Email.Split('@')[0] : "Customer");
                                var custInit = !string.IsNullOrWhiteSpace(custName) ? custName.Substring(0, 1).ToUpper() : "C";

                                var orderStatusClass = order.Status switch
                                {
                                    OrderStatus.Delivered => "bg-dark text-white",
                                    OrderStatus.Shipped => "bg-dark text-white",
                                    OrderStatus.Processing => "bg-secondary text-white text-dark",
                                    OrderStatus.Confirmed => "bg-secondary",
                                    OrderStatus.Cancelled => "bg-danger",
                                    _ => "bg-secondary text-dark"
                                };

                                var isReadyToShip = order.Status == OrderStatus.Pending ||
                                                    order.Status == OrderStatus.Confirmed ||
                                                    order.Status == OrderStatus.Processing;

                                var filterCategory = order.Status == OrderStatus.Delivered ? "delivered" : (isReadyToShip ? "ready" : "other");

                                var orderDateLocal = DateTime.SpecifyKind(order.OrderDate, DateTimeKind.Utc).ToLocalTime();

                                <tr class="order-row" data-order-type="@filterCategory">
                                    <td class="ps-4">
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                                           class="font-monospace fw-bold small text-dark text-decoration-none" title="View Order Details">
                                            #@order.Id.ToString()[..8].ToUpper()
                                        </a>
                                        @if (isReadyToShip && order.Payment?.PaymentStatus == PaymentStatus.Paid)
                                        {
                                            <span class="d-block badge bg-secondary-subtle text-dark-emphasis border border-warning-subtle mt-1" style="font-size: 0.65rem; width: fit-content;">
                                                <i class="bi bi-clock-history me-1"></i>Action Req.
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-pill d-flex align-items-center justify-content-center text-white fw-bold shadow-sm flex-shrink-0"
                                                 style="width: 32px; height: 32px; font-size: 12px; background: linear-gradient(135deg, #4285F4, #34A853);">
                                                @custInit
                                            </div>
                                            <div class="overflow-hidden">
                                                <div class="fw-semibold small text-dark text-truncate" style="max-width: 150px;">@custName</div>
                                                <small class="text-muted d-block text-truncate" style="max-width: 150px;">@(order.Customer?.Email ?? "N/A")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted small tabular-nums">
                                        <div>@orderDateLocal.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@orderDateLocal.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border rounded-pill tabular-nums">
                                            @(order.Items?.Sum(i => i.Quantity) ?? 0)
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark tabular-nums small">
                                        $@order.TotalAmount.ToString("N2")
                                    </td>
                                    <td>
                                        @if (order.Payment != null)
                                        {
                                            if (order.Payment.PaymentStatus == PaymentStatus.Paid || order.Payment.PaymentStatus == PaymentStatus.Completed)
                                            {
                                                <span class="badge bg-dark text-white-subtle text-dark border border-success-subtle rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Paid
                                                </span>
                                            }
                                            else if (order.Payment.PaymentStatus == PaymentStatus.Pending)
                                            {
                                                <span class="badge bg-secondary-subtle text-dark-emphasis border border-warning-subtle rounded-pill">
                                                    <i class="bi bi-hourglass-split me-1"></i>Unpaid
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-dark border border-danger-subtle rounded-pill">
                                                    <i class="bi bi-x-circle-fill me-1"></i>@order.Payment.PaymentStatus
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @orderStatusClass rounded-pill">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="dropdown">
                                            <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                                @if (isReadyToShip)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item" 
                                                                data-bs-toggle="modal" data-bs-target="#dispatchModal"
                                                                data-order-id="@order.Id"
                                                                data-order-num="@order.Id.ToString()[..8].ToUpper()"
                                                                data-customer="@custName"
                                                                data-carrier="@(order.Shipment?.ShippingCompany ?? "J&T Express")"
                                                                data-tracking="@(order.Shipment?.TrackingNumber ?? "")">
                                                            <i class="bi bi-box-seam text-dark"></i> <span>Dispatch Order</span>
                                                        </button>
                                                    </li>
                                                }
                                                @if (order.Shipment != null)
                                                {
                                                    <li>
                                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Shipments" asp-action="Details" asp-route-id="@order.Shipment.Id">
                                                            <i class="bi bi-truck text-dark"></i> <span>Shipment Details</span>
                                                        </a>
                                                    </li>
                                                }
                                                <li>
                                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">
                                                        <i class="bi bi-eye text-dark"></i> <span>Order Details</span>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr id="noMatchingOrdersRow" style="display: none;">
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-check-circle text-dark fs-3 d-block mb-2"></i>
                                    <div class="fw-semibold text-dark">No orders in this view</div>
                                    <small class="text-muted">All customer purchases in this category have been processed.</small>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="dash-empty-state">
                    <i class="bi bi-bag"></i>
                    <p class="mb-0">No orders placed yet.</p>
                </div>
            }
        </div>
    }

</div>

<!-- Quick Dispatch Modal for Store Admin Orders -->
<div class="modal fade" id="dispatchModal" tabindex="-1" aria-labelledby="dispatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-0-4 overflow-hidden">
            <form asp-area="Admin" asp-controller="Shipments" asp-action="Fulfill" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" id="dispatchOrderId" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                
                <div class="modal-header bg-light border-0 py-3 px-4">
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="dispatchModalLabel">
                            <i class="bi bi-box-seam text-dark me-2"></i>Dispatch Order <span id="dispatchOrderNum" class="font-monospace text-dark"></span>
                        </h5>
                        <small class="text-muted">Customer: <strong id="dispatchCustomerName" class="text-dark"></strong></small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body p-4">
                    <div class="p-3 bg-dark text-white-subtle border border-primary-subtle rounded-pill small text-dark-emphasis mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill fs-5 flex-shrink-0"></i>
                        <div>Confirming dispatch will transition the order status to <strong>Shipped</strong> and record carrier tracking info.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Shipping Courier / Carrier</label>
                        <select name="carrier" id="dispatchCarrierSelect" class="form-select rounded-pill">
                            <option value="J&T Express">J&T Express</option>
                            <option value="DHL Express">DHL Express</option>
                            <option value="FedEx">FedEx</option>
                            <option value="Grab Express">Grab Express</option>
                            <option value="Standard Courier">Standard Courier</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold small text-muted">Tracking Code / Parcel ID</label>
                        <input type="text" name="trackingNumber" id="dispatchTrackingInput" class="form-control font-monospace rounded-pill" placeholder="e.g. JT987654321KH" />
                        <div class="form-text small text-muted">Leave blank to automatically generate an internal tracking code.</div>
                    </div>
                </div>
                
                <div class="modal-footer bg-light border-0 py-3 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom rounded-pill px-4 shadow-sm fw-semibold">
                        <i class="bi bi-truck me-1"></i> Confirm &amp; Dispatch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- ApexCharts CDN for Professional Visual Statistics -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Theme Colors
            const colors = {
                primary: '#4285F4',
                success: '#34A853',
                warning: '#FBBC04',
                danger: '#EA4335',
                purple: '#8E24AA',
                teal: '#00ACC1',
                orange: '#FB8C00',
                slate: '#607D8B'
            };

            const isSuperView = @(isSuperView ? "true" : "false");

            if (isSuperView) {
                // =========================================================
                // 1. SUPER ADMIN: REVENUE & SALES VELOCITY TREND
                // =========================================================
                const saSalesTrend = @Html.Raw(JsonSerializer.Serialize(sa.SalesTrend));
                const saLabels = saSalesTrend.map(x => x.DateLabel || x.dateLabel);
                const saRevenues = saSalesTrend.map(x => Number(x.Revenue || x.revenue || 0));
                const saOrders = saSalesTrend.map(x => Number(x.OrdersCount || x.ordersCount || 0));

                const revenueTrendEl = document.querySelector("#chart-super-revenue-trend");
                if (revenueTrendEl) {
                    const options = {
                        series: [
                            { name: 'Revenue ($)', type: 'area', data: saRevenues },
                            { name: 'Orders Count', type: 'column', data: saOrders }
                        ],
                        chart: {
                            height: 290,
                            type: 'line',
                            toolbar: { show: false },
                            fontFamily: 'Inter, sans-serif'
                        },
                        stroke: {
                            width: [3, 0],
                            curve: 'smooth'
                        },
                        colors: [colors.primary, colors.teal],
                        fill: {
                            type: ['gradient', 'solid'],
                            gradient: {
                                shadeIntensity: 1,
                                opacityFrom: 0.35,
                                opacityTo: 0.05,
                                stops: [0, 90, 100]
                            }
                        },
                        labels: saLabels.length > 0 ? saLabels : ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'],
                        yaxis: [
                            {
                                title: { text: 'Revenue ($)', style: { color: colors.primary, fontWeight: 600 } },
                                labels: { formatter: (val) => '$' + Number(val).toLocaleString(undefined, { minimumFractionDigits: 0, maximumFractionDigits: 0 }) }
                            },
                            {
                                opposite: true,
                                title: { text: 'Orders Placed', style: { color: colors.teal, fontWeight: 600 } },
                                labels: { formatter: (val) => Number(val).toFixed(0) }
                            }
                        ],
                        grid: {
                            borderColor: '#f1f4f9',
                            strokeDashArray: 4
                        },
                        legend: { position: 'top', horizontalAlign: 'right' },
                        tooltip: {
                            shared: true,
                            intersect: false,
                            y: {
                                formatter: function (y, { seriesIndex }) {
                                    if (seriesIndex === 0) return '$' + Number(y).toLocaleString(undefined, { minimumFractionDigits: 2 });
                                    return y + ' orders';
                                }
                            }
                        }
                    };
                    new ApexCharts(revenueTrendEl, options).render();
                }

                // =========================================================
                // 2. SUPER ADMIN: ORDER PIPELINE DONUT CIRCLE
                // =========================================================
                const saOrdersDonutEl = document.querySelector("#chart-super-orders-donut");
                if (saOrdersDonutEl) {
                    const pending = @sa.PendingOrders;
                    const processing = @sa.ProcessingOrders;
                    const shipped = @sa.ShippedOrders;
                    const delivered = @sa.DeliveredOrders;
                    const cancelled = @sa.CancelledOrders;
                    const total = pending + processing + shipped + delivered + cancelled;

                    const donutSeries = total > 0 ? [pending, processing, shipped, delivered, cancelled] : [1, 0, 0, 0, 0];
                    const donutLabels = ['Pending', 'Processing', 'Shipped', 'Delivered', 'Cancelled'];
                    const donutColors = [colors.warning, colors.primary, colors.purple, colors.success, colors.danger];

                    const options = {
                        series: donutSeries,
                        labels: donutLabels,
                        colors: donutColors,
                        chart: {
                            type: 'donut',
                            height: 240,
                            fontFamily: 'Inter, sans-serif'
                        },
                        stroke: { width: 2, colors: ['#ffffff'] },
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '72%',
                                    labels: {
                                        show: true,
                                        total: {
                                            show: true,
                                            label: 'Total Orders',
                                            fontSize: '13px',
                                            color: '#697386',
                                            formatter: () => total.toLocaleString()
                                        },
                                        value: {
                                            fontSize: '22px',
                                            fontWeight: 800,
                                            color: '#1a1f36'
                                        }
                                    }
                                }
                            }
                        },
                        dataLabels: { enabled: false },
                        legend: { show: false },
                        tooltip: {
                            y: {
                                formatter: function (val) {
                                    if (total <= 0) return '0 orders';
                                    const pct = ((val / total) * 100).toFixed(1);
                                    return val + ' orders (' + pct + '%)';
                                }
                            }
                        }
                    };
                    new ApexCharts(saOrdersDonutEl, options).render();
                }

                // =========================================================
                // 3. SUPER ADMIN: USERS & ROLES DONUT CIRCLE
                // =========================================================
                const saUsersDonutEl = document.querySelector("#chart-super-users-donut");
                if (saUsersDonutEl) {
                    const custCount = @sa.TotalCustomers;
                    const adminCount = @sa.TotalAdmins;
                    const superCount = @sa.SuperAdminCount;
                    const usersTotal = custCount + adminCount;

                    const series = usersTotal > 0 ? [custCount, Math.max(0, adminCount - superCount), superCount] : [1, 0, 0];
                    const labels = ['Customers', 'Store Admins', 'Super Admins'];
                    const uColors = [colors.primary, colors.purple, colors.teal];

                    const options = {
                        series: series,
                        labels: labels,
                        colors: uColors,
                        chart: { type: 'donut', height: 220, fontFamily: 'Inter, sans-serif' },
                        stroke: { width: 2, colors: ['#ffffff'] },
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '70%',
                                    labels: {
                                        show: true,
                                        total: {
