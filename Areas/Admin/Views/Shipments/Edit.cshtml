@model WebApplication_ClothingEcommerce.Models.Shipment

@{
    ViewData["Title"] = "Edit Shipment";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <div class="page-eyebrow">SALES & FULFILLMENT</div>
            <h1 class="page-title">Edit Shipment</h1>
            <p class="page-description">Modify carrier, tracking number, and dispatch status.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Shipments
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm col-lg-8 mx-auto">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="OrderId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Order ID</label>
                    <input type="text" class="form-control" value="#@Model.OrderId.ToString()[..8].ToUpper()" readonly disabled />
                </div>

                <div class="mb-3">
                    <label asp-for="ShippingCompany" class="form-label fw-semibold">Shipping Carrier</label>
                    <select asp-for="ShippingCompany" class="form-select" required>
                        <option value="VET Express (VET)">VET Express (VET)</option>
                        <option value="J&T Express">J&T Express (J&T)</option>
                        <option value="Virak Buntham Logistics">Virak Buntham Logistics</option>
                        <option value="Standard Courier">Standard Courier</option>
                        <option value="DHL Express">DHL Express</option>
                        <option value="FedEx">FedEx</option>
                    </select>
                    <span asp-validation-for="ShippingCompany" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TrackingNumber" class="form-label fw-semibold">Tracking Number</label>
                    <input asp-for="TrackingNumber" class="form-control" placeholder="e.g. JT987654321KH" />
                    <span asp-validation-for="TrackingNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ShipmentStatus" class="form-label fw-semibold">Shipment Status</label>
                    <select asp-for="ShipmentStatus" class="form-select" asp-items="ViewBag.Statuses"></select>
                    <span asp-validation-for="ShipmentStatus" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="ShippedAt" class="form-label fw-semibold">Shipped Timestamp</label>
                        <input asp-for="ShippedAt" class="form-control" type="datetime-local" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeliveredAt" class="form-label fw-semibold">Delivered Timestamp</label>
                        <input asp-for="DeliveredAt" class="form-control" type="datetime-local" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
