@model IEnumerable<WebApplication_ClothingEcommerce.Models.CartItem>

@{
    ViewData["Title"] = "Cart Items";
}

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <!-- Breadcrumb -->
            <nav class="flex mb-2" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                    <li class="inline-flex items-center">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hover:text-primary-600 dark:hover:text-primary-400">Admin</a>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span data-en="Commerce" data-kh="ពាណិជ្ជកម្ម">Commerce</span>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span class="text-slate-900 dark:text-white font-semibold" data-en="Cart Items" data-kh="ទំនិញក្នុងកន្ត្រក">Cart Items</span>
                    </li>
                </ol>
            </nav>

            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950/50 text-primary-600 dark:text-primary-400 flex items-center justify-center text-lg">
                    <i class="bi bi-basket3"></i>
                </span>
                <span data-en="Customer Cart Items" data-kh="ទំនិញក្នុងកន្ត្រកអតិថិជន">Customer Cart Items</span>
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Real-time inventory reservations currently held in customer shopping baskets.
            </p>
        </div>

        <div>
            <a asp-action="Create" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold shadow-sm hover:shadow transition">
                <i class="bi bi-plus-lg"></i>
                <span data-en="Add Cart Item" data-kh="បន្ថែមទំនិញ">Add Cart Item</span>
            </a>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                        <th class="py-3.5 pl-6 pr-4">Product Variant</th>
                        <th class="py-3.5 px-4">Cart Owner / Customer</th>
                        <th class="py-3.5 px-4 text-center">Quantity</th>
                        <th class="py-3.5 px-4 text-right">Unit Price</th>
                        <th class="py-3.5 px-4 text-right">Line Total</th>
                        <th class="py-3.5 pl-4 pr-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 text-sm">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-500 dark:text-slate-400">
                                <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-2xl text-slate-400 mb-3">
                                    <i class="bi bi-cart-x"></i>
                                </div>
                                <h5 class="text-base font-semibold text-slate-900 dark:text-white">No cart items found</h5>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">There are no products currently reserved in shopping baskets.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var prod = item.Variant?.Product;
                            var img = prod?.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? prod?.Images?.FirstOrDefault()?.ImageUrl;
                            var price = item.Variant?.Price ?? 0;
                            var total = price * item.Quantity;
                            var cust = item.Cart?.Customer;

                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                                <!-- Product Variant -->
                                <td class="py-4 pl-6 pr-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-14 rounded-xl bg-slate-100 dark:bg-slate-800 overflow-hidden border border-slate-200 dark:border-slate-700 flex-shrink-0">
                                            @if (!string.IsNullOrEmpty(img))
                                            {
                                                <img src="@img" alt="@(prod?.Name ?? "Item")" class="w-full h-full object-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-full h-full flex items-center justify-center text-slate-400"><i class="bi bi-image text-lg"></i></div>
                                            }
                                        </div>
                                        <div class="min-w-0">
                                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 block">
                                                @(prod?.Brand?.Name ?? "CLOTHÉ")
                                            </span>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="text-sm font-semibold text-slate-900 dark:text-white hover:text-primary-600 transition truncate block">
                                                @(prod?.Name ?? "Product Variant")
                                            </a>
                                            <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                                <span>Color: <strong class="text-slate-700 dark:text-slate-300">@(item.Variant?.Color?.Name ?? "-")</strong></span>
                                                <span>•</span>
                                                <span>Size: <strong class="text-slate-700 dark:text-slate-300">@(item.Variant?.Size?.Name ?? "-")</strong></span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Customer / Cart -->
                                <td class="py-4 px-4">
                                    @if (cust != null)
                                    {
                                        <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">
                                            @cust.FirstName @cust.LastName
                                        </div>
                                        <span class="text-xs text-slate-500 dark:text-slate-400 block">@cust.Email</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400 italic">Unassigned Cart</span>
                                    }
                                    <span class="font-mono text-[10px] text-slate-400 block mt-0.5">Cart ID: @item.CartId.ToString().Substring(0, 8)...</span>
                                </td>

                                <!-- Quantity -->
                                <td class="py-4 px-4 text-center">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700">
                                        @item.Quantity
                                    </span>
                                </td>

                                <!-- Unit Price -->
                                <td class="py-4 px-4 text-right text-xs font-medium text-slate-600 dark:text-slate-400">
                                    $@price.ToString("N2")
                                </td>

                                <!-- Line Total -->
                                <td class="py-4 px-4 text-right font-extrabold text-slate-900 dark:text-white">
                                    $@total.ToString("N2")
                                </td>

                                <!-- Actions -->
                                <td class="py-4 pl-4 pr-6 text-right">
                                    <div class="dropdown relative inline-block text-left">
                                        <button class="action-meatball-btn w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition" type="button" aria-expanded="false" title="Actions" onclick="toggleActionMenu(this, event)">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-meatball dropdown-menu-end hidden absolute right-0 mt-2 w-48 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl py-1.5 z-[9999] focus:outline-none">
                                            <li>
                                                <a class="dropdown-item flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition" asp-action="Details" asp-route-id="@item.Id">
                                                    <i class="bi bi-eye text-primary-500"></i> <span>View Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition" asp-action="Edit" asp-route-id="@item.Id">
                                                    <i class="bi bi-pencil text-amber-500"></i> <span>Edit Item</span>
                                                </a>
                                            </li>
                                            <li><div class="my-1 border-t border-slate-100 dark:border-slate-800"></div></li>
                                            <li>
                                                <a class="dropdown-item flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition" asp-action="Delete" asp-route-id="@item.Id">
                                                    <i class="bi bi-trash"></i> <span>Remove from Cart</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
