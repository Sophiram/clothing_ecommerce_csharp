@model WebApplication_ClothingEcommerce.Models.Customer
@using WebApplication_ClothingEcommerce.Data.Enums

@{
    ViewData["Title"] = $"Customer: {Model.FirstName} {Model.LastName}";
}

<div class="admin-page container-fluid px-4 py-3">
    <!-- Breadcrumb & Back -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Customers
            </a>
            <span class="text-muted">/</span>
            <span class="fw-semibold text-dark">Customer Profile</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark btn-sm rounded-pill px-3">
                <i class="bi bi-pencil-square me-1"></i> Edit Profile
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Summary Card -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 bg-white mb-4">
                @{
                    var avatarUrl = ViewBag.AvatarUrl as string;
                }
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <img src="@avatarUrl" alt="@Model.FirstName" class="rounded-circle shadow mx-auto mb-3" style="width: 90px; height: 90px; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold fs-2 shadow mx-auto mb-3" style="width: 90px; height: 90px;">
                        @(string.IsNullOrEmpty(Model.FirstName) ? "C" : Model.FirstName.Substring(0, 1).ToUpper())
                    </div>
                }

                <h4 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h4>
                <p class="text-muted small mb-3">@Model.Email</p>

                <div class="d-flex justify-content-center gap-2 mb-3">
                    @if (Model.Status == CustomerStatus.Active)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Active
                        </span>
                    }
                    else if (Model.Status == CustomerStatus.Blocked)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1.5 fw-bold">
                            <i class="bi bi-slash-circle me-1"></i> Blocked
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1.5 fw-bold">
                            Inactive
                        </span>
                    }
                </div>

                <div class="list-group list-group-flush text-start small border-top pt-3">
                    <div class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Phone</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Phone) ? "Not specified" : Model.Phone)</span>
                    </div>
                    <div class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Registered</span>
                        <span class="fw-semibold">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Total Orders</span>
                        <span class="fw-semibold">@(Model.Orders?.Count ?? 0)</span>
                    </div>
                    <div class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Total Reviews</span>
                        <span class="fw-semibold">@(Model.Reviews?.Count ?? 0)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Addresses & Orders -->
        <div class="col-12 col-lg-8">
            <!-- Addresses -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-geo-alt text-primary me-2"></i> Shipping Addresses</h5>
                @if (Model.Addresses.Any())
                {
                    <div class="row g-3">
                        @foreach (var addr in Model.Addresses)
                        {
                            <div class="col-sm-6">
                                <div class="border rounded-3 p-3 bg-light position-relative">
                                    @if (addr.IsDefault)
                                    {
                                        <span class="badge bg-primary rounded-pill position-absolute top-0 end-0 m-2" style="font-size: 10px;">Default</span>
                                    }
                                    <div class="fw-bold small text-dark">@addr.Street</div>
                                    <div class="text-muted small">@addr.City, @addr.Province</div>
                                    <div class="text-muted small">Postal Code: @addr.PostalCode</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No shipping addresses on file.</p>
                }
            </div>

            <!-- Recent Orders -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-bag-check text-primary me-2"></i> Order History</h5>
                @if (Model.Orders != null && Model.Orders.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Order #</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate).Take(5))
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold">#@order.Id.ToString().Substring(0, 8)</td>
                                        <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@order.Status</span></td>
                                        <td class="fw-bold">$@order.TotalAmount.ToString("N2")</td>
                                        <td class="text-end">
                                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-light border rounded-pill">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No orders placed yet.</p>
                }
            </div>
        </div>
    </div>
</div>
