@model IEnumerable<WebApplication_ClothingEcommerce.Models.Customer>
@using WebApplication_ClothingEcommerce.Data.Enums

@{
    ViewData["Title"] = "Customers";
    var status = ViewBag.Status as CustomerStatus?;
    var customerAvatars = ViewBag.CustomerAvatars as Dictionary<Guid, string?> ?? new Dictionary<Guid, string?>();
}

<div class="admin-page container-fluid px-4 py-3">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 text-uppercase" style="font-size: 11px; font-weight: 700; letter-spacing: 0.05em;">
                    <i class="bi bi-people-fill me-1"></i> Store Customers
                </span>
                <span class="text-muted small">Registered Client Accounts</span>
            </div>
            <h1 class="h3 fw-bold mb-0 text-dark">Customer Management</h1>
            <p class="text-muted small mb-0">Browse and manage customer profiles, status, orders, and interaction history.</p>
        </div>

        <div class="d-flex gap-2">
            <span class="badge bg-light text-dark border p-2 px-3 rounded-pill d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success"></i>
                <span>Active: <strong>@ViewBag.ActiveCount</strong> / @ViewBag.TotalCount</span>
            </span>
        </div>
    </div>

    <!-- NOTIFICATION ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FILTER BAR -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="d-flex flex-grow-1 gap-2" style="max-width: 500px;">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0" placeholder="Search by name, email, phone..." />
                </div>
                <button type="submit" class="btn btn-dark rounded-pill px-3">Search</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Clear Search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-sm rounded-pill @(!status.HasValue ? "btn-dark" : "btn-light border")">All</a>
                <a asp-action="Index" asp-route-status="@CustomerStatus.Active" class="btn btn-sm rounded-pill @(status == CustomerStatus.Active ? "btn-dark" : "btn-light border")">Active</a>
                <a asp-action="Index" asp-route-status="@CustomerStatus.Inactive" class="btn btn-sm rounded-pill @(status == CustomerStatus.Inactive ? "btn-dark" : "btn-light border")">Inactive</a>
                <a asp-action="Index" asp-route-status="@CustomerStatus.Blocked" class="btn btn-sm rounded-pill @(status == CustomerStatus.Blocked ? "btn-dark" : "btn-light border")">Blocked</a>
            </div>
        </form>
    </div>

    <!-- TABLE CARD -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Orders</th>
                        <th>Registered</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @{
                                            var avatarUrl = customerAvatars.ContainsKey(customer.Id) ? customerAvatars[customer.Id] : null;
                                        }
                                        @if (!string.IsNullOrEmpty(avatarUrl))
                                        {
                                            <img src="@avatarUrl" alt="@customer.FirstName" class="rounded-circle shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 38px; height: 38px; font-size: 0.85rem;">
                                                @(string.IsNullOrEmpty(customer.FirstName) ? "C" : customer.FirstName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <a asp-action="Details" asp-route-id="@customer.Id" class="text-dark fw-bold text-decoration-none">
                                                @customer.FirstName @customer.LastName
                                            </a>
                                            <div class="text-muted font-monospace" style="font-size: 11px;">ID: @customer.Id.ToString().Substring(0, 8)...</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="small text-dark fw-semibold">@customer.Email</span>
                                </td>

                                <td class="small">
                                    @(string.IsNullOrEmpty(customer.Phone) ? "—" : customer.Phone)
                                </td>

                                <td>
                                    @if (customer.Status == CustomerStatus.Active)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">Active</span>
                                    }
                                    else if (customer.Status == CustomerStatus.Blocked)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 small">Blocked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 small">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 small">
                                        <i class="bi bi-bag-check me-1"></i> @(customer.Orders?.Count ?? 0)
                                    </span>
                                </td>

                                <td class="small text-muted">
                                    @customer.CreatedAt.ToString("MMM dd, yyyy")
                                </td>

                                <td class="pe-4 text-end">
                                    <div class="dropdown">
                                        <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@customer.Id">
                                                    <i class="bi bi-eye text-primary"></i> <span>View Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@customer.Id">
                                                    <i class="bi bi-pencil text-warning"></i> <span>Edit Profile</span>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider my-1" /></li>
                                            <li>
                                                <form method="post" asp-action="ToggleStatus" asp-route-id="@customer.Id" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-secondary">
                                                        <i class="bi bi-arrow-repeat text-info"></i> <span>Toggle Status</span>
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-people fs-1 text-muted d-block mb-2"></i>
                                <h5>No customers found</h5>
                                <p class="text-muted small">No customer accounts matched your search criteria.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
