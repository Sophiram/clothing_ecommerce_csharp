@model WebApplication_ClothingEcommerce.Models.Customer
@using WebApplication_ClothingEcommerce.Data.Enums

@{
    ViewData["Title"] = $"Edit Customer: {Model.FirstName} {Model.LastName}";
}

<div class="admin-page container-fluid px-4 py-3" style="max-width: 800px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border px-3">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <span class="text-muted">/</span>
            <span class="fw-semibold text-dark">Edit Customer</span>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="mb-4">
            <h4 class="fw-bold mb-1 text-dark">Modify Customer Information</h4>
            <p class="text-muted small mb-0">Update profile details and account status for this customer.</p>
        </div>

        <form method="post" asp-action="Edit" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="ApplicationUserId" />
            <input type="hidden" asp-for="CreatedAt" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- Profile Picture Section -->
            <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded-4">
                @{
                    var avatarUrl = ViewBag.AvatarUrl as string;
                }
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <img id="customerAvatarPreview" src="@avatarUrl" alt="Avatar" class="rounded-circle shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />
                }
                else
                {
                    <div id="customerAvatarFallback" class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm" style="width: 70px; height: 70px;">
                        @(string.IsNullOrEmpty(Model.FirstName) ? "C" : Model.FirstName.Substring(0, 1).ToUpper())
                    </div>
                    <img id="customerAvatarPreview" src="" alt="Avatar" class="rounded-circle shadow-sm d-none" style="width: 70px; height: 70px; object-fit: cover;" />
                }
                <div class="flex-grow-1">
                    <label class="form-label fw-semibold small mb-1">Profile Photo</label>
                    <input type="file" name="avatarFile" class="form-control form-control-sm rounded-3" accept="image/jpeg,image/png,image/webp" onchange="previewCustomerAvatar(this)" />
                    <div class="form-text small" style="font-size: 11px;">Upload JPG, PNG, or WebP photo (Max 5MB).</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label fw-semibold small">First Name</label>
                    <input asp-for="FirstName" class="form-control rounded-3" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label fw-semibold small">Last Name</label>
                    <input asp-for="LastName" class="form-control rounded-3" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label class="form-label fw-semibold small">Email Address</label>
                    <input value="@Model.Email" class="form-control rounded-3 bg-light" readonly />
                    <div class="form-text small">Email cannot be changed directly from customer profile.</div>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Phone" class="form-label fw-semibold small">Phone Number</label>
                    <input asp-for="Phone" class="form-control rounded-3" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Status" class="form-label fw-semibold small">Account Status</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<CustomerStatus>()" class="form-select rounded-3"></select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-dark rounded-pill px-4">
                    <i class="bi bi-check2 me-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewCustomerAvatar(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.getElementById('customerAvatarPreview');
                    var fallback = document.getElementById('customerAvatarFallback');
                    if (img) {
                        img.src = e.target.result;
                        img.classList.remove('d-none');
                    }
                    if (fallback) {
                        fallback.classList.add('d-none');
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
