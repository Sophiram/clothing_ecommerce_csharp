@model IEnumerable<WebApplication_ClothingEcommerce.Models.Inventory>

@{
    ViewData["Title"] = "Inventory";
}

<div class="admin-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Inventory</h1>
            <p class="page-description">Cross-product stock levels — a warehouse view across every variant.</p>
        </div>

        <a asp-action="Create" class="btn-primary-custom">
            <i class="bi bi-plus-lg"></i>
            Add Inventory
        </a>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="admin-alert admin-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="admin-alert admin-alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["Error"]
        </div>
    }

    <!-- MAIN CARD -->
    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">All Inventory Records</h3>
                <p class="admin-card-subtitle">Stock, reserved units, and last update per SKU</p>
            </div>
            <div class="admin-card-count">
                <span>@Model.Count()</span>
                <small>total</small>
            </div>
        </div>

        <!-- FILTER -->
        <div class="search-wrapper">
            <form asp-action="Index" method="get" class="search-form flex-wrap">

                <div class="search-input-wrapper" style="flex: 2; min-width: 220px;">
                    <select name="productId" class="search-input" asp-items="ViewBag.Products">
                        <option value="">All Products</option>
                    </select>
                </div>

                <button type="submit" class="btn-search">
                    <i class="bi bi-funnel"></i> Filter
                </button>

                <a asp-action="Index" class="btn-reset">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </a>

            </form>
        </div>

        <!-- TABLE -->
        <div class="table-responsive">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Size</th>
                        <th>Color</th>
                        <th>Total</th>
                        <th>Reserved</th>
                        <th>Available</th>
                        <th>Updated</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var available = item.AvailableQuantity;

                            <tr>

                                <td class="payment-name">
                                    @item.ProductVariant.Product.Name
                                </td>

                                <td>
                                    <code>@item.ProductVariant.SKU</code>
                                </td>

                                <td>
                                    <span class="tag-badge">@item.ProductVariant.Size.Name</span>
                                </td>

                                <td>
                                    <span class="tag-badge">@item.ProductVariant.Color.Name</span>
                                </td>

                                <td>
                                    <strong>@item.Quantity</strong>
                                </td>

                                <td>
                                    @item.ReservedQuantity
                                </td>

                                <td>
                                    @if (available > 0)
                                    {
                                        <span class="status-badge status-active">@available</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-danger">Out of Stock</span>
                                    }
                                </td>

                                <td>
                                    <small class="description-text">@item.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</small>
                                </td>

                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                                    <i class="bi bi-eye text-primary"></i> <span>View Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                                    <i class="bi bi-pencil text-warning"></i> <span>Edit Stock</span>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider my-1" /></li>
                                            <li>
                                                <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                                    <i class="bi bi-trash"></i> <span>Delete Inventory</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    <div class="empty-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <h5>No inventory records</h5>
                                    <p>Start by adding inventory for a product variant, or adjust your filter.</p>
                                    <a asp-action="Create" class="btn-primary-custom">
                                        <i class="bi bi-plus-lg"></i> Add Inventory
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>
    .status-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .tag-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        font-size: 0.8rem;
    }
</style>
