@model WebApplication_ClothingEcommerce.Models.Inventory

@{
    ViewData["Title"] = "Inventory Details";

    var product =
        Model.ProductVariant?.Product;

    var primaryImage =
        product?.Images?
            .FirstOrDefault(i => i.IsPrimary)
        ?? product?.Images?.FirstOrDefault();
}

<div class="container py-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <a asp-action="Index"
               class="text-decoration-none text-muted">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Inventory

            </a>

            <h2 class="fw-bold mt-3 mb-1">
                Inventory Details
            </h2>

            <p class="text-muted mb-0">
                Stock information for this product variant.
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">

                <i class="bi bi-trash me-1"></i>
                Delete

            </a>

        </div>

    </div>


    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="row g-4">

        <!-- PRODUCT -->

        <div class="col-lg-5">

            <div class="card shadow-sm border-0">

                @if (primaryImage != null)
                {
                    <img src="@primaryImage.ImageUrl"
                         class="card-img-top"
                         alt="@product?.Name"
                         style="height:320px; object-fit:cover;" />
                }
                else
                {
                    <div class="d-flex align-items-center
                        justify-content-center
                        bg-light"
                         style="height:320px;">

                        <i class="bi bi-image fs-1 text-muted"></i>

                    </div>
                }

                <div class="card-body">

                    <h4 class="fw-bold">
                        @product?.Name
                    </h4>

                    <p class="text-muted mb-3">
                        @Model.ProductVariant?.SKU
                    </p>

                    <div class="row g-3">

                        <div class="col-6">

                            <small class="text-muted">
                                Size
                            </small>

                            <div class="fw-semibold">
                                @Model.ProductVariant?.Size?.Name
                            </div>

                        </div>

                        <div class="col-6">

                            <small class="text-muted">
                                Color
                            </small>

                            <div class="fw-semibold">
                                @Model.ProductVariant?.Color?.Name
                            </div>

                        </div>

                        <div class="col-6">

                            <small class="text-muted">
                                Price
                            </small>

                            <div class="fw-semibold">
                                $@Model.ProductVariant?.Price.ToString("N2")
                            </div>

                        </div>

                        <div class="col-6">

                            <small class="text-muted">
                                Status
                            </small>

                            <div>

                                @if (Model.ProductVariant?.Status
                                    .ToString() == "Available")
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @Model.ProductVariant?.Status
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- INVENTORY -->

        <div class="col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-bold mb-0">

                        <i class="bi bi-box-seam me-2"></i>
                        Stock Information

                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-4">

                        <div class="col-md-4">

                            <div class="border rounded p-4 text-center">

                                <small class="text-muted">
                                    Total Stock
                                </small>

                                <h2 class="fw-bold mt-2 mb-0">
                                    @Model.Quantity
                                </h2>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="border rounded p-4 text-center">

                                <small class="text-muted">
                                    Reserved
                                </small>

                                <h2 class="fw-bold mt-2 mb-0">
                                    @Model.ReservedQuantity
                                </h2>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="border rounded p-4 text-center">

                                <small class="text-muted">
                                    Available
                                </small>

                                <h2 class="fw-bold mt-2 mb-0">

                                    @if (Model.AvailableQuantity > 0)
                                    {
                                        <span class="text-success">
                                            @Model.AvailableQuantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            0
                                        </span>
                                    }

                                </h2>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <div class="d-flex justify-content-between">

                        <span class="text-muted">
                            Last Updated
                        </span>

                        <strong>
                            @Model.UpdatedAt.ToLocalTime()
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>