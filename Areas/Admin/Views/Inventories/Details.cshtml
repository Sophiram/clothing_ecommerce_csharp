@model WebApplication_ClothingEcommerce.Models.Inventory

@{
    ViewData["Title"] = "Inventory Details";

    var product =
        Model.ProductVariant?.Product;

    var primaryImage =
        product?.Images?
            .FirstOrDefault(i => i.IsPrimary)
        ?? product?.Images?.FirstOrDefault();
}

<div class="admin-page py-4">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 mb-2 d-inline-flex align-items-center gap-1.5"
               data-en="← Back to Inventory" data-kh="← ត្រឡប់ទៅស្តុក">
                <i class="bi bi-arrow-left"></i>
                <span data-en="Back to Inventory" data-kh="ត្រឡប់ទៅស្តុក">Back to Inventory</span>
            </a>
            <h2 class="h3 fw-bold mb-1 text-dark dark:text-white" data-en="Inventory Details" data-kh="ព័ត៌មានលម្អិតអំពីស្តុក">
                Inventory Details
            </h2>
            <p class="text-muted mb-0 small" data-en="Real-time stock levels and allocation for this product variant." data-kh="កម្រិតស្តុកជាក់ស្តែង និងការបែងចែកសម្រាប់វ៉ារ្យ៉ង់ផលិតផលនេះ។">
                Real-time stock levels and allocation for this product variant.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 shadow-sm"
               data-en="Edit Inventory" data-kh="កែប្រែស្តុក">
                <i class="bi bi-pencil me-1.5"></i>
                <span data-en="Edit" data-kh="កែប្រែ">Edit</span>
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-4 shadow-sm"
               data-en="Delete" data-kh="លុបចោល">
                <i class="bi bi-trash me-1.5"></i>
                <span data-en="Delete" data-kh="លុបចោល">Delete</span>
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- PRODUCT VARIANT OVERVIEW CARD -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100" style="border-radius: 20px; border: 1px solid rgba(226, 232, 240, 0.8);">
                <div class="position-relative" style="height: 320px; background: #f8fafc;">
                    @if (primaryImage != null)
                    {
                        <img src="@primaryImage.ImageUrl"
                             class="w-100 h-100 object-fit-cover"
                             alt="@product?.Name" />
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                            <i class="bi bi-image fs-1 opacity-50 mb-2"></i>
                            <span class="small" data-en="No Image Available" data-kh="មិនមានរូបភាព">No Image Available</span>
                        </div>
                    }

                    <div class="position-absolute top-0 end-0 p-3">
                        @if (Model.ProductVariant?.Status.ToString() == "Available")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold"
                                  data-en="Available" data-kh="មានលក់">
                                <i class="bi bi-check-circle-fill me-1"></i> Available
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1.5 fw-semibold">
                                @Model.ProductVariant?.Status
                            </span>
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="mb-3">
                        <span class="badge rounded-pill px-2.5 py-1 text-xs fw-semibold mb-2" style="background: rgba(59, 130, 246, 0.1); color: #2563eb;">
                            @product?.Category?.Name
                        </span>
                        <h4 class="fw-bold mb-1 text-dark dark:text-white">
                            @product?.Name
                        </h4>
                        <p class="text-muted small mb-0 font-monospace">
                            SKU: @Model.ProductVariant?.SKU
                        </p>
                    </div>

                    <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px;">
                        <div class="row g-2">
                            <div class="col-6">
                                <span class="text-muted small d-block" data-en="Size" data-kh="ទំហំ">Size</span>
                                <span class="fw-semibold text-dark">@(Model.ProductVariant?.Size?.Name ?? "—")</span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small d-block" data-en="Color" data-kh="ពណ៌">Color</span>
                                <div class="d-flex align-items-center gap-1.5 mt-0.5">
                                    @if (!string.IsNullOrEmpty(Model.ProductVariant?.Color?.HexCode))
                                    {
                                        <span class="rounded-circle border" style="width: 14px; height: 14px; background-color: @Model.ProductVariant.Color.HexCode; display: inline-block;"></span>
                                    }
                                    <span class="fw-semibold text-dark">@(Model.ProductVariant?.Color?.Name ?? "—")</span>
                                </div>
                            </div>
                            <div class="col-6 pt-2 border-top">
                                <span class="text-muted small d-block" data-en="Variant Price" data-kh="តម្លៃវ៉ារ្យ៉ង់">Variant Price</span>
                                <span class="fw-bold text-primary fs-5 tabular-nums">$@Model.ProductVariant?.Price.ToString("N2")</span>
                            </div>
                            <div class="col-6 pt-2 border-top">
                                <span class="text-muted small d-block" data-en="Compare At" data-kh="តម្លៃដើម">Compare At</span>
                                <span class="text-muted small">@(Model.ProductVariant?.CompareAtPrice.HasValue == true ? $"${Model.ProductVariant.CompareAtPrice.Value:N2}" : "—")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- STOCK METRICS & INVENTORY MANAGEMENT -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="border-radius: 20px; border: 1px solid rgba(226, 232, 240, 0.8);">
                <div class="card-header bg-white dark:bg-slate-800 py-3.5 px-4 border-bottom d-flex align-items-center justify-content-between" style="border-radius: 20px 20px 0 0;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background: rgba(59, 130, 246, 0.1); color: #2563eb; width: 36px; height: 36px;">
                            <i class="bi bi-boxes fs-5"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-dark dark:text-white" data-en="Stock Breakdown" data-kh="ការបែងចែកស្តុក">
                            Stock Breakdown
                        </h5>
                    </div>
                    <span class="text-muted small" style="font-size: 0.78rem;">
                        ID: #@Model.Id
                    </span>
                </div>

                <div class="card-body p-4">
                    <!-- 3 Stock Stat Cards -->
                    <div class="row g-3 mb-4">
                        <!-- Total Quantity -->
                        <div class="col-sm-4">
                            <div class="p-4 text-center rounded-4 h-100" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 16px;">
                                <div class="text-muted small fw-semibold text-uppercase tracking-wider mb-1" data-en="Total Stock" data-kh="ស្តុកសរុប">
                                    Total Stock
                                </div>
                                <div class="h2 fw-bold mb-0 text-dark tabular-nums">
                                    @Model.Quantity
                                </div>
                                <span class="text-muted" style="font-size: 0.72rem;" data-en="physical units" data-kh="ឯកតារូបវ័ន្ត">physical units</span>
                            </div>
                        </div>

                        <!-- Reserved Quantity -->
                        <div class="col-sm-4">
                            <div class="p-4 text-center rounded-4 h-100" style="background: #fffbeb; border: 1.5px solid #fef3c7; border-radius: 16px;">
                                <div class="text-warning-emphasis small fw-semibold text-uppercase tracking-wider mb-1" data-en="Reserved" data-kh="បានកក់ទុក">
                                    Reserved
                                </div>
                                <div class="h2 fw-bold mb-0 text-amber-600 tabular-nums" style="color: #d97706;">
                                    @Model.ReservedQuantity
                                </div>
                                <span class="text-warning-emphasis" style="font-size: 0.72rem;" data-en="pending fulfillment" data-kh="កំពុងរៀបចំ">pending fulfillment</span>
                            </div>
                        </div>

                        <!-- Available Quantity -->
                        <div class="col-sm-4">
                            <div class="p-4 text-center rounded-4 h-100" style="background: @(Model.AvailableQuantity > 0 ? "#f0fdf4" : "#fef2f2"); border: 1.5px solid @(Model.AvailableQuantity > 0 ? "#bbf7d0" : "#fecaca"); border-radius: 16px;">
                                <div class="small fw-semibold text-uppercase tracking-wider mb-1" style="color: @(Model.AvailableQuantity > 0 ? "#15803d" : "#b91c1c");" data-en="Available" data-kh="អាចលក់បាន">
                                    Available
                                </div>
                                <div class="h2 fw-bold mb-0 tabular-nums" style="color: @(Model.AvailableQuantity > 0 ? "#16a34a" : "#dc2626");">
                                    @Model.AvailableQuantity
                                </div>
                                <span style="color: @(Model.AvailableQuantity > 0 ? "#15803d" : "#b91c1c"); font-size: 0.72rem;" data-en="@(Model.AvailableQuantity > 0 ? "ready for purchase" : "out of stock")" data-kh="@(Model.AvailableQuantity > 0 ? "រួចរាល់សម្រាប់ទិញ" : "អស់ពីស្តុក")">
                                    @(Model.AvailableQuantity > 0 ? "ready for purchase" : "out of stock")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Details / Audit Trail -->
                    <div class="p-3.5 rounded-3 mb-4" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px;">
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-muted small" data-en="Product Variant ID" data-kh="លេខកូដវ៉ារ្យ៉ង់ផលិតផល">Product Variant ID</span>
                            <span class="fw-semibold text-dark">#@Model.ProductVariantId</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-muted small" data-en="Stock Location / Warehouse" data-kh="ទីតាំងស្តុក / ឃ្លាំង">Stock Location</span>
                            <span class="fw-semibold text-dark" data-en="Main Facility (Phnom Penh)" data-kh="ឃ្លាំងមេ (ភ្នំពេញ)">Main Facility (Phnom Penh)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="text-muted small" data-en="Last Updated" data-kh="កាលបរិច្ឆេទធ្វើបច្ចុប្បន្នភាព">Last Updated</span>
                            <span class="fw-semibold text-dark tabular-nums">@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                    </div>

                    <!-- Quick Navigation Actions -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <a asp-controller="ProductVariants" asp-action="Details" asp-route-id="@Model.ProductVariantId"
                           class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm"
                           data-en="View Variant Specs" data-kh="មើលលក្ខណៈវ៉ារ្យ៉ង់">
                            <i class="bi bi-grid-3x3-gap me-1"></i>
                            <span data-en="View Variant Specs" data-kh="មើលលក្ខណៈវ៉ារ្យ៉ង់">View Variant Specs</span>
                        </a>

                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductVariant?.ProductId"
                           class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm"
                           data-en="Edit Parent Product" data-kh="កែប្រែផលិតផលមេ">
                            <i class="bi bi-box-arrow-up-right me-1"></i>
                            <span data-en="Edit Parent Product" data-kh="កែប្រែផលិតផលមេ">Edit Parent Product</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>