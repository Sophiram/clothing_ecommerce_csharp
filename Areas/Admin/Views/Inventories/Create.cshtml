@model WebApplication_ClothingEcommerce.Models.Inventory

@{
    ViewData["Title"] = "Add Inventory";
}

<div class="container py-4">

    <div class="mb-4">

        <a asp-action="Index"
           class="text-decoration-none text-muted">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Inventory

        </a>

        <h2 class="fw-bold mt-3 mb-1">
            Add Inventory
        </h2>

        <p class="text-muted">
            Create inventory stock for a product variant.
        </p>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-box-seam me-2"></i>
                        Inventory Information
                    </h5>

                </div>

                <div class="card-body p-4">

                    <div asp-validation-summary="All"
                         class="alert alert-danger">
                    </div>

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- VARIANT -->

                        <div class="mb-4">

                            <label asp-for="ProductVariantId"
                                   class="form-label fw-semibold">

                                Product Variant

                            </label>

                            <select asp-for="ProductVariantId"
                                    asp-items="ViewBag.ProductVariants"
                                    class="form-select">

                                <option value="">
                                    Select Product Variant
                                </option>

                            </select>

                            <span asp-validation-for="ProductVariantId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- QUANTITY -->

                        <div class="mb-4">

                            <label asp-for="Quantity"
                                   class="form-label fw-semibold">

                                Total Quantity

                            </label>

                            <input asp-for="Quantity"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="0" />

                            <div class="form-text">
                                Total stock available for this variant.
                            </div>

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- RESERVED -->

                        <div class="mb-4">

                            <label asp-for="ReservedQuantity"
                                   class="form-label fw-semibold">

                                Reserved Quantity

                            </label>

                            <input asp-for="ReservedQuantity"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   value="0" />

                            <div class="form-text">
                                Stock already reserved by customers.
                            </div>

                            <span asp-validation-for="ReservedQuantity"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PREVIEW -->

                        <div class="alert alert-light border">

                            <div class="d-flex justify-content-between">

                                <span class="text-muted">
                                    Available Quantity
                                </span>

                                <strong id="availableQuantity">
                                    0
                                </strong>

                            </div>

                        </div>


                        <!-- ACTIONS -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-fill">

                                <i class="bi bi-plus-lg me-1"></i>
                                Add Inventory

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary flex-fill">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function updateAvailable() {

            const quantity =
                parseInt(
                    document.getElementById("Quantity").value
                ) || 0;

            const reserved =
                parseInt(
                    document.getElementById("ReservedQuantity").value
                ) || 0;

            const available =
                Math.max(0, quantity - reserved);

            document.getElementById(
                "availableQuantity"
            ).textContent = available;
        }

        document
            .getElementById("Quantity")
            .addEventListener("input", updateAvailable);

        document
            .getElementById("ReservedQuantity")
            .addEventListener("input", updateAvailable);

        updateAvailable();

    </script>
}