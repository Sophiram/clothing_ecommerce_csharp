@model WebApplication_ClothingEcommerce.Models.Inventory

@{
    ViewData["Title"] = "Delete Inventory";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 text-center">

                    <div class="mb-3">

                        <i class="bi bi-exclamation-triangle-fill
                            text-danger fs-1">
                        </i>

                    </div>

                    <h3 class="fw-bold">
                        Delete Inventory?
                    </h3>

                    <p class="text-muted">
                        Are you sure you want to delete this
                        inventory record?
                    </p>


                    <div class="bg-light rounded p-3 my-4 text-start">

                        <div class="mb-2">

                            <small class="text-muted">
                                Product
                            </small>

                            <div class="fw-semibold">
                                @Model.ProductVariant.Product.Name
                            </div>

                        </div>


                        <div class="mb-2">

                            <small class="text-muted">
                                SKU
                            </small>

                            <div class="fw-semibold">
                                @Model.ProductVariant.SKU
                            </div>

                        </div>


                        <div class="row">

                            <div class="col-4">

                                <small class="text-muted">
                                    Size
                                </small>

                                <div>
                                    @Model.ProductVariant.Size.Name
                                </div>

                            </div>

                            <div class="col-4">

                                <small class="text-muted">
                                    Color
                                </small>

                                <div>
                                    @Model.ProductVariant.Color.Name
                                </div>

                            </div>

                            <div class="col-4">

                                <small class="text-muted">
                                    Stock
                                </small>

                                <div class="fw-bold">
                                    @Model.Quantity
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="alert alert-warning text-start">

                        <i class="bi bi-info-circle me-2"></i>

                        This action cannot be undone.

                    </div>


                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger flex-fill">

                                <i class="bi bi-trash me-1"></i>
                                Delete Inventory

                            </button>

                            <a asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary flex-fill">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>