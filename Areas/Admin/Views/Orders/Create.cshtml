@model WebApplication_ClothingEcommerce.Models.Order
@{
    ViewData["Title"] = "Create Order";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i> Back to Orders</a>
        <h2 class="fw-bold mt-3 mb-1">Create New Order</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Customer</label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AddressId" class="form-label fw-semibold">Shipping Address</label>
                            <select asp-for="AddressId" class="form-select" asp-items="ViewBag.AddressId">
                                <option value="">-- Select Address --</option>
                            </select>
                            <span asp-validation-for="AddressId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Order Status</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<WebApplication_ClothingEcommerce.Data.Enums.OrderStatus>()"></select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TotalAmount" class="form-label fw-semibold">Total Amount ($)</label>
                            <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Create Order</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}