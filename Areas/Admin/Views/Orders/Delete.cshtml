@model WebApplication_ClothingEcommerce.Models.Order
@{
    ViewData["Title"] = "Delete Order";
}

<div class="admin-page">
    <!-- PAGE HEADER -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="page-eyebrow">
                <a asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i> Back to Orders</a>
            </div>
            <h1 class="page-title text-danger">Delete Order Confirmation</h1>
            <p class="page-description">Are you sure you want to permanently remove this customer order?</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="admin-card text-center p-4">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                </div>
                <h3 class="fw-bold text-dark">Confirm Order Deletion</h3>
                <p class="text-muted small mb-4">This action cannot be undone. Associated records like shipment logs will also be affected.</p>

                <div class="border rounded-3 p-3 mb-4 bg-light text-start small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Order ID:</span>
                        <strong class="font-monospace text-dark">#@Model.Id.ToString()[..8].ToUpper()</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Customer:</span>
                        <strong class="text-dark">@Model.Customer?.FirstName @Model.Customer?.LastName (@Model.Customer?.Email)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Order Status:</span>
                        <span class="badge bg-secondary">@Model.Status</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Total Amount:</span>
                        <strong class="text-success fs-6">@Model.TotalAmount.ToString("C")</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                            <i class="bi bi-trash me-1"></i> Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-light border rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>