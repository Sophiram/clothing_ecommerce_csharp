@model WebApplication_ClothingEcommerce.Models.Order
@{
    ViewData["Title"] = "Delete Order";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 text-center">
                    <div class="text-danger mb-3"><i class="bi bi-exclamation-triangle-fill fs-1"></i></div>
                    <h3 class="fw-bold">Delete Order?</h3>
                    <p class="text-muted">Are you sure you want to permanently delete this order?</p>

                    <div class="border rounded p-3 mb-4 bg-light text-start">
                        <div><strong>Order ID:</strong> #@Model.Id</div>
                        <div><strong>Customer:</strong> @Model.Customer?.FirstName @Model.Customer?.LastName (@Model.Customer?.Email)</div>
                        <div><strong>Total:</strong> $@Model.TotalAmount.ToString("F2")</div>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-fill">Yes, Delete</button>
                            <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>