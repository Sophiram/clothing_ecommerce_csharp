@model IEnumerable<WebApplication_ClothingEcommerce.Models.Order>
@using WebApplication_ClothingEcommerce.Data.Enums
@{
    ViewData["Title"] = "Orders";
    var currentStatus = ViewBag.Status as OrderStatus?;
    var totalCount = (int)(ViewBag.TotalCount ?? Model?.Count() ?? 0);
    var pendingCount = (int)(ViewBag.PendingCount ?? Model?.Count(o => o.Status == OrderStatus.Pending) ?? 0);
    var processingCount = (int)(ViewBag.ProcessingCount ?? Model?.Count(o => o.Status == OrderStatus.Processing) ?? 0);
    var shippedCount = (int)(ViewBag.ShippedCount ?? Model?.Count(o => o.Status == OrderStatus.Shipped) ?? 0);
    var deliveredCount = (int)(ViewBag.DeliveredCount ?? Model?.Count(o => o.Status == OrderStatus.Delivered) ?? 0);
    var cancelledCount = (int)(ViewBag.CancelledCount ?? Model?.Count(o => o.Status == OrderStatus.Cancelled) ?? 0);
    var totalRevenue = (decimal)(ViewBag.TotalRevenue ?? Model?.Where(o => o.Status != OrderStatus.Cancelled).Sum(o => o.TotalAmount) ?? 0);
}

<div class="space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200/80 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-blue-600 dark:text-blue-400 mb-1 tracking-wider uppercase">
                <i class="bi bi-cart-check"></i>
                <span>SALES &amp; FULFILLMENT</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
                Orders Management
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Manage customer purchases, track fulfillment progression, and update statuses.
            </p>
        </div>

        <!-- ACTIONS -->
        <div class="flex items-center gap-2.5 flex-wrap">
            <a asp-action="Create"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-md hover:shadow-lg transition cursor-pointer">
                <i class="bi bi-plus-lg"></i>
                <span>Create Order</span>
            </a>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-xs flex items-center gap-2.5">
            <i class="bi bi-check-circle-fill text-base flex-shrink-0"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs flex items-center gap-2.5">
            <i class="bi bi-exclamation-triangle-fill text-base flex-shrink-0"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- 4 KPI SUMMARY CARDS (MATCHING REPORT LAYOUT) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- 1. TOTAL ORDERS -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Orders</span>
                <span class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-base">
                    <i class="bi bi-bag-check-fill"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-slate-900 dark:text-white">
                    @totalCount
                </div>
                <div class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400 font-semibold mt-1">
                    <span>Lifetime customer orders</span>
                </div>
            </div>
        </div>

        <!-- 2. PENDING CONFIRMATION -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Pending</span>
                <span class="w-9 h-9 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-base">
                    <i class="bi bi-clock-history"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-amber-600 dark:text-amber-400">
                    @pendingCount
                </div>
                <div class="flex items-center gap-1 text-xs text-amber-600 dark:text-amber-400 font-bold mt-1">
                    <span>Requires confirmation</span>
                </div>
            </div>
        </div>

        <!-- 3. IN FULFILLMENT -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Fulfillment</span>
                <span class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-base">
                    <i class="bi bi-truck"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-indigo-600 dark:text-indigo-400">
                    @(processingCount + shippedCount)
                </div>
                <div class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400 font-semibold mt-1">
                    <span>@processingCount processing &bull; @shippedCount shipped</span>
                </div>
            </div>
        </div>

        <!-- 4. TOTAL REVENUE -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Delivered Revenue</span>
                <span class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base">
                    <i class="bi bi-cash-stack"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400">
                    $@totalRevenue.ToString("N2")
                </div>
                <div class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400 font-bold mt-1">
                    <span>@deliveredCount delivered orders</span>
                </div>
            </div>
        </div>

    </div>

    <!-- SEARCH & STATUS FILTERS TOOLBAR -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm space-y-4">
        <form asp-action="Index" method="get" class="flex flex-col sm:flex-row items-center gap-3">
            <div class="relative flex-1 w-full">
                <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="w-full text-xs font-medium pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                       placeholder="Search Order ID, customer name or email..." />
            </div>

            <select name="status"
                    class="w-full sm:w-48 text-xs font-medium px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">All Statuses</option>
                @foreach (OrderStatus st in Enum.GetValues<OrderStatus>())
                {
                    <option value="@st" selected="@(currentStatus.HasValue && currentStatus.Value == st)">
                        @st
                    </option>
                }
            </select>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="submit"
                        class="flex-1 sm:flex-none px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition flex items-center justify-center gap-1.5 cursor-pointer">
                    <i class="bi bi-funnel-fill"></i> Filter
                </button>
                <a asp-action="Index"
                   class="flex-1 sm:flex-none px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 text-xs font-bold transition flex items-center justify-center gap-1.5">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </a>
            </div>
        </form>

        <!-- Status Pills -->
        <div class="flex items-center gap-1.5 flex-wrap pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
            <span class="font-bold text-slate-400 mr-1 text-[11px] uppercase tracking-wider">Status:</span>
            <a asp-action="Index" asp-route-search="@ViewBag.Search"
               class="px-2.5 py-1 rounded-full text-xs font-bold transition @(!currentStatus.HasValue ? "bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200")">
                All (@totalCount)
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Pending" asp-route-search="@ViewBag.Search"
               class="px-2.5 py-1 rounded-full text-xs font-bold transition @(currentStatus == OrderStatus.Pending ? "bg-amber-500 text-white shadow-sm" : "bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 hover:bg-amber-100")">
                Pending (@pendingCount)
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Processing" asp-route-search="@ViewBag.Search"
               class="px-2.5 py-1 rounded-full text-xs font-bold transition @(currentStatus == OrderStatus.Processing ? "bg-blue-600 text-white shadow-sm" : "bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-400 hover:bg-blue-100")">
                Processing (@processingCount)
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Shipped" asp-route-search="@ViewBag.Search"
               class="px-2.5 py-1 rounded-full text-xs font-bold transition @(currentStatus == OrderStatus.Shipped ? "bg-indigo-600 text-white shadow-sm" : "bg-indigo-50 dark:bg-indigo-950/40 text-indigo-700 dark:text-indigo-400 hover:bg-indigo-100")">
                Shipped (@shippedCount)
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Delivered" asp-route-search="@ViewBag.Search"
               class="px-2.5 py-1 rounded-full text-xs font-bold transition @(currentStatus == OrderStatus.Delivered ? "bg-emerald-600 text-white shadow-sm" : "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-100")">
                Delivered (@deliveredCount)
            </a>
            <a asp-action="Index" asp-route-status="@OrderStatus.Cancelled" asp-route-search="@ViewBag.Search"
               class="px-2.5 py-1 rounded-full text-xs font-bold transition @(currentStatus == OrderStatus.Cancelled ? "bg-rose-600 text-white shadow-sm" : "bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 hover:bg-rose-100")">
                Cancelled (@cancelledCount)
            </a>
        </div>
    </div>

    <!-- MAIN ORDERS TABLE CARD -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i class="bi bi-table text-blue-600"></i> Customer Orders
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">Showing @(Model?.Count() ?? 0) record@(Model?.Count() == 1 ? "" : "s") matching criteria</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                @(Model?.Count() ?? 0) total
            </span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 font-bold uppercase text-[10px] tracking-wider border-b border-slate-200/80 dark:border-slate-800">
                        <tr>
                            <th class="py-3 px-4">Order ID</th>
                            <th class="py-3 px-4">Customer</th>
                            <th class="py-3 px-4">Date Placed</th>
                            <th class="py-3 px-4 text-center">Items</th>
                            <th class="py-3 px-4 text-right">Amount</th>
                            <th class="py-3 px-4">Payment</th>
                            <th class="py-3 px-4">Order Status</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var item in Model)
                        {
                            var customerName = $"{item.Customer?.FirstName} {item.Customer?.LastName}".Trim();
                            if (string.IsNullOrEmpty(customerName))
                            {
                                customerName = item.Customer?.Email ?? "Guest / Deleted";
                            }
                            var customerInitial = !string.IsNullOrEmpty(item.Customer?.FirstName)
                                ? item.Customer.FirstName.Substring(0, 1).ToUpper()
                                : (customerName.Length > 0 ? customerName.Substring(0, 1).ToUpper() : "C");

                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition">
                                <!-- Order ID -->
                                <td class="py-3 px-4">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="font-mono font-bold text-blue-600 dark:text-blue-400 hover:underline">
                                        #@item.Id.ToString()[..8].ToUpper()
                                    </a>
                                </td>

                                <!-- Customer -->
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 text-white font-bold text-[11px] flex items-center justify-center flex-shrink-0 shadow-xs">
                                            @customerInitial
                                        </div>
                                        <div class="truncate max-w-[160px]">
                                            <div class="font-bold text-slate-900 dark:text-white truncate">@customerName</div>
                                            <div class="text-[11px] text-slate-400 truncate">@(item.Customer?.Email ?? "-")</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Date -->
                                <td class="py-3 px-4 text-slate-500 dark:text-slate-400">
                                    <div class="font-medium text-slate-800 dark:text-slate-200">@item.OrderDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <div class="text-[10px]">@item.OrderDate.ToLocalTime().ToString("hh:mm tt")</div>
                                </td>

                                <!-- Items -->
                                <td class="py-3 px-4 text-center">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                        @(item.Items?.Count ?? 0)
                                    </span>
                                </td>

                                <!-- Amount -->
                                <td class="py-3 px-4 text-right font-black text-slate-900 dark:text-white">
                                    $@item.TotalAmount.ToString("N2")
                                </td>

                                <!-- Payment -->
                                <td class="py-3 px-4">
                                    @if (item.Payment != null)
                                    {
                                        var pStatus = item.Payment.PaymentStatus.ToString();
                                        if (pStatus.Equals("Completed", StringComparison.OrdinalIgnoreCase) || pStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                                <i class="bi bi-credit-card"></i> Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                                                <i class="bi bi-clock"></i> @item.Payment.PaymentStatus
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-500">
                                            COD
                                        </span>
                                    }
                                </td>

                                <!-- Order Status -->
                                <td class="py-3 px-4">
                                    @switch (item.Status)
                                    {
                                        case OrderStatus.Delivered:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                                <i class="bi bi-check2-circle"></i> Delivered
                                            </span>
                                            break;
                                        case OrderStatus.Shipped:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
                                                <i class="bi bi-truck"></i> Shipped
                                            </span>
                                            break;
                                        case OrderStatus.Processing:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800">
                                                <i class="bi bi-arrow-repeat"></i> Processing
                                            </span>
                                            break;
                                        case OrderStatus.Cancelled:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
                                                <i class="bi bi-x-circle"></i> Cancelled
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                                                <i class="bi bi-clock-history"></i> @item.Status
                                            </span>
                                            break;
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="py-3 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 hover:border-blue-600 text-slate-600 dark:text-slate-300 hover:text-blue-600 flex items-center justify-center text-xs transition"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Receipt" asp-route-id="@item.Id" target="_blank"
                                           class="w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 hover:border-emerald-600 text-slate-600 dark:text-slate-300 hover:text-emerald-600 flex items-center justify-center text-xs transition"
                                           title="Print / View Receipt">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        <button type="button" onclick="openStatusModal('@item.Id')"
                                                class="w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 hover:border-amber-500 text-slate-600 dark:text-slate-300 hover:text-amber-600 flex items-center justify-center text-xs transition cursor-pointer"
                                                title="Quick Status Update">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="w-7 h-7 rounded-lg border border-slate-200 dark:border-slate-700 hover:border-rose-500 text-slate-600 dark:text-slate-300 hover:text-rose-600 flex items-center justify-center text-xs transition"
                                           title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>

                                    <!-- Tailwind Status Update Modal -->
                                    <div id="statusModal_@item.Id" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/70 backdrop-blur-xs text-left">
                                        <div class="w-full max-w-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl p-5 space-y-4">
                                            <form asp-action="Edit" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                
                                                <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-800">
                                                    <h4 class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
                                                        <i class="bi bi-pencil-square text-blue-600"></i> Update Order #@item.Id.ToString()[..8].ToUpper()
                                                    </h4>
                                                    <button type="button" onclick="closeStatusModal('@item.Id')" class="text-slate-400 hover:text-slate-600 text-xs">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </div>

                                                <div class="space-y-3 py-2">
                                                    <div>
                                                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Select New Status</label>
                                                        <select name="status" class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                                                            @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
                                                            {
                                                                <option value="@s" selected="@(item.Status == s)">@s</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 text-[11px] text-slate-500 dark:text-slate-400 space-y-1">
                                                        <div>Customer: <strong class="text-slate-700 dark:text-slate-200">@customerName</strong></div>
                                                        <div>Total: <strong class="text-emerald-600 font-bold">$@item.TotalAmount.ToString("N2")</strong></div>
                                                    </div>
                                                </div>

                                                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                                                    <button type="button" onclick="closeStatusModal('@item.Id')"
                                                            class="px-3 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
                                                        Cancel
                                                    </button>
                                                    <button type="submit"
                                                            class="px-4 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-xs font-bold text-white shadow">
                                                        Save Changes
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- EMPTY STATE -->
            <div class="text-center py-16 px-4">
                <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mx-auto mb-3">
                    <i class="bi bi-bag-x text-2xl"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-1">No orders found</h4>
                <p class="text-xs text-slate-400 mb-4 max-w-xs mx-auto">No orders matched your active search or status filters.</p>
                <a asp-action="Index"
                   class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition">
                    <i class="bi bi-arrow-repeat"></i> Reset All Filters
                </a>
            </div>
        }
    </div>

</div>

<script>
    function openStatusModal(id) {
        var modal = document.getElementById('statusModal_' + id);
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    }
    function closeStatusModal(id) {
        var modal = document.getElementById('statusModal_' + id);
        if (modal) {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }
    }
</script>