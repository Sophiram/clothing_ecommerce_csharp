@model WebApplication_ClothingEcommerce.Models.PaymentMethod

@{
    ViewData["Title"] = "Payment Method Details";
}

<div class="space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200/80 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-primary-600 dark:text-primary-400 mb-1 tracking-wider uppercase">
                <i class="bi bi-credit-card-2-front"></i>
                <span data-en="FINANCE / PAYMENT METHODS" data-kh="ហិរញ្ញវត្ថុ / វិធីសាស្ត្រទូទាត់">FINANCE / PAYMENT METHODS</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white" data-en="Payment Method Details" data-kh="ព័ត៌មានលម្អិតវិធីទូទាត់">
                Payment Method Details
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1" data-en="Review payment method configuration and transaction statistics." data-kh="ពិនិត្យមើលការកំណត់វិធីសាស្ត្រទូទាត់ និងស្ថិតិប្រតិបត្តិការ។">
                Review payment method configuration and transaction statistics.
            </p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold shadow-md hover:shadow-lg transition">
                <i class="bi bi-pencil-square"></i>
                <span data-en="Edit Method" data-kh="កែប្រែវិធីសាស្ត្រ">Edit Method</span>
            </a>
            <a asp-action="Index"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-bold shadow-xs transition">
                <i class="bi bi-arrow-left"></i>
                <span data-en="Back to List" data-kh="ត្រឡប់ក្រោយ">Back to List</span>
            </a>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- LEFT 2 COLS: METHOD SPEC & DETAILS -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">

                <!-- ICON & TITLE BANNER -->
                <div class="flex items-center gap-4 pb-6 border-b border-slate-100 dark:border-slate-800">
                    <div class="w-20 h-20 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center p-3 overflow-hidden shadow-inner flex-shrink-0">
                        @if (!string.IsNullOrWhiteSpace(Model.Icon))
                        {
                            <img src="@Model.Icon" alt="@Model.Name" class="w-full h-full object-contain" onerror="this.onerror=null;this.src='/images/khqr-logo.svg';" />
                        }
                        else
                        {
                            <i class="bi bi-credit-card-2-front text-3xl text-primary-600 dark:text-primary-400"></i>
                        }
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2.5 mb-1 flex-wrap">
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white">@Model.Name</h3>
                            @if (Model.IsActive)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    <span data-en="Active in Checkout" data-kh="ដំណើរការ">Active in Checkout</span>
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-500 border border-slate-200 dark:border-slate-700">
                                    <span data-en="Disabled" data-kh="បានបិទ">Disabled</span>
                                </span>
                            }
                        </div>
                        <span class="font-mono text-xs text-slate-400 dark:text-slate-500">ID: @Model.Id</span>
                    </div>
                </div>

                <!-- ATTRIBUTES GRID -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-800">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1" data-en="Display Sort Order" data-kh="លំដាប់បង្ហាញ">Display Sort Order</span>
                        <span class="text-base font-bold text-slate-900 dark:text-white">Position #@Model.DisplayOrder</span>
                    </div>

                    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-800">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1" data-en="Created Date" data-kh="កាលបរិច្ឆេទបង្កើត">Created Date</span>
                        <span class="text-base font-bold text-slate-900 dark:text-white">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                    </div>

                    <div class="sm:col-span-2 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-800">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1" data-en="Customer Notice / Instructions" data-kh="ការពិពណ៌នា / ចំណាំ">Customer Notice / Instructions</span>
                        <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Icon))
                    {
                        <div class="sm:col-span-2 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-800">
                            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-1" data-en="Icon Asset URL" data-kh="តំណរូបភាព Icon">Icon Asset URL</span>
                            <code class="text-xs font-mono text-primary-600 dark:text-primary-400 break-all">@Model.Icon</code>
                        </div>
                    }
                </div>

            </div>
        </div>

        <!-- RIGHT 1 COL: TRANSACTION STATS & ACTIONS -->
        <div class="space-y-6">

            <!-- USAGE CARD -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 shadow-sm space-y-5">
                <div class="flex items-center gap-2 pb-3 border-b border-slate-100 dark:border-slate-800">
                    <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-sm">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h4 class="font-bold text-xs text-slate-900 dark:text-white uppercase tracking-wider" data-en="Usage & Volume" data-kh="ស្ថិតិនៃការប្រើប្រាស់">Usage &amp; Volume</h4>
                </div>

                <div class="p-6 rounded-2xl bg-gradient-to-br from-primary-500/10 via-primary-500/5 to-transparent border border-primary-500/20 text-center">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1" data-en="Total Orders Paid" data-kh="ការទូទាត់សរុប">Total Orders Paid</span>
                    <div class="text-4xl font-black text-primary-600 dark:text-primary-400 tabular-nums my-1">@Model.Payments.Count</div>
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-500 dark:text-slate-400">
                        <i class="bi bi-shield-check text-emerald-500"></i> Checkout Transactions
                    </span>
                </div>

                <div class="space-y-2.5 pt-2">
                    <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" class="w-full">
                        @Html.AntiForgeryToken()
                        @if (Model.IsActive)
                        {
                            <button type="submit" class="w-full py-2.5 px-4 rounded-xl border border-amber-300 dark:border-amber-800 text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40 hover:bg-amber-100 transition text-xs font-bold flex items-center justify-center gap-1.5 cursor-pointer">
                                <i class="bi bi-pause-circle"></i>
                                <span data-en="Disable This Method" data-kh="ផ្អាកដំណើរការវិធីនេះ">Disable This Method</span>
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white transition text-xs font-bold shadow-sm flex items-center justify-center gap-1.5 cursor-pointer">
                                <i class="bi bi-play-circle"></i>
                                <span data-en="Enable This Method" data-kh="បើកដំណើរការវិធីនេះ">Enable This Method</span>
                            </button>
                        }
                    </form>

                    @if (Model.Payments.Count == 0)
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="w-full py-2.5 px-4 rounded-xl border border-rose-300 dark:border-rose-800 text-rose-700 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition text-xs font-bold flex items-center justify-center gap-1.5">
                            <i class="bi bi-trash"></i>
                            <span data-en="Delete Payment Method" data-kh="លុបវិធីទូទាត់នេះ">Delete Payment Method</span>
                        </a>
                    }
                </div>
            </div>

        </div>

    </div>

</div>