@model WebApplication_ClothingEcommerce.Models.PaymentMethod

@{
    ViewData["Title"] = "Create Payment Method";
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            Create Payment Method
        </h2>

        <p class="text-muted">
            Add a new payment option for customers.
        </p>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="e.g. KHQR" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Payment method description"></textarea>

                </div>


                <div class="mb-3">

                    <label asp-for="Icon"
                           class="form-label">
                        Icon URL
                    </label>

                    <input asp-for="Icon"
                           class="form-control"
                           placeholder="https://..." />

                </div>


                <div class="mb-3">

                    <label asp-for="DisplayOrder"
                           class="form-label">
                        Display Order
                    </label>

                    <input asp-for="DisplayOrder"
                           type="number"
                           class="form-control"
                           min="0" />

                </div>


                <div class="form-check mb-4">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Active
                    </label>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-dark">
                        Create
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}