@model IEnumerable<WebApplication_ClothingEcommerce.Models.PaymentMethod>

@{
    ViewData["Title"] = "Payment Methods";
}

<div class="admin-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="page-header">

        <div>
            <div class="page-eyebrow">
                SALES / PAYMENTS
            </div>

            <h1 class="page-title">
                Payment Methods
            </h1>

            <p class="page-description">
                Manage payment methods available during checkout.
            </p>
        </div>

        <div>

            <a asp-action="Create"
               class="btn-primary-custom">

                <i class="bi bi-plus-lg"></i>

                <span>
                    Add Payment Method
                </span>

            </a>

        </div>

    </div>


    <!-- =====================================================
         ALERTS
    ====================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="admin-alert admin-alert-success">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="admin-alert admin-alert-danger">

            <i class="bi bi-exclamation-circle-fill"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <!-- =====================================================
         PAYMENT METHODS CARD
    ====================================================== -->

    <div class="admin-card">

        <!-- CARD HEADER -->

        <div class="admin-card-header">

            <div>

                <h2 class="admin-card-title">
                    Payment Methods
                </h2>

                <p class="admin-card-subtitle">
                    Configure and manage available checkout payment options.
                </p>

            </div>

            <div class="admin-card-count">

                <span>
                    @(Model?.Count() ?? 0)
                </span>

                <small>
                    methods
                </small>

            </div>

        </div>


        <!-- =================================================
             SEARCH
        ================================================== -->

        <div class="search-wrapper">

            <form method="get"
                  class="search-form">

                <div class="search-input-wrapper">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="search-input"
                           placeholder="Search payment methods..." />

                </div>

                <button type="submit"
                        class="btn-search">

                    <i class="bi bi-search"></i>

                    <span>
                        Search
                    </span>

                </button>

                <a asp-action="Index"
                   class="btn-reset">

                    <i class="bi bi-arrow-counterclockwise"></i>

                    <span>
                        Reset
                    </span>

                </a>

            </form>

        </div>


        <!-- =================================================
             TABLE
        ================================================== -->
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="admin-table">

                    <thead>

                        <tr>

                            <th style="width:80px;">
                                ORDER
                            </th>

                            <th>
                                PAYMENT METHOD
                            </th>

                            <th>
                                DESCRIPTION
                            </th>

                            <th>
                                STATUS
                            </th>

                            <th>
                                PAYMENTS
                            </th>

                            <th class="text-end">
                                ACTIONS
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var method in Model)
                        {
                            <tr>

                                <!-- ORDER -->

                                <td>

                                    <span class="order-number">
                                        @method.DisplayOrder
                                    </span>

                                </td>


                                <!-- PAYMENT METHOD -->

                                <td>

                                    <div class="payment-method">

                                        <div class="payment-icon">

                                            @if (!string.IsNullOrWhiteSpace(method.Icon))
                                            {
                                                <img src="@method.Icon"
                                                     alt="@method.Name"
                                                     onerror="this.onerror=null;this.src='/images/khqr-logo.svg';" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-credit-card"></i>
                                            }

                                        </div>


                                        <div>

                                            <div class="payment-name">
                                                @method.Name
                                            </div>

                                            <div class="payment-id">
                                                ID #@method.Id
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- DESCRIPTION -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(method.Description))
                                    {
                                        <span class="description-text"
                                              title="@method.Description">

                                            @method.Description

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No description
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (method.IsActive)
                                    {
                                        <span class="status-pill status-active">

                                            <span class="status-dot"></span>

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-disabled">

                                            <span class="status-dot"></span>

                                            Disabled

                                        </span>
                                    }

                                </td>


                                <!-- PAYMENTS -->

                                <td>

                                    <span class="payment-count">
                                        @method.Payments.Count
                                    </span>

                                </td>


                                <!-- ACTIONS -->
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                            <!-- DETAILS -->
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@method.Id">
                                                    <i class="bi bi-eye text-primary"></i> <span>View Details</span>
                                                </a>
                                            </li>

                                            <!-- EDIT -->
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@method.Id">
                                                    <i class="bi bi-pencil text-warning"></i> <span>Edit Method</span>
                                                </a>
                                            </li>

                                            <!-- ENABLE / DISABLE -->
                                            <li>
                                                <form asp-action="ToggleActive" asp-route-id="@method.Id" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    @if (method.IsActive)
                                                    {
                                                        <button type="submit" class="dropdown-item text-secondary">
                                                            <i class="bi bi-pause-circle text-warning"></i> <span>Disable Method</span>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="dropdown-item text-secondary">
                                                            <i class="bi bi-play-circle text-success"></i> <span>Enable Method</span>
                                                        </button>
                                                    }
                                                </form>
                                            </li>

                                            <!-- DELETE -->
                                            @if (method.Payments.Count == 0)
                                            {
                                                <li><hr class="dropdown-divider my-1" /></li>
                                                <li>
                                                    <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@method.Id">
                                                        <i class="bi bi-trash"></i> <span>Delete Method</span>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- EMPTY STATE -->

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-credit-card-2-front"></i>

                </div>

                <h5>
                    No payment methods found
                </h5>

                <p>
                    Add your first payment method to make it available during checkout.
                </p>

                <a asp-action="Create"
                   class="btn-primary-custom">

                    <i class="bi bi-plus-lg"></i>

                    Add Payment Method

                </a>

            </div>
        }

    </div>

</div>