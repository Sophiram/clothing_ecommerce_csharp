@model IEnumerable<WebApplication_ClothingEcommerce.Models.PaymentMethod>

@{
    ViewData["Title"] = "Payment Methods";
    var totalMethods = Model?.Count() ?? 0;
    var activeMethods = Model?.Count(m => m.IsActive) ?? 0;
    var totalTransactions = Model?.Sum(m => m.Payments?.Count ?? 0) ?? 0;
    var disabledMethods = totalMethods - activeMethods;
}

<div class="space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200/80 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-blue-600 dark:text-blue-400 mb-1 tracking-wider uppercase">
                <i class="bi bi-wallet2"></i>
                <span>SALES &amp; PAYMENTS</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
                Payment Methods
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Configure and manage available payment gateways and checkout options.
            </p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            <a asp-action="Create"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-md hover:shadow-lg transition">
                <i class="bi bi-plus-lg"></i>
                <span>Add Payment Method</span>
            </a>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-2.5 p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/80 text-emerald-800 dark:text-emerald-300 text-xs font-semibold shadow-xs">
            <i class="bi bi-check-circle-fill text-emerald-600 text-sm"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="flex items-center gap-2.5 p-3.5 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/80 text-rose-800 dark:text-rose-300 text-xs font-semibold shadow-xs">
            <i class="bi bi-exclamation-triangle-fill text-rose-600 text-sm"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- 4 KPI SUMMARY CARDS (MATCHING REPORTS LAYOUT) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- 1. CONFIGURED METHODS -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Configured Methods</span>
                <span class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-base">
                    <i class="bi bi-wallet2"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-slate-900 dark:text-white tabular-nums">
                    @totalMethods
                </div>
                <div class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400 font-semibold mt-1">
                    <span>KHQR, Cards, COD</span>
                </div>
            </div>
        </div>

        <!-- 2. ACTIVE CHANNELS -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Active Channels</span>
                <span class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base">
                    <i class="bi bi-check2-circle"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400 tabular-nums">
                    @activeMethods
                </div>
                <div class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400 font-bold mt-1">
                    <i class="bi bi-arrow-up-right"></i>
                    <span>Live at checkout</span>
                </div>
            </div>
        </div>

        <!-- 3. TOTAL PAYMENTS PROCESSED -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Transactions</span>
                <span class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-base">
                    <i class="bi bi-receipt"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-indigo-600 dark:text-indigo-400 tabular-nums">
                    @totalTransactions
                </div>
                <div class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400 font-semibold mt-1">
                    <span>Processed customer orders</span>
                </div>
            </div>
        </div>

        <!-- 4. DISABLED CHANNELS -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Disabled Gateways</span>
                <span class="w-9 h-9 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-base">
                    <i class="bi bi-pause-circle-fill"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-amber-600 dark:text-amber-400 tabular-nums">
                    @disabledMethods
                </div>
                <div class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400 font-semibold mt-1">
                    <span>Inactive or in maintenance</span>
                </div>
            </div>
        </div>

    </div>

    <!-- FILTER TOOLBAR -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm">
        <form method="get" class="flex flex-col sm:flex-row items-center gap-3">
            <div class="relative flex-1 w-full">
                <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search payment methods..."
                       class="w-full text-xs font-medium pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="submit"
                        class="flex-1 sm:flex-initial px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-black dark:bg-slate-800 dark:hover:bg-slate-700 text-white text-xs font-bold transition flex items-center justify-center gap-1.5">
                    <i class="bi bi-funnel-fill"></i> <span>Search</span>
                </button>
                <a asp-action="Index" class="p-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Reset Search">
                    <i class="bi bi-arrow-repeat text-xs"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- PAYMENT METHODS TABLE CARD -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 dark:border-slate-800">
            <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">Payment Methods</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">Configure checkout payment options and reconciliation</p>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold">
                @totalMethods methods
            </span>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/60 text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 tracking-wider">
                            <th class="py-3 px-5" style="width: 80px;">Order</th>
                            <th class="py-3 px-4">Payment Method</th>
                            <th class="py-3 px-4">Description</th>
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4">Transactions</th>
                            <th class="py-3 px-5 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
                        @foreach (var method in Model)
                        {
                            var txCount = method.Payments?.Count ?? 0;

                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition">
                                <td class="py-3.5 px-5">
                                    <span class="font-mono font-bold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded text-xs">
                                        #@method.DisplayOrder
                                    </span>
                                </td>

                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center p-1.5 shrink-0">
                                            @if (!string.IsNullOrWhiteSpace(method.Icon))
                                            {
                                                <img src="@method.Icon" alt="@method.Name" class="max-w-full max-h-full object-contain" onerror="this.onerror=null;this.src='/images/khqr-logo.svg';" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-credit-card text-blue-600"></i>
                                            }
                                        </div>
                                        <div>
                                            <div class="font-bold text-slate-900 dark:text-white">@method.Name</div>
                                            <div class="font-mono text-[11px] text-slate-400">ID: #@method.Id.ToString()[..8]</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400">
                                    @if (!string.IsNullOrWhiteSpace(method.Description))
                                    {
                                        <span class="line-clamp-1 max-w-xs" title="@method.Description">@method.Description</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 italic">No description</span>
                                    }
                                </td>

                                <td class="py-3.5 px-4">
                                    @if (method.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                            <i class="bi bi-check2-circle"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                                            <i class="bi bi-pause-circle"></i> Disabled
                                        </span>
                                    }
                                </td>

                                <td class="py-3.5 px-4">
                                    <span class="font-mono font-bold text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded text-[11px]">
                                        @txCount tx
                                    </span>
                                </td>

                                <td class="py-3.5 px-5 text-right">
                                    <div class="inline-flex items-center gap-1.5 justify-end">
                                        <!-- Primary Edit Action -->
                                        <button type="button"
                                                onclick="openEditMethodModal('@method.Id', '@Html.Raw(Html.Encode(method.Name))', '@Html.Raw(Html.Encode(method.Description ?? ""))', '@Html.Raw(Html.Encode(method.Icon ?? ""))', @method.DisplayOrder, @method.IsActive.ToString().ToLower())"
                                                class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-300 dark:hover:border-blue-600 transition text-xs font-semibold shadow-2xs cursor-pointer"
                                                title="Edit Method">
                                            <i class="bi bi-pencil text-slate-400"></i>
                                            <span>Edit</span>
                                        </button>

                                        <!-- More Actions Meatball Menu -->
                                        <div class="dropdown relative inline-block text-left">
                                            <button class="action-meatball-btn w-7 h-7 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700/60 transition cursor-pointer"
                                                    type="button" aria-expanded="false" title="More Actions"
                                                    onclick="toggleActionMenu(this, event)">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-meatball dropdown-menu-end hidden absolute right-0 mt-2 w-48 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl py-1.5 z-[9999] focus:outline-none">
                                                <!-- Quick View Modal -->
                                                <li>
                                                    <button type="button"
                                                            onclick="openViewMethodModal('@method.Id', '@Html.Raw(Html.Encode(method.Name))', '@Html.Raw(Html.Encode(method.Description ?? "No description provided."))', '@Html.Raw(Html.Encode(method.Icon ?? ""))', @method.DisplayOrder, @method.IsActive.ToString().ToLower(), @txCount, '@method.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")')"
                                                            class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition text-left cursor-pointer">
                                                        <i class="bi bi-eye text-blue-500"></i> <span>Quick View</span>
                                                    </button>
                                                </li>

                                                <!-- Full Details Page -->
                                                <li>
                                                    <a asp-action="Details" asp-route-id="@method.Id"
                                                       class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                                                        <i class="bi bi-box-arrow-up-right text-indigo-500"></i> <span>Full Details</span>
                                                    </a>
                                                </li>

                                                <!-- Toggle Status -->
                                                <li>
                                                    <form asp-action="ToggleActive" asp-route-id="@method.Id" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        @if (method.IsActive)
                                                        {
                                                            <button type="submit" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/40 transition text-left cursor-pointer">
                                                                <i class="bi bi-pause-circle text-amber-500"></i> <span>Disable Method</span>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 transition text-left cursor-pointer">
                                                                <i class="bi bi-play-circle text-emerald-500"></i> <span>Enable Method</span>
                                                            </button>
                                                        }
                                                    </form>
                                                </li>

                                                @if (txCount == 0)
                                                {
                                                    <li class="my-1 border-t border-slate-100 dark:border-slate-800"></li>
                                                    <li>
                                                        <a asp-action="Delete" asp-route-id="@method.Id"
                                                           class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition">
                                                            <i class="bi bi-trash text-rose-500"></i> <span>Delete Method</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-16 px-4">
                <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mx-auto mb-3">
                    <i class="bi bi-credit-card-2-front text-2xl"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-1">No payment methods found</h4>
                <p class="text-xs text-slate-400 mb-4 max-w-xs mx-auto">Add your first payment method to make it available during checkout.</p>
                <a asp-action="Create"
                   class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition">
                    <i class="bi bi-plus-lg"></i> Add Payment Method
                </a>
            </div>
        }
    </div>

</div>

<!-- =========================================================
     MODERN TAILWIND EDIT PAYMENT METHOD POPUP MODAL
========================================================= -->
<div id="editMethodModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative animate-in fade-in zoom-in duration-150">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-base">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">Edit Payment Method</h3>
                    <p class="text-[11px] text-slate-400 font-mono" id="modalMethodIdBadge"></p>
                </div>
            </div>
            <button type="button" onclick="closeEditMethodModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm p-1 rounded-lg">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <form asp-action="Edit" method="post" class="mt-4 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="modalMethodId" />

            <div class="grid grid-cols-3 gap-3">
                <div class="col-span-2">
                    <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Method Name</label>
                    <input type="text" name="Name" id="modalMethodName" class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500" required />
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Display Order</label>
                    <input type="number" name="DisplayOrder" id="modalMethodDisplayOrder" class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500" min="0" required />
                </div>
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Description / Customer Note</label>
                <textarea name="Description" id="modalMethodDescription" rows="2" class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Icon Asset URL</label>
                <div class="flex items-center gap-2">
                    <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 flex items-center justify-center p-1 shrink-0">
                        <img id="modalMethodIconPreview" src="/images/khqr-logo.svg" alt="" class="max-w-full max-h-full object-contain" onerror="this.onerror=null;this.src='/images/khqr-logo.svg';" />
                    </div>
                    <input type="text" name="Icon" id="modalMethodIcon" class="w-full text-xs font-mono py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500" placeholder="/images/khqr-logo.svg" oninput="updateModalIconPreview(this.value)" />
                </div>
            </div>

            <div>
                <label class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-800 cursor-pointer">
                    <input type="checkbox" name="IsActive" value="true" id="modalMethodActive" class="w-4 h-4 rounded text-blue-600 border-slate-300 focus:ring-blue-500" />
                    <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">Enable for Checkout</span>
                </label>
            </div>

            <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeEditMethodModal()"
                        class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    Cancel
                </button>
                <button type="submit"
                        class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition flex items-center gap-1.5">
                    <i class="bi bi-check2"></i> <span>Save Changes</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =========================================================
     MODERN TAILWIND VIEW PAYMENT METHOD MODAL
========================================================= -->
<div id="viewMethodModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative animate-in fade-in zoom-in duration-150">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center p-1.5 shrink-0">
                    <img id="viewMethodLogo" src="/images/khqr-logo.svg" alt="" class="max-w-full max-h-full object-contain" onerror="this.onerror=null;this.src='/images/khqr-logo.svg';" />
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white" id="viewMethodName"></h3>
                    <div class="flex items-center gap-2 mt-0.5">
                        <span class="font-mono text-[10px] font-bold text-slate-400" id="viewMethodIdBadge"></span>
                        <span id="viewMethodStatusBadge"></span>
                    </div>
                </div>
            </div>
            <button type="button" onclick="closeViewMethodModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm p-1 rounded-lg">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="mt-4 space-y-3">
            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-800">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Description</span>
                <p class="text-xs text-slate-700 dark:text-slate-300" id="viewMethodDescription"></p>
            </div>

            <div class="grid grid-cols-2 gap-2.5 text-xs">
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-800">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Display Position</span>
                    <span class="font-bold text-slate-900 dark:text-white" id="viewMethodOrder">#0</span>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/70 dark:border-slate-800">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Total Payments</span>
                    <span class="font-bold text-blue-600 dark:text-blue-400" id="viewMethodPayments">0</span>
                </div>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-800">
                <a id="viewMethodFullLink" href="#" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Open Full Page</span>
                </a>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="closeViewMethodModal()"
                            class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                        Close
                    </button>
                    <button type="button" id="viewMethodEditBtn"
                            class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold shadow transition flex items-center gap-1.5">
                        <i class="bi bi-pencil"></i> Edit
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function updateModalIconPreview(url) {
        var img = document.getElementById('modalMethodIconPreview');
        if (img) {
            img.src = url && url.trim().length > 0 ? url.trim() : '/images/khqr-logo.svg';
        }
    }

    function openEditMethodModal(id, name, description, icon, displayOrder, isActive) {
        document.getElementById('modalMethodId').value = id;
        document.getElementById('modalMethodIdBadge').textContent = 'ID #' + id.substring(0, 8);
        document.getElementById('modalMethodName').value = name;
        document.getElementById('modalMethodDescription').value = description;
        document.getElementById('modalMethodIcon').value = icon;
        document.getElementById('modalMethodDisplayOrder').value = displayOrder;
        document.getElementById('modalMethodActive').checked = isActive;
        updateModalIconPreview(icon);

        var m = document.getElementById('editMethodModal');
        m.classList.remove('hidden');
        m.classList.add('flex');
    }

    function closeEditMethodModal() {
        var m = document.getElementById('editMethodModal');
        m.classList.add('hidden');
        m.classList.remove('flex');
    }

    function openViewMethodModal(id, name, description, icon, displayOrder, isActive, paymentsCount, createdAt) {
        document.getElementById('viewMethodName').textContent = name;
        document.getElementById('viewMethodIdBadge').textContent = '#' + id.substring(0, 8);
        document.getElementById('viewMethodDescription').textContent = description || 'No description provided.';
        document.getElementById('viewMethodOrder').textContent = 'Position #' + displayOrder;
        document.getElementById('viewMethodPayments').textContent = paymentsCount + ' transactions';
        document.getElementById('viewMethodLogo').src = icon || '/images/khqr-logo.svg';
        document.getElementById('viewMethodFullLink').href = '/Admin/PaymentMethods/Details/' + id;

        var statusBadge = document.getElementById('viewMethodStatusBadge');
        if (isActive) {
            statusBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800';
            statusBadge.innerHTML = '<i class="bi bi-check2-circle"></i> Active';
        } else {
            statusBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400';
            statusBadge.innerHTML = '<i class="bi bi-pause-circle"></i> Disabled';
        }

        var editBtn = document.getElementById('viewMethodEditBtn');
        editBtn.onclick = function() {
            closeViewMethodModal();
            openEditMethodModal(id, name, description, icon, displayOrder, isActive);
        };

        var m = document.getElementById('viewMethodModal');
        m.classList.remove('hidden');
        m.classList.add('flex');
    }

    function closeViewMethodModal() {
        var m = document.getElementById('viewMethodModal');
        m.classList.add('hidden');
        m.classList.remove('flex');
    }

    window.addEventListener('click', function(e) {
        var editM = document.getElementById('editMethodModal');
        var viewM = document.getElementById('viewMethodModal');
        if (e.target === editM) closeEditMethodModal();
        if (e.target === viewM) closeViewMethodModal();
    });
</script>
}