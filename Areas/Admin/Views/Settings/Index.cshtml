@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid px-4 py-3" style="max-width: 900px;">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 text-uppercase" style="font-size: 11px; font-weight: 700; letter-spacing: 0.05em;">
                    <i class="bi bi-shield-lock-fill me-1"></i> SuperAdmin Control
                </span>
                <span class="text-muted small">Platform Configuration</span>
            </div>
            <h1 class="h3 fw-bold mb-0 text-dark">System &amp; Store Settings</h1>
            <p class="text-muted small mb-0">Configure store metadata, security parameters, and operational controls.</p>
        </div>
    </div>

    <!-- Notification Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" asp-action="Save">
        @Html.AntiForgeryToken()

        <!-- Store Identity Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h5 class="fw-bold mb-3 text-dark">
                <i class="bi bi-shop text-primary me-2"></i> Store Identity &amp; Contact
            </h5>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label fw-semibold small">Store Name</label>
                    <input type="text" name="storeName" value="CLOTHÉ" class="form-control rounded-3" required />
                </div>

                <div class="col-sm-6">
                    <label class="form-label fw-semibold small">Currency</label>
                    <select name="currency" class="form-select rounded-3">
                        <option value="USD" selected>USD ($) - US Dollar</option>
                        <option value="KHR">KHR (៛) - Khmer Riel</option>
                    </select>
                </div>

                <div class="col-sm-6">
                    <label class="form-label fw-semibold small">Support Email</label>
                    <input type="email" name="supportEmail" value="support@clothe.com" class="form-control rounded-3" required />
                </div>

                <div class="col-sm-6">
                    <label class="form-label fw-semibold small">Support Phone</label>
                    <input type="tel" name="supportPhone" value="+855 23 888 999" class="form-control rounded-3" />
                </div>
            </div>
        </div>

        <!-- Security & Access Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h5 class="fw-bold mb-3 text-dark">
                <i class="bi bi-shield-check text-success me-2"></i> Security &amp; Access Controls
            </h5>

            <div class="d-flex flex-column gap-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="allowRegistration" value="true" id="regSwitch" checked />
                    <label class="form-check-label fw-semibold small" for="regSwitch">
                        Allow Public Customer Registration
                    </label>
                    <div class="text-muted" style="font-size: 11px;">
                        When enabled, new visitors can register customer accounts freely on the store.
                    </div>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="maintenanceMode" value="true" id="maintSwitch" />
                    <label class="form-check-label fw-semibold small text-danger" for="maintSwitch">
                        Maintenance Mode
                    </label>
                    <div class="text-muted" style="font-size: 11px;">
                        When activated, customer-facing store features are temporarily paused for routine servicing.
                    </div>
                </div>
            </div>
        </div>

        <!-- System Architecture Information -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h5 class="fw-bold mb-3 text-dark">
                <i class="bi bi-cpu text-secondary me-2"></i> Platform Information
            </h5>

            <div class="row g-3 small">
                <div class="col-sm-4">
                    <span class="text-muted d-block">Environment</span>
                    <strong class="text-dark">@ViewBag.EnvironmentName</strong>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted d-block">Framework</span>
                    <strong class="text-dark">.NET Core (@ViewBag.FrameworkVersion)</strong>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted d-block">Server Time (UTC)</span>
                    <strong class="text-dark">@ViewBag.ServerTimeUtc</strong>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-dark rounded-pill px-4 shadow-sm">
                <i class="bi bi-check2 me-1"></i> Save Settings
            </button>
        </div>
    </form>
</div>
