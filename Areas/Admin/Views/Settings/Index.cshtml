                <!-- Hidden inputs for legacy Save method -->
                <input type="hidden" name="storeName" value="@Model.StoreName" />
                <input type="hidden" name="supportEmail" value="@Model.Email" />
                <input type="hidden" name="supportPhone" value="@Model.Phone" />
                <input type="hidden" name="currency" value="USD" />

                <!-- Server Environment Diagnostic Box -->
                <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
                    <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Host System Diagnostics</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                            <span class="text-slate-400 block text-[10px]">Environment</span>
                            <span class="font-semibold text-slate-800 dark:text-white">@ViewBag.EnvironmentName</span>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                            <span class="text-slate-400 block text-[10px]">CLR / Framework</span>
                            <span class="font-semibold text-slate-800 dark:text-white">.NET Core @ViewBag.FrameworkVersion</span>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                            <span class="text-slate-400 block text-[10px]">Server UTC Time</span>
                            <span class="font-mono text-slate-800 dark:text-white text-[11px]">@ViewBag.ServerTimeUtc</span>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex justify-end">
                    <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-slate-900 hover:bg-black text-white font-bold text-sm shadow-md transition cursor-pointer">
                        <i class="bi bi-save"></i>
                        <span>Save System Parameters</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
    }

</div>

@section Scripts {
    <script>
        function switchSettingsTab(tabName) {
            ['store', 'receipt', 'system'].forEach(t => {
                const el = document.getElementById('tabContent_' + t);
                if (el) {
                    if (t === tabName) {
                        el.classList.remove('hidden');
                    } else {
                        el.classList.add('hidden');
                    }
                }
            });

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = 'tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition cursor-pointer text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800';
            });

            if (window.event && window.event.currentTarget) {
                window.event.currentTarget.className = 'tab-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 transition cursor-pointer bg-primary-600 text-white shadow-sm';
            }

            // Update URL query without page reload
            const url = new URL(window.location);
            url.searchParams.set('tab', tabName);
            window.history.replaceState({}, '', url);
        }

        function updateReceiptPreview() {
            const vat = document.getElementById('inpVatNumber')?.value || 'K005-902201889';
            const prefix = document.getElementById('inpReceiptPrefix')?.value || 'REC-';
            const rate = parseFloat(document.getElementById('inpExchangeRate')?.value) || 4100;
            const dual = document.getElementById('chkShowDualCurrency')?.checked ?? true;
            const qr = document.getElementById('chkShowKhqr')?.checked ?? true;
            const policyEn = document.getElementById('inpReturnPolicyEn')?.value || '';
            const thankEn = document.getElementById('inpThankYouNoteEn')?.value || '';

            const selectedTheme = document.querySelector('input[name="DefaultReceiptTheme"]:checked')?.value || 'ModernLuxury';

            const pThemeBadge = document.getElementById('previewThemeBadge');
            const pVat = document.getElementById('prevVatBox');
            const pReceiptNo = document.getElementById('prevReceiptNo');
            const pDualRow = document.getElementById('prevKhrDualRow');
            const pDualKhr = document.getElementById('prevKhrDual');
            const pQrWrap = document.getElementById('prevQrWrap');
            const pPolicy = document.getElementById('prevPolicyBox');
            const pThank = document.getElementById('prevThankYou');
            const pBox = document.getElementById('receiptPreviewBox');

            if (pThemeBadge) pThemeBadge.textContent = 'Theme: ' + selectedTheme;
            if (pVat) pVat.textContent = 'VAT / TIN: ' + vat;
            if (pReceiptNo) pReceiptNo.textContent = prefix + '#8F3A2C';
            if (pDualRow) pDualRow.style.display = dual ? 'flex' : 'none';
            if (pDualKhr) pDualKhr.textContent = '~ ៛' + Math.round(102 * rate).toLocaleString();
            if (pQrWrap) pQrWrap.style.display = qr ? 'inline-block' : 'none';
            if (pPolicy) pPolicy.textContent = policyEn;
            if (pThank) pThank.textContent = thankEn;

            // Apply Theme styling to the Preview Box
            if (pBox) {
                if (selectedTheme === 'AuthenticThermal') {
                    pBox.className = 'bg-white text-slate-900 border-2 border-dashed border-slate-400 rounded-none font-mono p-4 text-[11px] shadow-sm';
                } else if (selectedTheme === 'CorporateInvoice') {
                    pBox.className = 'bg-white text-slate-900 border-2 border-blue-900 rounded-lg font-sans p-4 text-xs shadow-md';
                } else if (selectedTheme === 'MinimalChic') {
                    pBox.className = 'bg-white text-slate-900 border border-slate-100 rounded-2xl font-sans p-5 text-xs shadow-none';
                } else {
                    pBox.className = 'bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-5 text-slate-900 dark:text-slate-100 font-sans text-xs transition-all duration-300';
                }
            }
        }
    </script>
}
