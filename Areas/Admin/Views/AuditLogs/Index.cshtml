@model IEnumerable<WebApplication_ClothingEcommerce.Models.AuditLog>

@{
    ViewData["Title"] = "System Audit Logs";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var todayCount = (int)(ViewBag.TodayCount ?? 0);
    var search = ViewBag.Search as string ?? "";
    var actionFilter = ViewBag.ActionFilter as string ?? "";
    var entityFilter = ViewBag.EntityFilter as string ?? "";
    var distinctActions = ViewBag.DistinctActions as List<string> ?? new List<string>();
    var distinctEntities = ViewBag.DistinctEntities as List<string> ?? new List<string>();
    var userAvatars = ViewBag.UserAvatars as Dictionary<string, string?> ?? new Dictionary<string, string?>();
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 text-uppercase" style="font-size: 11px; font-weight: 700; letter-spacing: 0.05em;">
                    <i class="bi bi-shield-lock me-1"></i> SuperAdmin Exclusive
                </span>
                <span class="text-muted small">System Security &amp; Compliance</span>
            </div>
            <h2 class="h3 fw-bold mb-0 text-dark">Audit Logs</h2>
            <p class="text-muted small mb-0">Review administrative actions, role modifications, and system security events</p>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#cleanupModal">
                <i class="bi bi-trash3 me-1"></i> Clean Old Logs
            </button>
            <a asp-action="Index" class="btn btn-light btn-sm border rounded-pill px-3 shadow-sm">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
            <i class="bi bi-info-circle-fill me-2 fs-5"></i>
            <div>@TempData["Info"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Total Log Entries</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@totalCount</h3>
                    </div>
                    <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-journal-text fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Events Today (UTC)</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@todayCount</h3>
                    </div>
                    <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-calendar2-check fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Action Types</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@distinctActions.Count</h3>
                    </div>
                    <div class="rounded-circle bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-lightning-charge fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Audited Entities</div>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@distinctEntities.Count</h3>
                    </div>
                    <div class="rounded-circle bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-layers fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters & Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@search" class="form-control bg-light border-start-0" placeholder="Search by email, action, details, IP..." />
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <select name="actionFilter" class="form-select bg-light">
                        <option value="">All Actions</option>
                        @foreach (var act in distinctActions)
                        {
                            <option value="@act" selected="@(act == actionFilter ? "selected" : null)">@act</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <select name="entityFilter" class="form-select bg-light">
                        <option value="">All Entities</option>
                        @foreach (var ent in distinctEntities)
                        {
                            <option value="@ent" selected="@(ent == entityFilter ? "selected" : null)">@ent</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 rounded-pill">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(actionFilter) || !string.IsNullOrEmpty(entityFilter))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Clear Filters">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Logs Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3" style="width: 170px;">Timestamp (UTC)</th>
                        <th style="width: 210px;">Performed By</th>
                        <th style="width: 140px;">Action</th>
                        <th style="width: 120px;">Entity</th>
                        <th>Details</th>
                        <th class="pe-4 text-end" style="width: 130px;">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                                    <div class="fw-semibold">No audit logs found</div>
                                    <small>Try clearing filters or check back after administrative actions occur</small>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            var badgeClass = "bg-secondary-subtle text-secondary border-secondary-subtle";
                            var actionUpper = log.Action.ToUpperInvariant();
                            if (actionUpper.Contains("CREATE") || actionUpper.Contains("ADD") || actionUpper.Contains("ACTIVE"))
                            {
                                badgeClass = "bg-success-subtle text-success border-success-subtle";
                            }
                            else if (actionUpper.Contains("DELETE") || actionUpper.Contains("REMOVE") || actionUpper.Contains("DEACTIVATE"))
                            {
                                badgeClass = "bg-danger-subtle text-danger border-danger-subtle";
                            }
                            else if (actionUpper.Contains("RESET") || actionUpper.Contains("PASSWORD"))
                            {
                                badgeClass = "bg-warning-subtle text-warning-emphasis border-warning-subtle";
                            }
                            else if (actionUpper.Contains("EDIT") || actionUpper.Contains("UPDATE") || actionUpper.Contains("ROLE"))
                            {
                                badgeClass = "bg-primary-subtle text-primary border-primary-subtle";
                            }

                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="fw-semibold text-dark small">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                                    <span class="text-muted" style="font-size: 11px;">
                                        @{
                                            var diff = DateTime.UtcNow - log.CreatedAt;
                                            string timeAgo = diff.TotalMinutes < 1 ? "Just now" :
                                                             diff.TotalHours < 1 ? $"{(int)diff.TotalMinutes}m ago" :
                                                             diff.TotalDays < 1 ? $"{(int)diff.TotalHours}h ago" :
                                                             $"{(int)diff.TotalDays}d ago";
                                        }
                                        @timeAgo
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @{
                                            var avatarUrl = !string.IsNullOrEmpty(log.UserId) && userAvatars.ContainsKey(log.UserId) ? userAvatars[log.UserId] : null;
                                        }
                                        @if (!string.IsNullOrEmpty(avatarUrl))
                                        {
                                            <img src="@avatarUrl" alt="@log.UserEmail" class="rounded-circle shadow-sm" style="width: 28px; height: 28px; object-fit: cover; flex-shrink: 0;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 11px; flex-shrink: 0;">
                                                @(string.IsNullOrEmpty(log.UserEmail) ? "?" : log.UserEmail.Substring(0, 1).ToUpperInvariant())
                                            </div>
                                        }
                                        <div class="text-truncate" style="max-width: 170px;">
                                            <div class="small fw-semibold text-dark text-truncate" title="@log.UserEmail">
                                                @(string.IsNullOrEmpty(log.UserEmail) ? "System" : log.UserEmail)
                                            </div>
                                            @if (!string.IsNullOrEmpty(log.UserId))
                                            {
                                                <div class="text-muted font-monospace" style="font-size: 10px;" title="@log.UserId">
                                                    ID: @(log.UserId.Length > 8 ? log.UserId.Substring(0, 8) + "..." : log.UserId)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge border rounded-pill px-2 py-1 small fw-semibold @badgeClass">
                                        @log.Action
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">
                                        @log.EntityName
                                    </span>
                                </td>

                                <td>
                                    <div class="small text-dark" style="max-width: 420px; word-break: break-word;">
                                        @(string.IsNullOrEmpty(log.Description) ? "-" : log.Description)
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.EntityId))
                                    {
                                        <span class="text-muted font-monospace" style="font-size: 10px;">
                                            Target ID: @log.EntityId
                                        </span>
                                    }
                                </td>

                                <td class="pe-4 text-end">
                                    <span class="font-monospace small text-muted">
                                        @(string.IsNullOrEmpty(log.IpAddress) ? "-" : log.IpAddress)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-top d-flex flex-column flex-sm-row justify-content-between align-items-center py-3 px-4 gap-2">
                <div class="small text-muted">
                    Showing page <strong>@currentPage</strong> of <strong>@totalPages</strong> (Total <strong>@totalCount</strong> events)
                </div>
                <nav aria-label="Audit log pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-actionFilter="@actionFilter" asp-route-entityFilter="@entityFilter">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@search" asp-route-actionFilter="@actionFilter" asp-route-entityFilter="@entityFilter">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-actionFilter="@actionFilter" asp-route-entityFilter="@entityFilter">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal: Cleanup Old Logs -->
<div class="modal fade" id="cleanupModal" tabindex="-1" aria-labelledby="cleanupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="post" asp-action="ClearOlderThan">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="cleanupModalLabel">
                        <i class="bi bi-trash3 text-danger me-1"></i> Clean Old Audit Logs
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-muted small">
                        Choose the age threshold of logs you wish to purge. Recent security events will be preserved for compliance.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Purge entries older than:</label>
                        <select name="days" class="form-select">
                            <option value="30">30 days</option>
                            <option value="60">60 days</option>
                            <option value="90">90 days</option>
                            <option value="180">180 days (6 months)</option>
                        </select>
                    </div>
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> This action cannot be undone.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Cleanup</button>
                </div>
            </form>
        </div>
    </div>
</div>
