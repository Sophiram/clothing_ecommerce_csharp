@model IEnumerable<WebApplication_ClothingEcommerce.Models.AuditLog>

@{
    ViewData["Title"] = "System Audit Logs";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var todayCount = (int)(ViewBag.TodayCount ?? 0);
    var search = ViewBag.Search as string ?? "";
    var actionFilter = ViewBag.ActionFilter as string ?? "";
    var entityFilter = ViewBag.EntityFilter as string ?? "";
    var distinctActions = ViewBag.DistinctActions as List<string> ?? new List<string>();
    var distinctEntities = ViewBag.DistinctEntities as List<string> ?? new List<string>();
    var userAvatars = ViewBag.UserAvatars as Dictionary<string, string?> ?? new Dictionary<string, string?>();
}

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <!-- Breadcrumb -->
            <nav class="flex mb-2" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                    <li class="inline-flex items-center">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hover:text-primary-600 dark:hover:text-primary-400">Admin</a>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span data-en="System" data-kh="ប្រព័ន្ធ">System</span>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span class="text-slate-900 dark:text-white font-semibold" data-en="Audit Logs" data-kh="កំណត់ហេតុ">Audit Logs</span>
                    </li>
                </ol>
            </nav>

            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 border border-rose-200/60 dark:border-rose-900/50 uppercase tracking-wider">
                    <i class="bi bi-shield-lock"></i> SuperAdmin Exclusive
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-400 hidden sm:inline" data-en="System Security & Compliance" data-kh="សវនកម្ម & អនុលោមភាព">System Security &amp; Compliance</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5" data-en="Audit Logs" data-kh="កំណត់ហេតុសវនកម្មប្រព័ន្ធ">
                <span class="w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950/50 text-primary-600 dark:text-primary-400 flex items-center justify-center text-lg">
                    <i class="bi bi-journal-text"></i>
                </span>
                Audit Logs
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1" data-en="Review administrative actions, role modifications, access changes, and security events." data-kh="ពិនិត្យមើលសកម្មភាពរដ្ឋបាល ការផ្លាស់ប្ដូរតួនាទី និងព្រឹត្តិការណ៍សុវត្ថិភាព។">
                Review administrative actions, role modifications, access changes, and security events.
            </p>
        </div>

        <div class="flex items-center gap-2.5">
            <button type="button" class="inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl border border-rose-200 dark:border-rose-900/60 bg-rose-50/60 dark:bg-rose-950/30 hover:bg-rose-100 dark:hover:bg-rose-900/50 text-rose-700 dark:text-rose-300 text-xs font-semibold shadow-sm transition" data-bs-toggle="modal" data-bs-target="#cleanupModal">
                <i class="bi bi-trash3"></i> <span data-en="Clean Old Logs" data-kh="សម្អាតកំណត់ហេតុចាស់ៗ">Clean Old Logs</span>
            </button>
            <a asp-action="Index" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-sm transition">
                <i class="bi bi-arrow-clockwise"></i> <span data-en="Refresh" data-kh="ផ្ទុកឡើងវិញ">Refresh</span>
            </a>
        </div>
    </div>

    <!-- NOTIFICATION ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/80 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-sm shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill text-lg text-emerald-500"></i>
            <span class="flex-1">@TempData["Success"]</span>
            <button type="button" class="text-emerald-500 hover:text-emerald-700 p-1" onclick="this.parentElement.remove();"><i class="bi bi-x-lg"></i></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="flex items-center gap-3 p-4 rounded-2xl bg-sky-50 dark:bg-sky-950/40 border border-sky-200/80 dark:border-sky-800 text-sky-800 dark:text-sky-300 text-sm shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill text-lg text-sky-500"></i>
            <span class="flex-1">@TempData["Info"]</span>
            <button type="button" class="text-sky-500 hover:text-sky-700 p-1" onclick="this.parentElement.remove();"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    <!-- STATS ROW -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total Log Entries -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-950/40 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xl flex-shrink-0">
                <i class="bi bi-journal-text"></i>
            </div>
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400" data-en="Total Log Entries" data-kh="កំណត់ហេតុសរុប">Total Log Entries</div>
                <div class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">@totalCount</div>
            </div>
        </div>

        <!-- Events Today -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl flex-shrink-0">
                <i class="bi bi-calendar2-check"></i>
            </div>
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400" data-en="Events Today (UTC)" data-kh="ថ្ងៃនេះ (UTC)">Events Today</div>
                <div class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">@todayCount</div>
            </div>
        </div>

        <!-- Action Types -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl flex-shrink-0">
                <i class="bi bi-lightning-charge"></i>
            </div>
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400" data-en="Action Types" data-kh="ប្រភេទសកម្មភាព">Action Types</div>
                <div class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">@distinctActions.Count</div>
            </div>
        </div>

        <!-- Audited Entities -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-sky-50 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl flex-shrink-0">
                <i class="bi bi-layers"></i>
            </div>
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400" data-en="Audited Entities" data-kh="អង្គភាពសវនកម្ម">Audited Entities</div>
                <div class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">@distinctEntities.Count</div>
            </div>
        </div>
    </div>

    <!-- FILTERS & SEARCH -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm">
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
            <!-- Search -->
            <div class="sm:col-span-2 lg:col-span-5 relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@search" class="w-full pl-9 pr-4 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500 transition" placeholder="Search by email, action, details, IP..." />
            </div>

            <!-- Action Filter -->
            <div class="lg:col-span-3">
                <select name="actionFilter" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 transition">
                    <option value="">All Actions</option>
                    @foreach (var act in distinctActions)
                    {
                        <option value="@act" selected="@(act == actionFilter ? "selected" : null)">@act</option>
                    }
                </select>
            </div>

            <!-- Entity Filter -->
            <div class="lg:col-span-2">
                <select name="entityFilter" class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 transition">
                    <option value="">All Entities</option>
                    @foreach (var ent in distinctEntities)
                    {
                        <option value="@ent" selected="@(ent == entityFilter ? "selected" : null)">@ent</option>
                    }
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="sm:col-span-2 lg:col-span-2 flex items-center gap-2">
                <button type="submit" class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium transition shadow-sm" data-en="Filter" data-kh="ចម្រាញ់">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(actionFilter) || !string.IsNullOrEmpty(entityFilter))
                {
                    <a asp-action="Index" class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Clear Filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- LOGS TABLE CARD -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                        <th class="py-3.5 pl-6 pr-4" style="width: 170px;" data-en="Timestamp (UTC)" data-kh="កាលបរិច្ឆេទ (UTC)">Timestamp (UTC)</th>
                        <th class="py-3.5 px-4" style="width: 210px;" data-en="Performed By" data-kh="ធ្វើឡើងដោយ">Performed By</th>
                        <th class="py-3.5 px-4" style="width: 140px;" data-en="Action" data-kh="សកម្មភាព">Action</th>
                        <th class="py-3.5 px-4" style="width: 120px;" data-en="Entity" data-kh="អង្គភាព">Entity</th>
                        <th class="py-3.5 px-4" data-en="Details" data-kh="ព័ត៌មានលម្អិត">Details</th>
                        <th class="py-3.5 pl-4 pr-6 text-right" style="width: 130px;" data-en="IP Address" data-kh="អាសយដ្ឋាន IP">IP Address</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 text-sm">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-500 dark:text-slate-400">
                                <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-2xl text-slate-400 mb-3">
                                    <i class="bi bi-journal-x"></i>
                                </div>
                                <h5 class="text-base font-semibold text-slate-900 dark:text-white" data-en="No audit logs found" data-kh="រកមិនឃើញកំណត់ហេតុ">No audit logs found</h5>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1" data-en="Try clearing filters or check back after administrative actions occur." data-kh="សូមសម្អាតការស្វែងរក ឬពិនិត្យឡើងវិញក្រោយមានសកម្មភាព។">
                                    Try clearing filters or check back after administrative actions occur
                                </p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            var badgeClass = "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700";
                            var actionUpper = log.Action.ToUpperInvariant();
                            if (actionUpper.Contains("CREATE") || actionUpper.Contains("ADD") || actionUpper.Contains("ACTIVE"))
                            {
                                badgeClass = "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-900/50";
                            }
                            else if (actionUpper.Contains("DELETE") || actionUpper.Contains("REMOVE") || actionUpper.Contains("DEACTIVATE"))
                            {
                                badgeClass = "bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 border border-rose-200/60 dark:border-rose-900/50";
                            }
                            else if (actionUpper.Contains("RESET") || actionUpper.Contains("PASSWORD"))
                            {
                                badgeClass = "bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-900/50";
                            }
                            else if (actionUpper.Contains("EDIT") || actionUpper.Contains("UPDATE") || actionUpper.Contains("ROLE"))
                            {
                                badgeClass = "bg-primary-50 dark:bg-primary-950/40 text-primary-700 dark:text-primary-400 border border-primary-200/60 dark:border-primary-900/50";
                            }

                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                                <!-- Timestamp -->
                                <td class="py-4 pl-6 pr-4">
                                    <div class="font-semibold text-slate-800 dark:text-slate-200 text-xs">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                                    <span class="text-[11px] text-slate-400 dark:text-slate-500">
                                        @{
                                            var diff = DateTime.UtcNow - log.CreatedAt;
                                            string timeAgo = diff.TotalMinutes < 1 ? "Just now" :
                                                             diff.TotalHours < 1 ? $"{(int)diff.TotalMinutes}m ago" :
                                                             diff.TotalDays < 1 ? $"{(int)diff.TotalHours}h ago" :
                                                             $"{(int)diff.TotalDays}d ago";
                                        }
                                        @timeAgo
                                    </span>
                                </td>

                                <!-- Performed By -->
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-2.5">
                                        @{
                                            var avatarUrl = !string.IsNullOrEmpty(log.UserId) && userAvatars.ContainsKey(log.UserId) ? userAvatars[log.UserId] : null;
                                        }
                                        @if (!string.IsNullOrEmpty(avatarUrl))
                                        {
                                            <img src="@avatarUrl" alt="@log.UserEmail" class="w-7 h-7 rounded-full object-cover shadow-sm ring-1 ring-slate-200 dark:ring-slate-700 flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-7 h-7 rounded-full bg-slate-900 dark:bg-slate-700 text-white flex items-center justify-center font-bold text-[11px] flex-shrink-0">
                                                @(string.IsNullOrEmpty(log.UserEmail) ? "?" : log.UserEmail.Substring(0, 1).ToUpperInvariant())
                                            </div>
                                        }
                                        <div class="truncate max-w-[170px]">
                                            <div class="text-xs font-semibold text-slate-800 dark:text-slate-200 truncate" title="@log.UserEmail">
                                                @(string.IsNullOrEmpty(log.UserEmail) ? "System" : log.UserEmail)
                                            </div>
                                            @if (!string.IsNullOrEmpty(log.UserId))
                                            {
                                                <div class="text-[10px] text-slate-400 dark:text-slate-500 font-mono" title="@log.UserId">
                                                    ID: @(log.UserId.Length > 8 ? log.UserId.Substring(0, 8) + "..." : log.UserId)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Action -->
                                <td class="py-4 px-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold @badgeClass">
                                        @log.Action
                                    </span>
                                </td>

                                <!-- Entity -->
                                <td class="py-4 px-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700">
                                        @log.EntityName
                                    </span>
                                </td>

                                <!-- Details -->
                                <td class="py-4 px-4">
                                    <div class="text-xs text-slate-700 dark:text-slate-300 max-w-md break-words">
                                        @(string.IsNullOrEmpty(log.Description) ? "-" : log.Description)
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.EntityId))
                                    {
                                        <span class="text-[10px] text-slate-400 dark:text-slate-500 font-mono block mt-0.5">
                                            Target: @log.EntityId
                                        </span>
                                    }
                                </td>

                                <!-- IP Address -->
                                <td class="py-4 pl-4 pr-6 text-right">
                                    <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
                                        @(string.IsNullOrEmpty(log.IpAddress) ? "-" : log.IpAddress)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        @if (totalPages > 1)
        {
            <div class="border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
                <div class="text-xs text-slate-500 dark:text-slate-400">
                    Showing page <strong class="text-slate-800 dark:text-slate-200">@currentPage</strong> of <strong class="text-slate-800 dark:text-slate-200">@totalPages</strong> (Total <strong class="text-slate-800 dark:text-slate-200">@totalCount</strong> events)
                </div>
                <nav aria-label="Audit log pagination" class="flex items-center gap-1">
                    <!-- Prev -->
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-actionFilter="@actionFilter" asp-route-entityFilter="@entityFilter"
                       class="w-8 h-8 rounded-xl border border-slate-200 dark:border-slate-700 flex items-center justify-center text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition @(currentPage <= 1 ? "opacity-40 pointer-events-none" : "")">
                        <i class="bi bi-chevron-left"></i>
                    </a>

                    <!-- Pages -->
                    @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                    {
                        <a asp-action="Index" asp-route-page="@p" asp-route-search="@search" asp-route-actionFilter="@actionFilter" asp-route-entityFilter="@entityFilter"
                           class="w-8 h-8 rounded-xl flex items-center justify-center text-xs font-semibold transition @(p == currentPage ? "bg-primary-600 text-white shadow-sm" : "border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700")">
                            @p
                        </a>
                    }

                    <!-- Next -->
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-actionFilter="@actionFilter" asp-route-entityFilter="@entityFilter"
                       class="w-8 h-8 rounded-xl border border-slate-200 dark:border-slate-700 flex items-center justify-center text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition @(currentPage >= totalPages ? "opacity-40 pointer-events-none" : "")">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal: Cleanup Old Logs -->
<div class="modal fade" id="cleanupModal" tabindex="-1" aria-labelledby="cleanupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl overflow-hidden">
            <form method="post" asp-action="ClearOlderThan">
                @Html.AntiForgeryToken()
                <div class="p-6 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-2xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center text-xl flex-shrink-0">
                            <i class="bi bi-trash3-fill"></i>
                        </div>
                        <div>
                            <h5 class="text-base font-bold text-slate-900 dark:text-white">Clean Old Logs</h5>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Purge historical audit records</p>
                        </div>
                    </div>
                    <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 rounded-lg" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="p-6 space-y-4">
                    <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                        Choose the age threshold of logs you wish to purge. Recent security events will be preserved for compliance.
                    </p>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Purge entries older than:</label>
                        <select name="days" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 transition">
                            <option value="30">30 days</option>
                            <option value="60">60 days</option>
                            <option value="90">90 days</option>
                            <option value="180">180 days (6 months)</option>
                        </select>
                    </div>
                    <div class="p-3.5 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200/80 dark:border-amber-800 text-xs text-amber-800 dark:text-amber-300 flex items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-amber-500 flex-shrink-0"></i>
                        <span>This action cannot be undone.</span>
                    </div>
                </div>
                <div class="p-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 flex justify-end gap-2.5">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 transition" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white shadow-sm transition">Confirm Cleanup</button>
                </div>
            </form>
        </div>
    </div>
</div>
