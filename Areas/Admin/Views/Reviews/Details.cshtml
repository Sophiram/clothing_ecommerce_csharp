@model WebApplication_ClothingEcommerce.Models.Review

@{
    ViewData["Title"] = "Review Details";
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <div class="page-eyebrow">CUSTOMERS & SOCIAL PROOF</div>
            <h1 class="page-title">Review Details</h1>
            <p class="page-description">Customer rating breakdown and comment details.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Reviews
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm col-lg-8 mx-auto">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                @if (Model.Product?.Images?.FirstOrDefault() != null)
                {
                    <img src="@Model.Product.Images.FirstOrDefault()!.ImageUrl" alt="@Model.Product.Name" class="rounded border" style="width: 72px; height: 72px; object-fit: cover;" />
                }
                <div>
                    <h5 class="fw-bold mb-1">@Model.Product?.Name</h5>
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="small text-decoration-none">
                        View Product <i class="bi bi-box-arrow-up-right ms-1"></i>
                    </a>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label class="text-muted small text-uppercase fw-semibold">Reviewer</label>
                    <div class="fw-bold mt-1">@(Model.Customer != null ? $"{Model.Customer.FirstName} {Model.Customer.LastName}".Trim() : "Anonymous")</div>
                    <small class="text-muted">@(Model.Customer?.Email ?? "N/A")</small>
                </div>

                <div class="col-sm-6">
                    <label class="text-muted small text-uppercase fw-semibold">Rating</label>
                    <div class="text-warning fs-5 mt-1">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= Model.Rating ? "bi-star-fill" : "bi-star text-muted")"></i>
                        }
                        <span class="text-dark fw-bold ms-2">@Model.Rating out of 5</span>
                    </div>
                </div>

                <div class="col-12">
                    <label class="text-muted small text-uppercase fw-semibold">Date Submitted</label>
                    <div class="mt-1">@Model.CreatedAt.ToLocalTime().ToString("f")</div>
                </div>

                <div class="col-12">
                    <label class="text-muted small text-uppercase fw-semibold">Customer Feedback</label>
                    <div class="p-3 bg-light rounded-3 mt-1 border">
                        <p class="mb-0 fs-6">
                            @(string.IsNullOrWhiteSpace(Model.Comment) ? "No written text was provided with this star rating." : Model.Comment)
                        </p>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this review?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Delete Review
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
