@model IEnumerable<WebApplication_ClothingEcommerce.Models.ProductVariant>

@{
    ViewData["Title"] = "Product Variants";
    var selectedProductId = ViewBag.ProductId as Guid?;
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-palette me-2"></i>
                Product Variants
            </h2>

            <p class="text-muted mb-0">
                Manage product size, color, price and inventory.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Add Variant

        </a>

    </div>


    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- FILTER -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Product
                    </label>

                    <select name="productId"
                            asp-items="ViewBag.Products"
                            class="form-select">

                        <option value="">
                            All Products
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <button type="submit"
                            class="btn btn-dark w-100">

                        <i class="bi bi-filter me-1"></i>
                        Filter

                    </button>

                </div>

                <div class="col-md-3">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary w-100">

                        <i class="bi bi-x-lg me-1"></i>
                        Clear

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- TABLE -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between">

                <h5 class="fw-bold mb-0">
                    Variant List
                </h5>

                <span class="badge bg-dark">
                    @Model.Count() Variants
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>Product</th>

                                <th>SKU</th>

                                <th>Size</th>

                                <th>Color</th>

                                <th>Price</th>

                                <th>Stock</th>

                                <th>Status</th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var variant in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-semibold">
                                            @variant.Product?.Name
                                        </div>

                                    </td>


                                    <td>

                                        <code>
                                            @variant.SKU
                                        </code>

                                    </td>


                                    <td>

                                        <span class="badge bg-light text-dark border">
                                            @variant.Size?.Name
                                        </span>

                                    </td>


                                    <td>

                                        <span class="badge bg-light text-dark border">
                                            @variant.Color?.Name
                                        </span>

                                    </td>


                                    <td>

                                        <strong>
                                            $@variant.Price.ToString("N2")
                                        </strong>

                                    </td>


                                    <td>

                                        @{
                                            var stock =
                                                variant.Inventory?.Quantity ?? 0;
                                        }

                                        @if (stock > 0)
                                        {
                                            <span class="badge bg-success">
                                                @stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Out of Stock
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (variant.Status ==
                                            WebApplication_ClothingEcommerce.Data.Enums.VariantStatus.Available)
                                        {
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @variant.Status
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@variant.Id"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@variant.Id"
                                               class="btn btn-sm btn-outline-warning">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@variant.Id"
                                               class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-palette fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No variants found
                    </h5>

                    <p class="text-muted">
                        Create your first product variant.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Variant

                    </a>

                </div>
            }

        </div>

    </div>

</div>