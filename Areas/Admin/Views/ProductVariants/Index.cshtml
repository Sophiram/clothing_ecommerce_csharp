@using WebApplication_ClothingEcommerce.Data.Enums
@using WebApplication_ClothingEcommerce.Models
@model IEnumerable<ProductVariant>

@{
    ViewData["Title"] = "Product Variants";
    var allProducts = ViewBag.AllProducts as List<Product>;
    var allSizes = ViewBag.AllSizes as List<Size>;
    var allColors = ViewBag.AllColors as List<Color>;
    var statusValues = ViewBag.StatusValues as List<VariantStatus>;
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Product Variants</h1>
            <p class="page-description">Manage product size, color, price and inventory.</p>
        </div>

        <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createVariantModal">
            <i class="bi bi-plus-lg"></i> Add Variant
        </button>
    </div>

    <div id="alertPlaceholder"></div>

    <!-- FILTER -->
    <div class="admin-card mb-4">
        <div style="padding: 22px 26px;">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Product</label>
                    <select name="productId" asp-items="ViewBag.Products" class="form-select">
                        <option value="">All Products</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn-search w-100"><i class="bi bi-filter"></i> Filter</button>
                </div>
                <div class="col-md-3">
                    <a asp-action="Index" class="btn-reset w-100 d-block text-center"><i class="bi bi-x-lg"></i> Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">Variant List</h3>
                <p class="admin-card-subtitle">All configured size/color combinations</p>
            </div>
            <div class="admin-card-count">
                <span>@Model.Count()</span>
                <small>total</small>
            </div>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Size</th>
                        <th>Color</th>
                        <th>Price</th>
                        <th>Compare At</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var variant in Model)
                        {
                            var stock = variant.Inventory?.Quantity ?? 0;

                            <tr>
                                <td class="payment-name">@variant.Product?.Name</td>
                                <td><code>@variant.SKU</code></td>
                                <td><span class="tag-badge">@variant.Size?.Name</span></td>
                                <td><span class="tag-badge">@variant.Color?.Name</span></td>
                                <td><strong>$@variant.Price.ToString("N2")</strong></td>
                                <td>
                                    @if (variant.CompareAtPrice.HasValue && variant.CompareAtPrice.Value > 0)
                                    {
                                        <span class="text-decoration-line-through text-muted small">$@variant.CompareAtPrice.Value.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (stock > 0)
                                    {
                                        <span class="status-badge status-active">@stock</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-danger">Out of Stock</span>
                                    }
                                </td>
                                <td>
                                    @if (variant.Status == VariantStatus.Available)
                                    {
                                        <span class="status-badge status-active">Available</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">@variant.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@variant.Id">
                                                    <i class="bi bi-eye text-primary"></i> <span>View Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item"
                                                        data-bs-toggle="modal" data-bs-target="#editVariantModal"
                                                        data-id="@variant.Id"
                                                        data-productid="@variant.ProductId"
                                                        data-sizeid="@variant.SizeId"
                                                        data-colorid="@variant.ColorId"
                                                        data-sku="@variant.SKU"
                                                        data-price="@variant.Price"
                                                        data-compareatprice="@(variant.CompareAtPrice?.ToString() ?? "")"
                                                        data-status="@variant.Status"
                                                        data-quantity="@stock">
                                                    <i class="bi bi-pencil text-warning"></i> <span>Edit Variant</span>
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider my-1" /></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger"
                                                        data-bs-toggle="modal" data-bs-target="#deleteVariantModal"
                                                        data-id="@variant.Id"
                                                        data-sku="@variant.SKU">
                                                    <i class="bi bi-trash"></i> <span>Delete Variant</span>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-palette"></i></div>
                                    <h5>No variants found</h5>
                                    <p>Create your first product variant.</p>
                                    <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createVariantModal">
                                        <i class="bi bi-plus-lg"></i> Add Variant
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

<!-- Create Modal -->
<div class="modal fade" id="createVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="createVariantForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Variant</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="createErrors" class="admin-alert admin-alert-danger d-none"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Product</label>
                            <select name="ProductId" class="form-select" required>
                                <option value="">Select product</option>
                                @if (allProducts != null)
                                {
                                    @foreach (var p in allProducts)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Size</label>
                            <select name="SizeId" class="form-select" required>
                                <option value="">Select size</option>
                                @if (allSizes != null)
                                {
                                    @foreach (var s in allSizes)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Color</label>
                            <select name="ColorId" class="form-select" required>
                                <option value="">Select color</option>
                                @if (allColors != null)
                                {
                                    @foreach (var c in allColors)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">SKU</label>
                            <input name="SKU" class="form-control" placeholder="e.g. TS-BLK-M" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Price</label>
                            <input type="number" step="0.01" min="0" name="Price" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Compare At Price</label>
                            <input type="number" step="0.01" min="0" name="CompareAtPrice" class="form-control" placeholder="Original price (optional)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Quantity</label>
                            <input type="number" min="0" name="quantity" class="form-control" value="0" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Status</label>
                            <select name="Status" class="form-select">
                                @if (statusValues != null)
                                {
                                    @foreach (var s in statusValues)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editVariantForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Variant</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="editErrors" class="admin-alert admin-alert-danger d-none"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Product</label>
                            <select name="ProductId" id="editProductId" class="form-select" required>
                                @if (allProducts != null)
                                {
                                    @foreach (var p in allProducts)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Size</label>
                            <select name="SizeId" id="editSizeId" class="form-select" required>
                                @if (allSizes != null)
                                {
                                    @foreach (var s in allSizes)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Color</label>
                            <select name="ColorId" id="editColorId" class="form-select" required>
                                @if (allColors != null)
                                {
                                    @foreach (var c in allColors)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">SKU</label>
                            <input name="SKU" id="editSku" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Price</label>
                            <input type="number" step="0.01" min="0" name="Price" id="editPrice" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Compare At Price</label>
                            <input type="number" step="0.01" min="0" name="CompareAtPrice" id="editCompareAtPrice" class="form-control" placeholder="Original price (optional)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Quantity</label>
                            <input type="number" min="0" name="quantity" id="editQuantity" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Status</label>
                            <select name="Status" id="editStatus" class="form-select">
                                @if (statusValues != null)
                                {
                                    @foreach (var s in statusValues)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteVariantForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header">
                    <h5 class="modal-title">Delete Variant</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="deleteErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <p>Are you sure you want to delete variant <strong id="deleteSku"></strong>? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="action-btn action-danger" style="width:auto;padding:8px 18px;">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .status-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-inactive {
        background: #f3f4f6;
        color: #6b7280;
    }

    .status-danger {
        background: #fee2e2;
        color: #b91c1c;
    }

    .tag-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        font-size: 0.8rem;
    }
</style>

@section Scripts {
    <script>
        function showAlert(type, message) {
            const placeholder = document.getElementById('alertPlaceholder');
            const cls = type === 'success' ? 'admin-alert-success' : 'admin-alert-danger';
            const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
            placeholder.innerHTML = `<div class="admin-alert ${cls}"><i class="bi ${icon}"></i> ${message}</div>`;
        }

        function showErrors(boxId, errors) {
            const box = document.getElementById(boxId);
            box.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> ' + errors.join('<br />');
            box.classList.remove('d-none');
        }

        function hideErrors(boxId) {
            document.getElementById(boxId).classList.add('d-none');
        }

        async function postForm(url, form, errorBoxId) {
            hideErrors(errorBoxId);
            const formData = new FormData(form);

            const response = await fetch(url, { method: 'POST', body: formData });

            let data = {};
            try { data = await response.json(); } catch { }

            if (!response.ok) {
                showErrors(errorBoxId, data.errors || ['Something went wrong.']);
                return null;
            }
            return data;
        }

        // ---------- CREATE ----------
        document.getElementById('createVariantForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const result = await postForm('@Url.Action("Create")', this, 'createErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('createVariantModal')).hide();
                sessionStorage.setItem('variantToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // ---------- EDIT ----------
        document.getElementById('editVariantModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('editId').value = btn.getAttribute('data-id');
            document.getElementById('editProductId').value = btn.getAttribute('data-productid');
            document.getElementById('editSizeId').value = btn.getAttribute('data-sizeid');
            document.getElementById('editColorId').value = btn.getAttribute('data-colorid');
            document.getElementById('editSku').value = btn.getAttribute('data-sku');
            document.getElementById('editPrice').value = btn.getAttribute('data-price');
            document.getElementById('editCompareAtPrice').value = btn.getAttribute('data-compareatprice') || '';
            document.getElementById('editQuantity').value = btn.getAttribute('data-quantity');
            document.getElementById('editStatus').value = btn.getAttribute('data-status');
            hideErrors('editErrors');
        });

        document.getElementById('editVariantForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const result = await postForm('@Url.Action("Edit")?id=' + id, this, 'editErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editVariantModal')).hide();
                sessionStorage.setItem('variantToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // ---------- DELETE ----------
        document.getElementById('deleteVariantModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteId').value = btn.getAttribute('data-id');
            document.getElementById('deleteSku').textContent = btn.getAttribute('data-sku');
            hideErrors('deleteErrors');
        });

        document.getElementById('deleteVariantForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('deleteId').value;
            const result = await postForm('@Url.Action("Delete")/' + id, this, 'deleteErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('deleteVariantModal')).hide();
                sessionStorage.setItem('variantToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // ---------- TOAST AFTER RELOAD ----------
        document.addEventListener('DOMContentLoaded', function() {
            const raw = sessionStorage.getItem('variantToast');
            if (raw) {
                const toast = JSON.parse(raw);
                showAlert(toast.type, toast.message);
                sessionStorage.removeItem('variantToast');
            }
        });
    </script>
}