@model WebApplication_ClothingEcommerce.Models.ProductVariant

@{
    ViewData["Title"] = "Variant Details";

    var image = Model.Product?.Images?
        .FirstOrDefault(i => i.IsPrimary)
        ?? Model.Product?.Images?.FirstOrDefault();

    var quantity = Model.Inventory?.Quantity ?? 0;
    var reserved = Model.Inventory?.ReservedQuantity ?? 0;
    var available = quantity - reserved;
}

<div class="container py-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <a asp-action="Index"
               class="text-decoration-none text-muted">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Variants

            </a>

            <h2 class="fw-bold mt-3 mb-1">
                Variant Details
            </h2>

            <p class="text-muted mb-0">
                @Model.SKU
            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">

                <i class="bi bi-trash me-1"></i>
                Delete

            </a>

        </div>

    </div>


    <div class="row g-4">

        <!-- PRODUCT -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                @if (image != null)
                {
                    <img src="@image.ImageUrl"
                         class="card-img-top"
                         style="height:320px; object-fit:cover;"
                         alt="@Model.Product?.Name" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light"
                         style="height:320px;">

                        <i class="bi bi-image fs-1 text-muted"></i>

                    </div>
                }


                <div class="card-body">

                    <small class="text-muted">
                        Product
                    </small>

                    <h5 class="fw-bold mt-1">
                        @Model.Product?.Name
                    </h5>

                    <a asp-controller="Products"
                       asp-action="Details"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-outline-primary btn-sm">

                        View Product

                    </a>

                </div>

            </div>

        </div>


        <!-- VARIANT INFO -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-bold mb-0">
                        Variant Information
                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-4">


                        <div class="col-md-6">

                            <small class="text-muted">
                                SKU
                            </small>

                            <div class="fw-bold mt-1">
                                <code>@Model.SKU</code>
                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Price
                            </small>

                            <div class="fw-bold fs-4 mt-1">
                                $@Model.Price.ToString("N2")
                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Size
                            </small>

                            <div class="mt-1">

                                <span class="badge bg-light text-dark border fs-6">
                                    @Model.Size?.Name
                                </span>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Color
                            </small>

                            <div class="mt-1">

                                <span class="badge bg-light text-dark border fs-6">
                                    @Model.Color?.Name
                                </span>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted">
                                Status
                            </small>

                            <div class="mt-1">

                                @if (Model.Status ==
                                    WebApplication_ClothingEcommerce.Data.Enums.VariantStatus.Available)
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @Model.Status
                                    </span>
                                }

                            </div>

                        </div>


                    </div>

                </div>

            </div>


            <!-- INVENTORY -->

            <div class="card border-0 shadow-sm mt-4">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-bold mb-0">

                        <i class="bi bi-box-seam me-2"></i>
                        Inventory

                    </h5>

                </div>


                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Quantity
                                </small>

                                <div class="fs-3 fw-bold">
                                    @quantity
                                </div>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Reserved
                                </small>

                                <div class="fs-3 fw-bold text-warning">
                                    @reserved
                                </div>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="border rounded p-3">

                                <small class="text-muted">
                                    Available
                                </small>

                                <div class="fs-3 fw-bold text-success">
                                    @available
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>