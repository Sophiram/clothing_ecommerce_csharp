@using WebApplication_ClothingEcommerce.Data.Enums
@model WebApplication_ClothingEcommerce.Models.Product

@{
    ViewData["Title"] = "Add Product";
    var hasErrors = !ViewData.ModelState.IsValid || TempData["Error"] != null;
}

<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-200 dark:border-slate-800">
        <div>
            <div class="text-[11px] font-bold uppercase tracking-widest text-primary-600 dark:text-primary-400 mb-1">
                Catalog &bull; Products
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">Add Product</h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm mt-0.5">
                Create a new catalog product. You can configure variants and upload images after saving.
            </p>
        </div>

        <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 font-semibold text-xs shadow-xs transition self-start sm:self-auto">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>

    <!-- INLINE ALERT (IF ERROR) -->
    @if (hasErrors)
    {
        <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/60 flex items-start gap-3 text-rose-800 dark:text-rose-200 text-xs sm:text-sm shadow-xs">
            <i class="bi bi-exclamation-triangle-fill text-rose-500 text-lg shrink-0 mt-0.5"></i>
            <div class="flex-1 space-y-1">
                <div class="font-bold">Please correct the highlighted fields below:</div>
                <div asp-validation-summary="All" class="text-xs list-disc list-inside text-rose-700 dark:text-rose-300"></div>
                @if (TempData["Error"] != null)
                {
                    <div class="text-xs font-medium">@TempData["Error"]</div>
                }
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-400 hover:text-rose-600 dark:hover:text-rose-200 text-lg leading-none cursor-pointer">&times;</button>
        </div>
    }

    <!-- PRODUCT DETAILS FORM CARD -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden">
        
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-800/30 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950/60 text-primary-600 dark:text-primary-400 flex items-center justify-center font-bold text-sm">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h2 class="text-sm font-bold text-slate-900 dark:text-white">Product Information</h2>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Fill in the basic identification and categorization details</p>
                </div>
            </div>
            <span class="text-[11px] font-semibold text-rose-500 dark:text-rose-400">* Required fields</span>
        </div>

        <form asp-action="Create" method="post" class="p-6 sm:p-8 space-y-6" id="productCreateForm">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6">

                <!-- Product Name -->
                <div class="md:col-span-6 space-y-1.5">
                    <label asp-for="Name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Product Name <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="Name" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition shadow-xs" placeholder="e.g. Classic Luxury Cotton T-Shirt" />
                    <span asp-validation-for="Name" class="text-rose-500 dark:text-rose-400 text-xs font-medium block"></span>
                </div>

                <!-- Category -->
                <div class="md:col-span-3 space-y-1.5">
                    <label asp-for="CategoryId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Category <span class="text-rose-500">*</span>
                    </label>
                    <select asp-for="CategoryId" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition shadow-xs" asp-items="ViewBag.Categories">
                        <option value="">Select category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-rose-500 dark:text-rose-400 text-xs font-medium block"></span>
                </div>

                <!-- Brand -->
                <div class="md:col-span-3 space-y-1.5">
                    <label asp-for="BrandId" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Brand <span class="text-rose-500">*</span>
                    </label>
                    <select asp-for="BrandId" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition shadow-xs" asp-items="ViewBag.Brands">
                        <option value="">Select brand</option>
                    </select>
                    <span asp-validation-for="BrandId" class="text-rose-500 dark:text-rose-400 text-xs font-medium block"></span>
                </div>

                <!-- Gender -->
                <div class="md:col-span-4 space-y-1.5">
                    <label asp-for="Gender" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Target Gender
                    </label>
                    <select asp-for="Gender" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition shadow-xs">
                        <option value="">Select gender</option>
                        <option value="Men">Men</option>
                        <option value="Women">Women</option>
                        <option value="Unisex">Unisex</option>
                        <option value="Kids">Kids</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-rose-500 dark:text-rose-400 text-xs font-medium block"></span>
                </div>

                <!-- Material -->
                <div class="md:col-span-4 space-y-1.5">
                    <label asp-for="Material" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Material <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="Material" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition shadow-xs" placeholder="e.g. 100% Organic Pima Cotton" />
                    <span asp-validation-for="Material" class="text-rose-500 dark:text-rose-400 text-xs font-medium block"></span>
                </div>

                <!-- Status -->
                <div class="md:col-span-4 space-y-1.5">
                    <label asp-for="Status" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Initial Status
                    </label>
                    <select asp-for="Status" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition shadow-xs">
                        @foreach (ProductStatus status in Enum.GetValues<ProductStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <!-- Description -->
                <div class="md:col-span-12 space-y-1.5">
                    <label asp-for="Description" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Product Description
                    </label>
                    <textarea asp-for="Description" rows="4" class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition shadow-xs resize-y" placeholder="Provide a rich, detailed overview of fabric quality, fit, styling recommendations, and craftsmanship..."></textarea>
                    <span asp-validation-for="Description" class="text-rose-500 dark:text-rose-400 text-xs font-medium block"></span>
                </div>

            </div>

            <!-- FORM ACTIONS -->
            <div class="pt-6 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 font-semibold text-xs shadow-xs transition">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white font-bold text-xs shadow-md hover:shadow-lg transition flex items-center gap-2 cursor-pointer">
                    <i class="bi bi-check-lg text-base"></i> Create Product
                </button>
            </div>
        </form>
    </div>

</div>

<!-- ================================================================
     ERROR POP-UP MODAL (PURE TAILWIND)
================================================================ -->
@if (hasErrors)
{
    <div id="errorPopupModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm transition-opacity duration-300" role="dialog" aria-modal="true" aria-labelledby="errorPopupTitle">
        
        <div id="errorPopupCard" class="relative w-full max-w-md bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-rose-200 dark:border-rose-900/60 overflow-hidden transform transition-all duration-200 scale-100 opacity-100">
            
            <!-- Modal Header Accent -->
            <div class="bg-rose-50 dark:bg-rose-950/50 p-5 border-b border-rose-100 dark:border-rose-900/50 flex items-start gap-4">
                <div class="w-12 h-12 rounded-2xl bg-rose-100 dark:bg-rose-900/60 text-rose-600 dark:text-rose-400 flex items-center justify-center text-2xl shrink-0 shadow-xs">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 id="errorPopupTitle" class="text-base font-bold text-slate-900 dark:text-white">Unable to Create Product</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Please review the required details before submitting</p>
                </div>
                <button type="button" onclick="closeErrorPopup()" class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-200/60 dark:hover:bg-slate-800 transition cursor-pointer" aria-label="Close modal">
                    <i class="bi bi-x-lg text-sm"></i>
                </button>
            </div>

            <!-- Modal Body: Error List -->
            <div class="p-6 space-y-4">
                <div class="text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                    Issues Detected (@ViewData.ModelState.Values.SelectMany(v => v.Errors).Count() error(s)):
                </div>

                <div class="space-y-2 max-h-60 overflow-y-auto pr-1">
                    @foreach (var state in ViewData.ModelState)
                    {
                        @foreach (var error in state.Value.Errors)
                        {
                            <div class="p-3 rounded-xl bg-rose-50/70 dark:bg-rose-950/30 border border-rose-200/60 dark:border-rose-900/40 flex items-start gap-2.5 text-xs text-rose-800 dark:text-rose-200">
                                <i class="bi bi-exclamation-circle-fill text-rose-500 mt-0.5 shrink-0"></i>
                                <div>
                                    @if (!string.IsNullOrEmpty(state.Key))
                                    {
                                        <span class="font-bold capitalize">@state.Key:</span>
                                    }
                                    <span>@error.ErrorMessage</span>
                                </div>
                            </div>
                        }
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="p-3 rounded-xl bg-rose-50/70 dark:bg-rose-950/30 border border-rose-200/60 dark:border-rose-900/40 flex items-start gap-2.5 text-xs text-rose-800 dark:text-rose-200">
                            <i class="bi bi-info-circle-fill text-rose-500 mt-0.5 shrink-0"></i>
                            <span>@TempData["Error"]</span>
                        </div>
                    }
                </div>

                <div class="pt-2">
                    <button type="button" onclick="closeErrorPopup()" class="w-full py-3 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-md transition flex items-center justify-center gap-2 cursor-pointer">
                        <i class="bi bi-pencil-square"></i> Review & Fix Errors
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function closeErrorPopup() {
            const modal = document.getElementById('errorPopupModal');
            const card = document.getElementById('errorPopupCard');
            if (modal && card) {
                card.classList.remove('scale-100', 'opacity-100');
                card.classList.add('scale-95', 'opacity-0');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 180);
            }

            // Automatically scroll to and focus on first invalid input
            const firstInvalid = document.querySelector('.input-validation-error') || 
                                 document.querySelector('span.field-validation-error')?.previousElementSibling;
            if (firstInvalid && typeof firstInvalid.focus === 'function') {
                firstInvalid.focus();
            }
        }

        // Close on backdrop click & escape key
        document.getElementById('errorPopupModal')?.addEventListener('click', function(e) {
            if (e.target === this) closeErrorPopup();
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeErrorPopup();
        });
    </script>
}
