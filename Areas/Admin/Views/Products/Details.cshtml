@using WebApplication_ClothingEcommerce.Data.Enums
@using WebApplication_ClothingEcommerce.Models
@model Product

@{
    ViewData["Title"] = "Product Details";

    var totalStock = Model.Variants.Sum(v => v.Inventory?.AvailableQuantity ?? 0);
    var avgRating = Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0;

    var allSizes = ViewBag.AllSizes as List<Size>;
    var allColors = ViewBag.AllColors as List<Color>;
    var statusValues = ViewBag.StatusValues as List<VariantStatus>;
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">@Model.Name</h1>
            <p class="page-description">Full product overview, variants, and reviews.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary-custom">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn-reset">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>


    <div class="row g-4">

        <!-- LEFT: OVERVIEW / IMAGES / VARIANTS -->
        <div class="col-lg-8">

            <!-- OVERVIEW -->
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">Overview</h3>
                </div>
                <div style="padding: 0 26px 26px;">

                    <div class="row g-3">
                        <div class="col-md-3">
                            <span class="page-eyebrow">Category</span>
                            <div class="payment-name">@(Model.Category?.Name ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <span class="page-eyebrow">Brand</span>
                            <div class="payment-name">@(Model.Brand?.Name ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <span class="page-eyebrow">Gender</span>
                            <div class="payment-name">@Model.Gender</div>
                        </div>
                        <div class="col-md-3">
                            <span class="page-eyebrow">Status</span>
                            @if (Model.Status == ProductStatus.Active)
                            {
                                <span class="status-pill status-active"><span class="status-dot"></span> Active</span>
                            }
                            else
                            {
                                <span class="status-pill status-disabled"><span class="status-dot"></span> @Model.Status</span>
                            }
                        </div>
                        <div class="col-md-3">
                            <span class="page-eyebrow">Material</span>
                            <div class="payment-name">@(string.IsNullOrWhiteSpace(Model.Material) ? "—" : Model.Material)</div>
                        </div>
                        <div class="col-md-3">
                            <span class="page-eyebrow">Total Stock</span>
                            <div class="payment-name">@totalStock units</div>
                        </div>
                        <div class="col-md-3">
                            <span class="page-eyebrow">Rating</span>
                            <div class="payment-name">@avgRating.ToString("0.0") / 5 (@Model.Reviews.Count)</div>
                        </div>
                        <div class="col-md-3">
                            <span class="page-eyebrow">Created</span>
                            <div class="payment-name">@Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <hr class="my-3" />
                        <span class="page-eyebrow">Description</span>
                        <p class="text-secondary mb-0 mt-2">@Model.Description</p>
                    }

                </div>
            </div>

            <!-- IMAGES -->
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">Images (@Model.Images.Count)</h3>
                    <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addImageModal">
                        <i class="bi bi-plus-lg"></i> Add Image
                    </button>
                </div>
                <div style="padding: 0 26px 26px;">


                    @if (Model.Images.Any())
                    {
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var img in Model.Images)
                            {
                                <div class="product-image-tile">
                                    <img src="@img.ImageUrl" class="product-image-thumb" alt="" />

                                    @if (img.IsPrimary)
                                    {
                                        <span class="status-pill status-active product-image-primary-tag">Primary</span>
                                    }

                                    <div class="product-image-actions">
                                        <button type="button" class="action-btn action-warning" title="Edit"
                                                data-bs-toggle="modal" data-bs-target="#editImageModal"
                                                data-id="@img.Id"
                                                data-url="@img.ImageUrl"
                                                data-primary="@img.IsPrimary.ToString().ToLower()">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="action-btn action-danger" title="Delete"
                                                data-bs-toggle="modal" data-bs-target="#deleteImageModal"
                                                data-id="@img.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">No images uploaded yet.</p>
                    }
                </div>
            </div>

            <!-- VARIANTS -->
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">Variants (@Model.Variants.Count)</h3>
                    <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addVariantModal">
                        <i class="bi bi-plus-lg"></i> Add Variant
                    </button>
                </div>

                <div style="padding: 16px 26px 0;">

                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Size</th>
                                <th>Color</th>
                                <th>SKU</th>
                                <th>Price</th>
                                <th>Compare At</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Variants.Any())
                            {
                                @foreach (var v in Model.Variants)
                                {
                                    var stock = v.Inventory?.Quantity ?? 0;

                                    <tr>
                                        <td>@(v.Size?.Name ?? "—")</td>
                                        <td>@(v.Color?.Name ?? "—")</td>
                                        <td><code>@v.SKU</code></td>
                                        <td><strong>$@v.Price.ToString("0.00")</strong></td>
                                        <td>
                                            @if (v.CompareAtPrice.HasValue && v.CompareAtPrice.Value > 0)
                                            {
                                                <span class="text-decoration-line-through text-muted small">$@v.CompareAtPrice.Value.ToString("0.00")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td>@stock</td>
                                        <td>
                                            @if (v.Status == VariantStatus.Available)
                                            {
                                                <span class="status-pill status-active"><span class="status-dot"></span> Available</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-disabled"><span class="status-dot"></span> @v.Status</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="table-actions">
                                                <button type="button" class="action-btn action-warning" title="Edit"
                                                        data-bs-toggle="modal" data-bs-target="#editVariantModal"
                                                        data-id="@v.Id"
                                                        data-sizeid="@v.SizeId"
                                                        data-colorid="@v.ColorId"
                                                        data-sku="@v.SKU"
                                                        data-price="@v.Price"
                                                        data-compareatprice="@(v.CompareAtPrice?.ToString() ?? "")"
                                                        data-status="@v.Status"
                                                        data-quantity="@stock">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button type="button" class="action-btn action-danger" title="Delete"
                                                        data-bs-toggle="modal" data-bs-target="#deleteVariantModal"
                                                        data-id="@v.Id"
                                                        data-sku="@v.SKU">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center text-secondary py-3">No variants added yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- RIGHT: REVIEWS -->
        <div class="col-lg-4">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title">Reviews (@Model.Reviews.Count)</h3>
                </div>
                <div style="padding: 0 26px 26px;">
                    @if (Model.Reviews.Any())
                    {
                        @foreach (var r in Model.Reviews.OrderByDescending(x => x.CreatedAt).Take(10))
                        {
                            <div class="mb-3 pb-3" style="border-bottom: 1px solid var(--admin-border);">
                                <div class="d-flex justify-content-between">
                                    <strong style="font-size:12px;">@(r.Customer?.FirstName ?? "Customer")</strong>
                                    <span style="color: var(--google-yellow-dark); font-size:11px;">
                                        @string.Concat(Enumerable.Repeat("★", r.Rating))@string.Concat(Enumerable.Repeat("☆", 5 - r.Rating))
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(r.Comment))
                                {
                                    <p class="text-secondary mb-0 mt-1" style="font-size:12px;">@r.Comment</p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-secondary mb-0">No reviews yet.</p>
                    }
                </div>
            </div>
        </div>

    </div>

</div>

<!-- =====================================================
     IMAGE MODALS
====================================================== -->

<div class="modal fade" id="addImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addImageForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProductId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Add Image</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="addImageErrors" class="admin-alert admin-alert-danger d-none"></div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold" style="font-size: 11px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--admin-text-light);">IMAGE SOURCE</label>
                        <div class="d-flex p-1 bg-light rounded-3">
                            <ul class="nav nav-pills nav-fill w-100" id="imageSourceTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active fw-medium py-2 rounded-2" id="upload-tab" data-bs-toggle="pill" data-bs-target="#upload-pane" type="button" role="tab" aria-selected="true" style="font-size: 13px;">
                                        <i class="bi bi-cloud-arrow-up me-1"></i> Upload from Local
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link fw-medium py-2 rounded-2" id="url-tab" data-bs-toggle="pill" data-bs-target="#url-pane" type="button" role="tab" aria-selected="false" style="font-size: 13px;">
                                        <i class="bi bi-link-45deg me-1"></i> Paste Image URL
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="tab-content mb-4" id="imageSourceTabContent">
                        <div class="tab-pane fade show active" id="upload-pane" role="tabpanel" tabindex="0">
                            <div>
                                <label class="form-label fw-semibold">Local Image File</label>
                                <input type="file" name="ImageFile" id="addImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                            </div>
                        </div>
                        <div class="tab-pane fade" id="url-pane" role="tabpanel" tabindex="0">
                            <div>
                                <label class="form-label fw-semibold">Image URL</label>
                                <input name="ImageUrl" id="addImageUrl" class="form-control" placeholder="https://..." />
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-4 text-center">
                        <img id="addImagePreview" src="" class="product-image-preview d-none" style="max-height: 180px;" alt="Image Preview" />
                        <div id="addImagePlaceholder" class="p-4 border rounded-3 bg-light text-muted d-flex flex-column align-items-center justify-content-center" style="min-height: 180px; border-style: dashed !important; border-color: #dee2e6 !important;">
                            <i class="bi bi-image fs-1 mb-2" style="color: #adb5bd;"></i>
                            <span class="small" style="color: #6c757d;">Image Preview</span>
                        </div>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsPrimary" id="addIsPrimary" value="true" />
                        <label class="form-check-label" for="addIsPrimary">Set as primary image</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom">
                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                        <i class="bi bi-check-lg"></i> Add Image
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editImageForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editImageId" />
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Image</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="editImageErrors" class="admin-alert admin-alert-danger d-none"></div>

                    <img id="editImagePreview" src="" class="product-image-preview mb-3" alt="" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Image URL</label>
                        <input name="imageUrl" id="editImageUrl" class="form-control" required />
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isPrimary" id="editIsPrimary" value="true" />
                        <label class="form-check-label" for="editIsPrimary">Set as primary image</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom">
                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                        <i class="bi bi-check-lg"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteImageForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteImageId" />
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Delete Image</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="deleteImageErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <p>Are you sure you want to delete this image? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="action-btn action-danger" style="width:auto;padding:8px 18px;">
                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =====================================================
     VARIANT MODALS
====================================================== -->

<div class="modal fade" id="addVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="addVariantForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProductId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Add Variant</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="addVariantErrors" class="admin-alert admin-alert-danger d-none"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Size</label>
                            <select name="SizeId" class="form-select" required>
                                <option value="">Select size</option>
                                @if (allSizes != null)
                                {
                                    @foreach (var s in allSizes)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Color</label>
                            <select name="ColorId" class="form-select" required>
                                <option value="">Select color</option>
                                @if (allColors != null)
                                {
                                    @foreach (var c in allColors)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">SKU</label>
                            <input name="SKU" class="form-control" placeholder="e.g. TS-BLK-M" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Price</label>
                            <input type="number" step="0.01" min="0" name="Price" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Compare At Price</label>
                            <input type="number" step="0.01" min="0" name="CompareAtPrice" class="form-control" placeholder="Original price (optional)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Quantity</label>
                            <input type="number" min="0" name="quantity" class="form-control" value="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Status</label>
                            <select name="Status" class="form-select">
                                @if (statusValues != null)
                                {
                                    @foreach (var s in statusValues)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom">
                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                        <i class="bi bi-check-lg"></i> Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

