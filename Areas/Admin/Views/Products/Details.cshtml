                        <i class="bi bi-check-lg"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteVariantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteVariantForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteVariantId" />
                <div class="modal-header">
                    <h5 class="modal-title">Delete Variant</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="deleteVariantErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <p>Are you sure you want to delete variant <strong id="deleteVariantSku"></strong>? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="action-btn action-danger" style="width:auto;padding:8px 18px;">
                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .product-image-tile {
        position: relative;
        width: 100px;
        height: 100px;
    }

    .product-image-thumb {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid var(--admin-border);
    }

    .product-image-primary-tag {
        position: absolute;
        top: 6px;
        left: 6px;
        font-size: 8px;
    }

    .product-image-actions {
        position: absolute;
        bottom: 4px;
        right: 4px;
        display: flex;
        gap: 4px;
        opacity: 0;
        transition: opacity 0.15s;
    }

    .product-image-tile:hover .product-image-actions {
        opacity: 1;
    }

    .product-image-preview {
        width: 100%;
        max-height: 200px;
        object-fit: contain;
        border-radius: 12px;
        border: 1px solid var(--admin-border);
        background: #f8f9fa;
    }

    .btn-primary-custom .spinner-border,
    .action-btn.action-danger .spinner-border {
        margin-right: 6px;
    }
</style>

@section Scripts {
    <script>
        // =========================================================
        // SHARED HELPERS
        // =========================================================

        function showFieldErrors(boxId, errors) {
            const box = document.getElementById(boxId);
            box.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> ' + errors.join('<br />');
            box.classList.remove('d-none');
        }

        function hideFieldErrors(boxId) {
            document.getElementById(boxId).classList.add('d-none');
        }

        function setSubmitting(form, isSubmitting) {
            const btn = form.querySelector('button[type="submit"]');
            const spinner = btn?.querySelector('.spinner-border');
            if (!btn) return;
            btn.disabled = isSubmitting;
            spinner?.classList.toggle('d-none', !isSubmitting);
        }

        async function postJsonForm(url, form, errorBoxId) {
            hideFieldErrors(errorBoxId);
            setSubmitting(form, true);

            try {
                const formData = new FormData(form);
                const response = await fetch(url, { method: 'POST', body: formData });

                let data = {};
                try { data = await response.json(); } catch { }

                if (!response.ok) {
                    showFieldErrors(errorBoxId, data.errors || ['Something went wrong.']);
                    return null;
                }
                return data;
            } finally {
                setSubmitting(form, false);
            }
        }

        function reloadWithToast(storageKey, message) {
            sessionStorage.setItem(storageKey, JSON.stringify({ type: 'success', message }));
            location.reload();
        }

        function showToastFromStorage(storageKey) {
            const raw = sessionStorage.getItem(storageKey);
            if (!raw) return;
            const toast = JSON.parse(raw);
            if (typeof window.showToast === 'function') {
                window.showToast(toast.type, toast.message);
            }
            sessionStorage.removeItem(storageKey);
        }

        // Call on load
        document.addEventListener('DOMContentLoaded', () => {
            showToastFromStorage('imageToast');
            showToastFromStorage('variantToast');
        });

        // =========================================================
        // IMAGES
        // =========================================================

        const addImageFile = document.getElementById('addImageFile');
        const addImageUrl = document.getElementById('addImageUrl');
        const addImagePreview = document.getElementById('addImagePreview');
        const addImagePlaceholder = document.getElementById('addImagePlaceholder');

        function updateAddPreview(src) {
            if (src) {
                addImagePreview.src = src;
                addImagePreview.classList.remove('d-none');
                addImagePlaceholder.classList.add('d-none');
            } else {
                addImagePreview.src = '';
                addImagePreview.classList.add('d-none');
                addImagePlaceholder.classList.remove('d-none');
            }
        }

        if (addImageFile) {
            addImageFile.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(e) { updateAddPreview(e.target.result); };
                    reader.readAsDataURL(this.files[0]);
                } else {
                    updateAddPreview('');
                }
            });
        }

        if (addImageUrl) {
            addImageUrl.addEventListener('input', function() {
                updateAddPreview(this.value.trim());
            });
        }

        if (addImagePreview) {
            addImagePreview.addEventListener('error', function() {
                updateAddPreview('');
                if (addImageUrl && addImageUrl.value.trim() !== '') {
                    window.showToast('error', 'Failed to load image from URL.');
                }
            });
        }

        const uploadTab = document.getElementById('upload-tab');
        const urlTab = document.getElementById('url-tab');

        if (uploadTab) {
            uploadTab.addEventListener('shown.bs.tab', function () {
                if (addImageUrl) addImageUrl.value = '';
                updateAddPreview(addImageFile && addImageFile.files && addImageFile.files[0] ? URL.createObjectURL(addImageFile.files[0]) : '');
            });
        }
        if (urlTab) {
            urlTab.addEventListener('shown.bs.tab', function () {
                if (addImageFile) addImageFile.value = '';
                updateAddPreview(addImageUrl ? addImageUrl.value.trim() : '');
            });
        }

        const addImageModalEl = document.getElementById('addImageModal');
        addImageModalEl.addEventListener('hidden.bs.modal', function() {
            document.getElementById('addImageForm').reset();
            hideFieldErrors('addImageErrors');
            updateAddPreview('');
            if (uploadTab) {
                const tab = new bootstrap.Tab(uploadTab);
                tab.show();
            }
        });

        document.getElementById('addImageForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const result = await postJsonForm('@Url.Action("Create", "ProductImages")', this, 'addImageErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(addImageModalEl).hide();
                reloadWithToast('imageToast', result.message);
            }
        });

        document.getElementById('editImageModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            const url = btn.getAttribute('data-url');
            document.getElementById('editImageId').value = btn.getAttribute('data-id');
            document.getElementById('editImageUrl').value = url;
            document.getElementById('editImagePreview').src = url;
            document.getElementById('editIsPrimary').checked = btn.getAttribute('data-primary') === 'true';
            hideFieldErrors('editImageErrors');
        });

        document.getElementById('editImageForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const result = await postJsonForm('@Url.Action("Edit", "ProductImages")', this, 'editImageErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editImageModal')).hide();
                reloadWithToast('imageToast', result.message);
            }
        });

        document.getElementById('deleteImageModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteImageId').value = btn.getAttribute('data-id');
            hideFieldErrors('deleteImageErrors');
        });

        document.getElementById('deleteImageForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const result = await postJsonForm('@Url.Action("Delete", "ProductImages")', this, 'deleteImageErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('deleteImageModal')).hide();
                reloadWithToast('imageToast', result.message);
            }
        });

        // =========================================================
        // VARIANTS
        // =========================================================

        const addVariantModalEl = document.getElementById('addVariantModal');
        addVariantModalEl.addEventListener('hidden.bs.modal', function() {
            document.getElementById('addVariantForm').reset();
            hideFieldErrors('addVariantErrors');
        });

        document.getElementById('addVariantForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const result = await postJsonForm('@Url.Action("Create", "ProductVariants")', this, 'addVariantErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(addVariantModalEl).hide();
                reloadWithToast('variantToast', result.message);
            }
        });

        document.getElementById('editVariantModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('editVariantId').value = btn.getAttribute('data-id');
            document.getElementById('editVariantSizeId').value = btn.getAttribute('data-sizeid');
            document.getElementById('editVariantColorId').value = btn.getAttribute('data-colorid');
            document.getElementById('editVariantSku').value = btn.getAttribute('data-sku');
            document.getElementById('editVariantPrice').value = btn.getAttribute('data-price');
            document.getElementById('editVariantCompareAtPrice').value = btn.getAttribute('data-compareatprice') || '';
            document.getElementById('editVariantQuantity').value = btn.getAttribute('data-quantity');
            document.getElementById('editVariantStatus').value = btn.getAttribute('data-status');
            hideFieldErrors('editVariantErrors');
        });

        document.getElementById('editVariantForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editVariantId').value;
            const result = await postJsonForm('@Url.Action("Edit", "ProductVariants")?id=' + id, this, 'editVariantErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editVariantModal')).hide();
                reloadWithToast('variantToast', result.message);
            }
        });

        document.getElementById('deleteVariantModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteVariantId').value = btn.getAttribute('data-id');
            document.getElementById('deleteVariantSku').textContent = btn.getAttribute('data-sku');
            hideFieldErrors('deleteVariantErrors');
        });

        document.getElementById('deleteVariantForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('deleteVariantId').value;
            const result = await postJsonForm('@Url.Action("Delete", "ProductVariants")/' + id, this, 'deleteVariantErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('deleteVariantModal')).hide();
                reloadWithToast('variantToast', result.message);
            }
        });

    </script>
}