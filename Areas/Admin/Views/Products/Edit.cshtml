@using WebApplication_ClothingEcommerce.Data.Enums
@model WebApplication_ClothingEcommerce.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Edit Product</h1>
            <p class="page-description">Update details for "@Model.Name".</p>
        </div>

        <a asp-action="Index" class="btn-reset">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="admin-alert admin-alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">Product Details</h3>
                <p class="admin-card-subtitle">Update the information below</p>
            </div>
        </div>

        <div style="padding: 26px;">

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">Product Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="BrandId" class="form-label fw-semibold">Brand</label>
                        <select asp-for="BrandId" class="form-select" asp-items="ViewBag.Brands"></select>
                        <span asp-validation-for="BrandId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label fw-semibold">Gender</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="Men">Men</option>
                            <option value="Women">Women</option>
                            <option value="Unisex">Unisex</option>
                            <option value="Kids">Kids</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Material" class="form-label fw-semibold">Material</label>
                        <input asp-for="Material" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            @foreach (ProductStatus status in Enum.GetValues<ProductStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn-reset">Cancel</a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}