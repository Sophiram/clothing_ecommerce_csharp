@using WebApplication_ClothingEcommerce.Data.Enums
@model IEnumerable<WebApplication_ClothingEcommerce.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-box-seam me-2"></i>
                Products
            </h2>

            <p class="text-muted mb-0">
                Manage your clothing products
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Product
        </a>

    </div>


    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- FILTER -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- SEARCH -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="Search product..." />

                        </div>

                    </div>


                    <!-- CATEGORY -->

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            Category
                        </label>

                        <select name="categoryId"
                                class="form-select"
                                asp-items="ViewBag.Categories">

                            <option value="">
                                All Categories
                            </option>

                        </select>

                    </div>


                    <!-- BRAND -->

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            Brand
                        </label>

                        <select name="brandId"
                                class="form-select"
                                asp-items="ViewBag.Brands">

                            <option value="">
                                All Brands
                            </option>

                        </select>

                    </div>


                    <!-- STATUS -->

                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            @foreach (ProductStatus status in Enum.GetValues<ProductStatus>())
                            {
                                if (ViewBag.Status != null &&
                                    (ProductStatus)ViewBag.Status == status)
                                {
                                    <option value="@status" selected>
                                        @status
                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @status
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- BUTTON -->

                    <div class="col-md-2 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-dark w-100">

                            <i class="bi bi-funnel me-1"></i>
                            Filter

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- PRODUCTS TABLE -->

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width: 90px;">
                                Image
                            </th>

                            <th>
                                Product
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Brand
                            </th>

                            <th>
                                Gender
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Variants
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var product in Model)
                            {
                                var primaryImage =
                                    product.Images
                                        .FirstOrDefault(i => i.IsPrimary)
                                    ?? product.Images.FirstOrDefault();

                                <tr>

                                    <!-- IMAGE -->

                                    <td>

                                        @if (primaryImage != null &&
                                             !string.IsNullOrWhiteSpace(primaryImage.ImageUrl))
                                        {
                                            <img src="@primaryImage.ImageUrl"
                                                 alt="@product.Name"
                                                 class="rounded"
                                                 style="
                                            width:65px;
                                            height:65px;
                                            object-fit:cover;
                                            " />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex
                                                align-items-center
                                                justify-content-center"
                                                 style="
                                                width:65px;
                                                height:65px;
                                                ">

                                                <i class="bi bi-image text-muted fs-4"></i>

                                            </div>
                                        }

                                    </td>


                                    <!-- PRODUCT -->

                                    <td>

                                        <div class="fw-semibold">
                                            @product.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(product.Description))
                                        {
                                            <small class="text-muted">
                                                @(product.Description.Length > 70
                                                    ? product.Description.Substring(0, 70) + "..."
                                                    : product.Description)
                                            </small>
                                        }

                                    </td>


                                    <!-- CATEGORY -->

                                    <td>

                                        @if (product.Category != null)
                                        {
                                            <span class="badge bg-light text-dark">
                                                @product.Category.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- BRAND -->

                                    <td>

                                        @if (product.Brand != null)
                                        {
                                            @product.Brand.Name
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>


                                    <!-- GENDER -->

                                    <td>
                                        @product.Gender
                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (product.Status == ProductStatus.Active)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @product.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- VARIANTS -->

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @product.Variants.Count
                                        </span>
                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-end">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Details">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5">

                                    <i class="bi bi-box-seam fs-1 text-muted"></i>

                                    <h5 class="mt-3">
                                        No products found
                                    </h5>

                                    <p class="text-muted">
                                        Start by creating your first product.
                                    </p>

                                    <a asp-action="Create"
                                       class="btn btn-primary">

                                        <i class="bi bi-plus-lg me-1"></i>
                                        Add Product

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>