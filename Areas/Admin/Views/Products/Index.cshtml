@using WebApplication_ClothingEcommerce.Data.Enums
@model IEnumerable<WebApplication_ClothingEcommerce.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="admin-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Products</h1>
            <p class="page-description">Manage your clothing products, pricing, and availability.</p>
        </div>

        <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createProductModal">
            <i class="bi bi-plus-lg"></i>
            Add Product
        </button>
    </div>

    <!-- MAIN CARD -->
    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">All Products</h3>
                <p class="admin-card-subtitle">Filter and manage your product catalog</p>
            </div>
            <div class="admin-card-count">
                <span>@Model.Count()</span>
                <small>total</small>
            </div>
        </div>

        <!-- FILTER -->
        <div class="search-wrapper">
            <form asp-action="Index" method="get" class="search-form flex-wrap">

                <div class="search-input-wrapper" style="flex: 2; min-width: 220px;">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="search-input"
                           placeholder="Search product name or description..." />
                </div>

                <select name="categoryId" class="search-input" style="flex: 1; min-width: 160px;" asp-items="ViewBag.Categories">
                    <option value="">All Categories</option>
                </select>

                <select name="brandId" class="search-input" style="flex: 1; min-width: 160px;" asp-items="ViewBag.Brands">
                    <option value="">All Brands</option>
                </select>

                <select name="status" class="search-input" style="flex: 1; min-width: 140px;">
                    <option value="">All Status</option>
                    @foreach (ProductStatus status in Enum.GetValues<ProductStatus>())
                    {
                        <option value="@status" selected="@(ViewBag.Status != null && (ProductStatus)ViewBag.Status == status)">
                            @status
                        </option>
                    }
                </select>

                <button type="submit" class="btn-search">
                    <i class="bi bi-funnel"></i> Filter
                </button>

                <a asp-action="Index" class="btn-reset">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </a>

            </form>
        </div>

        <!-- TABLE -->
        <div class="table-responsive">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th style="width: 80px;">Image</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Brand</th>
                        <th>Gender</th>
                        <th>Status</th>
                        <th>Variants</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            var primaryImage =
                                product.Images.FirstOrDefault(i => i.IsPrimary)
                                ?? product.Images.FirstOrDefault();

                            <tr>

                                <!-- IMAGE -->
                                <td>
                                    @if (primaryImage != null && !string.IsNullOrWhiteSpace(primaryImage.ImageUrl))
                                    {
                                        <img src="@primaryImage.ImageUrl"
                                             alt="@product.Name"
                                             style="width:52px;height:52px;object-fit:cover;border-radius:10px;border:1px solid var(--admin-border);" />
                                    }
                                    else
                                    {
                                        <div style="width:52px;height:52px;border-radius:10px;background:var(--admin-bg);display:flex;align-items:center;justify-content:center;color:#c2c8d6;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>

                                <!-- PRODUCT -->
                                <td>
                                    <div class="payment-name">@product.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(product.Description))
                                    {
                                        <span class="description-text">
                                            @(product.Description.Length > 60
                                                ? product.Description.Substring(0, 60) + "..."
                                                : product.Description)
                                        </span>
                                    }
                                </td>

                                <!-- CATEGORY -->
                                <td>
                                    @if (product.Category != null)
                                    {
                                        <span class="payment-count">@product.Category.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </td>

                                <!-- BRAND -->
                                <td>
                                    @(product.Brand?.Name ?? "—")
                                </td>

                                <!-- GENDER -->
                                <td>@product.Gender</td>

                                <!-- STATUS -->
                                <td>
                                    @if (product.Status == ProductStatus.Active)
                                    {
                                        <span class="status-pill status-active">
                                            <span class="status-dot"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-disabled">
                                            <span class="status-dot"></span> @product.Status
                                        </span>
                                    }
                                </td>

                                <!-- VARIANTS -->
                                <td>
                                    <span class="payment-count">@product.Variants.Count</span>
                                </td>

                                <!-- ACTIONS -->
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@product.Id">
                                                    <i class="bi bi-eye text-primary"></i> <span>View Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item edit-btn" href="javascript:void(0)"
                                                   data-id="@product.Id"
                                                   data-name="@product.Name"
                                                   data-category="@product.CategoryId"
                                                   data-brand="@product.BrandId"
                                                   data-gender="@product.Gender"
                                                   data-material="@product.Material"
                                                   data-status="@product.Status"
                                                   data-description="@product.Description">
                                                    <i class="bi bi-pencil text-warning"></i> <span>Edit Product</span>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider my-1" /></li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="javascript:void(0)" onclick="confirmDelete('@product.Id', this.dataset.name)" data-name="@product.Name">
                                                    <i class="bi bi-trash"></i> <span>Delete Product</span>
                                                </a>
                                                <form id="deleteForm-@product.Id" asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-none">
                                                    @Html.AntiForgeryToken()
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <h5>No products found</h5>
                                    <p>Start by creating your first product, or adjust your filters.</p>
                                    <a asp-action="Create" class="btn-primary-custom">
                                        <i class="bi bi-plus-lg"></i> Add Product
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- =====================================================
     CREATE MODAL
====================================================== -->
<div class="modal fade" id="createProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Product Name</label>
                            <input name="Name" class="form-control" placeholder="e.g. Classic Cotton T-Shirt" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                                <option value="">Select category</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Brand</label>
                            <select name="BrandId" class="form-select" asp-items="ViewBag.Brands" required>
                                <option value="">Select brand</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Gender</label>
                            <select name="Gender" class="form-select" required>
                                <option value="">Select gender</option>
                                <option value="Men">Men</option>
                                <option value="Women">Women</option>
                                <option value="Unisex">Unisex</option>
                                <option value="Kids">Kids</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Material</label>
                            <input name="Material" class="form-control" placeholder="e.g. 100% Cotton" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select name="Status" class="form-select">
                                @foreach (ProductStatus status in Enum.GetValues<ProductStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="Description" class="form-control" rows="4" placeholder="Describe the product..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-check-lg"></i> Create Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =====================================================
     EDIT MODAL
====================================================== -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editProductForm" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editProductId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Product Name</label>
                            <input name="Name" id="editProductName" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="CategoryId" id="editProductCategory" class="form-select" asp-items="ViewBag.Categories" required></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Brand</label>
                            <select name="BrandId" id="editProductBrand" class="form-select" asp-items="ViewBag.Brands" required></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Gender</label>
                            <select name="Gender" id="editProductGender" class="form-select" required>
                                <option value="Men">Men</option>
                                <option value="Women">Women</option>
                                <option value="Unisex">Unisex</option>
                                <option value="Kids">Kids</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Material</label>
                            <input name="Material" id="editProductMaterial" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select name="Status" id="editProductStatus" class="form-select">
                                @foreach (ProductStatus status in Enum.GetValues<ProductStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="Description" id="editProductDescription" class="form-control" rows="4"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // DELETE
        function confirmDelete(id, name) {
            Swal.fire({
                title: 'Delete Product?',
                text: `Are you sure you want to delete "${name}"? This cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ea4335',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm-' + id).submit();
                }
            });
        }

        // EDIT
        document.addEventListener('DOMContentLoaded', () => {
            const editButtons = document.querySelectorAll('.edit-btn');
            const editModalEl = document.getElementById('editProductModal');
            let editModal = null;
            if (editModalEl) {
                editModal = new bootstrap.Modal(editModalEl);
            }

            editButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const data = btn.dataset;
                    
                    document.getElementById('editProductId').value = data.id;
                    document.getElementById('editProductName').value = data.name;
                    document.getElementById('editProductCategory').value = data.category;
                    document.getElementById('editProductBrand').value = data.brand;
                    document.getElementById('editProductGender').value = data.gender;
                    document.getElementById('editProductMaterial').value = data.material || '';
                    document.getElementById('editProductStatus').value = data.status;
                    document.getElementById('editProductDescription').value = data.description || '';
                    
                    // Update form action with ID (if needed, though hidden field is usually enough for POST)
                    document.getElementById('editProductForm').action = '@Url.Action("Edit", "Products")/' + data.id;

                    editModal.show();
                });
            });
        });
    </script>
}