@model WebApplication_ClothingEcommerce.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <div class="text-danger mb-3">

                            <i class="bi bi-exclamation-triangle-fill fs-1"></i>

                        </div>

                        <h3 class="fw-bold">
                            Delete Product?
                        </h3>

                        <p class="text-muted">
                            This action cannot be undone.
                        </p>

                    </div>


                    <!-- PRODUCT -->

                    <div class="border rounded p-3 mb-4">

                        <div class="d-flex align-items-center">

                            @{
                                var image = Model.Images
                                    .FirstOrDefault(i => i.IsPrimary)
                                    ?? Model.Images.FirstOrDefault();
                            }

                            @if (image != null)
                            {
                                <img src="@image.ImageUrl"
                                     alt="@Model.Name"
                                     class="rounded me-3"
                                     style="
                                width:90px;
                                height:90px;
                                object-fit:cover;
                                " />
                            }
                            else
                            {
                                <div class="bg-light rounded me-3
                                    d-flex align-items-center
                                    justify-content-center"
                                     style="
                                    width:90px;
                                    height:90px;
                                    ">

                                    <i class="bi bi-image fs-2 text-muted"></i>

                                </div>
                            }


                            <div>

                                <h5 class="fw-bold mb-1">
                                    @Model.Name
                                </h5>

                                <div class="text-muted">
                                    @(Model.Brand?.Name ?? "-")
                                    ·
                                    @(Model.Category?.Name ?? "-")
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- WARNING -->

                    <div class="alert alert-danger">

                        <i class="bi bi-info-circle me-2"></i>

                        Deleting this product may also delete
                        its related images and variants,
                        depending on your database relationships.

                    </div>


                    <!-- FORM -->

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger flex-fill">

                                <i class="bi bi-trash me-1"></i>
                                Yes, Delete

                            </button>

                            <a asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary flex-fill">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>