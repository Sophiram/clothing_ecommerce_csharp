@model WebApplication_ClothingEcommerce.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Delete Product</h1>
            <p class="page-description">This action cannot be undone. Please confirm.</p>
        </div>
    </div>

    <div class="admin-card" style="max-width: 640px;">
        <div style="padding: 30px;">

            <div class="admin-alert admin-alert-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill"></i>
                You are about to permanently delete this product and cannot recover it.
            </div>

            <div class="d-flex gap-3 align-items-center mb-4">
                @{
                    var image = Model.Images.FirstOrDefault(i => i.IsPrimary) ?? Model.Images.FirstOrDefault();
                }
                @if (image != null && !string.IsNullOrWhiteSpace(image.ImageUrl))
                {
                    <img src="@image.ImageUrl" style="width:70px;height:70px;object-fit:cover;border-radius:12px;border:1px solid var(--admin-border);" />
                }
                else
                {
                    <div style="width:70px;height:70px;border-radius:12px;background:var(--admin-bg);display:flex;align-items:center;justify-content:center;color:#c2c8d6;">
                        <i class="bi bi-image fs-4"></i>
                    </div>
                }
                <div>
                    <div class="payment-name" style="font-size:15px;">@Model.Name</div>
                    <div class="text-secondary" style="font-size:12px;">
                        @(Model.Category?.Name ?? "—") · @(Model.Brand?.Name ?? "—") · @Model.Variants.Count variant(s)
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" name="id" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-primary-custom" style="background: var(--google-red); box-shadow: 0 8px 20px rgba(234,67,53,.28);">
                        <i class="bi bi-trash"></i> Confirm Delete
                    </button>
                    <a asp-action="Index" class="btn-reset">Cancel</a>
                </div>
            </form>

        </div>
    </div>

</div>