@model IEnumerable<WebApplication_ClothingEcommerce.Models.Size>

@{
    ViewData["Title"] = "Sizes";
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Sizes</h1>
            <p class="page-description">Manage product sizes (e.g., S, M, L, XL).</p>
        </div>

        <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createSizeModal">
            <i class="bi bi-plus-lg"></i> Add Size
        </button>
    </div>

    <div id="alertPlaceholder"></div>

    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">All Sizes</h3>
                <p class="admin-card-subtitle">Manage sizes used across product variants</p>
            </div>
            <div class="admin-card-count">
                <span>@Model.Count()</span>
                <small>total</small>
            </div>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Size Name</th>
                        <th>Variants Linked</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="payment-name">@item.Name</td>
                                <td><span class="payment-count">@(item.Variants?.Count ?? 0)</span></td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button type="button" class="action-btn action-warning" title="Edit"
                                                data-bs-toggle="modal" data-bs-target="#editSizeModal"
                                                data-id="@item.Id"
                                                data-name="@item.Name">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="action-btn action-danger" title="Delete"
                                                data-bs-toggle="modal" data-bs-target="#deleteSizeModal"
                                                data-id="@item.Id"
                                                data-name="@item.Name">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-rulers"></i></div>
                                    <h5>No sizes found</h5>
                                    <p>Add your first size to start managing variants.</p>
                                    <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createSizeModal">
                                        <i class="bi bi-plus-lg"></i> Add Size
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

<!-- Create Modal -->
<div class="modal fade" id="createSizeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createSizeForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Size</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="createErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Size Name</label>
                        <input name="Name" class="form-control" placeholder="e.g. Medium, XL, 42" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editSizeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editSizeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Size</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="editErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Size Name</label>
                        <input name="Name" id="editName" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteSizeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteSizeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header">
                    <h5 class="modal-title">Delete Size</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="deleteErrors" class="admin-alert admin-alert-danger d-none"></div>
                    <p>Are you sure you want to delete <strong id="deleteName"></strong>? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="action-btn action-danger" style="width:auto;padding:8px 18px;">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAlert(type, message) {
            const placeholder = document.getElementById('alertPlaceholder');
            const cls = type === 'success' ? 'admin-alert-success' : 'admin-alert-danger';
            const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
            placeholder.innerHTML = `<div class="admin-alert ${cls}"><i class="bi ${icon}"></i> ${message}</div>`;
        }

        function showErrors(boxId, errors) {
            const box = document.getElementById(boxId);
            box.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> ' + errors.join('<br />');
            box.classList.remove('d-none');
        }

        function hideErrors(boxId) {
            document.getElementById(boxId).classList.add('d-none');
        }

        async function postForm(url, form, errorBoxId) {
            hideErrors(errorBoxId);
            const formData = new FormData(form);

            const response = await fetch(url, { method: 'POST', body: formData });

            let data = {};
            try { data = await response.json(); } catch { }

            if (!response.ok) {
                showErrors(errorBoxId, data.errors || ['Something went wrong.']);
                return null;
            }
            return data;
        }

        // Create
        document.getElementById('createSizeForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const result = await postForm('@Url.Action("Create")', this, 'createErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('createSizeModal')).hide();
                sessionStorage.setItem('sizeToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // Populate + submit Edit
        document.getElementById('editSizeModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('editId').value = btn.getAttribute('data-id');
            document.getElementById('editName').value = btn.getAttribute('data-name');
            hideErrors('editErrors');
        });

        document.getElementById('editSizeForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const result = await postForm('@Url.Action("Edit")?id=' + id, this, 'editErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editSizeModal')).hide();
                sessionStorage.setItem('sizeToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // Populate + submit Delete
        document.getElementById('deleteSizeModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteId').value = btn.getAttribute('data-id');
            document.getElementById('deleteName').textContent = btn.getAttribute('data-name');
            hideErrors('deleteErrors');
        });

        document.getElementById('deleteSizeForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('deleteId').value;
            const result = await postForm('@Url.Action("Delete")/' + id, this, 'deleteErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('deleteSizeModal')).hide();
                sessionStorage.setItem('sizeToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // Show toast after reload
        document.addEventListener('DOMContentLoaded', function() {
            const raw = sessionStorage.getItem('sizeToast');
            if (raw) {
                const toast = JSON.parse(raw);
                showAlert(toast.type, toast.message);
                sessionStorage.removeItem('sizeToast');
            }
        });
    </script>
}