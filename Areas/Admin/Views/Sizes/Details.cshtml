@model WebApplication_ClothingEcommerce.Models.Size
@{
    ViewData["Title"] = "Size Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i> Back to Sizes</a>
            <h2 class="fw-bold mt-3 mb-1">Size: @Model.Name</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil me-1"></i> Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i> Delete</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3"><h5 class="fw-bold mb-0">Size Information</h5></div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted">ID</small>
                        <div class="font-monospace small">@Model.Id</div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted">Size Name</small>
                        <div><span class="badge bg-secondary fs-6">@Model.Name</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Product Variants using this Size</h5>
                    <span class="badge bg-info text-dark rounded-pill">@(Model.Variants?.Count ?? 0)</span>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (Model.Variants != null && Model.Variants.Any())
                        {
                            foreach (var item in Model.Variants)
                            {
                                <li class="list-group-item p-3">
                                    <span class="fw-semibold">Variant ID: @item.Id</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item p-4 text-center text-muted">No variants assigned to this size.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>