@model WebApplication_ClothingEcommerce.Models.ApplicationUser

@{
    ViewData["Title"] = $"Edit User: {Model.FullName}";
}

<div class="container-fluid px-4 py-3" style="max-width: 700px;">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border px-3">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
        <span class="text-muted">/</span>
        <span class="fw-semibold text-dark">Edit User Account</span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h4 class="fw-bold mb-1 text-dark">Edit User Profile</h4>
        <p class="text-muted small mb-4">Update contact information and role assignment.</p>

        <form method="post" asp-action="Edit" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <!-- Profile Picture Section -->
            <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded-4">
                @{
                    var avatarUrl = ViewBag.AvatarUrl as string;
                    var initial = !string.IsNullOrEmpty(Model.FirstName) ? Model.FirstName.Substring(0, 1).ToUpper() : "U";
                }
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <img id="userAvatarPreview" src="@avatarUrl" alt="Avatar" class="rounded-circle shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />
                }
                else
                {
                    <div id="userAvatarFallback" class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm" style="width: 70px; height: 70px;">
                        @initial
                    </div>
                    <img id="userAvatarPreview" src="" alt="Avatar" class="rounded-circle shadow-sm d-none" style="width: 70px; height: 70px; object-fit: cover;" />
                }
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label fw-semibold small mb-0">Profile Photo</label>
                        @if (!string.IsNullOrEmpty(avatarUrl))
                        {
                            <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0" onclick="document.getElementById('removeUserAvatarForm').submit();">
                                <i class="bi bi-trash me-1"></i>Remove
                            </button>
                        }
                    </div>
                    <input type="file" name="avatarFile" class="form-control form-control-sm rounded-3" accept="image/jpeg,image/png,image/webp" onchange="previewUserAvatar(this)" />
                    <div class="form-text small" style="font-size: 11px;">Upload JPG, PNG, or WebP photo (Max 5MB).</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label fw-semibold small">First Name *</label>
                    <input type="text" name="firstName" value="@Model.FirstName" class="form-control rounded-3" required />
                </div>

                <div class="col-sm-6">
                    <label class="form-label fw-semibold small">Last Name *</label>
                    <input type="text" name="lastName" value="@Model.LastName" class="form-control rounded-3" required />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold small">Email Address *</label>
                    <input type="email" name="email" value="@Model.Email" class="form-control rounded-3" required />
                </div>

                <div class="col-sm-6">
                    <label class="form-label fw-semibold small">Phone Number</label>
                    <input type="tel" name="phoneNumber" value="@Model.PhoneNumber" class="form-control rounded-3" />
                </div>

                <div class="col-sm-6">
                    <label class="form-label fw-semibold small">Assigned Role *</label>
                    <select name="role" class="form-select rounded-3" asp-items="ViewBag.Roles"></select>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-dark rounded-pill px-4">
                    <i class="bi bi-check2 me-1"></i> Save Changes
                </button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(ViewBag.AvatarUrl as string))
        {
            <form id="removeUserAvatarForm" asp-action="RemoveAvatar" method="post" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        function previewUserAvatar(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.getElementById('userAvatarPreview');
                    var fallback = document.getElementById('userAvatarFallback');
                    if (img) {
                        img.src = e.target.result;
                        img.classList.remove('d-none');
                    }
                    if (fallback) {
                        fallback.classList.add('d-none');
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
