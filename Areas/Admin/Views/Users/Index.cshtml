@model IEnumerable<WebApplication_ClothingEcommerce.Models.ApplicationUser>

@{
    ViewData["Title"] = "User Management";
    var userRolesMap = ViewBag.UserRoles as Dictionary<string, IList<string>> ?? new();
    var userLockoutMap = ViewBag.UserLockout as Dictionary<string, bool> ?? new();
    var userAvatarsMap = ViewBag.UserAvatars as Dictionary<string, string?> ?? new();
    var allRoles = ViewBag.AllRoles as List<string> ?? new();
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
    var search = ViewBag.Search as string ?? "";
    var roleFilter = ViewBag.RoleFilter as string ?? "";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 text-uppercase" style="font-size: 11px; font-weight: 700; letter-spacing: 0.05em;">
                    <i class="bi bi-shield-lock-fill me-1"></i> SuperAdmin Control
                </span>
                <span class="text-muted small">Access &amp; Identity Management</span>
            </div>
            <h1 class="h3 fw-bold mb-0 text-dark">Platform Users</h1>
            <p class="text-muted small mb-0">View all customer and administrative accounts across the platform.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-dark btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Create User
            </a>
        </div>
    </div>

    <!-- Notification Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="d-flex flex-grow-1 gap-2" style="max-width: 500px;">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@search" class="form-control bg-light border-start-0" placeholder="Search by name, email, phone..." />
                </div>
                <button type="submit" class="btn btn-dark rounded-pill px-3">Search</button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(roleFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Clear Filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(roleFilter) ? "btn-dark" : "btn-light border")">All Roles</a>
                @foreach (var r in allRoles)
                {
                    <a asp-action="Index" asp-route-roleFilter="@r" class="btn btn-sm rounded-pill @(roleFilter == r ? "btn-dark" : "btn-light border")">@r</a>
                }
            </div>
        </form>
    </div>

    <!-- Users Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">User</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Assigned Role</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                                    <h5>No users found</h5>
                                    <small>Try clearing filters or create a new user account</small>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            var isSelf = (user.Id == currentUserId);
                            var roles = userRolesMap.ContainsKey(user.Id) ? userRolesMap[user.Id] : new List<string>();
                            var isLocked = userLockoutMap.ContainsKey(user.Id) && userLockoutMap[user.Id];
                            var isSuperAdminUser = roles.Contains("SuperAdmin");
                            var initial = !string.IsNullOrEmpty(user.FirstName) ? user.FirstName.Substring(0, 1).ToUpper() : "U";

                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @{
                                            var avatarUrl = userAvatarsMap.ContainsKey(user.Id) ? userAvatarsMap[user.Id] : null;
                                        }
                                        @if (!string.IsNullOrEmpty(avatarUrl))
                                        {
                                            <img src="@avatarUrl" alt="@user.FullName" class="rounded-circle shadow-sm" style="width: 36px; height: 36px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">
                                                @initial
                                            </div>
                                        }
                                        <div>
                                            <div class="d-flex align-items-center gap-2">
                                                <a asp-action="Details" asp-route-id="@user.Id" class="text-dark fw-bold text-decoration-none">
                                                    @user.FullName
                                                </a>
                                                @if (isSelf)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 10px;">You</span>
                                                }
                                            </div>
                                            <span class="text-muted font-monospace" style="font-size: 11px;">ID: @user.Id.Substring(0, Math.Min(user.Id.Length, 8))...</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="text-dark fw-semibold small">@user.Email</span>
                                    @if (user.EmailConfirmed)
                                    {
                                        <i class="bi bi-patch-check-fill text-success ms-1" title="Email Confirmed"></i>
                                    }
                                </td>

                                <td class="small">
                                    @(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)
                                </td>

                                <td>
                                    @foreach (var role in roles)
                                    {
                                        if (role == "SuperAdmin")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 small fw-bold">
                                                <i class="bi bi-shield-fill-check me-1"></i> SuperAdmin
                                            </span>
                                        }
                                        else if (role == "Admin")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                                                <i class="bi bi-shield-check me-1"></i> Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 small">
                                                @role
                                            </span>
                                        }
                                    }
                                </td>

                                <td>
                                    @if (!isLocked)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 small">Deactivated</span>
                                    }
                                </td>

                                <td class="pe-4 text-end">
                                    <div class="dropdown">
                                        <button class="action-meatball-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@user.Id">
                                                    <i class="bi bi-eye text-primary"></i> <span>View Details</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@user.Id">
                                                    <i class="bi bi-pencil text-warning"></i> <span>Edit User</span>
                                                </a>
                                            </li>

                                            @if (!isSelf)
                                            {
                                                <li>
                                                    <!-- Toggle Status -->
                                                    <form method="post" asp-action="ToggleStatus" asp-route-id="@user.Id" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item text-secondary" onclick="return confirm('Change status for @user.FullName?');">
                                                            <i class="bi @(isLocked ? "bi-check-circle text-success" : "bi-slash-circle text-danger")"></i> <span>@(isLocked ? "Activate Account" : "Deactivate Account")</span>
                                                        </button>
                                                    </form>
                                                </li>

                                                <li>
                                                    <!-- Reset Password Trigger -->
                                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#userResetModal" data-id="@user.Id" data-name="@user.FullName">
                                                        <i class="bi bi-key text-info"></i> <span>Reset Password</span>
                                                    </button>
                                                </li>
                                            }

                                            <li><hr class="dropdown-divider my-1" /></li>

                                            @if (isSelf)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-muted disabled opacity-50" disabled>
                                                        <i class="bi bi-trash"></i> <span>Delete (Self)</span>
                                                    </button>
                                                </li>
                                            }
                                            else if (isSuperAdminUser)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-muted disabled opacity-50" disabled>
                                                        <i class="bi bi-shield-lock-fill"></i> <span>Delete Protected</span>
                                                    </button>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@user.Id">
                                                        <i class="bi bi-trash"></i> <span>Delete User</span>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Reset User Password -->
<div class="modal fade" id="userResetModal" tabindex="-1" aria-labelledby="userResetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="post" asp-action="ResetPassword">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="resetUserId" />

                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="userResetModalLabel">
                        <i class="bi bi-key text-primary me-1"></i> Reset Password
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body py-3">
                    <p class="text-muted small mb-3">Set a new password for <strong id="resetUserName" class="text-dark"></strong>.</p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">New Password *</label>
                        <input type="password" name="newPassword" class="form-control rounded-3" required minlength="6" placeholder="Minimum 6 characters" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold small">Confirm Password *</label>
                        <input type="password" name="confirmPassword" class="form-control rounded-3" required minlength="6" placeholder="Repeat new password" />
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark rounded-pill px-4">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const userResetModal = document.getElementById('userResetModal');
        if (userResetModal) {
            userResetModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('resetUserId').value = button.getAttribute('data-id') || '';
                document.getElementById('resetUserName').textContent = button.getAttribute('data-name') || 'User';
            });
        }
    </script>
}
