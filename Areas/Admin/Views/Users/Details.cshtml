@model WebApplication_ClothingEcommerce.Models.ApplicationUser

@{
    ViewData["Title"] = $"User Profile: {Model.FullName}";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
    var isCurrent = (bool)(ViewBag.IsCurrent ?? false);
    var isLocked = (bool)(ViewBag.IsLocked ?? false);
    var lockoutEnd = ViewBag.LockoutEnd as DateTimeOffset?;
    var accessFailed = (int)(ViewBag.AccessFailedCount ?? 0);
    var initial = !string.IsNullOrEmpty(Model.FirstName)
        ? Model.FirstName.Substring(0, 1).ToUpperInvariant()
        : "U";
}

<div class="container-fluid px-4 py-3" style="max-width: 860px;">

    <%-- Breadcrumb / Header --%>
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border px-3">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <span class="text-muted">/</span>
            <span class="fw-semibold text-dark">User Profile</span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark btn-sm rounded-pill px-3">
                <i class="bi bi-pencil me-1"></i> Edit Profile
            </a>
            @if (!isCurrent)
            {
                <form method="post" asp-action="ToggleStatus" asp-route-id="@Model.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-sm rounded-pill px-3 @(isLocked ? "btn-outline-success" : "btn-outline-warning")"
                            onclick="return confirm('@(isLocked ? "Activate" : "Deactivate") account for @Model.FullName?')">
                        <i class="bi @(isLocked ? "bi-check-circle" : "bi-slash-circle") me-1"></i>
                        @(isLocked ? "Activate" : "Deactivate")
                    </button>
                </form>
                <button type="button"
                        class="btn btn-sm btn-outline-primary rounded-pill px-3"
                        data-bs-toggle="modal"
                        data-bs-target="#resetPasswordModal">
                    <i class="bi bi-key me-1"></i> Reset Password
                </button>
            }
        </div>
    </div>

    <%-- Alerts --%>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex gap-2 align-items-center mb-3" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex gap-2 align-items-center mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <%-- LEFT: Avatar + Identity Card --%>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center h-100">

                <%-- Avatar --%>
                <div class="d-flex justify-content-center mb-3">
                    @{
                        var avatarUrl = ViewBag.AvatarUrl as string;
                    }
                    @if (!string.IsNullOrEmpty(avatarUrl))
                    {
                        <div class="position-relative">
                            <img src="@avatarUrl" alt="@Model.FullName" class="rounded-circle shadow" style="width: 88px; height: 88px; object-fit: cover;" />
                            @if (isCurrent)
                            {
                                <span class="position-absolute top-0 end-0 badge bg-primary rounded-pill border border-white"
                                      style="font-size: 9px; padding: 3px 5px;">YOU</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold position-relative"
                             style="width: 88px; height: 88px; font-size: 2rem;">
                            @initial
                            @if (isCurrent)
                            {
                                <span class="position-absolute top-0 end-0 badge bg-primary rounded-pill border border-white"
                                      style="font-size: 9px; padding: 3px 5px;">YOU</span>
                            }
                        </div>
                    }
                </div>

                <%-- Name & Email --%>
                <h5 class="fw-bold mb-1 text-dark">@Model.FullName</h5>
                <div class="text-muted small mb-3">
                    @Model.Email
                    @if (Model.EmailConfirmed)
                    {
                        <i class="bi bi-patch-check-fill text-success ms-1" title="Email Verified"></i>
                    }
                    else
                    {
                        <i class="bi bi-exclamation-circle-fill text-warning ms-1" title="Email Not Verified"></i>
                    }
                </div>

                <%-- Role badges --%>
                <div class="d-flex gap-1 flex-wrap justify-content-center mb-3">
                    @foreach (var r in roles)
                    {
                        string bc = "bg-secondary-subtle text-secondary border-secondary-subtle";
                        string ic = "bi-person";
                        if (r == "SuperAdmin") { bc = "bg-warning-subtle text-warning-emphasis border-warning-subtle"; ic = "bi-shield-fill-check"; }
                        else if (r == "Admin")  { bc = "bg-primary-subtle text-primary border-primary-subtle"; ic = "bi-shield-check"; }
                        <span class="badge @bc border rounded-pill px-3 py-1 small fw-semibold">
                            <i class="bi @ic me-1"></i>@r
                        </span>
                    }
                </div>

                <%-- Account Status --%>
                <div>
                    @if (!isLocked)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                            <i class="bi bi-check-circle me-1"></i> Active Account
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                            <i class="bi bi-lock me-1"></i> Deactivated
                        </span>
                    }
                </div>
            </div>
        </div>

        <%-- RIGHT: Details --%>
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">

                <h6 class="fw-bold text-uppercase text-muted small mb-3">
                    <i class="bi bi-person-lines-fill me-1"></i> Account Information
                </h6>

                <div class="row g-3">

                    <div class="col-sm-6">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">First Name</div>
                        <div class="fw-semibold text-dark mt-1">@(string.IsNullOrEmpty(Model.FirstName) ? "—" : Model.FirstName)</div>
                    </div>

                    <div class="col-sm-6">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">Last Name</div>
                        <div class="fw-semibold text-dark mt-1">@(string.IsNullOrEmpty(Model.LastName) ? "—" : Model.LastName)</div>
                    </div>

                    <div class="col-sm-6">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">Email Address</div>
                        <div class="fw-semibold text-dark mt-1 d-flex align-items-center gap-1 flex-wrap">
                            <span>@Model.Email</span>
                            @if (Model.EmailConfirmed)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 10px;">Verified</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill" style="font-size: 10px;">Unverified</span>
                            }
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">Phone Number</div>
                        <div class="fw-semibold text-dark mt-1">
                            @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">Account ID</div>
                        <div class="fw-semibold font-monospace small text-dark mt-1 text-break">@Model.Id</div>
                    </div>

                </div>

                <hr class="my-4" />

                <h6 class="fw-bold text-uppercase text-muted small mb-3" style="font-size: 11px;">
                    <i class="bi bi-shield-lock me-1"></i> Security &amp; Access
                </h6>

                <div class="row g-3">

                    <div class="col-sm-4">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">Account Status</div>
                        <div class="mt-1">
                            @if (!isLocked)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                    <i class="bi bi-check-circle me-1"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small">
                                    <i class="bi bi-lock me-1"></i> Deactivated
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">Failed Login Attempts</div>
                        <div class="fw-semibold text-dark mt-1">
                            @if (accessFailed > 0)
                            {
                                <span class="text-danger fw-bold">@accessFailed</span>
                                <span class="text-muted small ms-1">attempt(s)</span>
                            }
                            else
                            {
                                <span class="text-success">None</span>
                            }
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">Lockout Expiry</div>
                        <div class="fw-semibold text-dark mt-1 small">
                            @if (isLocked && lockoutEnd.HasValue)
                            {
                                if (lockoutEnd.Value > DateTimeOffset.MaxValue.AddDays(-1))
                                {
                                    <span class="text-danger">Permanent</span>
                                }
                                else
                                {
                                    <span class="text-danger">@lockoutEnd.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">Two-Factor Auth</div>
                        <div class="mt-1">
                            @if (Model.TwoFactorEnabled)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                    <i class="bi bi-shield-check me-1"></i> Enabled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1 small">
                                    Disabled
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="text-muted fw-semibold text-uppercase" style="font-size: 11px;">Phone Confirmed</div>
                        <div class="mt-1">
                            @if (Model.PhoneNumberConfirmed)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                    <i class="bi bi-check-circle me-1"></i> Confirmed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1 small">
                                    Not Confirmed
                                </span>
                            }
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <%-- Bottom actions --%>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    @if (!isCurrent)
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id"
                           class="btn btn-outline-danger btn-sm rounded-pill px-3">
                            <i class="bi bi-trash me-1"></i> Delete User
                        </a>
                    }
                    else
                    {
                        <span class="text-muted small fst-italic">
                            <i class="bi bi-info-circle me-1"></i> You cannot delete your own account.
                        </span>
                    }
                    <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border px-3">
                        Back to List
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<%-- Modal: Reset Password --%>
@if (!isCurrent)
{
    <div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form method="post" asp-action="ResetPassword">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold" id="resetPasswordModalLabel">
                            <i class="bi bi-key text-primary me-1"></i> Reset Password
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body py-3">
                        <p class="text-muted small mb-3">
                            Set a new password for <strong class="text-dark">@Model.FullName</strong>.
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">New Password *</label>
                            <input type="password" name="newPassword" class="form-control rounded-3" required minlength="6" placeholder="Minimum 6 characters" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small">Confirm Password *</label>
                            <input type="password" name="confirmPassword" class="form-control rounded-3" required minlength="6" placeholder="Repeat new password" />
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark rounded-pill px-4">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
