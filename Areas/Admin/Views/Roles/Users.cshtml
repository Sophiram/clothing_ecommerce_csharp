@model IEnumerable<WebApplication_ClothingEcommerce.Models.ApplicationUser>
@using Microsoft.AspNetCore.Identity

@{
    var role = ViewBag.Role as IdentityRole;
    var isSystem = ViewBag.IsSystem as bool? ?? false;
    ViewData["Title"] = $"Users in Role: {role?.Name}";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to Roles
                </a>
                <span class="text-muted">/</span>
                <span class="badge @(role?.Name == "SuperAdmin" ? "bg-warning-subtle text-warning-emphasis" : role?.Name == "Admin" ? "bg-primary-subtle text-primary" : "bg-light text-dark") border rounded-pill px-2.5 py-1">
                    @role?.Name
                </span>
            </div>
            <h1 class="h3 fw-bold mb-0 text-dark">Role Members: @role?.Name</h1>
            <p class="text-muted small mb-0">List of all platform accounts assigned the '@role?.Name' security role.</p>
        </div>

        <div class="d-flex gap-2">
            <span class="badge bg-white text-dark border p-2 px-3 rounded-pill d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-people-fill text-primary"></i>
                <span>Total Members: <strong>@Model.Count()</strong></span>
            </span>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">User</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Account Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            var initial = !string.IsNullOrEmpty(user.FirstName) ? user.FirstName.Substring(0, 1).ToUpper() : "U";
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">
                                            @initial
                                        </div>
                                        <div>
                                            <a asp-controller="Users" asp-action="Details" asp-route-id="@user.Id" class="text-dark fw-bold text-decoration-none">
                                                @user.FullName
                                            </a>
                                            <div class="text-muted font-monospace" style="font-size: 11px;">ID: @user.Id.Substring(0, Math.Min(user.Id.Length, 8))...</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="text-dark fw-semibold small">@user.Email</span>
                                    @if (user.EmailConfirmed)
                                    {
                                        <i class="bi bi-patch-check-fill text-success ms-1" title="Email Confirmed"></i>
                                    }
                                </td>

                                <td class="small">
                                    @(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)
                                </td>

                                <td>
                                    @if (user.LockoutEnd == null || user.LockoutEnd <= DateTimeOffset.UtcNow)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 small">Deactivated</span>
                                    }
                                </td>

                                <td class="pe-4 text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a asp-controller="Users" asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-light border rounded-pill px-2.5" title="View Profile">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-light border rounded-pill px-2.5" title="Edit Permissions">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-people fs-1 text-muted d-block mb-2"></i>
                                <h5>No users assigned</h5>
                                <p class="text-muted small">No accounts currently hold this security role.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
