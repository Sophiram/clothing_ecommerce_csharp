@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Role Management";
    var userCounts = ViewBag.UserCounts as Dictionary<string, int> ?? new();
    var systemRoles = ViewBag.SystemRoles as HashSet<string> ?? new();
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 text-uppercase" style="font-size: 11px; font-weight: 700; letter-spacing: 0.05em;">
                    <i class="bi bi-shield-lock-fill me-1"></i> SuperAdmin Control
                </span>
                <span class="text-muted small">Access Control &amp; RBAC</span>
            </div>
            <h1 class="h3 fw-bold mb-0 text-dark">Platform Security Roles</h1>
            <p class="text-muted small mb-0">Manage authorization roles and system permission scopes.</p>
        </div>

        <div>
            <button type="button" class="btn btn-dark btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                <i class="bi bi-plus-lg me-1"></i> Add New Role
            </button>
        </div>
    </div>

    <!-- Notification Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Roles Grid -->
    <div class="row g-3 mb-4">
        @foreach (var role in Model)
        {
            var isSystem = role.Name != null && systemRoles.Contains(role.Name);
            var memberCount = userCounts.ContainsKey(role.Id) ? userCounts[role.Id] : 0;

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="rounded-circle @(role.Name == "SuperAdmin" ? "bg-warning-subtle text-warning-emphasis" : role.Name == "Admin" ? "bg-primary-subtle text-primary" : "bg-light text-dark") d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                                @if (role.Name == "SuperAdmin")
                                {
                                    <i class="bi bi-shield-fill-check fs-4"></i>
                                }
                                else if (role.Name == "Admin")
                                {
                                    <i class="bi bi-shield-check fs-4"></i>
                                }
                                else
                                {
                                    <i class="bi bi-people fs-4"></i>
                                }
                            </div>

                            @if (isSystem)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 small">
                                    <i class="bi bi-lock-fill me-1"></i> Core System Role
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 small">
                                    Custom Role
                                </span>
                            }
                        </div>

                        <h4 class="fw-bold text-dark mb-1">@role.Name</h4>
                        <p class="text-muted small mb-3">
                            @if (role.Name == "SuperAdmin")
                            {
                                <span>Highest authority tier. Full access to system settings, audit logs, admin &amp; role management.</span>
                            }
                            else if (role.Name == "Admin")
                            {
                                <span>Store management tier. Can manage catalog, sales, inventory, and customers. Cannot manage system roles or admins.</span>
                            }
                            else if (role.Name == "User")
                            {
                                <span>Default customer tier. Can browse store, manage shopping cart, wishlist, profile, and orders.</span>
                            }
                            else
                            {
                                <span>Custom defined platform role with application-level assignments.</span>
                            }
                        </p>
                    </div>

                    <div class="border-top pt-3 mt-2 d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small">Assigned Users:</span>
                            <a asp-action="Users" asp-route-roleName="@role.Name" class="fw-bold text-dark text-decoration-none ms-1 hover-underline" title="View all users in this role">
                                @memberCount user@(memberCount == 1 ? "" : "s") <i class="bi bi-arrow-right-short"></i>
                            </a>
                        </div>

                        <div class="d-flex gap-1">
                            @if (isSystem)
                            {
                                <button class="btn btn-sm btn-light border rounded-pill px-3 text-muted" disabled title="Core system roles are protected and cannot be modified or deleted">
                                    <i class="bi bi-lock me-1"></i> Locked
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2.5" title="Rename Role" data-bs-toggle="modal" data-bs-target="#editRoleModal" data-id="@role.Id" data-name="@role.Name">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-action="Delete" asp-route-id="@role.Id" class="d-inline" onsubmit="return confirm('Delete custom role @role.Name?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5" @(memberCount > 0 ? "disabled title='Reassign users before deleting role'" : "")>
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: Create Role -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-labelledby="createRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="createRoleModalLabel">
                        <i class="bi bi-shield-plus text-primary me-1"></i> Create Security Role
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Role Name *</label>
                        <input type="text" name="roleName" class="form-control rounded-3" required placeholder="e.g. Moderator, Manager" />
                        <div class="form-text small">Enter a unique identifier for this security role.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark rounded-pill px-4">Create Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Role -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="post" asp-action="Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editRoleId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editRoleModalLabel">
                        <i class="bi bi-pencil-square text-primary me-1"></i> Edit Custom Role
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Role Name *</label>
                        <input type="text" name="newName" id="editRoleName" class="form-control rounded-3" required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark rounded-pill px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editRoleModal = document.getElementById('editRoleModal');
        if (editRoleModal) {
            editRoleModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('editRoleId').value = button.getAttribute('data-id') || '';
                document.getElementById('editRoleName').value = button.getAttribute('data-name') || '';
            });
        }
    </script>
}
