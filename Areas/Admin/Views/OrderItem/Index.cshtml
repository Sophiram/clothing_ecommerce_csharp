@model IEnumerable<WebApplication_ClothingEcommerce.Models.OrderItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VariantId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Variant)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.OrderId)
            </td>
            <td>
                @Html.DisplayFor(model => item.VariantId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(model => item.UnitPrice)
            </td>
            <td>
                @Html.DisplayFor(model => item.Order)
            </td>
            <td>
                @Html.DisplayFor(model => item.Variant)
            </td>
            <td class="text-end">
                <div class="dropdown">
                    <button class="action-meatball-btn" type="button" aria-expanded="false" title="Actions" onclick="toggleActionMenu(this, event)">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-meatball shadow border-0">
                        <li>
                            <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                <i class="bi bi-eye text-primary"></i> <span>View Details</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                <i class="bi bi-pencil text-warning"></i> <span>Edit</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1" /></li>
                        <li>
                            <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                <i class="bi bi-trash"></i> <span>Delete</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
