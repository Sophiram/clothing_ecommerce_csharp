@{
    ViewData["Title"] = "Access Denied";
}

<div class="auth-page-modern">
    <div class="text-center p-5 bg-white rounded-4 shadow-lg border" style="max-width: 480px; width: 100%;">
        <div class="mb-3">
            <span class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle" style="width: 70px; height: 70px;">
                <i class="bi bi-shield-lock-fill fs-2"></i>
            </span>
        </div>
        <h2 class="fw-bold mb-2">Access Restricted</h2>
        <p class="text-muted small mb-4">
            You do not have the necessary permissions to access this requested area. If you believe this is an error, please sign in with an authorized account.
        </p>
        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark rounded-pill px-4">
                <i class="bi bi-house-door me-1"></i> Return Home
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark rounded-pill px-4">
                <i class="bi bi-person me-1"></i> Sign in
            </a>
        </div>
    </div>
</div>