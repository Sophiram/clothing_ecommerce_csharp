@model WebApplication_ClothingEcommerce.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Delete Category</h1>
        </div>
    </div>

    <div class="admin-card" style="max-width: 560px;">
        <div style="padding: 30px;">

            <div class="admin-alert admin-alert-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill"></i>
                This action cannot be undone.
                @if (Model.Products.Any())
                {
                    <span> This category has <strong>@Model.Products.Count</strong> product(s) assigned — deletion will fail unless they're reassigned first.</span>
                }
            </div>

            <div class="mb-4">
                <div class="payment-name" style="font-size:15px;">@Model.Name</div>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="text-secondary" style="font-size:12px;">@Model.Description</div>
                }
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" name="id" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-primary-custom" style="background: var(--google-red); box-shadow: 0 8px 20px rgba(234,67,53,.28);">
                        <i class="bi bi-trash"></i> Confirm Delete
                    </button>
                    <a asp-action="Index" class="btn-reset">Cancel</a>
                </div>
            </form>

        </div>
    </div>

</div>