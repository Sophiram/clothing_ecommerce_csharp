@using ClothingEcommerce.Shared.DTOs.Catalog
@{
    Layout = "_Layout";
    ViewData["Title"] = "POS Terminal — Cashier Register";
    var categories = ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>();
}

<div class="space-y-4">
    <!-- POS TOP STATUS BAR -->
    <div class="bg-slate-900 text-white px-5 py-3 rounded-2xl flex flex-wrap items-center justify-between gap-3 shadow-md border border-slate-800">
        <div class="flex items-center gap-3 flex-wrap">
            <span class="inline-flex items-center gap-1.5 bg-blue-600 text-white text-xs font-black px-3 py-1.5 rounded-xl shadow-sm">
                <i class="bi bi-shop"></i> CLOTHÉ POS
            </span>
            <span class="text-xs text-slate-400">
                Cashier: <strong class="text-white">@ViewBag.CashierName</strong>
            </span>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-slate-800 text-emerald-400 border border-emerald-500/20">
                Rate: $1 = <span id="rateDisplay">4,100</span> KHR
            </span>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" onclick="openShiftSummaryModal()"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-700 bg-slate-800/80 hover:bg-slate-800 text-slate-200 text-xs font-bold transition">
                <i class="bi bi-clock-history"></i> Daily Shift (F6)
            </button>
            <button type="button" onclick="clearCart()"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-amber-500/40 bg-amber-950/20 hover:bg-amber-900/40 text-amber-300 text-xs font-bold transition">
                <i class="bi bi-trash3"></i> Clear Cart (F4)
            </button>
            <span id="posLiveClock" class="font-mono text-xs font-black text-cyan-400 ml-2 tracking-wider"></span>
        </div>
    </div>

    <!-- MAIN TWO-COLUMN WORKSPACE -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- LEFT: CATALOG & SCANNER (8 cols on xl) -->
        <div class="lg:col-span-7 xl:col-span-8 space-y-4">
            
            <!-- SCANNER & SEARCH CARD -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                    <div class="md:col-span-7">
                        <div class="relative flex items-center">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i class="bi bi-upc-scan text-sm"></i>
                            </div>
                            <input type="text" id="barcodeInput"
                                   class="w-full text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 pl-10 pr-16 py-2.5 text-slate-800 dark:text-slate-200 placeholder-slate-400 font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
                                   placeholder="Scan Barcode / SKU (Enter) [F2]" autofocus autocomplete="off" />
                            <button type="button" onclick="focusBarcode()"
                                    class="absolute right-1.5 px-2.5 py-1 rounded-lg bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-[11px] font-bold text-slate-600 dark:text-slate-300 shadow-sm hover:bg-slate-50">
                                <i class="bi bi-keyboard mr-0.5"></i> F2
                            </button>
                        </div>
                    </div>
                    <div class="md:col-span-5">
                        <div class="relative flex items-center">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i class="bi bi-search text-xs"></i>
                            </div>
                            <input type="text" id="searchInput"
                                   class="w-full text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 pl-9 pr-3 py-2.5 text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
                                   placeholder="Search product name..." autocomplete="off" />
                        </div>
                    </div>
                </div>

                <!-- CATEGORY PILLS -->
                <div class="flex items-center gap-2 overflow-x-auto pt-3 mt-3 border-t border-slate-100 dark:border-slate-800/80 no-scrollbar">
                    <button type="button" class="category-filter active px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex-shrink-0 bg-blue-600 text-white shadow-sm" data-cat-id="">
                        All Categories
                    </button>
                    @foreach (var cat in categories)
                    {
                        <button type="button" class="category-filter px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex-shrink-0 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 border border-slate-200/60 dark:border-slate-700" data-cat-id="@cat.Id">
                            @cat.Name
                        </button>
                    }
                </div>
            </div>

            <!-- PRODUCT GRID -->
            <div id="productGrid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3.5 max-h-[620px] overflow-y-auto pr-1">
                <div class="col-span-full text-center py-12 text-slate-400">
                    <div class="inline-block w-6 h-6 border-2 border-blue-600 border-t-transparent rounded-full animate-spin mb-2"></div>
                    <div class="text-xs font-semibold">Loading POS catalog...</div>
                </div>
            </div>
        </div>

        <!-- RIGHT: TICKET / REGISTER CART (4 cols on xl) -->
        <div class="lg:col-span-5 xl:col-span-4 sticky top-4">
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden flex flex-col">
                
                <!-- CUSTOMER BAR -->
                <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-full bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-base">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div>
                            <input type="text" id="customerNameInput" value="Walk-in Customer"
                                   class="text-xs font-bold text-slate-900 dark:text-white bg-transparent border-none p-0 focus:outline-none focus:ring-0" />
                            <div class="text-[10px] text-slate-400" id="customerPhoneDisplay">Default In-Store Sale</div>
                        </div>
                    </div>
                    <button type="button" onclick="openCustomerModal()"
                            class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-50 transition">
                        <i class="bi bi-pencil-square text-xs"></i>
                    </button>
                </div>

                <!-- TICKET ITEMS TABLE CONTAINER -->
                <div class="max-h-[380px] overflow-y-auto p-3">
                    <table class="w-full text-left text-xs">
                        <thead class="text-[10px] uppercase font-bold text-slate-400 border-b border-slate-100 dark:border-slate-800">
                            <tr>
                                <th class="pb-2">Item</th>
                                <th class="pb-2 text-center">Qty</th>
                                <th class="pb-2 text-right">Price</th>
                                <th class="pb-2 text-right">Total</th>
                                <th class="pb-2 w-6"></th>
                            </tr>
                        </thead>
                        <tbody id="cartTableBody" class="divide-y divide-slate-100 dark:divide-slate-800/40">
                            <tr>
                                <td colspan="5" class="text-center py-12 text-slate-400">
                                    <i class="bi bi-cart3 text-3xl d-block mb-1 text-slate-300 dark:text-slate-600"></i>
                                    <span class="text-xs">Cart is empty. Scan SKU or pick product.</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- TICKET SUMMARY & CHECKOUT BUTTON -->
                <div class="p-4 bg-slate-50 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 space-y-3">
                    <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                        <span>Subtotal:</span>
                        <span class="font-bold text-slate-800 dark:text-slate-200" id="cartSubtotalUsd">$0.00</span>
                    </div>

                    <div class="flex items-center justify-between text-xs">
                        <span class="text-slate-500 dark:text-slate-400">Discount ($):</span>
                        <input type="number" id="cartDiscountInput" value="0" min="0" step="0.5"
                               class="w-20 text-xs font-bold text-right rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-2 py-1 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-1 focus:ring-blue-500"
                               onchange="renderCartTotals()" />
                    </div>

                    <div class="pt-2 border-t border-slate-200 dark:border-slate-700/80">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-slate-900 dark:text-white uppercase tracking-wider">Grand Total (USD):</span>
                            <span class="text-xl font-black text-blue-600 dark:text-blue-400" id="cartTotalUsd">$0.00</span>
                        </div>
                        <div class="flex items-center justify-between mt-0.5">
                            <span class="text-[11px] text-slate-400 font-medium">Grand Total (KHR):</span>
                            <span class="font-mono text-sm font-bold text-emerald-600 dark:text-emerald-400" id="cartTotalKhr">0 ៛</span>
                        </div>
                    </div>

                    <button type="button" id="btnPay" onclick="openCheckoutModal()" disabled
                            class="w-full py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-sm font-black shadow-lg transition flex items-center justify-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <i class="bi bi-wallet2"></i>
                        <span>Pay &amp; Checkout (F8)</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     MODAL: PRODUCT VARIANT PICKER
========================================================= -->
<div class="modal fade" id="variantPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl overflow-hidden">
            <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white" id="variantModalTitle">Select Size &amp; Color</h3>
                    <p class="text-xs text-slate-400 mt-0.5" id="variantModalCategory"></p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="p-5">
                <div id="variantModalList" class="space-y-2 max-h-[380px] overflow-y-auto"></div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     MODAL: CHECKOUT & PAYMENT (CASH / KHQR)
========================================================= -->
<div class="modal fade" id="checkoutModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl overflow-hidden">
            <!-- Header -->
            <div class="p-5 bg-slate-900 text-white flex items-center justify-between border-b border-slate-800">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center text-sm font-bold">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold">POS Terminal Payment</h3>
                        <p class="text-[11px] text-slate-400">Select payment method and collect payment</p>
                    </div>
                </div>
                <button type="button" class="text-slate-400 hover:text-white text-lg cursor-pointer" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    <!-- LEFT COLUMN: TOTAL & PAYMENT METHOD SELECTOR -->
                    <div class="md:col-span-5 space-y-4">
                        <!-- Total to Pay Card -->
                        <div class="text-center p-4 bg-slate-50 dark:bg-slate-800/60 rounded-2xl border border-slate-200/80 dark:border-slate-700/80">
                            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Amount Due</span>
                            <div class="text-3xl font-black text-blue-600 dark:text-blue-400 mt-1" id="checkoutModalTotalUsd">$0.00</div>
                            <div class="text-sm font-mono font-bold text-emerald-600 dark:text-emerald-400 mt-0.5" id="checkoutModalTotalKhr">0 ៛</div>
                        </div>

                        <!-- Method Selector Buttons -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Payment Method</label>
                            <div class="space-y-2">
                                <button type="button" id="payMethodCashBtn" onclick="selectPaymentMethod('Cash')"
                                        class="w-full text-left p-3 rounded-xl border-2 transition-all flex items-center justify-between font-bold text-xs cursor-pointer border-emerald-500 bg-emerald-50/80 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 ring-2 ring-emerald-500/20 shadow-sm">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base">
                                            <i class="bi bi-cash-stack"></i>
                                        </div>
                                        <div>
                                            <div class="text-xs font-bold">Cash (សាច់ប្រាក់)</div>
                                            <div class="text-[10px] font-normal opacity-70">USD ($) or KHR (៛) with Change</div>
                                        </div>
                                    </div>
                                    <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px]" id="payMethodCashCheck">
                                        <i class="bi bi-check-lg"></i>
                                    </span>
                                </button>

                                <button type="button" id="payMethodKhqrBtn" onclick="selectPaymentMethod('KHQR')"
                                        class="w-full text-left p-3 rounded-xl border-2 transition-all flex items-center justify-between font-bold text-xs cursor-pointer border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:border-slate-300">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-rose-500/15 text-rose-600 dark:text-rose-400 flex items-center justify-center text-base">
                                            <i class="bi bi-qr-code-scan"></i>
                                        </div>
                                        <div>
                                            <div class="text-xs font-bold">NBC Bakong KHQR</div>
                                            <div class="text-[10px] font-normal opacity-70">Scan via ABA, ACLEDA &amp; 30+ Banks</div>
                                        </div>
                                    </div>
                                    <span class="w-5 h-5 rounded-full bg-rose-500 text-white flex items-center justify-center text-[10px] hidden" id="payMethodKhqrCheck">
                                        <i class="bi bi-check-lg"></i>
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: CASH TENDERED OR KHQR SCANNER -->
                    <div class="md:col-span-7">
                        <!-- PANE 1: CASH -->
                        <div id="pane-cash" class="space-y-3.5">
                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Cash Received from Customer</h4>
                            
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Tendered in USD ($)</label>
                                <div class="relative flex items-center">
                                    <span class="absolute left-3.5 font-black text-slate-400">$</span>
                                    <input type="number" id="tenderedUsdInput" placeholder="0.00" min="0" step="1"
                                           class="w-full text-sm font-black rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 pl-8 pr-4 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                           oninput="calculateChange()" />
                                </div>
                            </div>

                            <!-- Quick USD chips -->
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <button type="button" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-bold hover:bg-slate-100 cursor-pointer text-slate-700 dark:text-slate-200" onclick="setTenderedUsd(5)">$5</button>
                                <button type="button" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-bold hover:bg-slate-100 cursor-pointer text-slate-700 dark:text-slate-200" onclick="setTenderedUsd(10)">$10</button>
                                <button type="button" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-bold hover:bg-slate-100 cursor-pointer text-slate-700 dark:text-slate-200" onclick="setTenderedUsd(20)">$20</button>
                                <button type="button" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-bold hover:bg-slate-100 cursor-pointer text-slate-700 dark:text-slate-200" onclick="setTenderedUsd(50)">$50</button>
                                <button type="button" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-bold hover:bg-slate-100 cursor-pointer text-slate-700 dark:text-slate-200" onclick="setTenderedUsd(100)">$100</button>
                                <button type="button" class="px-2.5 py-1 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-sm cursor-pointer" onclick="setTenderedExact()">Exact</button>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Or Tendered in KHR (៛)</label>
                                <div class="relative flex items-center">
                                    <span class="absolute left-3.5 font-black text-slate-400">៛</span>
                                    <input type="number" id="tenderedKhrInput" placeholder="0" step="500"
                                           class="w-full text-sm font-mono font-bold rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 pl-8 pr-4 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                           oninput="calculateChange()" />
                                </div>
                            </div>

                            <!-- Quick KHR chips -->
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <button type="button" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-bold hover:bg-slate-100 cursor-pointer text-slate-700 dark:text-slate-200" onclick="setTenderedKhr(20000)">20,000៛</button>
                                <button type="button" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-bold hover:bg-slate-100 cursor-pointer text-slate-700 dark:text-slate-200" onclick="setTenderedKhr(50000)">50,000៛</button>
                                <button type="button" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-bold hover:bg-slate-100 cursor-pointer text-slate-700 dark:text-slate-200" onclick="setTenderedKhr(100000)">100,000៛</button>
                                <button type="button" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-bold hover:bg-slate-100 cursor-pointer text-slate-700 dark:text-slate-200" onclick="setTenderedKhr(200000)">200,000៛</button>
                            </div>

                            <!-- LIVE CHANGE / REMAINING FEEDBACK BOX -->
                            <div id="changeFeedbackBox" class="p-4 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/80 rounded-2xl transition">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold text-emerald-800 dark:text-emerald-300" id="changeFeedbackTitle">
                                        <i class="bi bi-check-circle mr-1"></i> Change Due (USD):
                                    </span>
                                    <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400" id="changeDisplayUsd">$0.00</span>
                                </div>
                                <div class="flex items-center justify-between mt-1">
                                    <span class="text-[11px] text-emerald-700 dark:text-emerald-400 font-medium">In Cambodian Riel:</span>
                                    <span class="text-sm font-mono font-bold text-emerald-600 dark:text-emerald-400" id="changeDisplayKhr">0 ៛</span>
                                </div>
                            </div>
                        </div>

                        <!-- PANE 2: KHQR -->
                        <div id="pane-khqr" class="hidden text-center py-2 space-y-3">
                            <div class="flex items-center justify-center gap-2">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                                    <i class="bi bi-qr-code-scan"></i> NBC Bakong KHQR
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Scan using ABA Mobile, ACLEDA, Wing, or 30+ Cambodia Banks</p>
                            
                            <div class="p-3 bg-white rounded-2xl border-2 border-slate-200 dark:border-slate-700 inline-block shadow-sm">
                                <div id="khqrQrContainer" class="flex justify-center items-center w-[180px] h-[180px] mx-auto bg-white rounded-xl">
                                    <div class="w-8 h-8 border-2 border-rose-600 border-t-transparent rounded-full animate-spin"></div>
                                </div>
                            </div>

                            <div class="space-y-1">
                                <div class="text-xs font-bold text-slate-800 dark:text-slate-200" id="khqrAmountDisplay">Amount: $0.00</div>
                                <div class="text-[11px] font-mono text-slate-400" id="khqrMd5Display"></div>
                            </div>

                            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span>Ready for customer scan</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="p-5 bg-slate-50 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-3">
                <button type="button" class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 cursor-pointer" data-bs-dismiss="modal">
                    Cancel (Esc)
                </button>
                <button type="button" id="btnConfirmSale" onclick="processSaleSubmission()"
