            } else {
                body.innerHTML = `<div class="text-center text-rose-500 py-6 text-xs">${result.message || "Failed to load summary."}</div>`;
            }
        } catch (err) {
            body.innerHTML = `<div class="text-center text-rose-500 py-6 text-xs">Error loading shift summary.</div>`;
        }
