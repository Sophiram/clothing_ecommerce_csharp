<!-- =========================================================
     POS TERMINAL JAVASCRIPT ENGINE
========================================================= -->
<script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
<script>
    const EXCHANGE_RATE = 4100;
    let catalog = [];
    let cart = []; // { variantId, productId, productName, sku, sizeName, colorName, price, quantity, maxStock }
    let currentCategoryFilter = "";
    let lastCheckoutResult = null;

    // Live clock
    function updateClock() {
        const now = new Date();
        const el = document.getElementById('posLiveClock');
        if (el) el.innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Hotkeys: F2 (Barcode focus), F4 (Clear cart), F8 (Checkout), F6 (Shift summary)
    window.addEventListener('keydown', function(e) {
        if (e.key === 'F2') {
            e.preventDefault();
            focusBarcode();
        } else if (e.key === 'F4') {
            e.preventDefault();
            clearCart();
        } else if (e.key === 'F8') {
            e.preventDefault();
            const btn = document.getElementById('btnPay');
            if (btn && !btn.disabled) openCheckoutModal();
        } else if (e.key === 'F6') {
            e.preventDefault();
            openShiftSummaryModal();
        }
    });

    function focusBarcode() {
        const input = document.getElementById('barcodeInput');
        if (input) {
            input.focus();
            input.select();
        }
    }

    // Load Catalog on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadCatalog();

        // Barcode enter event
        const barcodeInput = document.getElementById('barcodeInput');
        barcodeInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const code = this.value.trim();
                if (code) {
                    handleBarcodeScan(code);
                    this.value = '';
                }
            }
        });

        // Search input debounce
        let searchTimeout = null;
        document.getElementById('searchInput').addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                renderProductGrid();
            }, 250);
        });

        // Category pills
        document.querySelectorAll('.category-filter').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.category-filter').forEach(b => {
                    b.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow-sm');
                    b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
                });
                this.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
                this.classList.add('active', 'bg-blue-600', 'text-white', 'shadow-sm');
                currentCategoryFilter = this.getAttribute('data-cat-id') || "";
                renderProductGrid();
            });
        });
    });

    async function loadCatalog() {
        try {
            const res = await fetch('/Admin/Pos/GetProducts');
            const json = await res.json();
            if (json.success && json.data) {
                catalog = json.data;
                renderProductGrid();
            } else {
                document.getElementById('productGrid').innerHTML = `<div class="col-span-full text-center text-rose-500 py-6 text-xs">${json.message || "Failed to load products"}</div>`;
            }
        } catch (err) {
            console.error(err);
            document.getElementById('productGrid').innerHTML = `<div class="col-span-full text-center text-rose-500 py-6 text-xs">Error loading catalog.</div>`;
        }
    }

    function renderProductGrid() {
        const grid = document.getElementById('productGrid');
        const term = (document.getElementById('searchInput').value || "").trim().toLowerCase();

        const filtered = catalog.filter(p => {
            const matchCat = !currentCategoryFilter || (p.categoryId === currentCategoryFilter);
            const matchTerm = !term || p.name.toLowerCase().includes(term) || p.variants.some(v => v.sku.toLowerCase().includes(term));
            return matchCat && matchTerm;
        });

        if (filtered.length === 0) {
            grid.innerHTML = `<div class="col-span-full text-center py-12 text-slate-400 text-xs">No products found matching criteria.</div>`;
            return;
        }

        grid.innerHTML = filtered.map(p => {
            const img = p.imageUrl || '/images/product-placeholder.png';
            const price = Number(p.basePrice).toFixed(2);
            const hasMultipleVariants = p.variants && p.variants.length > 1;
            const inStock = p.totalAvailableStock > 0;

            return `
                <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-3 shadow-sm hover:shadow-md hover:border-blue-500 transition cursor-pointer flex flex-col justify-between group"
                     onclick="onProductClick('${p.productId}')">
                    <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-2.5">
                        <img src="${img}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                        <span class="absolute top-2 right-2 text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm ${inStock ? 'bg-emerald-500 text-white' : 'bg-rose-500 text-white'}">
                            ${inStock ? `${p.totalAvailableStock} in stock` : 'Out of Stock'}
                        </span>
                    </div>
                    <div class="flex-1 flex flex-col justify-between">
                        <div class="text-xs font-bold text-slate-900 dark:text-white line-clamp-2 mb-2 leading-tight" title="${p.name}">${p.name}</div>
                        <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-slate-800">
                            <span class="text-sm font-black text-blue-600 dark:text-blue-400">$${price}</span>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                                ${hasMultipleVariants ? `${p.variants.length} options` : 'Standard'}
                            </span>
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    function onProductClick(productId) {
        const prod = catalog.find(p => p.productId === productId);
        if (!prod) return;

        if (prod.variants.length === 1) {
            addVariantToCart(prod, prod.variants[0]);
        } else {
            openVariantPicker(prod);
        }
    }

    function handleBarcodeScan(code) {
        code = code.trim().toLowerCase();
        for (const prod of catalog) {
            for (const v of prod.variants) {
                if (v.sku.toLowerCase() === code) {
                    addVariantToCart(prod, v);
                    focusBarcode();
                    return;
                }
            }
        }
        alert(`SKU/Barcode '${code}' not found in catalog.`);
        focusBarcode();
    }

    function openVariantPicker(prod) {
        document.getElementById('variantModalTitle').innerText = prod.name;
        document.getElementById('variantModalCategory').innerText = prod.categoryName || 'Catalog Item';

        const list = document.getElementById('variantModalList');
        list.innerHTML = prod.variants.map(v => {
            const available = v.availableQuantity;
            const disabled = available <= 0;
            return `
                <button type="button" class="w-full text-left p-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-blue-500 flex items-center justify-between transition ${disabled ? 'opacity-40 pointer-events-none' : 'cursor-pointer'}" 
                        onclick="onVariantSelected('${prod.productId}', '${v.variantId}')">
                    <div>
                        <div class="text-xs font-bold text-slate-900 dark:text-white">${v.sizeName} / ${v.colorName}</div>
                        <code class="text-[10px] font-mono text-blue-600 dark:text-blue-400">SKU: ${v.sku}</code>
                    </div>
                    <div class="text-right">
                        <span class="text-xs font-black text-blue-600 dark:text-blue-400 block">$${Number(v.price).toFixed(2)}</span>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${available > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700'}">
                            ${available > 0 ? `${available} left` : 'Out of Stock'}
                        </span>
                    </div>
                </button>
            `;
        }).join('');

        const modal = new bootstrap.Modal(document.getElementById('variantPickerModal'));
        modal.show();
    }

    function onVariantSelected(prodId, variantId) {
        const prod = catalog.find(p => p.productId === prodId);
        if (!prod) return;
        const v = prod.variants.find(item => item.variantId === variantId);
        if (!v) return;

        addVariantToCart(prod, v);
        bootstrap.Modal.getInstance(document.getElementById('variantPickerModal')).hide();
        focusBarcode();
    }

    function addVariantToCart(prod, variant) {
        if (variant.availableQuantity <= 0) {
            alert(`Variant '${prod.name} (${variant.sizeName}/${variant.colorName})' is out of stock.`);
            return;
        }

        const existing = cart.find(item => item.variantId === variant.variantId);
        if (existing) {
            if (existing.quantity + 1 > variant.availableQuantity) {
                alert(`Max available stock (${variant.availableQuantity}) reached for this item.`);
                return;
            }
            existing.quantity += 1;
        } else {
            cart.push({
                variantId: variant.variantId,
                productId: prod.productId,
                productName: prod.name,
                sku: variant.sku,
                sizeName: variant.sizeName,
                colorName: variant.colorName,
                price: Number(variant.price),
                quantity: 1,
                maxStock: variant.availableQuantity
            });
        }

        renderCart();
    }

    function updateCartQty(variantId, delta) {
        const item = cart.find(i => i.variantId === variantId);
        if (!item) return;

        const newQty = item.quantity + delta;
        if (newQty <= 0) {
            removeFromCart(variantId);
        } else if (newQty > item.maxStock) {
            alert(`Cannot exceed available stock (${item.maxStock}).`);
        } else {
            item.quantity = newQty;
            renderCart();
        }
    }

    function removeFromCart(variantId) {
        cart = cart.filter(i => i.variantId !== variantId);
        renderCart();
    }

    function clearCart() {
        if (cart.length > 0 && !confirm("Clear all items from current cart?")) return;
        cart = [];
        renderCart();
        focusBarcode();
    }

    function renderCart() {
        const tbody = document.getElementById('cartTableBody');
        const btnPay = document.getElementById('btnPay');

        if (cart.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center py-12 text-slate-400">
                        <i class="bi bi-cart3 text-3xl d-block mb-1 text-slate-300 dark:text-slate-600"></i>
                        <span class="text-xs">Cart is empty. Scan SKU or pick product.</span>
                    </td>
                </tr>
            `;
            btnPay.disabled = true;
            renderCartTotals();
            return;
        }

        btnPay.disabled = false;
        tbody.innerHTML = cart.map(item => {
            const lineTotal = (item.price * item.quantity).toFixed(2);
            return `
                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/30 transition">
                    <td class="py-2.5">
                        <div class="font-bold text-slate-900 dark:text-white truncate max-w-[130px]" title="${item.productName}">${item.productName}</div>
                        <div class="text-[10px] text-slate-400">${item.sizeName} / ${item.colorName}</div>
                    </td>
                    <td class="py-2.5 text-center">
                        <div class="inline-flex items-center border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden bg-white dark:bg-slate-800">
                            <button type="button" class="px-2 py-0.5 text-xs text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700" onclick="updateCartQty('${item.variantId}', -1)">-</button>
                            <span class="px-2 py-0.5 text-xs font-bold text-slate-900 dark:text-white">${item.quantity}</span>
                            <button type="button" class="px-2 py-0.5 text-xs text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700" onclick="updateCartQty('${item.variantId}', 1)">+</button>
                        </div>
                    </td>
                    <td class="py-2.5 text-right font-medium text-slate-500">$${item.price.toFixed(2)}</td>
                    <td class="py-2.5 text-right font-black text-blue-600 dark:text-blue-400">$${lineTotal}</td>
                    <td class="py-2.5 text-center">
                        <button type="button" class="text-slate-400 hover:text-rose-600 transition" onclick="removeFromCart('${item.variantId}')">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </td>
                </tr>
            `;
        }).join('');

        renderCartTotals();
    }

    function renderCartTotals() {
        const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        const discountInput = document.getElementById('cartDiscountInput');
        let discount = parseFloat(discountInput.value) || 0;
        if (discount < 0) discount = 0;
        if (discount > subtotal) discount = subtotal;

        const grandTotalUsd = Math.max(0, subtotal - discount);
        const grandTotalKhr = Math.round(grandTotalUsd * EXCHANGE_RATE);

        document.getElementById('cartSubtotalUsd').innerText = `$${subtotal.toFixed(2)}`;
        document.getElementById('cartTotalUsd').innerText = `$${grandTotalUsd.toFixed(2)}`;
        document.getElementById('cartTotalKhr').innerText = `${grandTotalKhr.toLocaleString()} ៛`;
    }

    // ==========================================
    // CHECKOUT & PAYMENT LOGIC (CASH / KHQR)
    // ==========================================
    let currentPaymentMethod = 'Cash';

    function openCheckoutModal() {
        if (cart.length === 0) return;

        const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        const discount = parseFloat(document.getElementById('cartDiscountInput').value) || 0;
        const totalUsd = Math.max(0, subtotal - discount);
        const totalKhr = Math.round(totalUsd * EXCHANGE_RATE);

        document.getElementById('checkoutModalTotalUsd').innerText = `$${totalUsd.toFixed(2)}`;
        document.getElementById('checkoutModalTotalKhr').innerText = `${totalKhr.toLocaleString()} ៛`;

        // Pre-fill exact cash
        document.getElementById('tenderedUsdInput').value = totalUsd.toFixed(2);
        document.getElementById('tenderedKhrInput').value = '';

        // Default to Cash tab cleanly
        selectPaymentMethod('Cash');

        // Generate dynamic KHQR preview
        generateKhqrPreview(totalUsd);

        const modal = new bootstrap.Modal(document.getElementById('checkoutModal'));
        modal.show();
    }

    function selectPaymentMethod(method) {
        currentPaymentMethod = method;
        const btnCash = document.getElementById('payMethodCashBtn');
        const btnKhqr = document.getElementById('payMethodKhqrBtn');
        const checkCash = document.getElementById('payMethodCashCheck');
        const checkKhqr = document.getElementById('payMethodKhqrCheck');
        const paneCash = document.getElementById('pane-cash');
        const paneKhqr = document.getElementById('pane-khqr');
        const btnSubmit = document.getElementById('btnConfirmSale');

        if (method === 'Cash') {
            btnCash.className = "w-full text-left p-3 rounded-xl border-2 transition-all flex items-center justify-between font-bold text-xs cursor-pointer border-emerald-500 bg-emerald-50/80 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 ring-2 ring-emerald-500/20 shadow-sm";
            btnKhqr.className = "w-full text-left p-3 rounded-xl border-2 transition-all flex items-center justify-between font-bold text-xs cursor-pointer border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:border-slate-300";
            checkCash.classList.remove('hidden');
            checkKhqr.classList.add('hidden');
            paneCash.classList.remove('hidden');
            paneKhqr.classList.add('hidden');
            btnSubmit.className = "px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md hover:shadow-lg transition cursor-pointer flex items-center gap-1.5";
            btnSubmit.innerHTML = '<i class="bi bi-check-circle-fill"></i><span>Complete Sale &amp; Print Slip</span>';
            calculateChange();
        } else {
            btnKhqr.className = "w-full text-left p-3 rounded-xl border-2 transition-all flex items-center justify-between font-bold text-xs cursor-pointer border-rose-500 bg-rose-50/80 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 ring-2 ring-rose-500/20 shadow-sm";
            btnCash.className = "w-full text-left p-3 rounded-xl border-2 transition-all flex items-center justify-between font-bold text-xs cursor-pointer border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:border-slate-300";
            checkKhqr.classList.remove('hidden');
            checkCash.classList.add('hidden');
            paneKhqr.classList.remove('hidden');
            paneCash.classList.add('hidden');
            btnSubmit.className = "px-6 py-2.5 rounded-xl bg-gradient-to-r from-rose-600 to-indigo-600 hover:from-rose-700 hover:to-indigo-700 text-white text-xs font-bold shadow-md hover:shadow-lg transition cursor-pointer flex items-center gap-1.5";
            btnSubmit.innerHTML = '<i class="bi bi-qr-code-scan"></i><span>Confirm KHQR Paid &amp; Print Slip</span>';
        }
    }

    function setTenderedUsd(val) {
        document.getElementById('tenderedUsdInput').value = val.toFixed(2);
        document.getElementById('tenderedKhrInput').value = '';
        calculateChange();
    }

    function setTenderedKhr(val) {
        document.getElementById('tenderedKhrInput').value = val;
        document.getElementById('tenderedUsdInput').value = '';
        calculateChange();
    }

    function setTenderedExact() {
        const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        const discount = parseFloat(document.getElementById('cartDiscountInput').value) || 0;
        const totalUsd = Math.max(0, subtotal - discount);
        document.getElementById('tenderedUsdInput').value = totalUsd.toFixed(2);
        document.getElementById('tenderedKhrInput').value = '';
        calculateChange();
    }

    function calculateChange() {
        const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        const discount = parseFloat(document.getElementById('cartDiscountInput').value) || 0;
        const totalUsd = Math.max(0, subtotal - discount);

        const usdVal = parseFloat(document.getElementById('tenderedUsdInput').value) || 0;
        const khrVal = parseFloat(document.getElementById('tenderedKhrInput').value) || 0;

        const totalTenderedUsd = usdVal + (khrVal > 0 ? khrVal / EXCHANGE_RATE : 0);
        const diffUsd = totalTenderedUsd - totalUsd;

        const changeBox = document.getElementById('changeFeedbackBox');
        const labelTitle = document.getElementById('changeFeedbackTitle');
        const changeUsdEl = document.getElementById('changeDisplayUsd');
        const changeKhrEl = document.getElementById('changeDisplayKhr');

        if (diffUsd >= -0.005) {
            const changeUsd = Math.max(0, diffUsd);
            const changeKhr = Math.round(changeUsd * EXCHANGE_RATE);
            if (changeBox) changeBox.className = "p-4 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/80 rounded-2xl transition";
            if (labelTitle) {
                labelTitle.className = "text-xs font-bold text-emerald-800 dark:text-emerald-300";
                labelTitle.innerHTML = '<i class="bi bi-check-circle mr-1"></i> Change Due (USD):';
            }
            if (changeUsdEl) {
                changeUsdEl.className = "text-2xl font-black text-emerald-600 dark:text-emerald-400";
                changeUsdEl.innerText = `$${changeUsd.toFixed(2)}`;
            }
            if (changeKhrEl) {
                changeKhrEl.className = "text-sm font-mono font-bold text-emerald-600 dark:text-emerald-400";
                changeKhrEl.innerText = `${changeKhr.toLocaleString()} ៛`;
            }
        } else {
            const shortUsd = Math.abs(diffUsd);
            const shortKhr = Math.round(shortUsd * EXCHANGE_RATE);
            if (changeBox) changeBox.className = "p-4 bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-800/80 rounded-2xl transition";
            if (labelTitle) {
                labelTitle.className = "text-xs font-bold text-amber-800 dark:text-amber-300";
                labelTitle.innerHTML = '<i class="bi bi-exclamation-triangle mr-1"></i> Remaining Due (USD):';
            }
            if (changeUsdEl) {
                changeUsdEl.className = "text-2xl font-black text-amber-600 dark:text-amber-400";
                changeUsdEl.innerText = `$${shortUsd.toFixed(2)}`;
            }
            if (changeKhrEl) {
                changeKhrEl.className = "text-sm font-mono font-bold text-amber-600 dark:text-amber-400";
                changeKhrEl.innerText = `${shortKhr.toLocaleString()} ៛`;
            }
        }
    }

    function generateKhqrPreview(amount) {
        const totalKhr = Math.round(amount * EXCHANGE_RATE);
        const amountDisp = document.getElementById('khqrAmountDisplay');
        if (amountDisp) {
            amountDisp.innerText = `Amount: $${amount.toFixed(2)} (${totalKhr.toLocaleString()} ៛)`;
        }

        const qrContainer = document.getElementById('khqrQrContainer');
        qrContainer.innerHTML = '<div class="w-8 h-8 border-2 border-rose-600 border-t-transparent rounded-full animate-spin"></div>';
        
        const simulatedQr = `00020101021229370016bakong@clothe.pos5204599953038405405${amount.toFixed(2)}5802KH5910CLOTHE_POS6010PHNOM_PENH6304`;
        
        if (typeof QRCode !== 'undefined' && QRCode.toCanvas) {
            QRCode.toCanvas(simulatedQr, { width: 180, margin: 1, color: { dark: '#0f172a', light: '#ffffff' } }, function (error, canvas) {
                if (error) {
                    qrContainer.innerHTML = '<span class="text-rose-500 text-xs">QR code generation failed</span>';
                } else {
                    qrContainer.innerHTML = '';
                    qrContainer.appendChild(canvas);
                }
            });
        } else {
            qrContainer.innerHTML = '<div class="text-xs text-slate-500 p-4">KHQR Code Ready</div>';
        }
        document.getElementById('khqrMd5Display').innerText = `Ref: KHQR-${Math.random().toString(36).substring(2, 10).toUpperCase()}`;
    }

    // SALE SUBMISSION
    async function processSaleSubmission() {
        const btn = document.getElementById('btnConfirmSale');
        btn.disabled = true;
        btn.innerHTML = '<span class="inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-1"></span> Processing Sale...';

        const paymentMethod = currentPaymentMethod;
        const discount = parseFloat(document.getElementById('cartDiscountInput').value) || 0;
        const tenderedUsd = parseFloat(document.getElementById('tenderedUsdInput').value) || 0;
        const tenderedKhr = parseFloat(document.getElementById('tenderedKhrInput').value) || 0;

        const payload = {
            items: cart.map(i => ({
                variantId: i.variantId,
                quantity: i.quantity,
                unitPrice: i.price,
                discountPercentage: 0
            })),
            customerName: document.getElementById('customerNameInput').value || "Walk-in Customer",
            customerPhone: null,
            customerEmail: null,
            paymentMethod: paymentMethod,
            discountAmount: discount,
            cashTenderedUsd: tenderedUsd,
            cashTenderedKhr: tenderedKhr,
            exchangeRate: EXCHANGE_RATE,
            note: "In-store POS Register Sale"
        };

        try {
            const res = await fetch('/Admin/Pos/Checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await res.json();

            if (result.success && result.data) {
                lastCheckoutResult = result.data;

                // Clear cart & reload catalog stock
                cart = [];
                renderCart();
                loadCatalog();

                // Smooth modal transition: close checkout modal first, then open receipt modal
                const checkoutModalEl = document.getElementById('checkoutModal');
                const checkoutModalInstance = bootstrap.Modal.getInstance(checkoutModalEl);
                if (checkoutModalInstance) {
                    checkoutModalEl.addEventListener('hidden.bs.modal', function onModalClose() {
                        checkoutModalEl.removeEventListener('hidden.bs.modal', onModalClose);
                        displayReceipt(lastCheckoutResult);
                    }, { once: true });
                    checkoutModalInstance.hide();
                } else {
                    displayReceipt(lastCheckoutResult);
                }
            } else {
                alert(result.message || "Failed to complete transaction.");
            }
        } catch (err) {
            console.error(err);
            alert("Network error processing sale.");
        } finally {
            btn.disabled = false;
            selectPaymentMethod(currentPaymentMethod);
        }
    }

    function displayReceipt(data) {
        document.getElementById('rcptCode').innerText = data.receiptNumber || "REC-0000";
        document.getElementById('rcptDate').innerText = new Date(data.transactionDate).toLocaleString();
        document.getElementById('rcptCashier').innerText = data.cashierName || "Cashier";
        document.getElementById('rcptCustomer').innerText = document.getElementById('customerNameInput').value || "Walk-in Customer";

        const tbody = document.getElementById('rcptItemsTable');
        tbody.innerHTML = (data.items || []).map(i => `
            <tr>
                <td class="text-left py-1 text-slate-800 font-medium">${i.productName} <span class="text-[10px] text-slate-500">(${i.sizeName})</span></td>
                <td class="text-center py-1 text-slate-800 font-bold">${i.quantity}</td>
                <td class="text-right py-1 font-bold text-slate-900">$${Number(i.totalPrice).toFixed(2)}</td>
            </tr>
        `).join('');

        document.getElementById('rcptSubtotal').innerText = `$${Number(data.subtotalUsd).toFixed(2)}`;
        document.getElementById('rcptDiscount').innerText = `-$${Number(data.discountUsd).toFixed(2)}`;
        document.getElementById('rcptTotalUsd').innerText = `$${Number(data.totalAmountUsd).toFixed(2)}`;
        document.getElementById('rcptTotalKhr').innerText = `${Number(data.totalAmountKhr).toLocaleString()} ៛`;

        document.getElementById('rcptPayMethod').innerText = data.paymentMethod;
        document.getElementById('rcptTendered').innerText = `$${Number(data.cashTenderedUsd).toFixed(2)}`;
        document.getElementById('rcptChange').innerText = `$${Number(data.changeUsd).toFixed(2)}`;

        const modal = new bootstrap.Modal(document.getElementById('receiptModal'));
        modal.show();
    }

    function printReceiptSlip() {
        window.print();
    }

