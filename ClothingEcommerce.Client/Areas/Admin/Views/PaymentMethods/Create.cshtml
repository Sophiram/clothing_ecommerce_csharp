@model WebApplication_ClothingEcommerce.Models.PaymentMethod

@{
    ViewData["Title"] = "Create Payment Method";
}

<div class="space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200/80 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-primary-600 dark:text-primary-400 mb-1 tracking-wider uppercase">
                <i class="bi bi-credit-card-2-front"></i>
                <span data-en="FINANCE / PAYMENT METHODS" data-kh="ហិរញ្ញវត្ថុ / វិធីសាស្ត្រទូទាត់">FINANCE / PAYMENT METHODS</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white" data-en="Create Payment Method" data-kh="បង្កើតវិធីសាស្ត្រទូទាត់">
                Create Payment Method
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1" data-en="Add a new payment option for customers at checkout." data-kh="បន្ថែមជម្រើសទូទាត់ថ្មីសម្រាប់អតិថិជនពេលចេញទំនិញ។">
                Add a new payment option for customers at checkout.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-bold shadow-xs transition">
                <i class="bi bi-arrow-left"></i>
                <span data-en="Back to List" data-kh="ត្រឡប់ក្រោយ">Back to List</span>
            </a>
        </div>
    </div>

    <div class="max-w-3xl mx-auto">
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs font-semibold mb-6"></div>

                <div class="space-y-5">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="sm:col-span-2">
                            <label asp-for="Name" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5" data-en="Method Name *" data-kh="ឈ្មោះវិធីទូទាត់ *">Method Name <span class="text-rose-500">*</span></label>
                            <input asp-for="Name" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 transition" placeholder="e.g. KHQR, Wing Bank, Cash on Delivery" required />
                            <span asp-validation-for="Name" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="DisplayOrder" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5" data-en="Display Sort Order" data-kh="លំដាប់បង្ហាញ">Display Sort Order</label>
                            <input asp-for="DisplayOrder" type="number" min="0" value="0" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 transition" />
                            <span asp-validation-for="DisplayOrder" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Description" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5" data-en="Description / Customer Notice" data-kh="ការពិពណ៌នា / សេចក្តីជូនដំណឹង">Description / Customer Notice</label>
                        <textarea asp-for="Description" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 transition" placeholder="Scan KHQR to pay instantly using Bakong or any Cambodian bank app..."></textarea>
                        <span asp-validation-for="Description" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Icon" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5" data-en="Icon Asset URL" data-kh="តំណរូបភាព Icon">Icon Asset URL</label>
                        <div class="relative">
                            <input asp-for="Icon" id="txtCreateIcon" class="w-full pl-4 pr-10 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-xs font-mono focus:outline-none focus:ring-2 focus:ring-primary-500 transition" placeholder="/images/khqr-logo.svg or https://..." oninput="updateCreateIcon(this.value)" />
                            <div class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400" id="createIconPreview">
                                <i class="bi bi-image text-base"></i>
                            </div>
                        </div>
                        <span asp-validation-for="Icon" class="text-rose-500 text-xs mt-1 block"></span>

                        <div class="mt-2.5 flex items-center gap-1.5 flex-wrap">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mr-1">Presets:</span>
                            <button type="button" onclick="setCreatePreset('/images/khqr-logo.svg')" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition cursor-pointer">
                                KHQR
                            </button>
                            <button type="button" onclick="setCreatePreset('/images/aba-logo.svg')" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition cursor-pointer">
                                ABA Pay
                            </button>
                            <button type="button" onclick="setCreatePreset('/images/acleda-logo.svg')" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition cursor-pointer">
                                ACLEDA
                            </button>
                            <button type="button" onclick="setCreatePreset('/images/wing-logo.svg')" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[11px] font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition cursor-pointer">
                                Wing
                            </button>
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 flex items-center justify-between">
                        <div>
                            <label for="chkActiveCreate" class="text-xs font-bold text-slate-900 dark:text-white cursor-pointer block" data-en="Enable for Checkout immediately" data-kh="បើកដំណើរការលើការចេញទំនិញភ្លាមៗ">
                                Enable for Checkout immediately
                            </label>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                                Active methods appear in customer order checkout.
                            </p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
                            <input asp-for="IsActive" type="checkbox" id="chkActiveCreate" checked class="sr-only peer" />
                            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-emerald-600"></div>
                        </label>
                    </div>

                    <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                        <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 text-xs font-bold shadow-xs transition">
                            <span data-en="Cancel" data-kh="បោះបង់">Cancel</span>
                        </a>
                        <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold shadow-md hover:shadow-lg transition flex items-center gap-2 cursor-pointer">
                            <i class="bi bi-plus-lg text-sm"></i>
                            <span data-en="Create Payment Method" data-kh="បង្កើតវិធីទូទាត់">Create Payment Method</span>
                        </button>
                    </div>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function updateCreateIcon(url) {
            const preview = document.getElementById('createIconPreview');
            if (!preview) return;
            url = (url || '').trim();
            if (url) {
                preview.innerHTML = `<img src="${url}" alt="" class="w-5 h-5 object-contain" onerror="this.onerror=null;this.src='/images/khqr-logo.svg';" />`;
            } else {
                preview.innerHTML = `<i class="bi bi-image text-base"></i>`;
            }
        }

        function setCreatePreset(url) {
            const input = document.getElementById('txtCreateIcon');
            if (input) {
                input.value = url;
                updateCreateIcon(url);
            }
        }
    </script>
}