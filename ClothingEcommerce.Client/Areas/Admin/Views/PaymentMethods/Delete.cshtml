@model WebApplication_ClothingEcommerce.Models.PaymentMethod

@{
    ViewData["Title"] = "Delete Payment Method";
}

<div class="admin-page">

    <!-- PAGE HEADER -->
    <div class="page-header mb-4">
        <div>
            <div class="page-eyebrow text-danger" data-en="CONFIRMATION REQUIRED" data-kh="ត្រូវការការបញ្ជាក់">
                CONFIRMATION REQUIRED
            </div>
            <h1 class="page-title text-danger" data-en="Delete Payment Method" data-kh="លុបវិធីសាស្ត្រទូទាត់">
                Delete Payment Method
            </h1>
            <p class="page-description" data-en="Review method details before permanently removing it from checkout." data-kh="ពិនិត្យព័ត៌មានលម្អិតមុនពេលលុបចេញពីប្រព័ន្ធជាអចិន្ត្រៃយ៍។">
                Review method details before permanently removing it from checkout.
            </p>
        </div>

        <div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i>
                <span data-en="Back to List" data-kh="ត្រឡប់ក្រោយ">Back to List</span>
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border shadow-sm rounded-4 bg-white" style="border-radius: 20px; border-color: #fee2e2 !important;">
                <div class="card-body p-4 p-md-5 text-center">

                    <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px; background: #fee2e2; color: #dc2626;">
                        <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                    </div>

                    <h3 class="fw-bold text-dark mb-2">
                        <span data-en="Are you sure you want to delete" data-kh="តើអ្នកប្រាកដជាចង់លុប">Are you sure you want to delete</span>
                        <span class="text-danger">"@Model.Name"</span>?
                    </h3>

                    <p class="text-muted mb-4" data-en="This action cannot be undone if this method is completely removed." data-kh="សកម្មភាពនេះមិនអាចត្រឡប់វិញបានទេ ប្រសិនបើវិធីសាស្ត្រនេះត្រូវបានលុប។">
                        This action cannot be undone if this method is completely removed.
                    </p>

                    @if (Model.Payments.Any())
                    {
                        <div class="alert alert-warning rounded-4 text-start p-4 mb-4 border-warning border-opacity-25" style="background: #fffbeb;">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-shield-exclamation text-warning fs-3 mt-1"></i>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1" data-en="Cannot Delete Active Records" data-kh="មិនអាចលុបទិន្នន័យដែលមានស្រាប់">Cannot Delete Active Records</h6>
                                    <p class="small text-muted mb-0" data-en="This payment method is linked to existing completed or pending orders. For auditing and reporting integrity, please disable this method instead of deleting." data-kh="វិធីសាស្ត្រទូទាត់នេះត្រូវបានភ្ជាប់ជាមួយការបញ្ជាទិញដែលមានស្រាប់។ ដើម្បីសុចរិតភាពនៃរបាយការណ៍ សូមធ្វើការផ្អាកដំណើរការវិធីនេះជំនួសវិញ។">
                                        This payment method is linked to <strong>@Model.Payments.Count</strong> existing checkout payment(s). For auditing and reporting integrity, please disable this method instead of deleting.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                                <span data-en="Back to Payment Methods" data-kh="ត្រឡប់ទៅវិធីទូទាត់">Back to Payment Methods</span>
                            </a>
                            <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-warning rounded-pill px-4 py-2 text-white fw-semibold">
                                    <i class="bi bi-pause-circle me-1"></i>
                                    <span data-en="Disable Method Instead" data-kh="ផ្អាកដំណើរការវិធីនេះជំនួសវិញ">Disable Method Instead</span>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="d-flex justify-content-center gap-3 mt-4">
                                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5">
                                    <span data-en="Cancel" data-kh="បោះបង់">Cancel</span>
                                </a>
                                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                                    <i class="bi bi-trash me-1"></i>
                                    <span data-en="Yes, Delete Permanently" data-kh="បាទ/ចាស លុបជាអចិន្ត្រៃយ៍">Yes, Delete Permanently</span>
                                </button>
                            </div>
                        </form>
                    }

                </div>
            </div>
        </div>
    </div>

</div>