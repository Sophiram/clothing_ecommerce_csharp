                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto">Try adjusting your search criteria or create a new administrator account.</p>
                                <button type="button" class="mt-3 inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold shadow-sm transition" data-bs-toggle="modal" data-bs-target="#createAdminModal">
                                    <i class="bi bi-person-plus-fill"></i> Add Administrator
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

