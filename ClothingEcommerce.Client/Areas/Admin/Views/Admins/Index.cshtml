@model IEnumerable<WebApplication_ClothingEcommerce.Models.ViewModels.AdminListItemViewModel>

@{
    ViewData["Title"] = "Administrators";
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
    var totalAdmins = ViewBag.TotalAdmins ?? Model.Count();
    var superAdminCount = ViewBag.SuperAdminCount ?? Model.Count(m => m.IsSuperAdmin);
    var adminCount = ViewBag.AdminCount ?? Model.Count(m => !m.IsSuperAdmin);
}

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <!-- Breadcrumb -->
            <nav class="flex mb-2" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                    <li class="inline-flex items-center">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hover:text-primary-600 dark:hover:text-primary-400">Admin</a>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span data-en="System" data-kh="ប្រព័ន្ធ">System</span>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span class="text-slate-900 dark:text-white font-semibold" data-en="Administrators" data-kh="អ្នកគ្រប់គ្រង">Administrators</span>
                    </li>
                </ol>
            </nav>

            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-900/50 uppercase tracking-wider">
                    <i class="bi bi-shield-lock-fill"></i> SuperAdmin Control
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-400 hidden sm:inline" data-en="System Security & Access Hierarchy" data-kh="ឋានានុក្រមសិទ្ធិ & សុវត្ថិភាព">System Security &amp; Access Hierarchy</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5" data-en="Administrators Management" data-kh="ការគ្រប់គ្រងអ្នកគ្រប់គ្រង">
                <span class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg">
                    <i class="bi bi-shield-shaded"></i>
                </span>
                Administrators Management
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1" data-en="Manage privileged administrative accounts, hierarchy levels, status, and security credentials." data-kh="គ្រប់គ្រងគណនីអ្នកគ្រប់គ្រង កម្រិតសិទ្ធិ និងសុវត្ថិភាព។">
                Manage privileged administrative accounts, hierarchy levels, status, and security credentials.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" class="inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-sm transition" data-bs-toggle="modal" data-bs-target="#assignAdminModal">
                <i class="bi bi-person-up text-primary-500"></i>
                <span data-en="Assign Admin Role" data-kh="ផ្ដល់សិទ្ធិ Admin">Assign Admin Role</span>
            </button>
            <a asp-action="Create" class="hidden sm:inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-sm transition">
                <i class="bi bi-plus-lg"></i>
                <span data-en="Full Form" data-kh="ទម្រង់ពេញលេញ">Full Form</span>
            </a>
            <button type="button" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold shadow-sm hover:shadow transition" data-bs-toggle="modal" data-bs-target="#createAdminModal">
                <i class="bi bi-person-plus-fill"></i>
                <span data-en="Quick Add Admin" data-kh="បន្ថែម Admin រហ័ស">Quick Add Admin</span>
            </button>
        </div>
    </div>

    <!-- NOTIFICATION ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/80 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-sm shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill text-lg text-emerald-500"></i>
            <span class="flex-1">@TempData["Success"]</span>
            <button type="button" class="text-emerald-500 hover:text-emerald-700 p-1" onclick="this.parentElement.remove();"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="flex items-center gap-3 p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200/80 dark:border-rose-800 text-rose-800 dark:text-rose-300 text-sm shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-lg text-rose-500"></i>
            <span class="flex-1">@TempData["Error"]</span>
            <button type="button" class="text-rose-500 hover:text-rose-700 p-1" onclick="this.parentElement.remove();"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    <!-- STATS ROW -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total Admins -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-950/40 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xl flex-shrink-0">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block">Total Admins</span>
                <strong class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5 block">@totalAdmins</strong>
            </div>
        </div>

        <!-- Super Administrators -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl flex-shrink-0">
                <i class="bi bi-shield-shaded"></i>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block">Super Administrators</span>
                <strong class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5 block">@superAdminCount</strong>
            </div>
        </div>

        <!-- Store Administrators -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl flex-shrink-0">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block">Store Administrators</span>
                <strong class="text-2xl font-bold text-slate-900 dark:text-white mt-0.5 block">@adminCount</strong>
            </div>
        </div>

        <!-- Your Account -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow transition flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center text-xl flex-shrink-0">
                <i class="bi bi-shield-check"></i>
            </div>
            <div class="min-w-0">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 block">Your Account</span>
                <strong class="text-base font-bold text-slate-900 dark:text-white truncate block mt-0.5">@(User.Identity?.Name ?? "SuperAdmin")</strong>
            </div>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm">
        <form method="get" asp-action="Index" class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
            <div class="flex flex-1 max-w-xl items-center gap-2">
                <div class="relative flex-1">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search" class="w-full pl-9 pr-4 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition" placeholder="Search by name, email, phone..." />
                </div>
                <button type="submit" class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium transition shadow-sm">Search</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Clear Search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>

            <div class="flex items-center gap-2">
                <a asp-action="Index" class="px-3 py-1.5 rounded-full text-xs font-semibold transition @(string.IsNullOrEmpty(ViewBag.RoleFilter as string) ? "bg-primary-600 text-white shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200/60 dark:border-slate-700")">All</a>
                <a asp-action="Index" asp-route-roleFilter="SuperAdmin" class="px-3 py-1.5 rounded-full text-xs font-semibold transition @(ViewBag.RoleFilter == "SuperAdmin" ? "bg-primary-600 text-white shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200/60 dark:border-slate-700")">SuperAdmins</a>
                <a asp-action="Index" asp-route-roleFilter="Admin" class="px-3 py-1.5 rounded-full text-xs font-semibold transition @(ViewBag.RoleFilter == "Admin" ? "bg-primary-600 text-white shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200/60 dark:border-slate-700")">Admins</a>
            </div>
        </form>
    </div>

    <!-- TABLE CARD -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                        <th class="py-3.5 pl-6 pr-4">Administrator</th>
                        <th class="py-3.5 px-4">Email &amp; Status</th>
                        <th class="py-3.5 px-4">Phone</th>
                        <th class="py-3.5 px-4">Hierarchy / Role</th>
                        <th class="py-3.5 px-4">Account State</th>
                        <th class="py-3.5 pl-4 pr-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 text-sm">
                    @if (Model.Any())
                    {
                        @foreach (var admin in Model)
                        {
                            var initial = !string.IsNullOrEmpty(admin.FirstName) ? admin.FirstName.Substring(0, 1).ToUpper() : "A";

                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                                <!-- Administrator -->
                                <td class="py-4 pl-6 pr-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(admin.AvatarUrl))
                                        {
                                            <img src="@admin.AvatarUrl" alt="@admin.FullName" class="w-10 h-10 rounded-full object-cover shadow-sm ring-2 ring-white dark:ring-slate-800 flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-full bg-slate-900 dark:bg-slate-700 text-white flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">
                                                @initial
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <a asp-action="Details" asp-route-id="@admin.Id" class="text-slate-900 dark:text-white font-semibold hover:text-primary-600 dark:hover:text-primary-400 transition truncate">
                                                    @(string.IsNullOrEmpty(admin.FullName) ? "Administrator" : admin.FullName)
                                                </a>
                                                @if (admin.IsCurrentAdmin)
                                                {
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary-50 dark:bg-primary-950/50 text-primary-600 dark:text-primary-400 border border-primary-200/50 dark:border-primary-800/50 uppercase tracking-wider">
                                                        You
                                                    </span>
                                                }
                                            </div>
                                            <span class="text-xs text-slate-400 dark:text-slate-500 font-mono block">ID: @admin.Id.Substring(0, Math.Min(admin.Id.Length, 8))...</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Email & Status -->
                                <td class="py-4 px-4">
                                    <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">@admin.Email</div>
                                    @if (admin.EmailConfirmed)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-900/50 mt-1">
                                            <i class="bi bi-check-circle"></i>Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-900/50 mt-1">
                                            <i class="bi bi-exclamation-circle"></i>Unconfirmed
                                        </span>
                                    }
                                </td>

                                <!-- Phone -->
                                <td class="py-4 px-4 text-xs text-slate-500 dark:text-slate-400">
                                    @(string.IsNullOrEmpty(admin.PhoneNumber) ? "—" : admin.PhoneNumber)
                                </td>

                                <!-- Hierarchy / Role -->
                                <td class="py-4 px-4">
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var role in admin.Roles)
                                        {
                                            if (role == "SuperAdmin")
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 border border-amber-200/60 dark:border-amber-900/50">
                                                    <i class="bi bi-shield-fill-check"></i> SuperAdmin
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-primary-50 dark:bg-primary-950/40 text-primary-700 dark:text-primary-400 border border-primary-200/60 dark:border-primary-900/50">
                                                    <i class="bi bi-shield-check"></i> Admin
                                                </span>
                                            }
                                        }
                                    </div>
                                </td>

                                <!-- Account State -->
                                <td class="py-4 px-4">
                                    @if (admin.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-900/50">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 border border-rose-200/60 dark:border-rose-900/50">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                            Deactivated
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="py-4 pl-4 pr-6 text-right">
                                    <div class="dropdown relative inline-block text-left">
                                        <button class="action-meatball-btn w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition" type="button" aria-expanded="false" title="Actions" onclick="toggleActionMenu(this, event)">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-meatball dropdown-menu-end hidden absolute right-0 mt-2 w-48 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl py-1.5 z-[9999] focus:outline-none">
                                            <!-- View Details -->
                                            <li>
                                                <a class="dropdown-item flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition" asp-action="Details" asp-route-id="@admin.Id">
                                                    <i class="bi bi-eye text-primary-500"></i> <span>View Profile</span>
                                                </a>
                                            </li>

                                            <!-- Edit Admin -->
                                            <li>
                                                <button type="button" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition"
                                                        data-bs-toggle="modal" data-bs-target="#editAdminModal"
                                                        data-id="@admin.Id"
                                                        data-firstname="@admin.FirstName"
                                                        data-lastname="@admin.LastName"
                                                        data-email="@admin.Email"
                                                        data-phone="@admin.PhoneNumber"
                                                        data-role="@(admin.IsSuperAdmin ? "SuperAdmin" : "Admin")"
                                                        data-active="@admin.IsActive.ToString().ToLower()"
                                                        data-confirmed="@admin.EmailConfirmed.ToString().ToLower()">
                                                    <i class="bi bi-pencil text-amber-500"></i> <span>Edit Admin</span>
                                                </button>
                                            </li>

                                            <!-- Toggle Status (Activate / Deactivate) -->
                                            @if (!admin.IsCurrentAdmin)
                                            {
                                                <li>
                                                    <form method="post" asp-action="ToggleStatus" asp-route-id="@admin.Id" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        @if (admin.IsActive)
                                                        {
                                                            <button type="submit" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition" onclick="return confirm('Are you sure you want to deactivate @admin.FullName?');">
                                                                <i class="bi bi-slash-circle text-rose-500"></i> <span>Deactivate</span>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition">
                                                                <i class="bi bi-check2-circle text-emerald-500"></i> <span>Activate</span>
                                                            </button>
                                                        }
                                                    </form>
                                                </li>
                                            }

                                            <!-- Reset Password Trigger -->
                                            <li>
                                                <button type="button" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition"
                                                        data-bs-toggle="modal" data-bs-target="#resetPasswordModal"
                                                        data-id="@admin.Id"
                                                        data-name="@admin.FullName">
                                                    <i class="bi bi-key text-sky-500"></i> <span>Reset Password</span>
                                                </button>
                                            </li>

                                            <!-- Revoke Admin Role -->
                                            @if (!admin.IsCurrentAdmin && !admin.IsSuperAdmin)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition"
                                                            data-bs-toggle="modal" data-bs-target="#revokeAdminModal"
                                                            data-id="@admin.Id"
                                                            data-name="@admin.FullName"
                                                            data-email="@admin.Email">
                                                        <i class="bi bi-person-dash text-amber-500"></i> <span>Revoke Admin</span>
                                                    </button>
                                                </li>
                                            }

                                            <li><div class="my-1 border-t border-slate-100 dark:border-slate-800"></div></li>

                                            <!-- Delete Trigger -->
                                            @if (admin.IsCurrentAdmin)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-400 dark:text-slate-600 opacity-60 cursor-not-allowed" disabled>
                                                        <i class="bi bi-trash"></i> <span>Delete (Self)</span>
                                                    </button>
                                                </li>
                                            }
                                            else if (admin.IsSuperAdmin)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-slate-400 dark:text-slate-600 opacity-60 cursor-not-allowed" disabled>
                                                        <i class="bi bi-shield-lock-fill"></i> <span>Delete Protected</span>
                                                    </button>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item w-full flex items-center gap-2.5 px-4 py-2 text-xs font-medium text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition"
                                                            data-bs-toggle="modal" data-bs-target="#deleteAdminModal"
                                                            data-id="@admin.Id"
                                                            data-name="@admin.FullName"
                                                            data-email="@admin.Email">
                                                        <i class="bi bi-trash"></i> <span>Delete Admin</span>
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-500 dark:text-slate-400">
                                <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-2xl text-slate-400 mb-3">
                                    <i class="bi bi-shield-x"></i>
                                </div>
