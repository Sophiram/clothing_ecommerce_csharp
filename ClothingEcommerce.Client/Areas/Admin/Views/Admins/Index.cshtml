@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Populate Edit Modal
        const editModal = document.getElementById('editAdminModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('editAdminId').value = button.getAttribute('data-id') || '';
                document.getElementById('editAdminFirstName').value = button.getAttribute('data-firstname') || '';
                document.getElementById('editAdminLastName').value = button.getAttribute('data-lastname') || '';
                document.getElementById('editAdminEmail').value = button.getAttribute('data-email') || '';
                document.getElementById('editAdminPhone').value = button.getAttribute('data-phone') || '';
                document.getElementById('editAdminRole').value = button.getAttribute('data-role') || 'Admin';
                document.getElementById('editAdminActive').checked = (button.getAttribute('data-active') === 'true');
                document.getElementById('editAdminConfirmed').checked = (button.getAttribute('data-confirmed') === 'true');
            });
        }

        // Populate Reset Password Modal
        const resetModal = document.getElementById('resetPasswordModal');
        if (resetModal) {
            resetModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('resetPasswordAdminId').value = button.getAttribute('data-id') || '';
                const name = button.getAttribute('data-name') || 'Administrator';
                document.getElementById('resetAdminNameLabel').textContent = 'Set a new password for ' + name;
            });
        }

        // Populate Delete Modal
        const deleteModal = document.getElementById('deleteAdminModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('deleteAdminId').value = button.getAttribute('data-id') || '';
                document.getElementById('deleteAdminName').textContent = button.getAttribute('data-name') || '';
                document.getElementById('deleteAdminEmail').textContent = button.getAttribute('data-email') || '';
            });
        }

        // Populate Revoke Admin Modal
        const revokeModal = document.getElementById('revokeAdminModal');
        if (revokeModal) {
            revokeModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('revokeAdminId').value = button.getAttribute('data-id') || '';
                document.getElementById('revokeAdminName').textContent = button.getAttribute('data-name') || '';
                document.getElementById('revokeAdminEmail').textContent = button.getAttribute('data-email') || '';
            });
        }
    </script>
}
