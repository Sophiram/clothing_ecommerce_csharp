@model WebApplication_ClothingEcommerce.Models.ViewModels.AdminEditViewModel

@{
    ViewData["Title"] = $"Edit Administrator";
}

<div class="container-fluid px-4 py-3" style="max-width: 800px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill border px-3">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <span class="text-muted">/</span>
            <span class="fw-semibold text-dark">Edit Administrator</span>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="mb-4">
            <h4 class="fw-bold mb-1 text-dark">Modify Account Profile</h4>
            <p class="text-muted small mb-0">Update identity information, role permissions, and active status.</p>
        </div>

        <form method="post" asp-action="Edit" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- Profile Picture Section -->
            <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded-4">
                @{
                    var avatarUrl = ViewBag.AvatarUrl as string;
                    var initial = !string.IsNullOrEmpty(Model.FirstName) ? Model.FirstName.Substring(0, 1).ToUpper() : "A";
                }
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <img id="adminAvatarPreview" src="@avatarUrl" alt="Avatar" class="rounded-circle shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />
                }
                else
                {
                    <div id="adminAvatarFallback" class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm" style="width: 70px; height: 70px;">
                        @initial
                    </div>
                    <img id="adminAvatarPreview" src="" alt="Avatar" class="rounded-circle shadow-sm d-none" style="width: 70px; height: 70px; object-fit: cover;" />
                }
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label fw-semibold small mb-0">Profile Photo</label>
                        @if (!string.IsNullOrEmpty(avatarUrl))
                        {
                            <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0" onclick="document.getElementById('removeAdminAvatarForm').submit();">
                                <i class="bi bi-trash me-1"></i>Remove
                            </button>
                        }
                    </div>
                    <input type="file" name="avatarFile" class="form-control form-control-sm rounded-3" accept="image/jpeg,image/png,image/webp" onchange="previewAdminAvatar(this)" />
                    <div class="form-text small" style="font-size: 11px;">Upload JPG, PNG, or WebP photo (Max 5MB).</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label fw-semibold small"></label>
                    <input asp-for="FirstName" class="form-control rounded-3" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label fw-semibold small"></label>
                    <input asp-for="LastName" class="form-control rounded-3" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Email" class="form-label fw-semibold small"></label>
                    <input asp-for="Email" class="form-control rounded-3" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                    <input asp-for="PhoneNumber" class="form-control rounded-3" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Role" class="form-label fw-semibold small"></label>
                    <select asp-for="Role" class="form-select rounded-3">
                        <option value="Admin">Admin (Store &amp; Catalog Management)</option>
                        <option value="SuperAdmin">SuperAdmin (Full Platform &amp; System Access)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="card bg-light border-0 p-3 rounded-3 mt-2">
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="activeSwitch" />
                                <label class="form-check-label fw-semibold small" for="activeSwitch">
                                    Account Active (Can log in)
                                </label>
                                <div class="text-muted" style="font-size: 11px;">
                                    If unchecked, account will be locked out and denied login.
                                </div>
                            </div>

                            <div class="form-check form-switch">
                                <input asp-for="EmailConfirmed" class="form-check-input" type="checkbox" role="switch" id="emailSwitch" />
                                <label class="form-check-label fw-semibold small" for="emailSwitch">
                                    Email Confirmed
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-dark rounded-pill px-4">
                    <i class="bi bi-check2 me-1"></i> Save Changes
                </button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(ViewBag.AvatarUrl as string))
        {
            <form id="removeAdminAvatarForm" asp-action="RemoveAvatar" method="post" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewAdminAvatar(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.getElementById('adminAvatarPreview');
                    var fallback = document.getElementById('adminAvatarFallback');
                    if (img) {
                        img.src = e.target.result;
                        img.classList.remove('d-none');
                    }
                    if (fallback) {
                        fallback.classList.add('d-none');
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
