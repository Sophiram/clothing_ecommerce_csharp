@model IEnumerable<WebApplication_ClothingEcommerce.Models.Review>

@{
    ViewData["Title"] = "Customer Reviews";
}

<div class="admin-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <div class="page-eyebrow">CUSTOMERS & SOCIAL PROOF</div>
            <h1 class="page-title">Reviews</h1>
            <p class="page-description">Moderate, inspect, and analyze customer feedback across all clothing items.</p>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="admin-alert admin-alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    <!-- STAT PILLS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold">Total Reviews</small>
                        <h3 class="fw-bold mb-0 mt-1">@ViewBag.TotalCount</h3>
                    </div>
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle">
                        <i class="bi bi-chat-heart fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold">Average Rating</small>
                        <h3 class="fw-bold mb-0 mt-1 text-warning">
                            @(((double)ViewBag.AverageRating).ToString("0.0")) <i class="bi bi-star-fill text-warning fs-5"></i>
                        </h3>
                    </div>
                    <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-circle">
                        <i class="bi bi-star-half fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold">5-Star Ratings</small>
                        <h3 class="fw-bold mb-0 mt-1 text-success">@ViewBag.FiveStarCount</h3>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle">
                        <i class="bi bi-hand-thumbs-up fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white rounded-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold">Critical (1-2 Stars)</small>
                        <h3 class="fw-bold mb-0 mt-1 text-danger">@ViewBag.CriticalCount</h3>
                    </div>
                    <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-circle">
                        <i class="bi bi-exclamation-octagon fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CARD -->
    <div class="admin-card">

        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">All Customer Reviews</h3>
                <p class="admin-card-subtitle">Customer ratings and comments</p>
            </div>
            <div class="admin-card-count">
                <span>@(Model?.Count() ?? 0)</span>
                <small>total</small>
            </div>
        </div>

        <!-- SEARCH & FILTER -->
        <div class="search-wrapper">
            <form asp-action="Index" method="get" class="search-form flex-wrap gap-2">
                <div class="search-input-wrapper" style="flex: 2; min-width: 240px;">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="search-input" placeholder="Search product, customer, or comment keywords..." />
                </div>

                <div class="search-input-wrapper" style="flex: 1; min-width: 160px;">
                    <select name="rating" class="search-input">
                        <option value="">All Ratings</option>
                        <option value="5" selected="@(ViewBag.Rating == 5)">5 Stars ★★★★★</option>
                        <option value="4" selected="@(ViewBag.Rating == 4)">4+ Stars ★★★★☆</option>
                        <option value="3" selected="@(ViewBag.Rating == 3)">3+ Stars ★★★☆☆</option>
                        <option value="2" selected="@(ViewBag.Rating == 2)">2 Stars or lower</option>
                    </select>
                </div>

                <button type="submit" class="btn-search">
                    <i class="bi bi-funnel"></i> Filter
                </button>
                <a asp-action="Index" class="btn-reset">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </a>
            </form>
        </div>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Customer</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var primaryImg = item.Product?.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl 
                                            ?? item.Product?.Images?.FirstOrDefault()?.ImageUrl;

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(primaryImg))
                                        {
                                            <img src="@primaryImg" alt="@item.Product?.Name" class="rounded border" style="width: 44px; height: 44px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted" style="width: 44px; height: 44px;">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                        <div>
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="fw-bold text-dark text-decoration-none">
                                                @item.Product?.Name
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@(item.Customer != null ? $"{item.Customer.FirstName} {item.Customer.LastName}".Trim() : "Customer")</div>
                                    <small class="text-muted">@(item.Customer?.Email ?? "N/A")</small>
                                </td>
                                <td>
                                    <div class="text-warning text-nowrap">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            if (i <= item.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted"></i>
                                            }
                                        }
                                        <span class="ms-1 fw-bold text-dark">@item.Rating/5</span>
                                    </div>
                                </td>
                                <td>
                                    <p class="mb-0 text-muted small text-truncate" style="max-width: 320px;">
                                        @(string.IsNullOrWhiteSpace(item.Comment) ? "— (No text comment)" : item.Comment)
                                    </p>
                                </td>
                                <td>
                                    <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</small>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn" title="View Review">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <button type="button" class="action-btn action-danger" title="Delete Review"
                                                data-bs-toggle="modal" data-bs-target="#deleteReviewModal"
                                                data-id="@item.Id"
                                                data-product="@item.Product?.Name">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state py-5 text-center">
                                    <div class="empty-icon fs-1 text-muted mb-2"><i class="bi bi-star"></i></div>
                                    <h5>No customer reviews found</h5>
                                    <p class="text-muted">Reviews submitted by customers on product pages will appear here for moderation.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

<!-- Delete Review Modal -->
<div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteReviewId" />
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Delete Review</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to permanently delete this customer review for <strong id="deleteReviewProduct"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteReviewModal = document.getElementById('deleteReviewModal');
        if (deleteReviewModal) {
            deleteReviewModal.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                document.getElementById('deleteReviewId').value = btn.getAttribute('data-id');
                document.getElementById('deleteReviewProduct').textContent = btn.getAttribute('data-product');
            });
        }
    </script>
}
