@model WebApplication_ClothingEcommerce.Models.Payment
@{
    ViewData["Title"] = "Record Payment";
}

<div class="admin-page">
    <!-- PAGE HEADER -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="page-eyebrow">
                <a asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i> Back to Payments</a>
            </div>
            <h1 class="page-title">Record Payment Transaction</h1>
            <p class="page-description">Manually record or reconcile a customer payment against an order.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h3 class="admin-card-title"><i class="bi bi-credit-card me-2 text-primary"></i>Payment Details</h3>
                    <p class="admin-card-subtitle">Enter transaction information below</p>
                </div>

                <div class="p-4">
                    <form asp-action="Create">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-danger mb-3"></div>

                        <div class="row g-4">
                            <!-- ORDER -->
                            <div class="col-md-6">
                                <label asp-for="OrderId" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">Order Identifier (GUID)</label>
                                <input asp-for="OrderId" class="form-control" placeholder="Enter Order GUID" />
                                <span asp-validation-for="OrderId" class="text-danger small"></span>
                            </div>

                            <!-- PAYMENT METHOD -->
                            <div class="col-md-6">
                                <label asp-for="PaymentMethodId" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">Payment Gateway / Method</label>
                                <select asp-for="PaymentMethodId" class="form-select" asp-items="ViewBag.PaymentMethodId">
                                    <option value="">Select payment method</option>
                                </select>
                                <span asp-validation-for="PaymentMethodId" class="text-danger small"></span>
                            </div>

                            <!-- STATUS -->
                            <div class="col-md-6">
                                <label asp-for="PaymentStatus" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">Initial Settlement Status</label>
                                <select asp-for="PaymentStatus" class="form-select" asp-items="ViewBag.PaymentStatus">
                                    <option value="">Select status</option>
                                </select>
                                <span asp-validation-for="PaymentStatus" class="text-danger small"></span>
                            </div>

                            <!-- AMOUNT -->
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">Captured Amount ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>

                            <!-- PAID AT -->
                            <div class="col-md-6">
                                <label asp-for="PaidAt" class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">Paid Timestamp</label>
                                <input asp-for="PaidAt" class="form-control" type="datetime-local" />
                                <span asp-validation-for="PaidAt" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="border-top mt-4 pt-3 d-flex gap-2">
                            <button type="submit" class="btn-primary-custom px-4">
                                <i class="bi bi-check-lg me-1"></i> Record Payment
                            </button>
                            <a asp-action="Index" class="btn btn-light border rounded-pill px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
