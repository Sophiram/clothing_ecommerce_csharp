@model WebApplication_ClothingEcommerce.Models.Size
@{
    ViewData["Title"] = "Delete Size";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 text-center">
                    <div class="text-danger mb-3"><i class="bi bi-exclamation-triangle-fill fs-1"></i></div>
                    <h3 class="fw-bold">Delete Size?</h3>
                    <p class="text-muted">Are you sure you want to delete this size?</p>

                    <div class="border rounded p-3 mb-4 bg-light">
                        <span class="badge bg-secondary fs-5">@Model.Name</span>
                    </div>

                    @if (Model.Variants != null && Model.Variants.Any())
                    {
                        <div class="alert alert-warning text-start">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <strong>Warning:</strong> Delete will affect <strong>@Model.Variants.Count</strong> linked variant(s).
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-fill">Yes, Delete</button>
                            <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>