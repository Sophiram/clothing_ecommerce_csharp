@model WebApplication_ClothingEcommerce.Models.Brand

@{
    ViewData["Title"] = "Create Brand";
}

<div class="container-fluid py-4">

    <!-- HEADER -->

    <div class="mb-4">

        <div class="text-uppercase text-muted small fw-bold mb-1">
            Catalog / Brands
        </div>

        <h1 class="h3 fw-bold mb-1">
            Create Brand
        </h1>

        <p class="text-muted mb-0">
            Add a new brand to your clothing store.
        </p>

    </div>


    <!-- FORM -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">

            <h5 class="fw-bold mb-1">
                Brand Information
            </h5>

            <p class="text-muted small mb-0">
                Enter the brand information and upload its logo.
            </p>

        </div>


        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="row g-4">


                    <!-- NAME -->

                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            Brand Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Nike" />

                        <span asp-validation-for="Name"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- LOGO -->

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Brand Logo
                        </label>

                        <!-- TAB TOGGLE -->
                        <div class="img-input-tabs">
                            <button type="button" class="img-input-tab-btn active" data-tab="upload" onclick="switchImgTab('create','upload')">
                                <i class="bi bi-upload"></i> Upload File
                            </button>
                            <button type="button" class="img-input-tab-btn" data-tab="url" onclick="switchImgTab('create','url')">
                                <i class="bi bi-link-45deg"></i> Paste URL
                            </button>
                        </div>

                        <!-- UPLOAD PANEL -->
                        <div class="img-input-panel active" id="createPanel-upload">
                            <input type="file"
                                   name="logo"
                                   id="createLogoFile"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,.svg"
                                   onchange="previewImgFile(this,'createPreviewImg','createPreviewEmpty')" />
                            <div class="form-text">JPG, JPEG, PNG, WEBP or SVG. Maximum 5 MB.</div>
                        </div>

                        <!-- URL PANEL -->
                        <div class="img-input-panel" id="createPanel-url">
                            <div class="img-url-group">
                                <input type="text"
                                       name="logoUrl"
                                       id="createLogoUrl"
                                       class="form-control"
                                       placeholder="https://example.com/logo.png"
                                       oninput="previewImgUrl(this.value,'createPreviewImg','createPreviewEmpty')" />
                                <button type="button" class="img-clipboard-btn" onclick="pasteFromClipboard('createLogoUrl','createPreviewImg','createPreviewEmpty',this)" title="Paste from clipboard">
                                    <i class="bi bi-clipboard"></i> Paste
                                </button>
                            </div>
                            <div class="form-text">Paste a direct link to the brand logo.</div>
                        </div>

                        <!-- PREVIEW -->
                        <div class="img-preview-box">
                            <div class="img-preview-empty" id="createPreviewEmpty">
                                <i class="bi bi-image"></i>
                                Logo preview
                            </div>
                            <img id="createPreviewImg" src="" alt="Preview" />
                        </div>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter brand description..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- ACTIONS -->

                <div class="border-top mt-4 pt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-dark">

                        <i class="bi bi-check-lg me-1"></i>
                        Create Brand

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function switchImgTab(prefix, tab) {
            const btns = document.querySelectorAll(`[onclick*="switchImgTab('${prefix}'"]`);
            btns.forEach(b => b.classList.toggle('active', b.getAttribute('data-tab') === tab));
            ['upload','url'].forEach(t => {
                const p = document.getElementById(`${prefix}Panel-${t}`);
                if (p) p.classList.toggle('active', t === tab);
            });
            const prevImg = document.getElementById(`${prefix}PreviewImg`);
            const prevEmpty = document.getElementById(`${prefix}PreviewEmpty`);
            if (prevImg) { prevImg.src = ''; prevImg.classList.remove('visible'); }
            if (prevEmpty) prevEmpty.style.display = '';
            if (tab === 'upload') {
                const u = document.getElementById(`${prefix}LogoUrl`);
                if (u) u.value = '';
            } else {
                const f = document.getElementById(`${prefix}LogoFile`);
                if (f) f.value = '';
            }
        }

        function previewImgFile(input, previewId, emptyId) {
            const preview = document.getElementById(previewId);
            const empty = document.getElementById(emptyId);
            if (!preview || !empty) return;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.classList.add('visible');
                    empty.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.src = ''; preview.classList.remove('visible'); empty.style.display = '';
            }
        }

        function previewImgUrl(url, previewId, emptyId) {
            const preview = document.getElementById(previewId);
            const empty = document.getElementById(emptyId);
            if (!preview || !empty) return;
            if (!url || !url.trim()) {
                preview.src = ''; preview.classList.remove('visible'); empty.style.display = ''; return;
            }
            preview.onload = () => { preview.classList.add('visible'); empty.style.display = 'none'; };
            preview.onerror = () => { preview.classList.remove('visible'); empty.style.display = ''; };
            preview.src = url.trim();
        }

        async function pasteFromClipboard(inputId, previewId, emptyId, btn) {
            try {
                const text = await navigator.clipboard.readText();
                const input = document.getElementById(inputId);
                if (input) { input.value = text; previewImgUrl(text, previewId, emptyId); }
                if (btn) {
                    btn.classList.add('pasted');
                    btn.innerHTML = '<i class="bi bi-check-lg"></i> Pasted!';
                    setTimeout(() => { btn.classList.remove('pasted'); btn.innerHTML = '<i class="bi bi-clipboard"></i> Paste'; }, 2000);
                }
            } catch (e) {
                if (window.__notyf) window.__notyf.error('Clipboard access denied. Please paste manually (Ctrl+V).');
            }
        }
    </script>
}