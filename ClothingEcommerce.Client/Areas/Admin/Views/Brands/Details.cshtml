@model WebApplication_ClothingEcommerce.Models.Brand

@{
    ViewData["Title"] = "Brand Details";
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <div class="page-eyebrow">CATALOG</div>
            <h1 class="page-title">Brand Details</h1>
            <p class="page-description">View brand information and products.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn-reset"><i class="bi bi-arrow-left"></i> Back</a>
            <button type="button" class="btn-primary-custom" data-bs-toggle="modal" data-bs-target="#editBrandModal"
                    data-id="@Model.Id"
                    data-name="@Model.Name"
                    data-description="@Model.Description"
                    data-logo="@Model.Logo">
                <i class="bi bi-pencil"></i> Edit
            </button>
        </div>
    </div>

    <div id="alertPlaceholder"></div>

    <!-- OVERVIEW CARD -->
    <div class="admin-card mb-4">
        <div style="padding: 26px;">
            <div class="d-flex flex-wrap align-items-center gap-4">

                @if (!string.IsNullOrWhiteSpace(Model.Logo))
                {
                    <img src="@Model.Logo" alt="@Model.Name" class="brand-logo-thumb-lg" />
                }
                else
                {
                    <div class="brand-logo-placeholder-lg"><i class="bi bi-award"></i></div>
                }

                <div class="flex-grow-1">
                    <h2 class="fw-bold mb-1">@Model.Name</h2>
                    <div class="text-muted small mb-2">Brand ID: <code>@Model.Id</code></div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-0">@Model.Description</p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">No description available.</p>
                    }
                </div>

                <div class="brand-stat-box">
                    <div class="brand-stat-label">Products</div>
                    <div class="brand-stat-value">@(Model.Products?.Count ?? 0)</div>
                </div>

            </div>
        </div>
    </div>

    <!-- BRAND INFO CARD -->
    <div class="admin-card mb-4">
        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">Brand Information</h3>
                <p class="admin-card-subtitle">Basic information about this brand.</p>
            </div>
        </div>

        <div style="padding: 0 26px 26px;">
            <div class="row g-4">

                <div class="col-md-6">
                    <div class="detail-label">Brand Name</div>
                    <div class="fw-semibold">@Model.Name</div>
                </div>

                <div class="col-md-6">
                    <div class="detail-label">Total Products</div>
                    <span class="payment-count">@(Model.Products?.Count ?? 0)</span>
                </div>

                <div class="col-12">
                    <div class="detail-label">Description</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div>@Model.Description</div>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">No description available.</span>
                    }
                </div>

                <div class="col-12">
                    <div class="detail-label">Logo</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <code>@Model.Logo</code>
                    }
                    else
                    {
                        <span class="text-muted">No logo uploaded.</span>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- PRODUCTS CARD -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <h3 class="admin-card-title">Brand Products</h3>
                <p class="admin-card-subtitle">Products associated with @Model.Name.</p>
            </div>
            <div class="admin-card-count">
                <span>@(Model.Products?.Count ?? 0)</span>
                <small>total</small>
            </div>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Variants</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products != null && Model.Products.Any())
                    {
                        @foreach (var product in Model.Products)
                        {
                            var firstVariant = product.Variants?.FirstOrDefault();

                            <tr>
                                <td>
                                    <div class="payment-name">@product.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(product.Gender))
                                    {
                                        <small class="text-muted">@product.Gender</small>
                                    }
                                </td>
                                <td>
                                    @if (product.Category != null)
                                    {
                                        <span class="tag-badge">@product.Category.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><span class="payment-count">@(product.Variants?.Count ?? 0)</span></td>
                                <td>
                                    @if (firstVariant != null)
                                    {
                                        @firstVariant.Price.ToString("C")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (product.Status.ToString() == "Active")
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">@product.Status</span>
                                    }
                                </td>
                                <td><small>@product.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</small></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-box-seam"></i></div>
                                    <h5>No products</h5>
                                    <p>This brand does not have any products yet.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Edit Modal (same as Index) -->
<div class="modal fade" id="editBrandModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editBrandForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Brand</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="editErrors" class="admin-alert admin-alert-danger d-none"></div>

                    <div class="mb-3 d-flex align-items-center gap-3">
                        <img id="editLogoPreview" src="" alt="" class="brand-logo-thumb d-none" />
                        <div id="editLogoPlaceholder" class="brand-logo-placeholder"><i class="bi bi-award"></i></div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="removeLogo" id="editRemoveLogo" value="true" />
                            <label class="form-check-label small" for="editRemoveLogo">Remove current logo</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input name="Name" id="editName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" id="editDescription" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Replace Logo</label>
                        <input type="file" name="logo" class="form-control" accept=".jpg,.jpeg,.png,.webp,.svg" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-reset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .detail-label {
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 700;
        color: #9ca3af;
        margin-bottom: 4px;
        letter-spacing: 0.03em;
    }

    .brand-logo-thumb {
        width: 52px;
        height: 52px;
        object-fit: contain;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #fff;
    }

    .brand-logo-placeholder {
        width: 52px;
        height: 52px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        font-size: 1.2rem;
    }

    .brand-logo-thumb-lg {
        width: 120px;
        height: 120px;
        object-fit: contain;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #fff;
    }

    .brand-logo-placeholder-lg {
        width: 120px;
        height: 120px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        font-size: 2.5rem;
    }

    .brand-stat-box {
        text-align: center;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 14px 22px;
        min-width: 110px;
    }

    .brand-stat-label {
        text-transform: uppercase;
        font-size: 0.7rem;
        font-weight: 700;
        color: #9ca3af;
    }

    .brand-stat-value {
        font-size: 1.8rem;
        font-weight: 700;
    }

    .tag-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        font-size: 0.8rem;
    }

    .status-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-inactive {
        background: #f3f4f6;
        color: #6b7280;
    }
</style>

@section Scripts {
    <script>
        function showAlert(type, message) {
            const placeholder = document.getElementById('alertPlaceholder');
            const cls = type === 'success' ? 'admin-alert-success' : 'admin-alert-danger';
            const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
            placeholder.innerHTML = `<div class="admin-alert ${cls}"><i class="bi ${icon}"></i> ${message}</div>`;
        }

        function showErrors(boxId, errors) {
            const box = document.getElementById(boxId);
            box.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> ' + errors.join('<br />');
            box.classList.remove('d-none');
        }

        function hideErrors(boxId) {
            document.getElementById(boxId).classList.add('d-none');
        }

        async function postForm(url, form, errorBoxId) {
            hideErrors(errorBoxId);
            const formData = new FormData(form);

            const response = await fetch(url, { method: 'POST', body: formData });

            let data = {};
            try { data = await response.json(); } catch { }

            if (!response.ok) {
                showErrors(errorBoxId, data.errors || ['Something went wrong.']);
                return null;
            }
            return data;
        }

        document.getElementById('editBrandModal').addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('editId').value = btn.getAttribute('data-id');
            document.getElementById('editName').value = btn.getAttribute('data-name');
            document.getElementById('editDescription').value = btn.getAttribute('data-description') || '';
            document.getElementById('editRemoveLogo').checked = false;

            const logo = btn.getAttribute('data-logo');
            const preview = document.getElementById('editLogoPreview');
            const placeholder = document.getElementById('editLogoPlaceholder');

            if (logo) {
                preview.src = logo;
                preview.classList.remove('d-none');
                placeholder.classList.add('d-none');
            } else {
                preview.classList.add('d-none');
                placeholder.classList.remove('d-none');
            }

            hideErrors('editErrors');
        });

        document.getElementById('editBrandForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const result = await postForm('@Url.Action("Edit", "Brands")?id=' + id, this, 'editErrors');
            if (result && result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editBrandModal')).hide();
                sessionStorage.setItem('brandToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            const raw = sessionStorage.getItem('brandToast');
            if (raw) {
                const toast = JSON.parse(raw);
                showAlert(toast.type, toast.message);
                sessionStorage.removeItem('brandToast');
            }
        });
    </script>
}