@model IEnumerable<WebApplication_ClothingEcommerce.Models.Brand>

@{
    ViewData["Title"] = "Brands";
    var totalBrands = Model?.Count() ?? 0;
    var totalProducts = Model?.Sum(b => b.Products?.Count ?? 0) ?? 0;
    var brandsWithLogo = Model?.Count(b => !string.IsNullOrWhiteSpace(b.Logo)) ?? 0;
    var activeVendors = Model?.Count(b => (b.Products?.Count ?? 0) > 0) ?? 0;
}

<div class="space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200/80 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-blue-600 dark:text-blue-400 mb-1 tracking-wider uppercase">
                <i class="bi bi-award-fill"></i>
                <span>CATALOG &amp; PARTNERS</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
                Brands
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Manage apparel brands, vendor labels, and official manufacturer emblems.
            </p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            <button type="button" onclick="openCreateBrandModal()"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-md hover:shadow-lg transition cursor-pointer">
                <i class="bi bi-plus-lg"></i>
                <span>Add Brand</span>
            </button>
        </div>
    </div>

    <!-- NOTIFICATION PLACEHOLDER -->
    <div id="alertPlaceholder"></div>

    <!-- 4 KPI SUMMARY CARDS (MATCHING REPORTS LAYOUT) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- 1. TOTAL BRANDS -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Brands</span>
                <span class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-base">
                    <i class="bi bi-award-fill"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-slate-900 dark:text-white tabular-nums">
                    @totalBrands
                </div>
                <div class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400 font-semibold mt-1">
                    <span>Partner brands &amp; labels</span>
                </div>
            </div>
        </div>

        <!-- 2. TOTAL PRODUCTS LINKED -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Branded Items</span>
                <span class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-base">
                    <i class="bi bi-bag-check-fill"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400 tabular-nums">
                    @totalProducts
                </div>
                <div class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400 font-bold mt-1">
                    <i class="bi bi-arrow-up-right"></i>
                    <span>Assigned clothing items</span>
                </div>
            </div>
        </div>

        <!-- 3. BRANDS WITH LOGOS -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Emblems Verified</span>
                <span class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-base">
                    <i class="bi bi-image-fill"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-indigo-600 dark:text-indigo-400 tabular-nums">
                    @brandsWithLogo
                </div>
                <div class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400 font-semibold mt-1">
                    <span>With custom logo</span>
                </div>
            </div>
        </div>

        <!-- 4. ACTIVE VENDORS -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Active Vendors</span>
                <span class="w-9 h-9 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-base">
                    <i class="bi bi-shop-window"></i>
                </span>
            </div>
            <div class="mt-3">
                <div class="text-2xl font-black text-amber-600 dark:text-amber-400 tabular-nums">
                    @activeVendors
                </div>
                <div class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400 font-semibold mt-1">
                    <span>Currently selling pieces</span>
                </div>
            </div>
        </div>

    </div>

    <!-- SEARCH & FILTER TOOLBAR -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm">
        <form asp-action="Index" method="get" class="flex flex-col sm:flex-row items-center gap-3">
            <div class="relative flex-1 w-full">
                <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search brand name or description..."
                       class="w-full text-xs font-medium pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="submit"
                        class="flex-1 sm:flex-initial px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-black dark:bg-slate-800 dark:hover:bg-slate-700 text-white text-xs font-bold transition flex items-center justify-center gap-1.5">
                    <i class="bi bi-funnel-fill"></i> <span>Filter</span>
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="p-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition" title="Reset Search">
                        <i class="bi bi-x-lg text-xs"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- BRANDS DATA TABLE CARD -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        @if (Model != null && Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" id="brandsTable">
                    <thead>
                        <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/60 text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 tracking-wider">
                            <th class="py-3 px-4 w-20">Logo</th>
                            <th class="py-3 px-4">Brand Name</th>
                            <th class="py-3 px-4">Description</th>
                            <th class="py-3 px-4">Products</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs">
                        @foreach (var brand in Model)
                        {
                            var prodCount = brand.Products?.Count ?? 0;
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition" data-row-id="@brand.Id">
                                <!-- Logo Thumbnail -->
                                <td class="py-3 px-4">
                                    @if (!string.IsNullOrWhiteSpace(brand.Logo))
                                    {
                                        <div class="w-12 h-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1 flex items-center justify-center overflow-hidden">
                                            <img src="@brand.Logo" alt="@brand.Name" class="w-full h-full object-contain" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center text-lg">
                                            <i class="bi bi-award"></i>
                                        </div>
                                    }
                                </td>

                                <!-- Brand Name -->
                                <td class="py-3.5 px-4 font-bold text-slate-900 dark:text-white">
                                    <a asp-action="Details" asp-route-id="@brand.Id" class="hover:text-blue-600 transition">
                                        @brand.Name
                                    </a>
                                </td>

                                <!-- Description -->
                                <td class="py-3.5 px-4 text-slate-500 dark:text-slate-400 max-w-md truncate">
                                    @(brand.Description ?? "—")
                                </td>

                                <!-- Products -->
                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold @(prodCount > 0 ? "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700")">
                                        <i class="bi bi-box-seam text-[10px]"></i> @prodCount items
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-action="Details" asp-route-id="@brand.Id"
                                           class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-blue-600 hover:border-blue-300 transition"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <button type="button"
                                                onclick="openEditBrandModal('@brand.Id', '@brand.Name', '@(brand.Description ?? "")', '@(brand.Logo ?? "")')"
                                                class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-amber-50 dark:hover:bg-amber-950/40 hover:text-amber-600 hover:border-amber-300 transition cursor-pointer"
                                                title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <button type="button"
                                                onclick="openDeleteBrandModal('@brand.Id', '@brand.Name')"
                                                class="p-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600 hover:border-rose-300 transition cursor-pointer"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-16 px-4">
                <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mx-auto mb-3">
                    <i class="bi bi-award text-2xl"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-1">No brands found</h4>
                <p class="text-xs text-slate-400 mb-4 max-w-xs mx-auto">Add your first brand to start managing your catalog.</p>
                <button type="button" onclick="openCreateBrandModal()"
                        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition">
                    <i class="bi bi-plus-lg"></i> Add Brand
                </button>
            </div>
        }
    </div>

</div>

<!-- =========================================================
     MODERN TAILWIND MODALS
========================================================== -->

<!-- CREATE BRAND MODAL -->
<div id="createBrandModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative animate-in fade-in zoom-in duration-150">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-base">
                    <i class="bi bi-plus-circle"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">Add Brand</h3>
                    <p class="text-[11px] text-slate-400">Create a new partner manufacturer</p>
                </div>
            </div>
            <button type="button" onclick="closeCreateBrandModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm p-1 rounded-lg">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <form id="createBrandForm" enctype="multipart/form-data" class="mt-4 space-y-4">
            @Html.AntiForgeryToken()
            <div id="createErrors" class="hidden p-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs"></div>

            <div>
                <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Brand Name</label>
                <input name="Name" class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500" placeholder="e.g. Nike, Zara, Adidas" required />
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Description</label>
                <textarea name="Description" rows="2" class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500" placeholder="Brand story and heritage..."></textarea>
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Brand Logo</label>
                
                <!-- Tab switch: Upload vs URL -->
                <div class="flex items-center gap-1.5 p-1 bg-slate-100 dark:bg-slate-800 rounded-xl mb-2 text-xs">
                    <button type="button" id="createTabUpload" onclick="switchBrandTab('create','upload')"
                            class="flex-1 py-1 rounded-lg font-bold transition bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs">
                        <i class="bi bi-upload mr-1"></i> Upload File
                    </button>
                    <button type="button" id="createTabUrl" onclick="switchBrandTab('create','url')"
                            class="flex-1 py-1 rounded-lg font-bold transition text-slate-500 hover:text-slate-900 dark:hover:text-white">
                        <i class="bi bi-link-45deg mr-1"></i> Image URL
                    </button>
                </div>

                <div id="createPanelUpload">
                    <input type="file" name="logo" id="createLogoFile" accept=".jpg,.jpeg,.png,.webp,.svg"
                           onchange="previewBrandFile(this, 'createPreviewImg', 'createPreviewEmpty')"
                           class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-slate-100 dark:file:bg-slate-800 file:text-slate-700 dark:file:text-slate-200 hover:file:bg-slate-200 cursor-pointer" />
                </div>

                <div id="createPanelUrl" class="hidden">
                    <input type="text" name="logoUrl" id="createLogoUrl" placeholder="https://example.com/logo.png"
                           oninput="previewBrandUrl(this.value, 'createPreviewImg', 'createPreviewEmpty')"
                           class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
                </div>

                <!-- Preview Area -->
                <div class="mt-2 h-24 rounded-xl border border-dashed border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 flex items-center justify-center p-2 relative overflow-hidden">
                    <div id="createPreviewEmpty" class="text-slate-400 text-center text-xs">
                        <i class="bi bi-image block text-xl mb-1"></i>
                        <span>Logo preview</span>
                    </div>
                    <img id="createPreviewImg" src="" alt="Preview" class="max-h-full max-w-full object-contain hidden" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeCreateBrandModal()"
                        class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    Cancel
                </button>
                <button type="submit"
                        class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition flex items-center gap-1.5">
                    <i class="bi bi-check2"></i> <span>Create Brand</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT BRAND MODAL -->
<div id="editBrandModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative animate-in fade-in zoom-in duration-150">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-base">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">Edit Brand</h3>
                    <p class="text-[11px] text-slate-400">Modify brand credentials and emblem</p>
                </div>
            </div>
            <button type="button" onclick="closeEditBrandModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm p-1 rounded-lg">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <form id="editBrandForm" enctype="multipart/form-data" class="mt-4 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editId" />
            <div id="editErrors" class="hidden p-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs"></div>

            <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700">
                <div class="w-12 h-12 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1 flex items-center justify-center overflow-hidden flex-shrink-0">
                    <img id="editLogoCurrent" src="" alt="Current Logo" class="w-full h-full object-contain hidden" />
                    <div id="editLogoPlaceholder" class="text-slate-400 text-lg">
                        <i class="bi bi-award"></i>
                    </div>
                </div>
                <label class="flex items-center gap-2 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">
                    <input type="checkbox" name="removeLogo" id="editRemoveLogo" value="true" class="rounded text-rose-600 focus:ring-rose-500" />
                    <span>Remove current logo</span>
                </label>
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Brand Name</label>
                <input name="Name" id="editName" class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Description</label>
                <textarea name="Description" id="editDescription" rows="2" class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <div id="editLogoSection">
                <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Replace Logo (Optional)</label>
                
                <div class="flex items-center gap-1.5 p-1 bg-slate-100 dark:bg-slate-800 rounded-xl mb-2 text-xs">
                    <button type="button" id="editTabUpload" onclick="switchBrandTab('edit','upload')"
                            class="flex-1 py-1 rounded-lg font-bold transition bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs">
                        <i class="bi bi-upload mr-1"></i> Upload File
                    </button>
                    <button type="button" id="editTabUrl" onclick="switchBrandTab('edit','url')"
                            class="flex-1 py-1 rounded-lg font-bold transition text-slate-500 hover:text-slate-900 dark:hover:text-white">
                        <i class="bi bi-link-45deg mr-1"></i> Image URL
                    </button>
                </div>

                <div id="editPanelUpload">
                    <input type="file" name="logo" id="editLogoFile" accept=".jpg,.jpeg,.png,.webp,.svg"
                           onchange="previewBrandFile(this, 'editPreviewImg', 'editPreviewEmpty')"
                           class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-slate-100 dark:file:bg-slate-800 file:text-slate-700 dark:file:text-slate-200 hover:file:bg-slate-200 cursor-pointer" />
                </div>

                <div id="editPanelUrl" class="hidden">
                    <input type="text" name="logoUrl" id="editLogoUrl" placeholder="https://example.com/logo.png"
                           oninput="previewBrandUrl(this.value, 'editPreviewImg', 'editPreviewEmpty')"
                           class="w-full text-xs font-semibold py-2 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
                </div>

                <div class="mt-2 h-20 rounded-xl border border-dashed border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 flex items-center justify-center p-2 relative overflow-hidden">
                    <div id="editPreviewEmpty" class="text-slate-400 text-center text-[11px]">
                        <span>New emblem preview</span>
                    </div>
                    <img id="editPreviewImg" src="" alt="New Preview" class="max-h-full max-w-full object-contain hidden" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeEditBrandModal()"
                        class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    Cancel
                </button>
                <button type="submit"
                        class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition flex items-center gap-1.5">
                    <i class="bi bi-check2"></i> <span>Save Changes</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- DELETE BRAND MODAL -->
<div id="deleteBrandModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-sm w-full p-6 shadow-2xl relative animate-in fade-in zoom-in duration-150">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center text-base">
                    <i class="bi bi-trash"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white">Delete Brand</h3>
                    <p class="text-[11px] text-slate-400">Confirm removal</p>
                </div>
            </div>
            <button type="button" onclick="closeDeleteBrandModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm p-1 rounded-lg">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <form id="deleteBrandForm" class="mt-4 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteId" />
            <div id="deleteErrors" class="hidden p-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs"></div>

            <p class="text-xs text-slate-600 dark:text-slate-300">
                Are you sure you want to delete <strong class="text-slate-900 dark:text-white" id="deleteName"></strong>? This action cannot be undone.
            </p>

            <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeDeleteBrandModal()"
                        class="px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    Cancel
                </button>
                <button type="submit"
                        class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shadow transition flex items-center gap-1.5">
                    <i class="bi bi-trash"></i> <span>Delete</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function showAlert(type, message) {
            const placeholder = document.getElementById('alertPlaceholder');
            const isSuccess = type === 'success';
            placeholder.innerHTML = `
                <div class="p-4 rounded-2xl ${isSuccess ? 'bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300' : 'bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300'} text-xs flex items-center gap-2.5 mb-4">
                    <i class="bi ${isSuccess ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'} text-base flex-shrink-0"></i>
                    <span>${message}</span>
                </div>
            `;
        }

        function showErrors(boxId, errors) {
            const box = document.getElementById(boxId);
            box.innerHTML = '<i class="bi bi-exclamation-triangle-fill mr-1"></i> ' + errors.join('<br />');
            box.classList.remove('hidden');
        }

        function hideErrors(boxId) {
            document.getElementById(boxId).classList.add('hidden');
        }

        function switchBrandTab(prefix, tab) {
            const isUpload = tab === 'upload';
            document.getElementById(`${prefix}PanelUpload`).classList.toggle('hidden', !isUpload);
            document.getElementById(`${prefix}PanelUrl`).classList.toggle('hidden', isUpload);

            const tabUp = document.getElementById(`${prefix}TabUpload`);
            const tabUrl = document.getElementById(`${prefix}TabUrl`);

            if (isUpload) {
                tabUp.className = 'flex-1 py-1 rounded-lg font-bold transition bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs';
                tabUrl.className = 'flex-1 py-1 rounded-lg font-bold transition text-slate-500 hover:text-slate-900 dark:hover:text-white';
                document.getElementById(`${prefix}LogoUrl`).value = '';
            } else {
                tabUrl.className = 'flex-1 py-1 rounded-lg font-bold transition bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs';
                tabUp.className = 'flex-1 py-1 rounded-lg font-bold transition text-slate-500 hover:text-slate-900 dark:hover:text-white';
                document.getElementById(`${prefix}LogoFile`).value = '';
            }
            document.getElementById(`${prefix}PreviewImg`).classList.add('hidden');
            document.getElementById(`${prefix}PreviewEmpty`).classList.remove('hidden');
        }

        function previewBrandFile(input, previewId, emptyId) {
            const preview = document.getElementById(previewId);
            const empty = document.getElementById(emptyId);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                    empty.classList.add('hidden');
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.src = '';
                preview.classList.add('hidden');
                empty.classList.remove('hidden');
            }
        }

        function previewBrandUrl(url, previewId, emptyId) {
            const preview = document.getElementById(previewId);
            const empty = document.getElementById(emptyId);
            if (!url || !url.trim()) {
                preview.src = '';
                preview.classList.add('hidden');
                empty.classList.remove('hidden');
                return;
            }
            preview.onload = function() {
                preview.classList.remove('hidden');
                empty.classList.add('hidden');
            };
            preview.onerror = function() {
                preview.classList.add('hidden');
                empty.classList.remove('hidden');
            };
            preview.src = url.trim();
        }

        async function postForm(url, form, errorBoxId) {
            hideErrors(errorBoxId);
            const formData = new FormData(form);

            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            let data = {};
            try { data = await response.json(); } catch { }

            if (!response.ok) {
                showErrors(errorBoxId, data.errors || ['Something went wrong.']);
                return null;
            }
            return data;
        }

        function openCreateBrandModal() {
            hideErrors('createErrors');
            document.getElementById('createBrandForm').reset();
            switchBrandTab('create', 'upload');
            const modal = document.getElementById('createBrandModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCreateBrandModal() {
            const modal = document.getElementById('createBrandModal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        function openEditBrandModal(id, name, desc, logo) {
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editDescription').value = desc || '';
            document.getElementById('editRemoveLogo').checked = false;
            hideErrors('editErrors');

            const currentImg = document.getElementById('editLogoCurrent');
            const placeholder = document.getElementById('editLogoPlaceholder');
            if (logo) {
                currentImg.src = logo;
                currentImg.classList.remove('hidden');
                placeholder.classList.add('hidden');
            } else {
                currentImg.classList.add('hidden');
                placeholder.classList.remove('hidden');
            }

            switchBrandTab('edit', 'upload');
            const modal = document.getElementById('editBrandModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeEditBrandModal() {
            const modal = document.getElementById('editBrandModal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        function openDeleteBrandModal(id, name) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteName').textContent = name;
            hideErrors('deleteErrors');
            const modal = document.getElementById('deleteBrandModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeDeleteBrandModal() {
            const modal = document.getElementById('deleteBrandModal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        // Create submit
        document.getElementById('createBrandForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const result = await postForm('@Url.Action("Create")', this, 'createErrors');
            if (result && result.success) {
                closeCreateBrandModal();
                sessionStorage.setItem('brandToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // Edit submit
        document.getElementById('editBrandForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const result = await postForm('@Url.Action("Edit")?id=' + id, this, 'editErrors');
            if (result && result.success) {
                closeEditBrandModal();
                sessionStorage.setItem('brandToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // Delete submit
        document.getElementById('deleteBrandForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const id = document.getElementById('deleteId').value;
            const result = await postForm('@Url.Action("Delete")/' + id, this, 'deleteErrors');
            if (result && result.success) {
                closeDeleteBrandModal();
                sessionStorage.setItem('brandToast', JSON.stringify({ type: 'success', message: result.message }));
                location.reload();
            }
        });

        // Show toast after reload
        document.addEventListener('DOMContentLoaded', function() {
            const raw = sessionStorage.getItem('brandToast');
            if (raw) {
                const toast = JSON.parse(raw);
                showAlert(toast.type, toast.message);
                sessionStorage.removeItem('brandToast');
            }
        });
    </script>
}
