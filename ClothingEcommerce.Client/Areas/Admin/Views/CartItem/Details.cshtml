@model WebApplication_ClothingEcommerce.Models.CartItem

@{
    ViewData["Title"] = "Cart Item Details";
    var product = Model?.Variant?.Product;
    var primaryImg = product?.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl 
                  ?? product?.Images?.FirstOrDefault()?.ImageUrl;
    var unitPrice = Model?.Variant?.Price ?? 0;
    var quantity = Model?.Quantity ?? 0;
    var lineTotal = unitPrice * quantity;
    var customer = Model?.Cart?.Customer;
}

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <!-- Breadcrumb -->
            <nav class="flex mb-2" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                    <li class="inline-flex items-center">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hover:text-primary-600 dark:hover:text-primary-400">Admin</a>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span data-en="Commerce" data-kh="ពាណិជ្ជកម្ម">Commerce</span>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <a asp-action="Index" class="hover:text-primary-600 dark:hover:text-primary-400" data-en="Cart Items" data-kh="ទំនិញក្នុងកន្ត្រក">Cart Items</a>
                    </li>
                    <li class="flex items-center">
                        <i class="bi bi-chevron-right text-[10px] mx-1 text-slate-400"></i>
                        <span class="text-slate-900 dark:text-white font-semibold" data-en="Details" data-kh="ព័ត៌មានលម្អិត">Product Cart Details</span>
                    </li>
                </ol>
            </nav>

            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950/50 text-primary-600 dark:text-primary-400 flex items-center justify-center text-lg">
                    <i class="bi bi-cart3"></i>
                </span>
                <span data-en="Product Cart Details" data-kh="ព័ត៌មានលម្អិតទំនិញក្នុងកន្ត្រក">Product Cart Details</span>
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Inspect variant specifications, unit valuation, quantity reserved, and customer ownership.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <a asp-action="Index" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-sm transition">
                <i class="bi bi-arrow-left"></i>
                <span data-en="Back to List" data-kh="ត្រឡប់ក្រោយ">Back to List</span>
            </a>

            @if (Model != null)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200/80 dark:border-amber-800 hover:bg-amber-100 text-amber-700 dark:text-amber-300 text-xs font-semibold shadow-sm transition">
                    <i class="bi bi-pencil"></i>
                    <span data-en="Edit Item" data-kh="កែសម្រួល">Edit Item</span>
                </a>

                <a asp-action="Delete" asp-route-id="@Model.Id" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl border border-rose-200 dark:border-rose-900/60 bg-rose-50/60 dark:bg-rose-950/30 hover:bg-rose-100 text-rose-700 dark:text-rose-300 text-xs font-semibold transition">
                    <i class="bi bi-trash"></i>
                    <span data-en="Remove" data-kh="លុបចោល">Remove Item</span>
                </a>
            }
            else
            {
                <form asp-action="SeedSample" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold shadow-sm transition">
                        <i class="bi bi-plus-circle"></i>
                        <span>Populate Sample Item</span>
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model == null)
    {
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-12 text-center shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-primary-50 dark:bg-primary-950/50 text-primary-600 dark:text-primary-400 flex items-center justify-center text-3xl mx-auto mb-4">
                <i class="bi bi-cart-x"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2" data-en="No Cart Item Available" data-kh="មិនមានទំនិញក្នុងកន្ត្រក">No Cart Item Available</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mb-6">
                There are currently no items saved in customer shopping carts. You can populate sample test items or browse the product catalog.
            </p>
            <div class="flex items-center justify-center gap-3">
                <form asp-action="SeedSample" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold shadow-md transition">
                        <i class="bi bi-plus-circle"></i>
                        <span>Add Sample Cart Items</span>
                    </button>
                </form>
                <a asp-area="" asp-controller="Shop" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold hover:bg-slate-50 transition">
                    <i class="bi bi-shop"></i>
                    <span>View Shop</span>
                </a>
            </div>
        </div>
    }
    else
    {

    <!-- 2-COLUMN DETAILS LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- LEFT COLUMN: Product & Pricing (8 cols) -->
        <div class="lg:col-span-8 space-y-6">

            <!-- Product Summary Card -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950/40 text-primary-600 dark:text-primary-400 flex items-center justify-center text-sm">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <h2 class="text-base font-bold text-slate-900 dark:text-white" data-en="Product Specification" data-kh="លក្ខណៈទំនិញ">
                            Product Specification
                        </h2>
                    </div>
                    @if (product != null)
                    {
                        <a asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" target="_blank" class="inline-flex items-center gap-1 text-xs font-semibold text-primary-600 hover:text-primary-700 transition">
                            <span>Storefront View</span>
                            <i class="bi bi-box-arrow-up-right text-[10px]"></i>
                        </a>
                    }
                </div>

                <div class="flex flex-col sm:flex-row items-start gap-6">
                    <!-- Image -->
                    <div class="w-full sm:w-36 h-44 rounded-2xl bg-slate-100 dark:bg-slate-800 overflow-hidden border border-slate-200/80 dark:border-slate-700 flex-shrink-0 relative">
                        @if (!string.IsNullOrEmpty(primaryImg))
                        {
                            <img src="@primaryImg" alt="@(product?.Name ?? "Product Image")" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-slate-400">
                                <i class="bi bi-image text-3xl"></i>
                            </div>
                        }
                    </div>

                    <!-- Details -->
                    <div class="flex-1 space-y-3 min-w-0">
                        <div>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700 mb-1">
                                @(product?.Brand?.Name ?? "CLOTHÉ Brand")
                            </span>
                            <h3 class="text-lg font-bold text-slate-900 dark:text-white truncate">
                                @(product?.Name ?? "Product Name Unavailable")
                            </h3>
                            <span class="font-mono text-xs text-slate-400 dark:text-slate-500 block mt-0.5">
                                SKU: @(Model.Variant?.SKU ?? "NO-SKU")
                            </span>
                        </div>

                        <!-- Variant Attributes Grid -->
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
                            <div class="p-3 rounded-xl bg-slate-50/60 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800">
                                <span class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 block mb-1">Selected Color</span>
                                <div class="flex items-center gap-1.5">
                                    @if (!string.IsNullOrEmpty(Model.Variant?.Color?.HexCode))
                                    {
                                        <span class="w-3.5 h-3.5 rounded-full border border-slate-300 dark:border-slate-600 shadow-sm" style="background-color: @Model.Variant.Color.HexCode;"></span>
                                    }
                                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">
                                        @(Model.Variant?.Color?.Name ?? "Standard")
                                    </span>
                                </div>
                            </div>

                            <div class="p-3 rounded-xl bg-slate-50/60 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800">
                                <span class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 block mb-1">Selected Size</span>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-lg text-xs font-extrabold bg-white dark:bg-slate-700 text-slate-900 dark:text-white border border-slate-200 dark:border-slate-600">
                                    @(Model.Variant?.Size?.Name ?? "One Size")
                                </span>
                            </div>

                            <div class="p-3 rounded-xl bg-slate-50/60 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800">
                                <span class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 block mb-1">Availability</span>
                                <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-600 dark:text-emerald-400">
                                    <i class="bi bi-check-circle-fill text-[10px]"></i> Active Variant
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Financials & Quantity Breakdown Card -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div class="flex items-center gap-2.5 pb-4 mb-5 border-b border-slate-100 dark:border-slate-800">
                    <div class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white" data-en="Financial & Quantity Breakdown" data-kh="តម្លៃ & បរិមាណ">
                        Financial &amp; Quantity Breakdown
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="p-4 rounded-xl border border-slate-200/80 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Unit Price</span>
                        <div class="text-xl font-bold text-slate-900 dark:text-white">
                            $@unitPrice.ToString("N2")
                        </div>
                        @if (Model.Variant != null && Model.Variant.CompareAtPrice.HasValue && Model.Variant.CompareAtPrice.Value > unitPrice)
                        {
                            <span class="text-xs line-through text-slate-400 block mt-0.5">
                                Original: $@Model.Variant.CompareAtPrice.Value.ToString("N2")
                            </span>
                        }
                    </div>

                    <div class="p-4 rounded-xl border border-slate-200/80 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40">
                        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-1">Quantity in Cart</span>
                        <div class="text-xl font-bold text-primary-600 dark:text-primary-400">
                            @Model.Quantity <span class="text-xs font-normal text-slate-500 dark:text-slate-400">unit@(Model.Quantity == 1 ? "" : "s")</span>
                        </div>
                    </div>

                    <div class="p-4 rounded-xl border border-emerald-200/80 dark:border-emerald-800/60 bg-emerald-50/40 dark:bg-emerald-950/20">
                        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 block mb-1">Item Line Total</span>
                        <div class="text-2xl font-extrabold text-emerald-700 dark:text-emerald-400">
                            $@lineTotal.ToString("N2")
                        </div>
                    </div>
                </div>

                <!-- Technical IDs -->
                <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 font-mono">
                        <span class="text-slate-400 block text-[10px] uppercase font-sans font-bold mb-0.5">Cart Item Record ID</span>
                        <span class="text-slate-800 dark:text-slate-200 select-all break-all">@Model.Id</span>
                    </div>

                    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 font-mono">
                        <span class="text-slate-400 block text-[10px] uppercase font-sans font-bold mb-0.5">Product Variant ID</span>
                        <span class="text-slate-800 dark:text-slate-200 select-all break-all">@Model.VariantId</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: Customer & Cart Relationship (4 cols) -->
        <div class="lg:col-span-4 space-y-6">

            <!-- Customer Card -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-slate-100 dark:border-slate-800">
                    <div class="w-8 h-8 rounded-xl bg-sky-50 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 flex items-center justify-center text-sm">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white" data-en="Cart Owner" data-kh="ម្ចាស់កន្ត្រក">
                        Cart Owner
                    </h3>
                </div>

                @if (customer != null)
                {
                    <div class="space-y-3 text-xs">
                        <div>
                            <span class="text-slate-400 dark:text-slate-500 font-semibold uppercase tracking-wider block mb-0.5">Customer Name</span>
                            <span class="text-sm font-bold text-slate-900 dark:text-white">@customer.FirstName @customer.LastName</span>
                        </div>

                        <div>
                            <span class="text-slate-400 dark:text-slate-500 font-semibold uppercase tracking-wider block mb-0.5">Email Address</span>
                            <span class="text-slate-800 dark:text-slate-200 font-medium">@customer.Email</span>
                        </div>

                        @if (!string.IsNullOrEmpty(customer.Phone))
                        {
                            <div>
                                <span class="text-slate-400 dark:text-slate-500 font-semibold uppercase tracking-wider block mb-0.5">Phone Number</span>
                                <span class="text-slate-800 dark:text-slate-200 font-medium">@customer.Phone</span>
                            </div>
                        }

                        <div class="pt-2">
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary-600 hover:text-primary-700 transition">
                                <i class="bi bi-person"></i> View Customer Profile <i class="bi bi-arrow-right text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-xs text-slate-500 dark:text-slate-400 italic">
                        No customer profile linked to this cart.
                    </div>
                }
            </div>

            <!-- Cart Session Details Card -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-4">
                <div class="flex items-center gap-2.5 pb-4 border-b border-slate-100 dark:border-slate-800">
                    <div class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm">
                        <i class="bi bi-cart"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white" data-en="Shopping Cart Session" data-kh="កន្ត្រកទំនិញ">
                        Shopping Cart Session
                    </h3>
                </div>

                <div class="space-y-3 text-xs">
                    <div>
                        <span class="text-slate-400 dark:text-slate-500 font-semibold uppercase tracking-wider block mb-0.5">Cart Identifier</span>
                        <span class="font-mono text-[11px] text-slate-800 dark:text-slate-200 select-all break-all">@Model.CartId</span>
                    </div>

                    @if (Model.Cart != null)
                    {
                        <div>
                            <span class="text-slate-400 dark:text-slate-500 font-semibold uppercase tracking-wider block mb-0.5">Cart Created</span>
                            <span class="text-slate-800 dark:text-slate-200">@Model.Cart.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </div>

                        <div class="pt-2">
                            <a asp-controller="Cart" asp-action="Index" asp-route-customerId="@Model.Cart.CustomerId" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold shadow-sm transition">
                                <i class="bi bi-cart3"></i> View Entire Customer Cart
                            </a>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
    }
</div>
