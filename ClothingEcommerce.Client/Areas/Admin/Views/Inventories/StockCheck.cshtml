@using ClothingEcommerce.Shared.DTOs.Catalog
@using ClothingEcommerce.Shared.DTOs.Inventory
@model PagedResult<StockCheckItemDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Real-Time Stock Checker";
    var filter = ViewBag.Filter as StockFilterDto ?? new StockFilterDto();
    var categories = ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>();
    var isManagerOrAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Manager");
    var totalItems = Model?.TotalCount ?? Model?.Items?.Count ?? 0;
}

<div class="space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200/80 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-2 text-xs font-bold text-blue-600 dark:text-blue-400 mb-1 tracking-wider uppercase">
                <i class="bi bi-upc-scan"></i>
                <span>INVENTORY &amp; WAREHOUSE</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
                Real-Time Stock Checker
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Floor staff &amp; warehouse inventory lookup across sizes, colors, and live physical availability.
            </p>
        </div>

        <!-- ACTIONS -->
        <div class="flex items-center gap-2.5 flex-wrap">
            @if (isManagerOrAdmin)
            {
                <a asp-action="Movements"
                   class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 text-xs font-bold shadow-sm transition">
                    <i class="bi bi-clock-history"></i>
                    <span>Stock Movement Log</span>
                </a>
            }
            <a asp-area="Admin" asp-controller="Pos" asp-action="Index"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-md hover:shadow-lg transition">
                <i class="bi bi-shop"></i>
                <span>Open POS Terminal</span>
            </a>
        </div>
    </div>

    <!-- SCANNER & FILTER BAR -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm">
        <form method="get" class="flex flex-col md:flex-row items-center gap-3">
            <div class="relative flex-1 w-full">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <i class="bi bi-search text-xs"></i>
                </div>
                <input type="text" name="SearchTerm" value="@filter.SearchTerm"
                       class="w-full text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 pl-9 pr-4 py-2.5 text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
                       placeholder="Scan Barcode / SKU / Product Name..." autofocus autocomplete="off" />
            </div>

            <div class="flex items-center gap-2">
                <label class="inline-flex items-center gap-2 text-xs font-semibold text-rose-600 dark:text-rose-400 cursor-pointer bg-rose-50 dark:bg-rose-950/40 px-3 py-2 rounded-xl border border-rose-200 dark:border-rose-800/60">
                    <input type="checkbox" name="LowStockOnly" value="true" id="chkLowStock"
                           class="w-3.5 h-3.5 rounded text-rose-600 focus:ring-rose-500"
                           @(filter.LowStockOnly == true ? "checked" : "") onchange="this.form.submit()" />
                    <span><i class="bi bi-exclamation-triangle-fill mr-1"></i>Low Stock Warning (&le; 5)</span>
                </label>
            </div>

            <div class="flex items-center gap-2 w-full md:w-auto">
                <button type="submit"
                        class="flex-1 md:flex-none px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition flex items-center justify-center gap-1.5 cursor-pointer">
                    <i class="bi bi-funnel-fill"></i> Filter Stock
                </button>
                <a asp-action="StockCheck"
                   class="flex-1 md:flex-none px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 text-xs font-bold transition flex items-center justify-center gap-1.5">
                    <i class="bi bi-arrow-repeat"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- MAIN STOCK TABLE CARD -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between flex-wrap gap-2">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i class="bi bi-boxes text-blue-600"></i> Stock Verification Table
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">Live counts across all catalog variants</p>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                @totalItems variant@(totalItems == 1 ? "" : "s")
            </span>
        </div>

        @if (Model == null || !Model.Items.Any())
        {
            <div class="text-center py-16 px-4">
                <div class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl shadow-sm">
                    <i class="bi bi-inbox"></i>
                </div>
                <h4 class="text-base font-bold text-slate-800 dark:text-slate-200">No Inventory Items Found</h4>
                <p class="text-xs text-slate-400 max-w-sm mx-auto mt-1">
                    No products or variants matched your search criteria. Try clearing the filter or checking product SKUs.
                </p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 font-bold uppercase text-[10px] tracking-wider border-b border-slate-200/80 dark:border-slate-800">
                        <tr>
                            <th class="py-3 px-4">Product &amp; Category</th>
                            <th class="py-3 px-4">Barcode / SKU</th>
                            <th class="py-3 px-4">Variant (Size &amp; Color)</th>
                            <th class="py-3 px-4 text-right">Retail Price</th>
                            <th class="py-3 px-4 text-center">Physical Stock</th>
                            <th class="py-3 px-4 text-center">Available Stock</th>
                            <th class="py-3 px-4 text-center">Stock Health</th>
                            @if (isManagerOrAdmin)
                            {
                                <th class="py-3 px-4 text-right">Inventory Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/50">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.ProductName" class="w-10 h-10 rounded-xl object-cover border border-slate-200 dark:border-slate-700 flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 flex-shrink-0">
                                                <i class="bi bi-image text-xs"></i>
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <div class="font-bold text-slate-900 dark:text-white truncate">@item.ProductName</div>
                                            <div class="text-[11px] text-slate-400 truncate">@item.CategoryName &middot; @item.BrandName</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <code class="font-mono text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 px-2 py-0.5 rounded-lg">@item.VariantSku</code>
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2">
                                        @if (!string.IsNullOrEmpty(item.ColorHex))
                                        {
                                            <span class="w-3.5 h-3.5 rounded-full border border-slate-300 dark:border-slate-600 flex-shrink-0" style="background-color: @item.ColorHex;"></span>
                                        }
                                        <span class="font-medium text-slate-700 dark:text-slate-300">@item.SizeName / @item.ColorName</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-right font-black text-slate-900 dark:text-white">
                                    $@item.Price.ToString("N2")
                                </td>
                                <td class="py-3.5 px-4 text-center font-bold text-slate-700 dark:text-slate-300">
                                    @item.Quantity
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold @(item.AvailableQuantity > 5 ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800" : (item.AvailableQuantity > 0 ? "bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 border border-amber-200 dark:border-amber-800" : "bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-400 border border-rose-200 dark:border-rose-800"))">
                                        @item.AvailableQuantity
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (item.AvailableQuantity == 0)
                                    {
                                        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300">Out of Stock</span>
                                    }
                                    else if (item.AvailableQuantity <= 5)
                                    {
                                        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Healthy</span>
                                    }
                                </td>
                                @if (isManagerOrAdmin)
                                {
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="inline-flex items-center gap-1.5">
                                            <button type="button"
                                                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 text-xs font-bold transition cursor-pointer"
                                                    onclick="openAdjustModal('@item.ProductVariantId', '@item.ProductName', '@item.VariantSku', 'StockIn')">
                                                <i class="bi bi-plus-lg"></i>
                                                <span>Stock IN</span>
                                            </button>
                                            <button type="button"
                                                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-900/50 text-xs font-bold transition cursor-pointer"
                                                    onclick="openAdjustModal('@item.ProductVariantId', '@item.ProductName', '@item.VariantSku', 'StockOut')">
                                                <i class="bi bi-dash-lg"></i>
                                                <span>Stock OUT</span>
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION FOOTER -->
            @if (Model != null && Model.TotalPages > 1)
            {
                <div class="p-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between flex-wrap gap-2">
                    <span class="text-xs text-slate-500 dark:text-slate-400">
                        Page <strong class="text-slate-800 dark:text-slate-200">@Model.PageNumber</strong> of <strong class="text-slate-800 dark:text-slate-200">@Model.TotalPages</strong>
                    </span>
                    <div class="flex items-center gap-1.5">
                        <a asp-action="StockCheck" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchTerm="@filter.SearchTerm" asp-route-lowStockOnly="@filter.LowStockOnly"
                           class="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold @(!Model.HasPreviousPage ? "opacity-50 pointer-events-none text-slate-400" : "text-slate-700 dark:text-slate-300 hover:bg-slate-50")">
                            Previous
                        </a>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <a asp-action="StockCheck" asp-route-page="@p" asp-route-searchTerm="@filter.SearchTerm" asp-route-lowStockOnly="@filter.LowStockOnly"
                               class="w-8 h-8 rounded-xl text-xs font-bold flex items-center justify-center transition @(p == Model.PageNumber ? "bg-blue-600 text-white shadow-sm" : "border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50")">
                                @p
                            </a>
                        }
                        <a asp-action="StockCheck" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchTerm="@filter.SearchTerm" asp-route-lowStockOnly="@filter.LowStockOnly"
                           class="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold @(!Model.HasNextPage ? "opacity-50 pointer-events-none text-slate-400" : "text-slate-700 dark:text-slate-300 hover:bg-slate-50")">
                            Next
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- =========================================================
     MODAL: STOCK ADJUSTMENT (IN / OUT)
========================================================= -->
<div class="modal fade" id="adjustModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl overflow-hidden">
            <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white" id="adjustModalTitle">Adjust Stock</h3>
                    <p class="text-xs text-slate-400 mt-0.5">Physical count modification</p>
                </div>
                <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="p-5 space-y-4">
                <input type="hidden" id="adjustVariantId" />
                
                <div class="p-3 bg-slate-50 dark:bg-slate-800/60 rounded-2xl border border-slate-100 dark:border-slate-800">
                    <div class="font-bold text-sm text-slate-900 dark:text-white" id="adjustProductName">Product</div>
                    <code class="text-xs font-mono text-blue-600 dark:text-blue-400 mt-0.5 block" id="adjustSku">SKU: --</code>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Adjustment Type</label>
                    <select id="adjustTypeSelect"
                            class="w-full text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="StockIn">Stock IN (Supplier Shipment Arrival)</option>
                        <option value="StockOut">Stock OUT (Store Transfer / Sample)</option>
                        <option value="Damaged">Damaged / Defective Goods</option>
                        <option value="Return">Customer Return</option>
                        <option value="AuditCorrection">Physical Audit Count Correction</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Quantity</label>
                    <input type="number" id="adjustQuantityInput" min="1" value="1"
                           class="w-full text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-slate-800 dark:text-slate-200 font-bold focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Reason / Notes</label>
                    <input type="text" id="adjustReasonInput" placeholder="e.g. Batch arrival or floor damage"
                           class="w-full text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Reference Document #</label>
                    <input type="text" id="adjustRefInput" placeholder="PO-12345 or RMA-001"
                           class="w-full text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-2.5 font-mono text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>
            </div>
            <div class="p-5 bg-slate-50 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-2.5">
                <button type="button" class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 transition" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" id="btnSubmitAdjustment" onclick="submitAdjustment()"
                        class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-md hover:shadow-lg transition cursor-pointer">
                    Save Adjustment
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function openAdjustModal(variantId, name, sku, defaultType) {
        document.getElementById('adjustVariantId').value = variantId;
        document.getElementById('adjustProductName').innerText = name;
        document.getElementById('adjustSku').innerText = 'SKU: ' + sku;
        document.getElementById('adjustTypeSelect').value = defaultType;
        document.getElementById('adjustQuantityInput').value = 1;
        document.getElementById('adjustReasonInput').value = '';
        document.getElementById('adjustRefInput').value = '';

        const modal = new bootstrap.Modal(document.getElementById('adjustModal'));
        modal.show();
    }

    async function submitAdjustment() {
        const btn = document.getElementById('btnSubmitAdjustment');
        btn.disabled = true;

        const payload = {
            productVariantId: document.getElementById('adjustVariantId').value,
            movementType: document.getElementById('adjustTypeSelect').value,
            quantity: parseInt(document.getElementById('adjustQuantityInput').value) || 1,
            reason: document.getElementById('adjustReasonInput').value,
            reference: document.getElementById('adjustRefInput').value
        };

        try {
            const res = await fetch('/Admin/Inventories/Adjust', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const json = await res.json();
            if (json.success) {
                location.reload();
            } else {
                alert(json.message || "Failed to adjust stock.");
                btn.disabled = false;
            }
        } catch (err) {
            console.error(err);
            alert("Error adjusting stock.");
            btn.disabled = false;
        }
    }
</script>
