# Application Environment Variables Template
# Copy this file to .env and configure values for your environment. DO NOT commit .env with real credentials!

ASPNETCORE_ENVIRONMENT=Production
DefaultConnection="Server=localhost;Database=WebApplication_ClothingEcommerce;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# KHQR / Bakong Payment API Configuration
KHQR_BASE_URL="https://api-bakong.nbc.gov.kh"
KHQR_MERCHANT_ID="your_merchant_id_here"
KHQR_BAKONG_ACCOUNT_ID="your_bakong_account_id_here"
KHQR_MERCHANT_NAME="Clothing Store"
KHQR_MERCHANT_CITY="Phnom Penh"
