# =========================================================================
# Application Environment Variables Template (.env.example)
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env with real credentials!
# =========================================================================

ASPNETCORE_ENVIRONMENT=Development
DefaultConnection="Server=localhost;Database=WebApplication_ClothingEcommerce;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# ========================================
# Initial SuperAdmin Account Seed
# ========================================
SUPERADMIN_EMAIL="superadmin@clothe.com"
SUPERADMIN_PASSWORD="your-strong-superadmin-password"

# ========================================
# Google Authentication Credentials (OAuth 2.0)
# ========================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ========================================
# Bakong KHQR Payment Configuration
# ========================================
BAKONG_ACCOUNT_ID="your_account@bkrt"
BAKONG_MERCHANT_NAME="Your Merchant Name"
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_PHONE="012345678"
BAKONG_STORE_LABEL="Clothing Store"
BAKONG_CURRENCY="USD"
BAKONG_USD_TO_KHR_RATE="4100"
BAKONG_BASE_URL="https://api-bakong.nbc.gov.kh"
BAKONG_TOKEN="your-bakong-jwt-token"

# Backward Compatibility (KHQR Prefix)
KHQR_BAKONG_ACCOUNT_ID="your_account@bkrt"
KHQR_MERCHANT_NAME="Your Merchant Name"
KHQR_MERCHANT_CITY="Phnom Penh"
KHQR_PHONE="012345678"
KHQR_STORE_LABEL="Clothing Store"
KHQR_CURRENCY="USD"
KHQR_USD_TO_KHR_RATE="4100"
KHQR_BASE_URL="https://api-bakong.nbc.gov.kh"
KHQR_TOKEN="your-bakong-jwt-token"

# ========================================
# Telegram Bot Integration
# ========================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="your_telegram_bot_username"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# ========================================
# Mail (SMTP) Configuration
# ========================================
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="465"
MAIL_USERNAME="your_email@gmail.com"
MAIL_PASSWORD="your_email_app_password"
MAIL_FROM_ADDRESS="your_email@gmail.com"
MAIL_FROM_NAME="CLOTHÉ Clothing Store"
MAIL_ENCRYPTION="ssl"
MAIL_ADMIN_EMAIL="admin@clothe.com"
SMTP_ADMIN_EMAIL="admin@clothe.com"

# Legacy SMTP Compatibility
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_email_app_password"
SMTP_FROM_EMAIL="noreply@clothe.com"
SMTP_FROM_NAME="CLOTHÉ Clothing Store"
SMTP_ENABLE_SSL=true
SMTP_NOTIFY_NEW_ORDER=true
SMTP_NOTIFY_PAYMENT_SUCCESS=true
SMTP_NOTIFY_LOW_STOCK=true
SMTP_NOTIFY_SHIPMENT_UPDATE=true
